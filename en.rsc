3:["$","div",null,{"lang":"en","children":[["$","$Le",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI isn’t the problem. Sameness is.","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"50 accounts. One idea. Zero strategy.","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Does native really win? Show the data.","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"Your agent can publish. Teach it to wait.","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"One brand account cannot carry everything.","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"New subtitles do not make a new idea.","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"The feed did not add hours to the day.","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"Welcome to the feed arms race.","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Your SaaS competes with cat videos too.","dek":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"A row of phones is not a strategy.","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"AGD must outlive the name of its vendor.","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"A small manifesto for accounts with a reason to exist.","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"What we refuse to sell as growth.","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"Native is an environment, not a talisman.","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"A persona is not a photo and a name.","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"“Stop scrolling”: everybody is shouting the same thing.","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless. Not voiceless.","dek":"A Faceless Account creates content without relying on its operator’s visible face."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"A recurring format beats an empty template.","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"A chaotic account still has a point of view.","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"A synthetic character needs something to say.","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"One product. Three narrators. Three reasons.","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"A slideshow is a story, not a sliced PDF.","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"A little tension beats fifteen advice slides.","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Teach something before the final slide.","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"The joke should work without the logo.","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"The product enters when it becomes useful.","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Marketing caught brainrot. What next?","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"A good brief starts with what we want to learn.","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"The hook’s promise must be paid back.","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"Your creative library is not a final_final folder.","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"The format works. Until it just repeats.","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"The matrix that stops fifty copies from being born.","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"Warm an account without invoking magic.","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native posting: the action matters, so does the brief.","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Warming is not a robot dance.","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"A US account does not guarantee a US audience.","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Localization starts before the publish button.","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"Launching in the US from abroad: start with the scene.","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"Translate the words. Then rebuild the situation.","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"The account brief fits on one page.","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"The handoff that prevents “I thought you meant”.","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"A publishing window beats a sacred minute.","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"Your network starts with an accurate inventory.","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Zero views is not a diagnosis.","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"Shadowban is sometimes the name we give the unknown.","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"Different failures hidden inside “it does not work”.","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic does not mean undercover.","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"On Reddit, context is the entrance.","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Participate before distributing.","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"An asset folder needs evidence, not assumptions.","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"A retrospective starts with what we do not know.","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"A test also costs the time spent making sense of it.","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"Viral compared with what?","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"The denominator is half the story.","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"The average loves an overly good story.","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"P90 is not a new word for good.","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"The hit makes noise. The rest explains the system.","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"The network works. Or one account carries it.","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"Compare what is actually comparable.","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"7:42 p.m. is not a strategy.","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"Posting more: more chances or more noise?","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Warming deserves more than an anecdote.","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"An old account is not a control group.","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"Slideshow versus video: context comes first.","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"Series or chaos? A test, not a taste war.","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"Diversity also lives in what you learn.","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"Maybe it is not native. Maybe it is the feature.","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"A zero rate deserves a complete definition.","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Uncertainty is part of the result.","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"The missing accounts had results too.","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"After a hit, returning to earth is not always a failure.","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Day seven does not exist for yesterday’s visitor.","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"A UTM tells you about the click. Not the whole story.","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"A million views can miss the problem.","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Write possible verdicts before knowing the score.","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"Knowing when to stop is part of the test.","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"A hypothesis needs a label, not a disguise.","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI can think about the system before filling the calendar.","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"A distribution agent is not a talking calendar.","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"Behind the API, someone actually opens the app.","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"MCP connects tools. It does not write your strategy.","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"A preview must know what it does not simulate.","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"Retry without ordering twice.","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"A webhook reports an event. It does not replace your state.","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"An agent without a ceiling has no budget.","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"Autonomy is a ladder, not a switch.","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Your API is not a distribution strategy.","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Good content can land on the wrong account.","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"Group ideas without erasing their differences.","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"A useful alert tells you what to inspect.","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human review should contain a real decision.","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Documentation that says no beats a page promising everything.","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"A video can have a second life in search.","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic content needs a reason for every page.","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"To be cited, first be quotable.","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"A good link continues an idea.","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Two languages, two real reading experiences.","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"A strict schema frees the voice. It does not write it.","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"The log that makes tomorrow understandable.","dek":"An agent log connects intent, tool, result and next decision."}}]}],"$Lf","$L10"]}]
1:["$","main",null,{"id":"main","className":"main-shell","children":["$","$L11",null,{"items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","tier":"canonical","evidence":"editorial","sources":[],"related":["account-isolation","content-isolation","content-saturation"],"en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","point":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","body":["The pitch fits in a browser tab: one generator, a few prompts, fifty videos. The problem starts after export. Who watches? Why should that person stop at this account instead of the next one? Production has a button. Distribution still needs a reason to exist.","A brand account is often asked to reassure, sell, entertain, recruit and explain. Every post negotiates with the others. AGD separates those jobs. One account explores student frustrations; another challenges work habits; a third demonstrates a product in context. One company, three editorial promises.","The trap is reading this architecture as a volume recipe. Thirty accounts running the same edit do not represent thirty ideas. They mostly multiply coordination, repetition and unanswered questions. Diversification lives in what a viewer receives, not in the number of rows in a spreadsheet.","AGD is a proposed framework drawn from the TokPortal blueprint, not an academic consensus or a reach guarantee. Its value depends on the experiments it helps run. The useful question is whether a network reveals something that one account would hide. Can the signal be connected to an angle, an audience or a format?","Build a small network whose differences you can explain. Document the failures alongside the breakout posts. And keep a commercial measure next to views: somebody enjoying your edit does not necessarily have a problem your product solves."],"action":["Write a different editorial promise for each account.","Attach each post to a hypothesis and an audience.","Measure by cohort, then inspect qualified visits."],"trap":"A clone network can increase output without adding a single perspective.","quote":"The next advantage is knowing where an idea deserves to live.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The next advantage is knowing where an idea deserves to live.","text":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account-Generated Distribution","text":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A clone network can increase output without adding a single perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a different editorial promise for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach each post to a hypothesis and an audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 3","title":"Measure by cohort, then inspect qualified visits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"video":{"src":"/video/below-the-surface.mp4","poster":"/images/iceberg.jpg","caption":{"en":"Below the surface — animated original illustration. No audio."},"tracks":{"en":"/video/intro-en.vtt"}},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"FEEDRAID Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","kind":"essay","image":"ai-sameness","tier":"editorial","evidence":"editorial","sources":[],"related":["hook-slop","content-isolation","account-persona"],"en":{"title":"AI isn’t the problem. Sameness is.","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute.","point":"AI Slop describes output that puts volume ahead of distinctiveness and usefulness. It is an editorial judgment about the result, not an automatic diagnosis based on which tool made it.","body":["Sometimes you recognize the brief before you understand the video. Two seconds of surprise, a voice that never doubts, three benefits, an imaginary button. The issue is not that a machine speaks. It is that nobody seems to have anything to say.","AI can widen the creative field: prototype a setting, try a narrative, visualize something impossible to film. It can also compress twenty perspectives into one perfectly forgettable average. Output speed cannot distinguish those uses.","In an AGD network, diversity should survive the removal of account names. Mix nine posts from three personas and ask someone to reconstruct the groups. If the only difference is subtitle color, you have probably distributed a template rather than identities.","Before adding variants, change a fundamental choice: the conflict, the intended audience or the knowledge offered. An idea worth a human version may deserve a synthetic version too. The reverse does not become true because a subscription includes a thousand generations."],"action":["Mix nine posts and test whether personas remain recognizable.","Change the perspective before the rendering.","Delete passages that communicate nothing."],"trap":"High output does not demonstrate creative diversity or audience satisfaction.","quote":"Your generator doesn’t need a better prompt. Your account needs a point of view.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your generator doesn’t need a better prompt. Your account needs a point of view.","text":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"AI Slop","text":"AI Slop describes output that puts volume ahead of distinctiveness and usefulness. It is an editorial judgment about the result, not an automatic diagnosis based on which tool made it.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"High output does not demonstrate creative diversity or audience satisfaction.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Mix nine posts and test whether personas remain recognizable.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Change the perspective before the rendering.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 3","title":"Delete passages that communicate nothing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"illustration","src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"en":"An analogue CRT monitor projects a green signal into a dark room."},"credit":"FEEDRAID Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/signal.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","kind":"guide","image":"account-isolation","tier":"canonical","evidence":"editorial","sources":[],"related":["content-isolation","multi-account-strategy","account-persona"],"en":{"title":"50 accounts. One idea. Zero strategy.","dek":"Account Isolation: differentiate the voices before multiplying the profiles.","point":"Account Isolation is the AGD principle that gives every account a sufficiently distinct identity, audience and purpose to operate as an independent editorial surface.","body":["A different avatar does not create a new audience. If every account describes the same product with the same humor for the same people, you have mostly multiplied the credentials to manage. The network exists technically; its editorial logic is still missing.","Consider a note-taking app. One account can cover lectures, another fiction writing, another meeting notes. The demonstrations share a product, but their situations, references and success criteria change. That distance makes the experiments readable.","Write three sentences for each account: who it addresses, what it promises and what it refuses to publish. The last one does the most work. It stops every success elsewhere in the network from becoming an instruction to copy.","Isolation here is not a method for hiding account relationships or bypassing enforcement. It concerns distribution diversity. An audience that understands who is speaking is a more durable asset than infrastructure designed to remain incomprehensible."],"action":["Define an audience, a promise and a refusal for each account.","Compare comments for genuinely different uses.","Revise accounts whose roles overlap."],"trap":"Editorial differentiation should not be confused with technical concealment.","quote":"Another account is only useful when it brings another perspective.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Another account is only useful when it brings another perspective.","text":"Account Isolation: differentiate the voices before multiplying the profiles.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Account Isolation","text":"Account Isolation is the AGD principle that gives every account a sufficiently distinct identity, audience and purpose to operate as an independent editorial surface.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Editorial differentiation should not be confused with technical concealment.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define an audience, a promise and a refusal for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Compare comments for genuinely different uses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 3","title":"Revise accounts whose roles overlap.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"illustration","src":"/images/current.jpg","width":1536,"height":1024,"alt":{"en":"Silver fish diverge into separate directions through a dark ocean."},"credit":"FEEDRAID Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/current.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","kind":"protocol","image":"native-vs-api","tier":"canonical","evidence":"hypothesis","sources":["https://developers.tiktok.com/doc/content-posting-api-get-started/","https://developers.tokportal.com/"],"related":["native-posting","niche-warming","matched-cohorts"],"tokportal":"native","en":{"title":"Does native really win? Show the data.","dek":"“APIs kill reach.” Here is the protocol that claim would need.","point":"Comparing Native Posting with API publishing requires comparable cohorts and identical observation windows. This note reports no experimental result: the verdict remains unknown.","body":["Two screenshots do not make an experiment. An established account posts natively, a new account uses an API, and someone attributes the gap to the upload method. Age, followers, topic and editing quality disappear from the story.","The protocol starts before publication: define eligible accounts, formats, countries and observation windows. Allocate treatments within comparable blocks and retain technical failures. An analysis restricted to successful publications would answer a different question.","Available native features can differ from an integration’s capabilities. Separate two tests: with identical content and features, does the publishing channel change results? And in actual use, does access to native tools change the performance of the complete workflow?","TokPortal illustrates the separation between API orchestration and human execution inside consumer apps. That describes an architecture; it does not prove algorithmic superiority. A conclusion would need a verifiable method and observations."],"action":["Preregister cohorts, primary metric and observation window.","Keep failures in the relevant denominator.","Report median, dispersion and uncertainty."],"trap":"Attributing a creative or account-age difference to the publishing channel.","quote":"An operational preference is not a law of the algorithm.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An operational preference is not a law of the algorithm.","text":"“APIs kill reach.” Here is the protocol that claim would need.","media":"/images/editorial/native-vs-api.jpg"},{"label":"THE CONCEPT","title":"Native Posting","text":"Comparing Native Posting with API publishing requires comparable cohorts and identical observation windows. This note reports no experimental result: the verdict remains unknown.","media":"/images/editorial/native-vs-api.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Attributing a creative or account-age difference to the publishing channel.","media":"/images/editorial/native-vs-api.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Preregister cohorts, primary metric and observation window.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-vs-api.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep failures in the relevant denominator.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-vs-api.jpg"},{"label":"PUT IT TO WORK / 3","title":"Report median, dispersion and uncertainty.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-vs-api.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/native-vs-api.jpg","width":1280,"height":849,"alt":{"en":"Keys, indicator lights, and a rotary dial on a vintage wooden telephone switchboard."},"credit":"Antti Leppänen","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 6750269c8667b0eeec97772aa4c8ec3aa97acff4.","source":"https://commons.wikimedia.org/wiki/File:Orion_%26_Oriola_switchboard_Elisa_Telephone_Museum.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","kind":"guide","image":"agent-first-dry-run","tier":"canonical","evidence":"documented","sources":["https://developers.tokportal.com/mcp/","https://developers.tokportal.com/sandbox/"],"related":["human-api","agentic-agd","idempotency"],"tokportal":"sandbox","en":{"title":"Your agent can publish. Teach it to wait.","dek":"A real MCP workflow starts with a readable preview, not a surprise charge.","point":"TokPortal MCP exposes social operations to an agent. A preview uses top-level dry_run: true, with creation parameters inside body; the decision to execute live remains a separate step.","body":["An agent executing everything quickly is not necessarily a good operator. In a paid workflow, its first useful skill is explaining what it will trigger: country, platform, account and immediate or recurring costs.","The remote server is https://app.tokportal.com/api/ext/mcp. The local package documentation requires version 1.15.1 or later for reliable previews: version 1.15.0 advertised an argument it did not forward correctly. That detail matters more than an impressive agent demo.","Read available countries, prices and balance first. To preview a US TikTok account, tokportal_create_bundle accepts dry_run: true and a body containing bundle_type: account_only, platform: tiktok and country: USA. The response should distinguish simulated credits from charged credits.","Preview identifiers are synthetic. Never reuse them in production. After approval, create real resources and continue with their live identifiers. YouTube bundle creation is not supported through this API in the documentation consulted."],"action":["Read countries, prices and balance before previewing.","Check credits_charged: 0 in the simulated response.","Wait for explicit approval before live creation."],"trap":"A dry run validates a contract; it does not reserve real accounts or capacity.","quote":"Autonomy starts with knowing what still needs a green light.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Autonomy starts with knowing what still needs a green light.","text":"A real MCP workflow starts with a readable preview, not a surprise charge.","media":"/images/editorial/agent-first-dry-run.jpg"},{"label":"THE CONCEPT","title":"Agentic AGD","text":"TokPortal MCP exposes social operations to an agent. A preview uses top-level dry_run: true, with creation parameters inside body; the decision to execute live remains a separate step.","media":"/images/editorial/agent-first-dry-run.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A dry run validates a contract; it does not reserve real accounts or capacity.","media":"/images/editorial/agent-first-dry-run.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Read countries, prices and balance before previewing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-first-dry-run.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check credits_charged: 0 in the simulated response.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-first-dry-run.jpg"},{"label":"PUT IT TO WORK / 3","title":"Wait for explicit approval before live creation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-first-dry-run.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agent-first-dry-run.jpg","width":1280,"height":976,"alt":{"en":"A red railway signal glows against a deep blue evening sky."},"credit":"W.carter","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 6efd9fae6123d3472d48491b2d5ae91c124f5c48.","source":"https://commons.wikimedia.org/wiki/File:Red_railway_signal_at_dusk.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"006","slug":"multi-account-strategy","term":"Multi-Account Strategy","category":"doctrine","kind":"essay","image":"multi-account-strategy","tier":"canonical","evidence":"editorial","sources":[],"related":["content-isolation","native-account","distribution-is-the-moat"],"en":{"title":"One brand account cannot carry everything.","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts.","point":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts. It is AGD’s organizational foundation, not its complete definition.","body":["Separate reasons to watch before allocating posts. A cooking app can cover student meals, Sunday preparation and chef techniques. The same recipe does not fulfill all three promises. Extra operating cost should buy learning, not merely more calendar slots.","Consider two accounts covering different uses of a notes tool and a third documenting onboarding. After a cycle, compare the questions each receives. If all attract exactly the same requests, revisit their promises before creating a fourth profile. The next account should address an identified gap. Account count is an input to this decision, not evidence that the architecture works."],"action":["Map three audiences and a suitable format for each.","Assign an owner to every account."],"trap":"Extra accounts without distinct hypotheses make analysis noisier.","quote":"One brand account cannot carry everything.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"One brand account cannot carry everything.","text":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts.","media":"/images/editorial/multi-account-strategy.jpg"},{"label":"THE CONCEPT","title":"Multi-Account Strategy","text":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts. It is AGD’s organizational foundation, not its complete definition.","media":"/images/editorial/multi-account-strategy.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Extra accounts without distinct hypotheses make analysis noisier.","media":"/images/editorial/multi-account-strategy.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Map three audiences and a suitable format for each.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/multi-account-strategy.jpg"},{"label":"PUT IT TO WORK / 2","title":"Assign an owner to every account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/multi-account-strategy.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/multi-account-strategy.jpg","width":1280,"height":960,"alt":{"en":"An aerial view of the branching railway tracks at Clapham Junction in London."},"credit":"Mertbiol","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 2f38544bbef93068d0196f4624ed11c612af3a61.","source":"https://commons.wikimedia.org/wiki/File:Aerial_photograph_of_Clapham_Junction_railway_station.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"007","slug":"content-isolation","term":"Content Isolation","category":"doctrine","kind":"essay","image":"content-isolation","tier":"canonical","evidence":"editorial","sources":[],"related":["content-saturation","multi-account-strategy","distribution-is-the-moat"],"en":{"title":"New subtitles do not make a new idea.","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose.","point":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose. It complements Account Isolation, which differentiates distribution surfaces.","body":["One problem can become a precise demo, a failure story or a comparison of habits. Those versions offer different information. Recoloring an edit preserves its structure and perspective. Archive concepts with their variations so you know whether you are testing an idea or its packaging.","Take an exam-preparation video. One version explains scheduling, another tells a story about forgetting, and a third compares revision methods. They share raw material but change the question addressed. Record that question in the brief. It becomes a practical reason to reject a supposedly new version that merely changes its colors while preserving the same argument and viewing experience."],"action":["Assign an identifier to each creative concept.","Record what each version changes for the viewer."],"trap":"Duplication can make one looping idea look like many experiments.","quote":"New subtitles do not make a new idea.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"New subtitles do not make a new idea.","text":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose.","media":"/images/editorial/content-isolation.jpg"},{"label":"THE CONCEPT","title":"Content Isolation","text":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose. It complements Account Isolation, which differentiates distribution surfaces.","media":"/images/editorial/content-isolation.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Duplication can make one looping idea look like many experiments.","media":"/images/editorial/content-isolation.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Assign an identifier to each creative concept.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-isolation.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record what each version changes for the viewer.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-isolation.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/content-isolation.jpg","width":1280,"height":1707,"alt":{"en":"Individual letterpress printing blocks sorted into compartments of a wooden tray."},"credit":"Ross Dunn","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e81a9124f021a76db25f5651107674c2b318b15f.","source":"https://commons.wikimedia.org/wiki/File:Printing_Press_letters_for_long_gone,_traditional_newsprint_(41343604484).jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"008","slug":"content-saturation","term":"Content Saturation","category":"doctrine","kind":"essay","image":"content-saturation","tier":"editorial","evidence":"editorial","sources":[],"related":["feed-escalation","content-isolation","distribution-is-the-moat"],"en":{"title":"The feed did not add hours to the day.","dek":"Content Saturation describes content supply exceeding available attention.","point":"Content Saturation describes content supply exceeding available attention. Within AGD it is a thesis about competition, not an established universal measurement.","body":["Your actual competitor in a feed might be a joke a friend shared. A post does not win merely by beating another company’s post. It must earn a place in a session where nobody requested your product. Situational relevance becomes more useful than another arbitrary posting schedule.","For a tutorial, narrowing the promise may be the useful response. “Find a note during a call” describes a real moment; “be more productive” describes almost everything. A specific situation helps choose the opening screen, what to demonstrate and what to remove. Competition becomes a relevance question rather than a demand to make every piece louder, faster and longer."],"action":["Describe when the audience would need this content.","Remove introductions that delay its value."],"trap":"Content abundance does not by itself prove declining reach for every account.","quote":"The feed did not add hours to the day.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The feed did not add hours to the day.","text":"Content Saturation describes content supply exceeding available attention.","media":"/images/editorial/content-saturation.jpg"},{"label":"THE CONCEPT","title":"Content Saturation","text":"Content Saturation describes content supply exceeding available attention. Within AGD it is a thesis about competition, not an established universal measurement.","media":"/images/editorial/content-saturation.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Content abundance does not by itself prove declining reach for every account.","media":"/images/editorial/content-saturation.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe when the audience would need this content.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-saturation.jpg"},{"label":"PUT IT TO WORK / 2","title":"Remove introductions that delay its value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-saturation.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/content-saturation.jpg","width":1280,"height":720,"alt":{"en":"An elevated view of Shibuya Crossing surrounded by illuminated screens and city streets."},"credit":"David Kernan","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 3abb12c212e38c662a406c48dd9a526c881404f3.","source":"https://commons.wikimedia.org/wiki/File:Shibuya_Crossing,_Aerial.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"009","slug":"feed-escalation","term":"Feed Escalation","category":"doctrine","kind":"essay","image":"feed-escalation","tier":"editorial","evidence":"editorial","sources":[],"related":["attention-war","content-saturation","distribution-is-the-moat"],"en":{"title":"Welcome to the feed arms race.","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds.","point":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds. It is not a scientific metric.","body":["When an editing effect becomes easy to reproduce, it stops being enough to distinguish a creator. You can escalate or change the game: a calm tutorial, an uncut demonstration, a specific opinion. Compare these options with the relevant audience rather than the creative director’s taste.","Imagine two demonstrations of one feature. The first piles on effects and commentary; the second shows a complete operation with a few quiet annotations. Ask what viewers understand about the use case, not simply which edit appears more expensive. The calm format is not inherently superior. It deserves a place among options that can be evaluated with a clear audience and objective."],"action":["Test a calm format against a dense edit with a comparable promise.","Inspect qualitative feedback too."],"trap":"More stimulation does not necessarily mean more understanding.","quote":"Welcome to the feed arms race.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Welcome to the feed arms race.","text":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds.","media":"/images/editorial/feed-escalation.jpg"},{"label":"THE CONCEPT","title":"Feed Escalation","text":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds. It is not a scientific metric.","media":"/images/editorial/feed-escalation.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"More stimulation does not necessarily mean more understanding.","media":"/images/editorial/feed-escalation.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Test a calm format against a dense edit with a comparable promise.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/feed-escalation.jpg"},{"label":"PUT IT TO WORK / 2","title":"Inspect qualitative feedback too.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/feed-escalation.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/feed-escalation.jpg","width":1280,"height":856,"alt":{"en":"Foaming waves surge against a dark stone seawall on the French Mediterranean coast."},"credit":"Christian Ferrer","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 2eee3d863a69eda37f2744597749b83d169ccee1.","source":"https://commons.wikimedia.org/wiki/File:Waves_on_the_Th%C3%A9%C3%A2tre_de_la_Mer.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"010","slug":"attention-war","term":"Attention War","category":"doctrine","kind":"essay","image":"attention-war","tier":"editorial","evidence":"editorial","sources":[],"related":["agd-not-phone-farm","feed-escalation","distribution-is-the-moat"],"en":{"title":"Your SaaS competes with cat videos too.","dek":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms.","point":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms. It helps describe the context in which a post is received.","body":["Someone can have a problem your app solves and still have no desire to hear about it right now. A useful angle bridges that gap: show a familiar friction before presenting a solution. There is no need to imitate entertainment until your topic disappears; useful information can be its own attraction.","A budgeting app can discuss three subscriptions renewing on the same day. The problem is understandable before the brand appears. If a free manual method solves it, show that method too. The product becomes relevant for readers whose constraints justify a more complete solution. This makes the content useful independently while leaving a concrete reason to investigate the tool further."],"action":["Write the lived situation before the product sentence.","Check that the content works without its CTA."],"trap":"Retention on unrelated entertainment does not prove buying intent.","quote":"Your SaaS competes with cat videos too.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your SaaS competes with cat videos too.","text":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms.","media":"/images/editorial/attention-war.jpg"},{"label":"THE CONCEPT","title":"Attention War","text":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms. It helps describe the context in which a post is received.","media":"/images/editorial/attention-war.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Retention on unrelated entertainment does not prove buying intent.","media":"/images/editorial/attention-war.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the lived situation before the product sentence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attention-war.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check that the content works without its CTA.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attention-war.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/attention-war.jpg","width":1280,"height":720,"alt":{"en":"Crowds move below towering illuminated billboards in Times Square at night."},"credit":"ScottandYanling","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 5ddae25d04c3d3d4ad78cd0745a1f27946fe5fa5.","source":"https://commons.wikimedia.org/wiki/File:Times_Square_at_Night_with_crowds_of_people.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"011","slug":"agd-not-phone-farm","term":"Phone Farming","category":"doctrine","kind":"essay","image":"agd-not-phone-farm","tier":"operating","evidence":"editorial","sources":[],"related":["agd-without-tokportal","attention-war","distribution-is-the-moat"],"en":{"title":"A row of phones is not a strategy.","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments.","point":"Phone Farming describes infrastructure for operating accounts across mobile environments. AGD describes a distribution model: the two categories are not synonyms.","body":["An equipment inventory explains available capacity, not what accounts say. Start with audiences, access rights and editorial responsibilities. Determine execution needs afterward. Buying capacity before knowing who publishes what often turns creative uncertainty into a fixed cost.","A team can have little equipment and clearly separated editorial roles. Another can possess substantial capacity without knowing what to publish. Compare systems on delivery times, reliability and the quality of delivered creative work. Hardware then answers a measured constraint rather than becoming scenery for a growth presentation. A photograph of devices cannot reveal whether the underlying accounts have a reason to exist."],"action":["Separate editorial planning from infrastructure planning.","Calculate coordination cost per active account."],"trap":"Device count measures neither account quality nor audience diversity.","quote":"A row of phones is not a strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A row of phones is not a strategy.","text":"Phone Farming describes infrastructure for operating accounts across mobile environments.","media":"/images/editorial/agd-not-phone-farm.jpg"},{"label":"THE CONCEPT","title":"Phone Farming","text":"Phone Farming describes infrastructure for operating accounts across mobile environments. AGD describes a distribution model: the two categories are not synonyms.","media":"/images/editorial/agd-not-phone-farm.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Device count measures neither account quality nor audience diversity.","media":"/images/editorial/agd-not-phone-farm.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Separate editorial planning from infrastructure planning.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agd-not-phone-farm.jpg"},{"label":"PUT IT TO WORK / 2","title":"Calculate coordination cost per active account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agd-not-phone-farm.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agd-not-phone-farm.jpg","width":1280,"height":853,"alt":{"en":"Rows of analogue telephone switching equipment and rotary phones in a heritage museum."},"credit":"David Palmer","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 84a40780c1cb84185b6ea194af29859003c8b598.","source":"https://commons.wikimedia.org/wiki/File:Ferrymead_Heritage_park_telephone_switch_equipment_04.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"012","slug":"agd-without-tokportal","term":"AGD & infrastructure","category":"doctrine","kind":"essay","image":"agd-without-tokportal","tier":"operating","evidence":"editorial","sources":[],"related":["ten-principles","agd-not-phone-farm","distribution-is-the-moat"],"en":{"title":"AGD must outlive the name of its vendor.","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","point":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","body":["You can begin with legitimate accounts run by an internal team, briefs and a spreadsheet. A service becomes relevant when coordination, markets or interfaces create concrete constraints. Evaluate scope, cost and responsibility for each layer. The tool should answer a problem already articulated.","A shared sheet may cover a first cycle: account, idea, file, status and observed outcome. When transfer errors recur, an interface may add real value. Evaluate it against those specific errors. That reasoning makes vendor selection explainable and also reveals when no additional purchase is necessary. The category remains useful because its principles can guide work before a particular provider enters the process."],"action":["Describe the current workflow without product names.","Find its bottleneck before selecting infrastructure."],"trap":"This publication is initiated by TokPortal; that relationship does not turn its opinions into independent evidence.","quote":"AGD must outlive the name of its vendor.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"AGD must outlive the name of its vendor.","text":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","media":"/images/editorial/agd-without-tokportal.jpg"},{"label":"THE CONCEPT","title":"AGD & infrastructure","text":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","media":"/images/editorial/agd-without-tokportal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This publication is initiated by TokPortal; that relationship does not turn its opinions into independent evidence.","media":"/images/editorial/agd-without-tokportal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe the current workflow without product names.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agd-without-tokportal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Find its bottleneck before selecting infrastructure.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agd-without-tokportal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agd-without-tokportal.jpg","width":1280,"height":853,"alt":{"en":"The large dish and supporting steel structure of the Sardinia Radio Telescope."},"credit":"Mike Peel","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: fad5b72e1e4615b34c91154be576922083b2f74d.","source":"https://commons.wikimedia.org/wiki/File:At_Sardinia_2025_010_-_Sardinia_Radio_Telescope.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"013","slug":"ten-principles","term":"AGD principles","category":"doctrine","kind":"essay","image":"ten-principles","tier":"operating","evidence":"editorial","sources":[],"related":["anti-principles","agd-without-tokportal","distribution-is-the-moat"],"en":{"title":"A small manifesto for accounts with a reason to exist.","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning.","point":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning. They form a decision framework, not an algorithmic recipe.","body":["Give accounts an identity, content a difference and markets a context. Test native preferences where they matter. Examine distributions beyond averages. Document failures, costs and limits. Use automation to improve decisions. Refuse to let one success replace an explanation of the method.","Apply the principles to an ordinary decision: reuse a hit elsewhere. Differentiation asks for a changed angle; context asks whether the audience fits; measurement asks that the concept’s lineage remain recorded. The manifesto becomes a working filter rather than a poster. You can still reuse material, but the reason and the meaningful changes should be visible to the person creating and evaluating it."],"action":["Review a plan against these principles before launch.","State which decision each principle changes."],"trap":"A doctrine repeated without concrete decisions becomes another layer of jargon.","quote":"A small manifesto for accounts with a reason to exist.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A small manifesto for accounts with a reason to exist.","text":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning.","media":"/images/editorial/ten-principles.jpg"},{"label":"THE CONCEPT","title":"AGD principles","text":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning. They form a decision framework, not an algorithmic recipe.","media":"/images/editorial/ten-principles.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A doctrine repeated without concrete decisions becomes another layer of jargon.","media":"/images/editorial/ten-principles.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Review a plan against these principles before launch.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ten-principles.jpg"},{"label":"PUT IT TO WORK / 2","title":"State which decision each principle changes.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ten-principles.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/ten-principles.jpg","width":1280,"height":895,"alt":{"en":"Strong shadows beneath the projecting roof of a concrete brutalist building."},"credit":"Henrique Lima","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: a0c381dd7482ec6992f65554dde8c1bbe8d2bcbb.","source":"https://commons.wikimedia.org/wiki/File:Brutalist_Architecture_(181685065).jpeg","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0"}},{"id":"014","slug":"anti-principles","term":"AGD anti-principles","category":"doctrine","kind":"essay","image":"anti-principles","tier":"operating","evidence":"editorial","sources":[],"related":["native-account","ten-principles","distribution-is-the-moat"],"en":{"title":"What we refuse to sell as growth.","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context.","point":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context. These are editorial and operational choices.","body":["The problem with miracle recipes is not only that they may be wrong. They often prevent the useful questions. Why this content for this audience? What does this learning cost? What happens if the result is negative? A practice that never allows for failure is rarely an experiment.","When advice arrives with a spectacular result, ask about attempts missing from the screenshot. The advice may still be interesting even if its author measured little. Its status changes: a lead to explore, not a rule to impose. This distinction avoids replacing one dogma with another. Skepticism is useful when it clarifies the next test, not when it automatically dismisses every observation."],"action":["Require a denominator for every success number.","Write a stop condition before launching."],"trap":"Being provocative does not excuse inaccuracy, even about advice you hate.","quote":"What we refuse to sell as growth.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"What we refuse to sell as growth.","text":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context.","media":"/images/editorial/anti-principles.jpg"},{"label":"THE CONCEPT","title":"AGD anti-principles","text":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context. These are editorial and operational choices.","media":"/images/editorial/anti-principles.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Being provocative does not excuse inaccuracy, even about advice you hate.","media":"/images/editorial/anti-principles.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Require a denominator for every success number.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/anti-principles.jpg"},{"label":"PUT IT TO WORK / 2","title":"Write a stop condition before launching.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/anti-principles.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/anti-principles.jpg","width":1280,"height":847,"alt":{"en":"Graffiti and discarded materials inside an abandoned amusement park building."},"credit":"Chad Ajamian","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 6707aeffbd1d5ce7ef248108c877a72f5b8d9126.","source":"https://commons.wikimedia.org/wiki/File:Abandoned_amusement_park_Magic_Kingdom,_Sydney_(175372369).jpg","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0"}},{"id":"015","slug":"native-account","term":"Native Account","category":"doctrine","kind":"essay","image":"native-account","tier":"canonical","evidence":"editorial","sources":[],"related":["multi-account-strategy","anti-principles","distribution-is-the-moat"],"en":{"title":"Native is an environment, not a talisman.","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment.","point":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment. The definition describes execution.","body":["Native operation can provide access to the flows and features ordinary creators use. It also introduces timing, permissions and human tasks to organize. Nothing in this definition guarantees an audience. A good brief separates execution requirements from distribution outcomes measured afterward.","In a brief, replace “quality account” with checkable conditions: working access, a profile matching the plan and required features available. Add who checks them and when. This precision helps resolve incidents without debating an adjective. Creative quality and audience outcomes can then be judged from their own observations. Keeping these questions separate makes both procurement and editorial analysis easier to understand."],"action":["List the features actually needed inside the app.","Define expected execution evidence."],"trap":"The word native does not prove that content will receive more recommendations.","quote":"Native is an environment, not a talisman.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Native is an environment, not a talisman.","text":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment.","media":"/images/editorial/native-account.jpg"},{"label":"THE CONCEPT","title":"Native Account","text":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment. The definition describes execution.","media":"/images/editorial/native-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The word native does not prove that content will receive more recommendations.","media":"/images/editorial/native-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"List the features actually needed inside the app.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define expected execution evidence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-account.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/native-account.jpg","width":1280,"height":853,"alt":{"en":"A close view of the intricate living pattern of a coral colony in the Red Sea."},"credit":"Diego Delso","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: eb3210c233111380e0c07b4cc0443deb19cd8935.","source":"https://commons.wikimedia.org/wiki/File:Coral_(Galaxea_fascicularis),_mar_Rojo,_Egipto,_2023-04-18,_DD_128.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"016","slug":"account-persona","term":"Account Persona","category":"creative","kind":"essay","image":"account-persona","tier":"canonical","evidence":"editorial","sources":[],"related":["hook-slop","creative-matrix","distribution-is-the-moat"],"en":{"title":"A persona is not a photo and a name.","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return..","point":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.","body":["Write the opinions this account can defend and the topics it leaves to others. A rushed student does not discuss an app like an organizational consultant. Character appears through chosen details, not a biography full of adjectives. A fictional persona should be identifiable as such when it could be mistaken for a real person.","Test the character against a frustration. What happens when the app does not solve everything? A credible voice can acknowledge a limit, propose a manual workaround or reject an unsuitable use. If the persona only praises the product, its identity may collapse when the audience asks an unexpected question. A consistent boundary often reveals more character than another carefully chosen visual accessory."],"action":["Write three opinions and three refusals.","Test consistency across five scripts."],"trap":"An invented testimonial does not become acceptable because a persona delivers it.","quote":"A persona is not a photo and a name.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A persona is not a photo and a name.","text":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return..","media":"/images/editorial/account-persona.jpg"},{"label":"THE CONCEPT","title":"Account Persona","text":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.","media":"/images/editorial/account-persona.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An invented testimonial does not become acceptable because a persona delivers it.","media":"/images/editorial/account-persona.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write three opinions and three refusals.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-persona.jpg"},{"label":"PUT IT TO WORK / 2","title":"Test consistency across five scripts.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-persona.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/account-persona.jpg","width":1280,"height":875,"alt":{"en":"Carved stone theatrical masks displayed among the ruins of Ostia Antica."},"credit":"Dennis G. Jarvis","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 5a244f48cf59ebe7c71fe44087df41410beb2633.","source":"https://commons.wikimedia.org/wiki/File:Italy_-_Ostia_Antica_-_Theatre_Masks_(5149585364).jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"017","slug":"hook-slop","term":"Hook Slop","category":"creative","kind":"guide","image":"hook-slop","tier":"editorial","evidence":"editorial","sources":[],"related":["faceless-account","account-persona","distribution-is-the-moat"],"en":{"title":"“Stop scrolling”: everybody is shouting the same thing.","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value.","point":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value. It is an editorial criticism, not a platform category.","body":["A good opening makes a promise the rest fulfills. “I lost my notes before the exam” creates a specific situation. “This app will change your life” could sell anything. Compare the first sentence with the conclusion: if they address different problems, early retention may measure delayed disappointment.","Try rewriting without commands or spectacular adjectives. Replace the demand to stay with the situation you will resolve. If the opening becomes clearer, precision has improved. Then evaluate the full piece: a quieter hook may attract fewer curious viewers and more people facing the actual problem. That possibility is worth testing, not asserting as a universal advantage of restrained creative work."],"action":["Connect the opening to visible evidence.","Remove superlatives that add nothing."],"trap":"Better opening retention does not guarantee that the promise is delivered later.","quote":"“Stop scrolling”: everybody is shouting the same thing.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"“Stop scrolling”: everybody is shouting the same thing.","text":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value.","media":"/images/editorial/hook-slop.jpg"},{"label":"THE CONCEPT","title":"Hook Slop","text":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value. It is an editorial criticism, not a platform category.","media":"/images/editorial/hook-slop.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Better opening retention does not guarantee that the promise is delivered later.","media":"/images/editorial/hook-slop.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect the opening to visible evidence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/hook-slop.jpg"},{"label":"PUT IT TO WORK / 2","title":"Remove superlatives that add nothing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/hook-slop.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/hook-slop.jpg","width":1280,"height":1707,"alt":{"en":"A red and cream handheld megaphone with a coiled microphone cord."},"credit":"Solomon203","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 20e7e1574fe6745909375e5658e0229e84fcafe0.","source":"https://commons.wikimedia.org/wiki/File:Seikaku_ER-56_20190217.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"018","slug":"faceless-account","term":"Faceless Account","category":"creative","kind":"guide","image":"faceless-account","tier":"operating","evidence":"editorial","sources":[],"related":["formatted-account","hook-slop","distribution-is-the-moat"],"en":{"title":"Faceless. Not voiceless.","dek":"A Faceless Account creates content without relying on its operator’s visible face.","point":"A Faceless Account creates content without relying on its operator’s visible face. Topic, narration and visual choices can still make it recognizable.","body":["An annotated screen recording can express a stronger opinion than a talking avatar. For an app, show a use and its constraints: a failed search, a useful setting, a decision. Viewers should leave with something even if they never see your face. Check rights to any footage used.","For a demo, use your own recording with clearly labeled fictional data. Focus on the useful action and remove personal information. Narration can address a common mistake or a difficult decision. This gives the content personality without needing a face, an invented customer or an imitation of a known creator. The audience still receives a concrete explanation it can assess independently."],"action":["Define a consistent visual language.","Record a complete, understandable action."],"trap":"An absent face does not erase transparency requirements or other creators’ rights.","quote":"Faceless. Not voiceless.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Faceless. Not voiceless.","text":"A Faceless Account creates content without relying on its operator’s visible face.","media":"/images/editorial/faceless-account.jpg"},{"label":"THE CONCEPT","title":"Faceless Account","text":"A Faceless Account creates content without relying on its operator’s visible face. Topic, narration and visual choices can still make it recognizable.","media":"/images/editorial/faceless-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An absent face does not erase transparency requirements or other creators’ rights.","media":"/images/editorial/faceless-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define a consistent visual language.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/faceless-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record a complete, understandable action.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/faceless-account.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/faceless-account.jpg","width":1280,"height":853,"alt":{"en":"A motorcyclist appears as a dark silhouette between headlights on a street at night."},"credit":"Tiomax80","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 28b410648b8d738726989e99d05ce42fe2b6b720.","source":"https://commons.wikimedia.org/wiki/File:Night_silhouettes._(9722264213).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"019","slug":"formatted-account","term":"Formatted Account","category":"creative","kind":"guide","image":"formatted-account","tier":"operating","evidence":"editorial","sources":[],"related":["chaotic-account","faceless-account","distribution-is-the-moat"],"en":{"title":"A recurring format beats an empty template.","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize.","point":"A Formatted Account uses a repeatable creative structure an audience can recognize. Repetition concerns the promise, not necessarily the substance.","body":["“One setting, one avoided mistake” is a format: every episode can teach something different. A colored background with three arbitrary sentences is only a template. Record what stays fixed and what varies. That separation makes testing clearer while preventing the series from exhausting itself.","A useful episode may slightly break its format to serve the subject. Keep the promise but adjust length when the explanation requires it. Record that exception so it is not confused with a strategic change. Consistency helps readers recognize what they receive; it should not become a restriction that prevents explanation. A format earns its place by making good ideas easier to deliver."],"action":["Define the recurring promise in one sentence.","Prepare ten episodes with different lessons."],"trap":"Recognizing a format does not guarantee the next episode offers anything new.","quote":"A recurring format beats an empty template.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A recurring format beats an empty template.","text":"A Formatted Account uses a repeatable creative structure an audience can recognize.","media":"/images/editorial/formatted-account.jpg"},{"label":"THE CONCEPT","title":"Formatted Account","text":"A Formatted Account uses a repeatable creative structure an audience can recognize. Repetition concerns the promise, not necessarily the substance.","media":"/images/editorial/formatted-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Recognizing a format does not guarantee the next episode offers anything new.","media":"/images/editorial/formatted-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the recurring promise in one sentence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/formatted-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Prepare ten episodes with different lessons.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/formatted-account.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/formatted-account.jpg","width":1280,"height":960,"alt":{"en":"Repeating rounded concrete balconies on Chicago’s River City apartments."},"credit":"w_lemay","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 23b78937a31d7f80187e6a7a408758763669adfd.","source":"https://commons.wikimedia.org/wiki/File:River_City,_Wells_Street_and_Polk_Street,_Chicago,_IL_-_54519335782.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"020","slug":"chaotic-account","term":"Chaotic Account","category":"creative","kind":"essay","image":"chaotic-account","tier":"operating","evidence":"editorial","sources":[],"related":["ai-persona","formatted-account","distribution-is-the-moat"],"en":{"title":"A chaotic account still has a point of view.","dek":"A Chaotic Account allows several formats rather than one rigid template.","point":"A Chaotic Account allows several formats rather than one rigid template. In AGD, chaotic means flexible, not devoid of audience or logic.","body":["A founder can post a screenshot, an anecdote and a demo without losing their voice. The connection is their view of work. Organize content by purpose: explain, entertain, expose friction. Otherwise the week’s strongest post becomes an excuse to chase every trend.","Imagine a week built around missed appointments: a meme, an anecdote and a practical demonstration. Formats change while the problem remains recognizable. Compare responses within that content family. You can learn which treatment clarifies the situation without reducing the entire editorial direction to the format producing the biggest spike. This preserves flexibility while providing a meaningful basis for the next creative decision."],"action":["Keep a common audience across formats.","Label each post by purpose."],"trap":"Format diversity can complicate attribution; document what actually changed.","quote":"A chaotic account still has a point of view.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A chaotic account still has a point of view.","text":"A Chaotic Account allows several formats rather than one rigid template.","media":"/images/editorial/chaotic-account.jpg"},{"label":"THE CONCEPT","title":"Chaotic Account","text":"A Chaotic Account allows several formats rather than one rigid template. In AGD, chaotic means flexible, not devoid of audience or logic.","media":"/images/editorial/chaotic-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Format diversity can complicate attribution; document what actually changed.","media":"/images/editorial/chaotic-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep a common audience across formats.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/chaotic-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Label each post by purpose.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/chaotic-account.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/chaotic-account.jpg","width":1280,"height":960,"alt":{"en":"Graffiti, wall paintings, and parked bicycles on an Amsterdam street."},"credit":"Fons Heijnsbroek","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: d99302b5d7a919d63639110e4b3951ed8c4c5f9f.","source":"https://commons.wikimedia.org/wiki/File:Wall-paintings_and_urban_art_on_the_walls_in_Amsterdam_city.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"021","slug":"ai-persona","term":"AI Persona","category":"creative","kind":"guide","image":"ai-persona","tier":"operating","evidence":"editorial","sources":[],"related":["persona-agd","chaotic-account","distribution-is-the-moat"],"en":{"title":"A synthetic character needs something to say.","dek":"An AI Persona substantially uses AI for appearance, voice or production.","point":"An AI Persona substantially uses AI for appearance, voice or production. Its editorial value still depends on coherence and usefulness.","body":["Define continuity: what the character knows, does not know, likes and never claims to have experienced. A fictional narrator can tell an illustrative story, not provide a fake customer testimonial. Inconsistent voice or recurring details break identity faster than imperfect rendering. Keep a reference sheet and identify the fiction.","A continuity sheet can include preferred vocabulary, editorial positions and consistent visual details. Add subjects where the character does not offer expert judgment. Stability supports production while transparency supports reader understanding. The aim is coherent fiction, not an imaginary person presented as an actual customer. Review both image and script because a careful disclosure cannot repair contradictory claims inside the content itself."],"action":["Write the character’s boundaries.","Review scripts for invented real-world experiences."],"trap":"A realistic appearance is not evidence of expertise or product use.","quote":"A synthetic character needs something to say.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A synthetic character needs something to say.","text":"An AI Persona substantially uses AI for appearance, voice or production.","media":"/images/editorial/ai-persona.jpg"},{"label":"THE CONCEPT","title":"AI Persona","text":"An AI Persona substantially uses AI for appearance, voice or production. Its editorial value still depends on coherence and usefulness.","media":"/images/editorial/ai-persona.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A realistic appearance is not evidence of expertise or product use.","media":"/images/editorial/ai-persona.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the character’s boundaries.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ai-persona.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review scripts for invented real-world experiences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ai-persona.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/ai-persona.jpg","width":1280,"height":1214,"alt":{"en":"A seated fashion mannequin dressed in dark clothes in a Paris shop window."},"credit":"Ввласенко","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 124997d1f6190a84a1df6987fe9a4899cae645d4.","source":"https://commons.wikimedia.org/wiki/File:Mannequin_in_the_shop_window._Paris,_France.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"022","slug":"persona-agd","term":"Persona AGD","category":"creative","kind":"guide","image":"persona-agd","tier":"operating","evidence":"editorial","sources":[],"related":["slideshow-agd","ai-persona","distribution-is-the-moat"],"en":{"title":"One product. Three narrators. Three reasons.","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts..","point":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.","body":["For a calendar tool, consider clearly fictional perspectives: a juggling freelancer, a revising student, a coordinating parent. Each encounters a specific problem. The difference must appear in the scenario, not merely a displayed age. Then examine whether audiences and their questions actually differ.","Build a scenario grid and look for duplicates. If all three narrators always encounter the same situation in the same words, their biographies are doing no work. Rewrite from each character’s constraints. A credible difference in context is more useful than a catalog of psychological traits invented to fill a brief. Evaluate the published content against those constraints rather than the personas’ decorative descriptions."],"action":["Connect each persona to a specific friction.","Avoid having them repeat the same sales script."],"trap":"Three characters do not prove you reached three different audiences.","quote":"One product. Three narrators. Three reasons.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"One product. Three narrators. Three reasons.","text":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts..","media":"/images/editorial/persona-agd.jpg"},{"label":"THE CONCEPT","title":"Persona AGD","text":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.","media":"/images/editorial/persona-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Three characters do not prove you reached three different audiences.","media":"/images/editorial/persona-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect each persona to a specific friction.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/persona-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Avoid having them repeat the same sales script.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/persona-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/persona-agd.jpg","width":1280,"height":960,"alt":{"en":"An empty ornate theatre with golden balconies, a decorated ceiling, and rows of seats."},"credit":"Avacado-pie","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 6b5398d1da234f7ae8a607929282ac89a233cf97.","source":"https://commons.wikimedia.org/wiki/File:Paramount_Theatre_Seating_View_(empty).jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"023","slug":"slideshow-agd","term":"Slideshow AGD","category":"creative","kind":"guide","image":"slideshow-agd","tier":"canonical","evidence":"editorial","sources":[],"related":["story-slideshow","persona-agd","distribution-is-the-moat"],"en":{"title":"A slideshow is a story, not a sliced PDF.","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows.","point":"Slideshow AGD uses accounts publishing native carousels or slideshows. A useful sequence progresses, giving a clear reason to reach the next screen.","body":["Write the transitions first: situation, complication, discovery, application. A slide can hold one idea without becoming empty. If every screen repeats the first screen’s promise, readers move without learning. Read the sequence without design to check progression before polishing typography.","An educational sequence can start with a poor result, show its cause and offer a correction. Images should help viewers see the difference rather than merely occupy space. Check text size, contrast and visual load on every slide. A mobile slideshow should remain readable without constant zooming. Its narrative structure and physical legibility work together; neither compensates for the absence of the other."],"action":["Give each slide a purpose.","Keep a conclusion useful without another click."],"trap":"More slides do not mean more value or better distribution.","quote":"A slideshow is a story, not a sliced PDF.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A slideshow is a story, not a sliced PDF.","text":"Slideshow AGD uses accounts publishing native carousels or slideshows.","media":"/images/editorial/slideshow-agd.jpg"},{"label":"THE CONCEPT","title":"Slideshow AGD","text":"Slideshow AGD uses accounts publishing native carousels or slideshows. A useful sequence progresses, giving a clear reason to reach the next screen.","media":"/images/editorial/slideshow-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"More slides do not mean more value or better distribution.","media":"/images/editorial/slideshow-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Give each slide a purpose.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/slideshow-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep a conclusion useful without another click.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/slideshow-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/slideshow-agd.jpg","width":1280,"height":1019,"alt":{"en":"A vintage slide projector with its large lens and upright slide holder."},"credit":"Berthold Werner","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 27154a4bcea6fba329e9b96074e7df16ef08581f.","source":"https://commons.wikimedia.org/wiki/File:Super_Zett_III_Slide_projektor_BW_2025-07-25_16-38-31_stack.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"024","slug":"story-slideshow","term":"Story Slideshow","category":"creative","kind":"essay","image":"story-slideshow","tier":"operating","evidence":"editorial","sources":[],"related":["educational-slideshow","slideshow-agd","distribution-is-the-moat"],"en":{"title":"A little tension beats fifteen advice slides.","dek":"A Story Slideshow organizes a sequence around a situation and its resolution.","point":"A Story Slideshow organizes a sequence around a situation and its resolution. Its value is narrative; it does not depend on a magic slide count.","body":["Open with a concrete choice: recover your notes or improvise in front of a client. Show what complicates the choice and what resolves it. A product can enter when it becomes useful. Remove it from the draft: if the entire scene collapses, you may have written an ad without a story.","Write two endings before production: one shows what the person learned, another immediately pushes a purchase. If the first better serves the subject, keep it. A CTA can follow without stealing the resolution. Readers should distinguish the story’s value from the commercial next step. This also makes it possible to test that next step without rebuilding the entire narrative each time."],"action":["Write the conflict in one line.","Show the resolution instead of announcing it."],"trap":"Do not invent a customer outcome to make the ending more convincing.","quote":"A little tension beats fifteen advice slides.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A little tension beats fifteen advice slides.","text":"A Story Slideshow organizes a sequence around a situation and its resolution.","media":"/images/editorial/story-slideshow.jpg"},{"label":"THE CONCEPT","title":"Story Slideshow","text":"A Story Slideshow organizes a sequence around a situation and its resolution. Its value is narrative; it does not depend on a magic slide count.","media":"/images/editorial/story-slideshow.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Do not invent a customer outcome to make the ending more convincing.","media":"/images/editorial/story-slideshow.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the conflict in one line.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/story-slideshow.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show the resolution instead of announcing it.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/story-slideshow.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/story-slideshow.jpg","width":1280,"height":851,"alt":{"en":"An analogue cinema projector displayed outside the Onomichi Cinema Museum."},"credit":"Asturio Cantabrio","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: ec961929acd5111ad04a302fe37a8e9bc5f6215a.","source":"https://commons.wikimedia.org/wiki/File:Onomichi_Cinema_Museum_film_projector_ac_(1).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"025","slug":"educational-slideshow","term":"Educational Slideshow","category":"creative","kind":"guide","image":"educational-slideshow","tier":"operating","evidence":"editorial","sources":[],"related":["meme-slideshow","story-slideshow","distribution-is-the-moat"],"en":{"title":"Teach something before the final slide.","dek":"An educational slideshow communicates usable knowledge during reading.","point":"An educational slideshow communicates usable knowledge during reading. Its entire promise should not be deferred to a sales page.","body":["Take a narrow question: how do median and mean differ? A small, explicitly illustrative numerical example is enough. Show the calculation and the decision it changes. The last screen can suggest further reading, but earlier screens should already answer the original question.","To explain a misleading average, show a few fictional values and place the large outcome beside them. Readers can repeat the calculation and see why the conclusion changes. This verifiability makes the sequence stronger than an impressive number standing alone. It also creates a useful transition to a longer note for readers wanting more detail, while leaving the original slideshow complete on its own."],"action":["Choose an answerable question.","Include an example and a limitation."],"trap":"A definition without application often leaves all useful work to the reader.","quote":"Teach something before the final slide.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Teach something before the final slide.","text":"An educational slideshow communicates usable knowledge during reading.","media":"/images/editorial/educational-slideshow.jpg"},{"label":"THE CONCEPT","title":"Educational Slideshow","text":"An educational slideshow communicates usable knowledge during reading. Its entire promise should not be deferred to a sales page.","media":"/images/editorial/educational-slideshow.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A definition without application often leaves all useful work to the reader.","media":"/images/editorial/educational-slideshow.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose an answerable question.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/educational-slideshow.jpg"},{"label":"PUT IT TO WORK / 2","title":"Include an example and a limitation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/educational-slideshow.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/educational-slideshow.jpg","width":1280,"height":811,"alt":{"en":"The concrete exterior and geometric forms of Brunel University’s lecture theatre building."},"credit":"Suntooooth","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 1349fdb7d3f3dc2e0871b89c07f79bb928de3bef.","source":"https://commons.wikimedia.org/wiki/File:Brunel_University_lecture_theatre_2024-04-12_(cropped).png","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"026","slug":"meme-slideshow","term":"Meme Slideshow","category":"creative","kind":"guide","image":"meme-slideshow","tier":"operating","evidence":"editorial","sources":[],"related":["product-discovery","educational-slideshow","distribution-is-the-moat"],"en":{"title":"The joke should work without the logo.","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline.","point":"A Meme Slideshow builds its sequence around a cultural observation or punchline. A product can fit inside it, but cannot replace the comic mechanism.","body":["Useful material often comes from a friction your audience instantly recognizes. Three meetings to decide to cancel one, for example. Show the text to someone in the intended audience. Ask what they recognized, not whether they liked it. Qualitative feedback helps separate resonance from politeness.","The punchline can target a habit rather than a person. A recognizable shared behavior provides material without inventing customer quotes. Keep a fictional situation’s status clear. Comic precision often comes from one convincing detail rather than a spectacular claim about how many people experience the scene. That leaves space for humor while preserving the distinction between an observation, an illustration and actual research."],"action":["Start with a specific observation.","Check rights to reused images."],"trap":"A successful joke does not automatically validate product positioning.","quote":"The joke should work without the logo.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The joke should work without the logo.","text":"A Meme Slideshow builds its sequence around a cultural observation or punchline.","media":"/images/editorial/meme-slideshow.jpg"},{"label":"THE CONCEPT","title":"Meme Slideshow","text":"A Meme Slideshow builds its sequence around a cultural observation or punchline. A product can fit inside it, but cannot replace the comic mechanism.","media":"/images/editorial/meme-slideshow.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful joke does not automatically validate product positioning.","media":"/images/editorial/meme-slideshow.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Start with a specific observation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/meme-slideshow.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check rights to reused images.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/meme-slideshow.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/meme-slideshow.jpg","width":1280,"height":960,"alt":{"en":"A playful illustrated street mural displayed on an outdoor construction fence in Łódź."},"credit":"Mariochom","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 8f2ee9c6d97afce8e29553b1f6663617a8c3e771.","source":"https://commons.wikimedia.org/wiki/File:%C5%81%C3%B3d%C5%BA-canvas_with_funny_graphics.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"027","slug":"product-discovery","term":"Product Discovery","category":"creative","kind":"guide","image":"product-discovery","tier":"operating","evidence":"editorial","sources":[],"related":["brainrotization","meme-slideshow","distribution-is-the-moat"],"en":{"title":"The product enters when it becomes useful.","dek":"Product discovery content introduces a tool inside an understandable use case.","point":"Product discovery content introduces a tool inside an understandable use case. An editorial approach does not remove the need to disclose a relevant commercial relationship.","body":["Show the task before the interface. For a video tool, the subject might be adapting an edit to three formats. Explain what stays manual, what gets easier and where results fail. A demo retaining limitations helps readers more than a context-free feature list.","A complementary tool can appear when the workflow needs it. Google Sheets, for example, can organize ideas before production. Explain its exact role and what information moves to the next step. A logo list explains little; a clearly described transition lets readers repeat the work using their own setup. This gives adjacent products a reason to appear beyond lending credibility to a promotional collection."],"action":["Describe the job to be done.","Show a real limitation of the solution."],"trap":"A subtle mention should not conceal who benefits commercially from the content.","quote":"The product enters when it becomes useful.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The product enters when it becomes useful.","text":"Product discovery content introduces a tool inside an understandable use case.","media":"/images/editorial/product-discovery.jpg"},{"label":"THE CONCEPT","title":"Product Discovery","text":"Product discovery content introduces a tool inside an understandable use case. An editorial approach does not remove the need to disclose a relevant commercial relationship.","media":"/images/editorial/product-discovery.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A subtle mention should not conceal who benefits commercially from the content.","media":"/images/editorial/product-discovery.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe the job to be done.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/product-discovery.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show a real limitation of the solution.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/product-discovery.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/product-discovery.jpg","width":1280,"height":848,"alt":{"en":"A wood and metal bookcase with shelves, drawers, plants, and records in a workshop interior."},"credit":"Micheli Design","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: abae288e07415059ba5ed386b74934ebeedf1341.","source":"https://commons.wikimedia.org/wiki/File:Custom-made_industrial_wood_and_metal_bookcase_%E2%80%93_Micheli_Design.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"028","slug":"brainrotization","term":"Brainrotization","category":"creative","kind":"essay","image":"brainrotization","tier":"editorial","evidence":"editorial","sources":[],"related":["creative-brief","product-discovery","distribution-is-the-moat"],"en":{"title":"Marketing caught brainrot. What next?","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats.","point":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats. It describes neither a medical condition nor a cognitive measurement.","body":["Absurdity can create a shared language, but it can also erase the subject. Ask what remains after the joke: an idea, a recognized problem, a useful memory? Frenetic editing need not be condemned by default. It should pass the same coherence test as the quietest video.","Absurd content can still identify its status: sketch, metaphor or invented example. That framing prevents a joke from becoming commercial evidence in an out-of-context screenshot. Work on the punchline and legibility together. Audiences can enjoy chaotic form without wanting to decode an incomprehensible demonstration. The useful question is whether the chosen absurdity sharpens the point or merely delays its arrival."],"action":["Summarize the message without describing effects.","Test understanding with the intended audience."],"trap":"Provocative cultural language does not justify claims about audience health or attention.","quote":"Marketing caught brainrot. What next?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Marketing caught brainrot. What next?","text":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats.","media":"/images/editorial/brainrotization.jpg"},{"label":"THE CONCEPT","title":"Brainrotization","text":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats. It describes neither a medical condition nor a cognitive measurement.","media":"/images/editorial/brainrotization.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Provocative cultural language does not justify claims about audience health or attention.","media":"/images/editorial/brainrotization.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Summarize the message without describing effects.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/brainrotization.jpg"},{"label":"PUT IT TO WORK / 2","title":"Test understanding with the intended audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/brainrotization.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/brainrotization.jpg","width":1280,"height":850,"alt":{"en":"A row of illuminated arcade cabinets in a games exhibition."},"credit":"Staffan Vilcans","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: a43ae782ce93d9fa18b56b39cb11d8b819098d53.","source":"https://commons.wikimedia.org/wiki/File:Arcade_machines_-_13332978733.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"029","slug":"creative-brief","term":"Creative Brief","category":"creative","kind":"guide","image":"creative-brief","tier":"operating","evidence":"editorial","sources":[],"related":["hook-payoff","brainrotization","distribution-is-the-moat"],"en":{"title":"A good brief starts with what we want to learn.","dek":"An AGD creative brief connects audience, promise, format and hypothesis.","point":"An AGD creative brief connects audience, promise, format and hypothesis. It gives a creator direction and an analyst an interpretable question.","body":["Replace “make a viral video” with “test whether this friction resonates with students revising.” List requirements, freedoms and boundaries. A useful constraint explains its role: the first screen should make the situation visible, not merely contain a keyword.","Add the sentence a viewer should be able to repeat afterward. It is not a mandatory slogan but a comprehension check. If the creative team proposes a better way to convey the idea, the brief should allow it. The document sets the job’s objective without confusing that objective with the first imagined solution. This distinction keeps constraints useful while preserving the creator’s judgment."],"action":["Write the learning question.","Define what the creator can choose freely."],"trap":"An overly prescriptive brief can eliminate the variation the test was meant to explore.","quote":"A good brief starts with what we want to learn.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A good brief starts with what we want to learn.","text":"An AGD creative brief connects audience, promise, format and hypothesis.","media":"/images/editorial/creative-brief.jpg"},{"label":"THE CONCEPT","title":"Creative Brief","text":"An AGD creative brief connects audience, promise, format and hypothesis. It gives a creator direction and an analyst an interpretable question.","media":"/images/editorial/creative-brief.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An overly prescriptive brief can eliminate the variation the test was meant to explore.","media":"/images/editorial/creative-brief.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the learning question.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-brief.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define what the creator can choose freely.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-brief.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/creative-brief.jpg","width":1280,"height":924,"alt":{"en":"An archival photograph of printers working at benches in the Deli Courant typesetting workshop."},"credit":"Rijksmuseum","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: bdc598ccc83875350e8488c22995634e31cdafff.","source":"https://commons.wikimedia.org/wiki/File:Zetterij_van_de_Deli_Courant,_NG-1990-14-39.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"030","slug":"hook-payoff","term":"Hook & payoff","category":"creative","kind":"guide","image":"hook-payoff","tier":"operating","evidence":"editorial","sources":[],"related":["creative-library","creative-brief","distribution-is-the-moat"],"en":{"title":"The hook’s promise must be paid back.","dek":"The payoff is the narrative or practical answer to the opening promise.","point":"The payoff is the narrative or practical answer to the opening promise. Its alignment with the hook is checked in the content, not only in a retention curve.","body":["If the opening promises an expensive mistake, show the mistake and how to avoid it. A vague revelation in the final second does not repay the promise. Read the sequence as a contract: what did the viewer agree to by staying? This check may remove a strong but misleading opening.","A simple audit shows only the beginning and asks what a person expects. Then reveal the ending. The gap between expectation and answer helps expose unintended promises. This feedback is not a representative measurement of your market, but it can uncover incoherence before full production. Keep the observed confusion in the brief so the next revision addresses a concrete problem rather than somebody’s vague preference."],"action":["Write promise and resolution side by side.","Check that the resolution is clearly shown."],"trap":"Keeping an audience through confusion is not the same as delivering value.","quote":"The hook’s promise must be paid back.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The hook’s promise must be paid back.","text":"The payoff is the narrative or practical answer to the opening promise.","media":"/images/editorial/hook-payoff.jpg"},{"label":"THE CONCEPT","title":"Hook & payoff","text":"The payoff is the narrative or practical answer to the opening promise. Its alignment with the hook is checked in the content, not only in a retention curve.","media":"/images/editorial/hook-payoff.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Keeping an audience through confusion is not the same as delivering value.","media":"/images/editorial/hook-payoff.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write promise and resolution side by side.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/hook-payoff.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check that the resolution is clearly shown.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/hook-payoff.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/hook-payoff.jpg","width":1280,"height":1623,"alt":{"en":"A fishing figure silhouetted atop a lighthouse beneath a warm orange sunset."},"credit":"Petar Milošević","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e99fef0dea0e1c8e1ae36c1a45caa61d9cde8705.","source":"https://commons.wikimedia.org/wiki/File:Fishing_by_lighthouse_at_sunset_(Adriatic_Sea).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"031","slug":"creative-library","term":"Creative Library","category":"creative","kind":"guide","image":"creative-library","tier":"operating","evidence":"editorial","sources":[],"related":["format-fatigue","hook-payoff","distribution-is-the-moat"],"en":{"title":"Your creative library is not a final_final folder.","dek":"A creative library organizes concepts, versions, rights and results.","point":"A creative library organizes concepts, versions, rights and results. It lets a team recover an idea and its test conditions without relying on memory.","body":["Give the concept an identifier, then identify its versions. Keep the brief, image sources, intended markets and associated posts. A filename cannot explain what changed. A winning version without context quickly becomes a template copied for the wrong reasons.","Add a short note after every test: what was published, how versions differed and the limits of interpretation. Avoid renaming every strong file “winner.” Content can win on views and lose on product understanding. Precise annotations make an archive usable by a new colleague or agent without requiring them to reconstruct the campaign from scattered messages and the memory of its original owner."],"action":["Connect each asset to its concept.","Keep licenses and published versions."],"trap":"An asset in a shared drive is not automatically licensed for every account or market.","quote":"Your creative library is not a final_final folder.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your creative library is not a final_final folder.","text":"A creative library organizes concepts, versions, rights and results.","media":"/images/editorial/creative-library.jpg"},{"label":"THE CONCEPT","title":"Creative Library","text":"A creative library organizes concepts, versions, rights and results. It lets a team recover an idea and its test conditions without relying on memory.","media":"/images/editorial/creative-library.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An asset in a shared drive is not automatically licensed for every account or market.","media":"/images/editorial/creative-library.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect each asset to its concept.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-library.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep licenses and published versions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-library.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/creative-library.jpg","width":1280,"height":736,"alt":{"en":"A narrow library aisle with bookshelves and a window looking out onto green trees."},"credit":"Scntst0009","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 8aa0653c477e3a0a8a6be354856fd77dde899b34.","source":"https://commons.wikimedia.org/wiki/File:Library_shelves_iitd.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"032","slug":"format-fatigue","term":"Format fatigue","category":"creative","kind":"essay","image":"format-fatigue","tier":"operating","evidence":"editorial","sources":[],"related":["creative-matrix","creative-library","distribution-is-the-moat"],"en":{"title":"The format works. Until it just repeats.","dek":"Format fatigue is a hypothesis about weakening response after repetition.","point":"Format fatigue is a hypothesis about weakening response after repetition. Studying it requires separating repetition from weaker topics and audience changes.","body":["Do not abandon a series after two weak episodes. Compare topics, promises and observation maturity. Test a structural variation addressing the same problem. If every format declines together, looking only for a creative explanation may hide another cause.","Separate new viewers from returning audiences when data allows. A format can feel repetitive to the team while remaining new to much of the audience. The reverse can also happen: creators still enjoy a series while responses suggest fatigue. Ground the decision in observable context rather than internal enthusiasm alone. Where those audience distinctions cannot be measured, state the uncertainty instead of filling it with assumptions."],"action":["Compare episodes at equal observation ages.","Test a variation before abandoning the series."],"trap":"A decline does not prove audience fatigue; the cause may remain unknown.","quote":"The format works. Until it just repeats.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The format works. Until it just repeats.","text":"Format fatigue is a hypothesis about weakening response after repetition.","media":"/images/editorial/format-fatigue.jpg"},{"label":"THE CONCEPT","title":"Format fatigue","text":"Format fatigue is a hypothesis about weakening response after repetition. Studying it requires separating repetition from weaker topics and audience changes.","media":"/images/editorial/format-fatigue.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A decline does not prove audience fatigue; the cause may remain unknown.","media":"/images/editorial/format-fatigue.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Compare episodes at equal observation ages.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/format-fatigue.jpg"},{"label":"PUT IT TO WORK / 2","title":"Test a variation before abandoning the series.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/format-fatigue.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/format-fatigue.jpg","width":1280,"height":853,"alt":{"en":"A macro photograph of the concentric grooves on a vinyl record."},"credit":"Evan-Amos","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 13066ddb840fd0edc705d1355a26db24f3285fc1.","source":"https://commons.wikimedia.org/wiki/File:12in-LP-Vinyl-Record-Macro-Grooves.jpg","license":"Public domain","licenseUrl":"https://creativecommons.org/publicdomain/mark/1.0/"}},{"id":"033","slug":"creative-matrix","term":"Creative Matrix","category":"creative","kind":"guide","image":"creative-matrix","tier":"operating","evidence":"editorial","sources":[],"related":["account-persona","format-fatigue","distribution-is-the-moat"],"en":{"title":"The matrix that stops fifty copies from being born.","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format.","point":"A creative matrix crosses variation dimensions: audience, problem, angle and format. It helps select experiments rather than mechanically filling every cell.","body":["Start with a few credible combinations. One problem may deserve a demo and a narrative without needing a meme. Record why each combination could work. Empty cells are useful: sometimes they reveal a missing idea rather than insufficient output.","An interesting cell should become a brief. Write the opening situation, the difference offered and the question to measure. If none of those sentences comes easily, leave the cell empty. The matrix is a selection tool: its value may be reducing productions that do not yet have a subject. A small set of explainable experiments is easier to learn from than an exhaustive but arbitrary catalog."],"action":["Cross three audiences with three relevant angles.","Reject combinations without an editorial reason."],"trap":"A full table is not proof of diversity if every scenario says the same thing.","quote":"The matrix that stops fifty copies from being born.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The matrix that stops fifty copies from being born.","text":"A creative matrix crosses variation dimensions: audience, problem, angle and format.","media":"/images/editorial/creative-matrix.jpg"},{"label":"THE CONCEPT","title":"Creative Matrix","text":"A creative matrix crosses variation dimensions: audience, problem, angle and format. It helps select experiments rather than mechanically filling every cell.","media":"/images/editorial/creative-matrix.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A full table is not proof of diversity if every scenario says the same thing.","media":"/images/editorial/creative-matrix.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Cross three audiences with three relevant angles.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-matrix.jpg"},{"label":"PUT IT TO WORK / 2","title":"Reject combinations without an editorial reason.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-matrix.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/creative-matrix.jpg","width":1280,"height":720,"alt":{"en":"Colorful Amsterdam canal houses and illuminated windows reflected in the water at blue hour."},"credit":"Basile Morin","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 552058bafe635df809ac18513f7f7490715e5706.","source":"https://commons.wikimedia.org/wiki/File:Colorful_windows_and_canal_houses_at_blue_hour_with_water_reflection_in_Damrak_Amsterdam_Netherlands.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"034","slug":"niche-warming","term":"Niche Warming","category":"field-notes","kind":"guide","image":"niche-warming","tier":"canonical","evidence":"editorial","sources":[],"related":["native-posting","budget-of-learning","distribution-is-the-moat"],"en":{"title":"Warm an account without invoking magic.","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions.","point":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions. Its precise effect on reach remains a testable hypothesis.","body":["Preparation can help understand an audience’s codes as well as contextualize an account. Record topics, creators and recommendations encountered. A checklist of mechanical gestures does not prove relevant context formed. Compare comparable accounts afterward and retain observations contradicting your intuition.","A preparation notebook can record creator vocabulary, recurring comment questions and formats that have become ordinary. Those observations feed a concrete brief. Keep them separate from account outcomes: learning a niche’s language can provide research value even when no reach improvement is demonstrated. This distinction allows the team to use what it actually learned without turning the whole activity into an unsupported algorithmic claim."],"action":["Define the niche and its queries.","Document observations without inventing a reach recipe."],"trap":"No magic duration or universal interaction count is established here.","quote":"Warm an account without invoking magic.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Warm an account without invoking magic.","text":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions.","media":"/images/editorial/niche-warming.jpg"},{"label":"THE CONCEPT","title":"Niche Warming","text":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions. Its precise effect on reach remains a testable hypothesis.","media":"/images/editorial/niche-warming.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"No magic duration or universal interaction count is established here.","media":"/images/editorial/niche-warming.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the niche and its queries.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/niche-warming.jpg"},{"label":"PUT IT TO WORK / 2","title":"Document observations without inventing a reach recipe.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/niche-warming.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/niche-warming.jpg","width":1280,"height":805,"alt":{"en":"Grapevines spill out through the open roof vents of a small glass greenhouse."},"credit":"W.carter","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 96222187d3e8a19262275212c26ce0a1b42a181e.","source":"https://commons.wikimedia.org/wiki/File:Small_greenhouse_with_grapevines_escaping.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"035","slug":"native-posting","term":"Native Posting","category":"field-notes","kind":"guide","image":"native-posting","tier":"canonical","evidence":"editorial","sources":[],"related":["native-warming","niche-warming","distribution-is-the-moat"],"tokportal":"native","en":{"title":"Native posting: the action matters, so does the brief.","dek":"Native Posting means publishing through a platform’s consumer interface.","point":"Native Posting means publishing through a platform’s consumer interface. An API may orchestrate work without being the final publishing channel.","body":["A brief should distinguish ready-to-publish content from choices left to the operator: text, audio, cover, timing. Define delivery evidence and what requires correction. Native execution provides operational context; it does not remove the need to check current platform capabilities.","For delivery, request the post URL, actual time and any departures from the brief. An unavailable feature should be reported rather than silently substituted. This record lets analysis compare outcomes against what actually happened. A publishing plan and a verified publication are different objects. Keeping both prevents the team from attributing performance to a creative or native feature that never reached the audience."],"action":["Specify the native features required.","Verify the URL and version actually published."],"trap":"A delivered post is not evidence of reach or conversion.","quote":"Native posting: the action matters, so does the brief.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Native posting: the action matters, so does the brief.","text":"Native Posting means publishing through a platform’s consumer interface.","media":"/images/editorial/native-posting.jpg"},{"label":"THE CONCEPT","title":"Native Posting","text":"Native Posting means publishing through a platform’s consumer interface. An API may orchestrate work without being the final publishing channel.","media":"/images/editorial/native-posting.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A delivered post is not evidence of reach or conversion.","media":"/images/editorial/native-posting.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Specify the native features required.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-posting.jpg"},{"label":"PUT IT TO WORK / 2","title":"Verify the URL and version actually published.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-posting.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/native-posting.jpg","width":1200,"height":1600,"alt":{"en":"A red roadside postbox set against dense green leaves and climbing plants."},"credit":"Rodhullandemu","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: d3e028e667be99e939087a2a5c28148a4c304537.","source":"https://commons.wikimedia.org/wiki/File:Post_box_at_81_Coombe_Road,_Irby.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"036","slug":"native-warming","term":"Native Warming","category":"field-notes","kind":"guide","image":"native-warming","tier":"canonical","evidence":"editorial","sources":[],"related":["geo-targeted-account","native-posting","distribution-is-the-moat"],"en":{"title":"Warming is not a robot dance.","dek":"Native Warming happens in the real application through ordinary, authentic interactions.","point":"Native Warming happens in the real application through ordinary, authentic interactions. The practice should remain meaningful to the person performing it.","body":["Providing interests and an observation goal is more intelligible than prescribing a choreography of likes. An operator can report relevant trends, language mismatches or off-topic content. Those observations have research value even when their effect on later distribution remains unknown.","A useful instruction might request three recurring question types in a niche. The number structures the report; it is not an algorithmic dose. Operators should remain free to report that no clear pattern emerged. Missing signal is information, not work to disguise so a form looks complete. This preserves the distinction between an authentic observation task and a mechanical requirement to perform a predetermined sequence."],"action":["Write an observation objective.","Capture qualitative learning."],"trap":"An action being human does not turn a hypothesis into a demonstrated result.","quote":"Warming is not a robot dance.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Warming is not a robot dance.","text":"Native Warming happens in the real application through ordinary, authentic interactions.","media":"/images/editorial/native-warming.jpg"},{"label":"THE CONCEPT","title":"Native Warming","text":"Native Warming happens in the real application through ordinary, authentic interactions. The practice should remain meaningful to the person performing it.","media":"/images/editorial/native-warming.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An action being human does not turn a hypothesis into a demonstrated result.","media":"/images/editorial/native-warming.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write an observation objective.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-warming.jpg"},{"label":"PUT IT TO WORK / 2","title":"Capture qualitative learning.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-warming.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/native-warming.jpg","width":1280,"height":720,"alt":{"en":"A yellow Lisbon tram travels through an illuminated city square at night."},"credit":"Fredericknoronha","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 0f1b3a36d121609a61424738e6561420d2206df5.","source":"https://commons.wikimedia.org/wiki/File:A_tram_on_the_streets_of_Lisbon,_Portugal_by_night.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"037","slug":"geo-targeted-account","term":"Geo-Targeted Account","category":"field-notes","kind":"guide","image":"geo-targeted-account","tier":"canonical","evidence":"editorial","sources":[],"related":["geo-posting","native-warming","distribution-is-the-moat"],"en":{"title":"A US account does not guarantee a US audience.","dek":"A Geo-Targeted Account is established and operated in its target market.","point":"A Geo-Targeted Account is established and operated in its target market. Geography is one execution context among others, without guaranteeing audience composition.","body":["Separate operating country, content language and observed viewer countries. An English video can travel far beyond its intended market. Examine available geographic data and its coverage. If a reliable breakdown is unavailable, keep it unknown instead of inferring it from account location.","Use three columns: intended market, operating country and observed audience. The last may remain unknown when data is unavailable. This prevents an export from turning intent into outcome. Before changing markets, also inspect product constraints and questions received in comments. A geographically relevant audience can still be a poor fit for an offer unavailable locally or a use case that does not match its needs."],"action":["Define the intended market before publishing.","Measure geographic share when available."],"trap":"A creation country is not deterministic ad targeting.","quote":"A US account does not guarantee a US audience.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A US account does not guarantee a US audience.","text":"A Geo-Targeted Account is established and operated in its target market.","media":"/images/editorial/geo-targeted-account.jpg"},{"label":"THE CONCEPT","title":"Geo-Targeted Account","text":"A Geo-Targeted Account is established and operated in its target market. Geography is one execution context among others, without guaranteeing audience composition.","media":"/images/editorial/geo-targeted-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A creation country is not deterministic ad targeting.","media":"/images/editorial/geo-targeted-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the intended market before publishing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/geo-targeted-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Measure geographic share when available.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/geo-targeted-account.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/geo-targeted-account.jpg","width":1280,"height":846,"alt":{"en":"Illuminated New York apartment buildings and streets under a dark night sky."},"credit":"Paulo Barcellos Jr.","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e5acabdb111b2215fee04c166e00757641f2ef21.","source":"https://commons.wikimedia.org/wiki/File:New_York_City_at_night_HDR.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"038","slug":"geo-posting","term":"Geo-Posting","category":"field-notes","kind":"guide","image":"geo-posting","tier":"canonical","evidence":"editorial","sources":[],"related":["us-launch","geo-targeted-account","distribution-is-the-moat"],"tokportal":"native","en":{"title":"Localization starts before the publish button.","dek":"Geo-Posting means publishing through an account operated in the target market.","point":"Geo-Posting means publishing through an account operated in the target market. Content must still fit that audience’s uses, references and constraints.","body":["A US-focused demo may fail if it shows prices, units or situations unfamiliar to viewers. Have someone who knows the market review the scenario. Execution location and cultural relevance are separate dimensions; record them separately rather than explaining every result through geography.","Consider an illustrative French demo using a local school calendar before targeting an English-speaking audience. Translating the voice without adapting dates can make the use case incoherent. Fix the context before judging distribution. You will then test an understandable proposition instead of the audience’s patience with an imported scenario. Record those changes because the localized version is a different creative treatment, not merely another upload location."],"action":["Adapt the scenario, units and language.","Separate creative variables from geography."],"trap":"Weak local results may come from message, product or context; country is not the only suspect.","quote":"Localization starts before the publish button.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Localization starts before the publish button.","text":"Geo-Posting means publishing through an account operated in the target market.","media":"/images/editorial/geo-posting.jpg"},{"label":"THE CONCEPT","title":"Geo-Posting","text":"Geo-Posting means publishing through an account operated in the target market. Content must still fit that audience’s uses, references and constraints.","media":"/images/editorial/geo-posting.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Weak local results may come from message, product or context; country is not the only suspect.","media":"/images/editorial/geo-posting.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Adapt the scenario, units and language.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/geo-posting.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate creative variables from geography.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/geo-posting.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/geo-posting.jpg","width":1280,"height":853,"alt":{"en":"A large illuminated globe of Earth inside the Naturalis Biodiversity Center."},"credit":"Henk Caspers/Naturalis Biodiversity Center","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 44944f77122fd4571e09c940fdcc9a95c84f36b2.","source":"https://commons.wikimedia.org/wiki/File:Naturalis_Biodiversity_Center_-_Museum_-_Exhibition_Earth_08_-_Huge_globe_with_Africa_showing,_overview.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"039","slug":"us-launch","term":"US launch","category":"field-notes","kind":"guide","image":"us-launch","tier":"operating","evidence":"editorial","sources":[],"related":["localization-not-translation","geo-posting","distribution-is-the-moat"],"en":{"title":"Launching in the US from abroad: start with the scene.","dek":"An international launch needs an understandable offer and a locally relevant use case.","point":"An international launch needs an understandable offer and a locally relevant use case. Social distribution does not replace adapting the post-click journey.","body":["Before producing a series, check that target-market visitors can understand value, pricing and product terms. Choose a narrow use case for initial content. Localized accounts will not rescue a page addressing unfamiliar constraints or an unavailable offer.","Follow the click into the product: availability, language, displayed currency and signup experience. A video promising an immediate action should not lead to a page imposing a different expectation. This review sometimes reveals that the main launch problem is promise-to-destination consistency rather than account infrastructure. Fixing that mismatch gives any subsequent distribution experiment a clearer proposition to evaluate and a more meaningful commercial outcome to observe."],"action":["Review the complete journey in local context.","Connect every angle to a relevant destination."],"trap":"A US audience alone is not evidence of paying demand.","quote":"Launching in the US from abroad: start with the scene.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Launching in the US from abroad: start with the scene.","text":"An international launch needs an understandable offer and a locally relevant use case.","media":"/images/editorial/us-launch.jpg"},{"label":"THE CONCEPT","title":"US launch","text":"An international launch needs an understandable offer and a locally relevant use case. Social distribution does not replace adapting the post-click journey.","media":"/images/editorial/us-launch.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A US audience alone is not evidence of paying demand.","media":"/images/editorial/us-launch.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Review the complete journey in local context.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/us-launch.jpg"},{"label":"PUT IT TO WORK / 2","title":"Connect every angle to a relevant destination.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/us-launch.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/us-launch.jpg","width":1280,"height":837,"alt":{"en":"The Brooklyn Bridge and its lights reflected in the East River at night."},"credit":"Andrew Choy","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b54c8c7238c3d18b84bee035a7737729a8bd18e7.","source":"https://commons.wikimedia.org/wiki/File:Brooklyn_Bridge_at_Night.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"040","slug":"localization-not-translation","term":"Localization","category":"field-notes","kind":"guide","image":"localization-not-translation","tier":"operating","evidence":"editorial","sources":[],"related":["account-brief","us-launch","distribution-is-the-moat"],"en":{"title":"Translate the words. Then rebuild the situation.","dek":"Localization adapts meaning, references and uses.","point":"Localization adapts meaning, references and uses. A grammatically correct translation can preserve a scenario irrelevant to its new audience.","body":["Back-to-school content changes with local calendars, exams and habits. Keep the underlying problem and rewrite its context. Translated subtitles are only part of the work: imagery, product screens and numerical examples may also need adaptation.","Keep a glossary for terms that must remain stable, including Account-Generated Distribution. Elsewhere, allow natural phrasing instead of literal copying. Review the complete promise: what a local reader understands should match what the content and product can actually deliver. This creates equivalent meaning without requiring identical sentence structures, cultural examples or pacing across languages that organize information differently."],"action":["List cultural references in the script.","Review the example, not just the sentences."],"trap":"Changing flags and language without context can produce pages or posts without distinct value.","quote":"Translate the words. Then rebuild the situation.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Translate the words. Then rebuild the situation.","text":"Localization adapts meaning, references and uses.","media":"/images/editorial/localization-not-translation.jpg"},{"label":"THE CONCEPT","title":"Localization","text":"Localization adapts meaning, references and uses. A grammatically correct translation can preserve a scenario irrelevant to its new audience.","media":"/images/editorial/localization-not-translation.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Changing flags and language without context can produce pages or posts without distinct value.","media":"/images/editorial/localization-not-translation.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"List cultural references in the script.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/localization-not-translation.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review the example, not just the sentences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/localization-not-translation.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/localization-not-translation.jpg","width":1280,"height":853,"alt":{"en":"Pedestrians walk beneath colorful illuminated signs on a night street in Kabukichō, Tokyo."},"credit":"Basile Morin","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: cf18157beaaa356725bc4dc42c26e03b126dd53a.","source":"https://commons.wikimedia.org/wiki/File:Colorful_neon_street_signs_in_Kabukich%C5%8D,_Shinjuku,_Tokyo.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"041","slug":"account-brief","term":"Account Brief","category":"field-notes","kind":"guide","image":"account-brief","tier":"operating","evidence":"editorial","sources":[],"related":["operator-handoff","localization-not-translation","distribution-is-the-moat"],"en":{"title":"The account brief fits on one page.","dek":"An account brief sets its promise, audience, voice and boundaries.","point":"An account brief sets its promise, audience, voice and boundaries. It gives creation, execution and analysis a shared contract.","body":["Include two examples of desired posts and one counterexample. State who approves, when to escalate uncertainty and where to record results. Keep the page short enough to use during work. A strategy document nobody opens does not prevent persona drift.","A useful check asks whether a new colleague could choose between two pieces using only the document. If both seem equally acceptable while only one fits the persona, a decision criterion is probably missing. Add the detail that settles the choice, then remove background paragraphs that never help decide. A brief becomes stronger through sharper boundaries, not automatically through extra length or more sophisticated vocabulary."],"action":["Write promise, audience, voice and refusals.","Add an owner and correction path."],"trap":"A brief should evolve through documented decisions; leaving it frozen is not consistency.","quote":"The account brief fits on one page.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The account brief fits on one page.","text":"An account brief sets its promise, audience, voice and boundaries.","media":"/images/editorial/account-brief.jpg"},{"label":"THE CONCEPT","title":"Account Brief","text":"An account brief sets its promise, audience, voice and boundaries. It gives creation, execution and analysis a shared contract.","media":"/images/editorial/account-brief.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A brief should evolve through documented decisions; leaving it frozen is not consistency.","media":"/images/editorial/account-brief.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write promise, audience, voice and refusals.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-brief.jpg"},{"label":"PUT IT TO WORK / 2","title":"Add an owner and correction path.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-brief.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/account-brief.jpg","width":1280,"height":721,"alt":{"en":"A close view of the ribbon and mechanical parts inside a red typewriter."},"credit":"Raimond Spekking","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 945a83becb899a824a5dba1cf74e03727f04580f.","source":"https://commons.wikimedia.org/wiki/File:Silver-Reed_SR_200_in_red-9542.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"042","slug":"operator-handoff","term":"Operator handoff","category":"field-notes","kind":"guide","image":"operator-handoff","tier":"operating","evidence":"editorial","sources":[],"related":["publishing-window","account-brief","distribution-is-the-moat"],"tokportal":"native","en":{"title":"The handoff that prevents “I thought you meant”.","dek":"A handoff transfers an executable task with assets, constraints and success conditions.","point":"A handoff transfers an executable task with assets, constraints and success conditions. Ambiguity should be resolved before irreversible action.","body":["Specify file version, account, text and permitted discretion. Separate a preferred time from a hard deadline. Operators should know when to stop: corrupted assets, unavailable features, language mismatch. Structured feedback is better than publishing merely to keep the queue moving.","Prepare a small example of expected feedback: received URL, observed time, missing feature and requested correction. Keep sensitive information out of the report. This template helps operators communicate what the next stage actually needs without guessing each colleague’s preferred format. It also makes exceptions easier to compare because the team receives a consistent record of facts rather than a collection of incompatible success messages."],"action":["Provide one authoritative asset version.","Define pause and escalation conditions."],"trap":"A task marked complete does not replace checking what was actually published.","quote":"The handoff that prevents “I thought you meant”.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The handoff that prevents “I thought you meant”.","text":"A handoff transfers an executable task with assets, constraints and success conditions.","media":"/images/editorial/operator-handoff.jpg"},{"label":"THE CONCEPT","title":"Operator handoff","text":"A handoff transfers an executable task with assets, constraints and success conditions. Ambiguity should be resolved before irreversible action.","media":"/images/editorial/operator-handoff.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A task marked complete does not replace checking what was actually published.","media":"/images/editorial/operator-handoff.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Provide one authoritative asset version.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/operator-handoff.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define pause and escalation conditions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/operator-handoff.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/operator-handoff.jpg","width":1280,"height":942,"alt":{"en":"An empty recording studio with a mixing desk, speakers, and a glowing computer screen."},"credit":"VACANT FEVER","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b89c45f904cc4fbed262ea9e8272568c75160614.","source":"https://commons.wikimedia.org/wiki/File:Mixing_at_Jackpot!_Recording_Studio_(Portland,_Oregon).jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"043","slug":"publishing-window","term":"Publishing window","category":"field-notes","kind":"guide","image":"publishing-window","tier":"operating","evidence":"editorial","sources":[],"related":["account-inventory","operator-handoff","distribution-is-the-moat"],"en":{"title":"A publishing window beats a sacred minute.","dek":"A publishing window defines an acceptable interval for a task.","point":"A publishing window defines an acceptable interval for a task. It supports planning without claiming a particular minute guarantees better reach.","body":["Use the market’s timezone and retain an absolute timestamp for analysis. If content depends on an event, record the actual deadline. A post delivered on time in the wrong timezone is not a correct delivery. Operational precision matters even when timing’s marketing effect is uncertain.","For event-dependent content, add a post-deadline rule: pause and request a new brief rather than publish something now inaccurate. Evergreen material may allow a wider window. The calendar becomes a contract suited to the editorial substance rather than a collection of precise times chosen by habit. This also helps operators prioritize work according to real consequences instead of the visual density of a scheduling board."],"action":["Name the timezone and interval.","Record actual publication time."],"trap":"Punctuality does not prove a universal optimal posting time.","quote":"A publishing window beats a sacred minute.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A publishing window beats a sacred minute.","text":"A publishing window defines an acceptable interval for a task.","media":"/images/editorial/publishing-window.jpg"},{"label":"THE CONCEPT","title":"Publishing window","text":"A publishing window defines an acceptable interval for a task. It supports planning without claiming a particular minute guarantees better reach.","media":"/images/editorial/publishing-window.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Punctuality does not prove a universal optimal posting time.","media":"/images/editorial/publishing-window.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Name the timezone and interval.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/publishing-window.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record actual publication time.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/publishing-window.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/publishing-window.jpg","width":1280,"height":848,"alt":{"en":"Orange and pink sunset light behind the Rubin Observatory on a rocky mountain summit."},"credit":"NOIRLab/NSF/AURA","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e35daade4d8c26b453796e0d4ac8410ab5d84edb.","source":"https://commons.wikimedia.org/wiki/File:Sunset_at_Rubin_Observatory_(SummitCameraMay2023-CC).jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"044","slug":"account-inventory","term":"Account inventory","category":"field-notes","kind":"guide","image":"account-inventory","tier":"operating","evidence":"editorial","sources":[],"related":["zero-views","publishing-window","distribution-is-the-moat"],"en":{"title":"Your network starts with an accurate inventory.","dek":"An AGD inventory connects each account to its role, market, owner and observed state.","point":"An AGD inventory connects each account to its role, market, owner and observed state. It separates available assets from desired ones.","body":["An account being created, an accessible account and a publishing-ready account are different states. Record last verification time instead of keeping permanent labels. Credentials belong in an appropriate manager, not an editorial sheet. The inventory describes the system without exposing its secrets.","Distinguish active, temporarily unavailable and out-of-scope accounts. Keep status-change history for retrospectives. Otherwise a disappeared account can drop out of calculations and make the network look stronger. The inventory is therefore also a measurement tool, provided each update does not rewrite the past. Current capacity answers today’s planning question; historical membership answers what happened to the original cohort and resources committed to it."],"action":["Define unambiguous states.","Record an owner and verification date."],"trap":"An outdated inventory can make an agent plan work against unavailable capacity.","quote":"Your network starts with an accurate inventory.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your network starts with an accurate inventory.","text":"An AGD inventory connects each account to its role, market, owner and observed state.","media":"/images/editorial/account-inventory.jpg"},{"label":"THE CONCEPT","title":"Account inventory","text":"An AGD inventory connects each account to its role, market, owner and observed state. It separates available assets from desired ones.","media":"/images/editorial/account-inventory.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An outdated inventory can make an agent plan work against unavailable capacity.","media":"/images/editorial/account-inventory.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define unambiguous states.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-inventory.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record an owner and verification date.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-inventory.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/account-inventory.jpg","width":1280,"height":853,"alt":{"en":"Rows of server racks and cables at the NOIRLab headquarters."},"credit":"NOIRLab/NSF/AURA/T. Slovinský","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: f2d53536efa6a11a83ddffb4ceed3ae171f2ca92.","source":"https://commons.wikimedia.org/wiki/File:NOIRLab_HQ_Server_Racks_(6V6A0402-CC).jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"045","slug":"zero-views","term":"Stuck at 0 views","category":"field-notes","kind":"guide","image":"zero-views","tier":"operating","evidence":"editorial","sources":[],"related":["shadowban","account-inventory","distribution-is-the-moat"],"en":{"title":"Zero views is not a diagnosis.","dek":"Stuck at 0 views describes low or absent distribution after publication.","point":"Stuck at 0 views describes low or absent distribution after publication. Without further evidence it identifies neither enforcement nor its cause.","body":["Check publication state, accessibility, media processing and visible notifications. Record the post’s exact age at inspection. Compare it with content observed at the same age. Immediately deleting and reposting can destroy information needed to understand what happened.","A useful report states when the post was published, when it was accessible and when its counter was still zero. This sounds less dramatic than an instant diagnosis but allows later verification. If the counter changes, preserve both observations. You then have an interpretable timeline instead of an isolated screenshot, and can distinguish delayed measurement from genuinely absent distribution without inventing the reason for either."],"action":["Preserve URL, timestamp and notifications.","Separate observation from explanatory hypotheses."],"trap":"A zero in a tool can also indicate missing or delayed data.","quote":"Zero views is not a diagnosis.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Zero views is not a diagnosis.","text":"Stuck at 0 views describes low or absent distribution after publication.","media":"/images/editorial/zero-views.jpg"},{"label":"THE CONCEPT","title":"Stuck at 0 views","text":"Stuck at 0 views describes low or absent distribution after publication. Without further evidence it identifies neither enforcement nor its cause.","media":"/images/editorial/zero-views.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A zero in a tool can also indicate missing or delayed data.","media":"/images/editorial/zero-views.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Preserve URL, timestamp and notifications.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/zero-views.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate observation from explanatory hypotheses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/zero-views.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/zero-views.jpg","width":1280,"height":720,"alt":{"en":"Rows of empty red seats inside a dark cinema auditorium."},"credit":"Eden, Janine and Jim","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 7efa31682b711fa79d7e2cd7453520dc65b0ae27.","source":"https://commons.wikimedia.org/wiki/File:Empty_Movie_Theater_(54280927025).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"046","slug":"shadowban","term":"Shadowban","category":"field-notes","kind":"guide","image":"shadowban","tier":"operating","evidence":"editorial","sources":[],"related":["distribution-failure","zero-views","distribution-is-the-moat"],"en":{"title":"Shadowban is sometimes the name we give the unknown.","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice.","point":"Shadowban is an informal term for suspected distribution suppression without explicit notice. Here it remains a hypothesis unless evidence establishes it.","body":["Describe what changed: fewer views, a missing traffic source, a displayed restriction. Keep screenshots and dates. A missing explanation does not justify inventing platform intent. A precise timeline helps support or analysts work; a dramatic label provides little information.","Also preserve decisions made after the decline. Content changes, pauses or deletions can affect later observations. The objective is not to prove the first intuition but to keep the record interpretable. Precise language leaves room for competing explanations and new platform information. It also prevents an unverified suspicion from becoming a permanent account label that influences every future brief and analysis."],"action":["Write the exact symptom.","Use available official diagnostic or appeal channels."],"trap":"Correlation with a recent change does not prove that change caused the decline.","quote":"Shadowban is sometimes the name we give the unknown.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Shadowban is sometimes the name we give the unknown.","text":"Shadowban is an informal term for suspected distribution suppression without explicit notice.","media":"/images/editorial/shadowban.jpg"},{"label":"THE CONCEPT","title":"Shadowban","text":"Shadowban is an informal term for suspected distribution suppression without explicit notice. Here it remains a hypothesis unless evidence establishes it.","media":"/images/editorial/shadowban.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Correlation with a recent change does not prove that change caused the decline.","media":"/images/editorial/shadowban.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the exact symptom.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/shadowban.jpg"},{"label":"PUT IT TO WORK / 2","title":"Use available official diagnostic or appeal channels.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/shadowban.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/shadowban.jpg","width":1280,"height":853,"alt":{"en":"Streetlights glow softly through fog above a road in Mecklenburg-Vorpommern."},"credit":"Harald Hoyer","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: c3ff7a3d2c68e70e7bdffd03a4e5488f69f99994.","source":"https://commons.wikimedia.org/wiki/File:Fog_and_Street_lights_in_Mecklenburg-Vorpommern.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"047","slug":"distribution-failure","term":"Distribution failure","category":"field-notes","kind":"guide","image":"distribution-failure","tier":"operating","evidence":"editorial","sources":[],"related":["native-not-deceptive","shadowban","distribution-is-the-moat"],"en":{"title":"Different failures hidden inside “it does not work”.","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach.","point":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach. These states call for different responses.","body":["Start with observable facts. Does the account exist? Is the post accessible? Does a notification describe a restriction? Only then inspect performance. This separation avoids requesting new creative work when the original file was never published correctly.","A simple matrix can connect each state to a check: access for accounts, URL for posts, notification for restrictions and measurement window for reach. The team can then route the incident to the right owner. This reduces back-and-forth and protects creators from being asked to remake content to solve a technical problem. The classification earns its value through a concrete next action, not through more elaborate terminology."],"action":["Classify the issue by verified state.","Connect each state to an owner and next action."],"trap":"An overly broad diagnosis mixes technical incidents, moderation and editorial performance.","quote":"Different failures hidden inside “it does not work”.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Different failures hidden inside “it does not work”.","text":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach.","media":"/images/editorial/distribution-failure.jpg"},{"label":"THE CONCEPT","title":"Distribution failure","text":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach. These states call for different responses.","media":"/images/editorial/distribution-failure.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An overly broad diagnosis mixes technical incidents, moderation and editorial performance.","media":"/images/editorial/distribution-failure.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Classify the issue by verified state.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/distribution-failure.jpg"},{"label":"PUT IT TO WORK / 2","title":"Connect each state to an owner and next action.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/distribution-failure.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/distribution-failure.jpg","width":1280,"height":960,"alt":{"en":"The remnants of an old railway bridge beside a newer crossing in rural South Australia."},"credit":"Calistemon","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 146af285bc7bdad5b630bc77878acb87a5765a00.","source":"https://commons.wikimedia.org/wiki/File:Crystal_Brook%E2%80%93Broken_Hill_railway_line_bridge_over_the_Cavanagh_Chase,_July_2026_03.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"048","slug":"native-not-deceptive","term":"Commercial transparency","category":"field-notes","kind":"guide","image":"native-not-deceptive","tier":"operating","evidence":"editorial","sources":[],"related":["reddit-agd","distribution-failure","distribution-is-the-moat"],"en":{"title":"Organic does not mean undercover.","dek":"Content can be useful, native and commercial at once.","point":"Content can be useful, native and commercial at once. Editorial product integration should not invent independence or experience that does not exist.","body":["If a brand initiates the project, make that relationship accessible. Then explain the subject with its limitations. Readers can value a vendor-originated guide when they understand its perspective. A pirate voice is better used challenging dogma than hiding its own position.","On FEEDRAID, the transparency page explains the TokPortal relationship and articles separate illustrative examples from observed outcomes. This allows a direct editorial voice without making readers guess the commercial context. The strongest product integration helps explain a specific operation while keeping limitations visible. Readers can then assess both the usefulness of the explanation and the perspective of the organization behind it."],"action":["Disclose the relevant commercial relationship.","Separate demonstrations, illustrations and measured experience."],"trap":"This note states an editorial rule, not a legal analysis of every country’s requirements.","quote":"Organic does not mean undercover.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Organic does not mean undercover.","text":"Content can be useful, native and commercial at once.","media":"/images/editorial/native-not-deceptive.jpg"},{"label":"THE CONCEPT","title":"Commercial transparency","text":"Content can be useful, native and commercial at once. Editorial product integration should not invent independence or experience that does not exist.","media":"/images/editorial/native-not-deceptive.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This note states an editorial rule, not a legal analysis of every country’s requirements.","media":"/images/editorial/native-not-deceptive.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Disclose the relevant commercial relationship.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-not-deceptive.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate demonstrations, illustrations and measured experience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-not-deceptive.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/native-not-deceptive.jpg","width":1252,"height":835,"alt":{"en":"Sunlight illuminates the veins and edges of green guava leaves."},"credit":"מינוזיג","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b256c11b7a9475c9669c649acaef689be162b219.","source":"https://commons.wikimedia.org/wiki/File:Guava_leaves_sunlight.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"049","slug":"reddit-agd","term":"Reddit AGD","category":"field-notes","kind":"guide","image":"reddit-agd","tier":"operating","evidence":"editorial","sources":[],"related":["community-distribution","native-not-deceptive","distribution-is-the-moat"],"en":{"title":"On Reddit, context is the entrance.","dek":"Reddit AGD adapts account differentiation to legitimate community participation.","point":"Reddit AGD adapts account differentiation to legitimate community participation. It does not mean multiplying identical promotional posts.","body":["Read subreddit rules and discussions before contributing. Answer a question with useful material even without an external link. Disclose a relevant product relationship. Accounts coordinated to simulate agreement undermine the trust a contribution needs.","A useful starting point is a technical question you can answer with a reproducible method. Explain the steps in the contribution itself and add a link only when it supplements the answer. Participation should fit local rules, including restrictions on promotions accepted elsewhere. Keep commercial relationships clear and never use additional accounts to manufacture support for the contribution or make a vendor recommendation appear independently endorsed."],"action":["Check the community’s own rules.","Answer the question before suggesting a resource."],"trap":"The strategy does not justify coordinated voting or fake independent-member testimonials.","quote":"On Reddit, context is the entrance.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"On Reddit, context is the entrance.","text":"Reddit AGD adapts account differentiation to legitimate community participation.","media":"/images/editorial/reddit-agd.jpg"},{"label":"THE CONCEPT","title":"Reddit AGD","text":"Reddit AGD adapts account differentiation to legitimate community participation. It does not mean multiplying identical promotional posts.","media":"/images/editorial/reddit-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The strategy does not justify coordinated voting or fake independent-member testimonials.","media":"/images/editorial/reddit-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check the community’s own rules.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/reddit-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Answer the question before suggesting a resource.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/reddit-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/reddit-agd.jpg","width":1280,"height":940,"alt":{"en":"Rows of shelves and display tables filled with books inside a bookshop."},"credit":"Anthony O'Neil","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 1f536d2bc8d8fba99c8f7f939798567cd3288555.","source":"https://commons.wikimedia.org/wiki/File:Bookshop_interior_-_geograph.org.uk_-_7540912.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"050","slug":"community-distribution","term":"Community distribution","category":"field-notes","kind":"guide","image":"community-distribution","tier":"operating","evidence":"editorial","sources":[],"related":["content-rights","reddit-agd","distribution-is-the-moat"],"en":{"title":"Participate before distributing.","dek":"A community is not merely an acquisition channel.","point":"A community is not merely an acquisition channel. Community distribution depends on contributions matching its expectations and rules.","body":["Identify recurring questions and what members consider a useful answer. A technical note may fit where a product announcement would not. Early usefulness is often reflected in the exchange, not the number of links posted. Record objections instead of treating them as noise.","Keep a context note for each community: expected subjects, accepted formats, frequent objections and promotional limits. This should not become a recipe for bypassing moderation. It helps prevent irrelevant contributions and recognize discussions where your product has no useful place. Choosing not to insert a link can preserve the quality of the exchange and keep the participation aligned with what members actually asked."],"action":["Identify a question people actually ask.","Produce a self-contained, contextual answer."],"trap":"A contribution allowed in one community is not automatically appropriate in another.","quote":"Participate before distributing.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Participate before distributing.","text":"A community is not merely an acquisition channel.","media":"/images/editorial/community-distribution.jpg"},{"label":"THE CONCEPT","title":"Community distribution","text":"A community is not merely an acquisition channel. Community distribution depends on contributions matching its expectations and rules.","media":"/images/editorial/community-distribution.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A contribution allowed in one community is not automatically appropriate in another.","media":"/images/editorial/community-distribution.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Identify a question people actually ask.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/community-distribution.jpg"},{"label":"PUT IT TO WORK / 2","title":"Produce a self-contained, contextual answer.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/community-distribution.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/community-distribution.jpg","width":1280,"height":858,"alt":{"en":"An elevated view of a dense festival crowd gathered beside an illuminated outdoor stage."},"credit":"Skyviewphotography","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b60dfd243e4db215fc16a2c9912ff30e240ebefa.","source":"https://commons.wikimedia.org/wiki/File:Splore_Crowd_2016_.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"051","slug":"content-rights","term":"Content rights","category":"field-notes","kind":"guide","image":"content-rights","tier":"operating","evidence":"editorial","sources":[],"related":["campaign-retrospective","community-distribution","distribution-is-the-moat"],"en":{"title":"An asset folder needs evidence, not assumptions.","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions.","point":"A provenance register connects images, sounds and videos to their origins and checked usage conditions. It provides an operational basis for publishing with known rights.","body":["Keep the source link, creator, license and consultation date. An image appearing in search is not therefore free to use. Recheck scope when an asset changes market or medium. For AI creations, record their origin without presenting them as documentary photographs.","The register can also record modifications such as cropping, subtitles or adaptation. Some permissions have a scope that needs checking before reuse. If that scope is unknown, prefer original work or an asset with verified conditions. Production speed does not justify losing provenance. A clear record lets the next operator understand what can be reused without treating every available file as universally cleared."],"action":["Attach provenance to every asset.","Exclude files whose usage scope remains unknown."],"trap":"This tracking method does not replace reviewing a license or a specific legal situation.","quote":"An asset folder needs evidence, not assumptions.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An asset folder needs evidence, not assumptions.","text":"A provenance register connects images, sounds and videos to their origins and checked usage conditions.","media":"/images/editorial/content-rights.jpg"},{"label":"THE CONCEPT","title":"Content rights","text":"A provenance register connects images, sounds and videos to their origins and checked usage conditions. It provides an operational basis for publishing with known rights.","media":"/images/editorial/content-rights.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This tracking method does not replace reviewing a license or a specific legal situation.","media":"/images/editorial/content-rights.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach provenance to every asset.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-rights.jpg"},{"label":"PUT IT TO WORK / 2","title":"Exclude files whose usage scope remains unknown.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-rights.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/content-rights.jpg","width":1280,"height":588,"alt":{"en":"A row of worn archive binders with handwritten labels and colored spines."},"credit":"MHM55","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: d4710c9b080ac8372ddfa3b81608dd5718cecd0f.","source":"https://commons.wikimedia.org/wiki/File:Archive-boxes-Biella-misc.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"052","slug":"campaign-retrospective","term":"Campaign retrospective","category":"field-notes","kind":"guide","image":"campaign-retrospective","tier":"operating","evidence":"editorial","sources":[],"related":["budget-of-learning","content-rights","distribution-is-the-moat"],"en":{"title":"A retrospective starts with what we do not know.","dek":"An AGD retrospective connects objectives, execution, observations and decisions.","point":"An AGD retrospective connects objectives, execution, observations and decisions. It preserves missing data rather than turning it into zero results.","body":["Separate planned, delivered and measurable posts. Record changes made during execution. A spectacular outcome may come from one idea; a weak outcome may conceal incomplete delivery. Finish with concrete decisions: continue, modify, stop or collect missing evidence.","A useful conclusion can be modest: the concept appears understandable, but the destination was not measured correctly. The next action is to repair measurement before claiming conversion optimization. This avoids restarting a campaign around a number nobody can reproduce and gives the next cycle a precise purpose. Separate what the team learned from what it hoped to learn, even when the latter would make a better presentation."],"action":["Document departures from the plan.","Tie each conclusion to an observation."],"trap":"A retrospective that changes no decisions can become a decorative presentation.","quote":"A retrospective starts with what we do not know.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A retrospective starts with what we do not know.","text":"An AGD retrospective connects objectives, execution, observations and decisions.","media":"/images/editorial/campaign-retrospective.jpg"},{"label":"THE CONCEPT","title":"Campaign retrospective","text":"An AGD retrospective connects objectives, execution, observations and decisions. It preserves missing data rather than turning it into zero results.","media":"/images/editorial/campaign-retrospective.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A retrospective that changes no decisions can become a decorative presentation.","media":"/images/editorial/campaign-retrospective.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Document departures from the plan.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/campaign-retrospective.jpg"},{"label":"PUT IT TO WORK / 2","title":"Tie each conclusion to an observation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/campaign-retrospective.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/campaign-retrospective.jpg","width":1280,"height":843,"alt":{"en":"Film boxes and developing equipment inside a historic photographic darkroom."},"credit":"Geoff Charles","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: c3c5ded9b45880247af2d935e4dac39f5282175e.","source":"https://commons.wikimedia.org/wiki/File:Photographic_darkroom,_probably_Geoff_Charles%27s_darkroom,_Bangor_(1532109).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"053","slug":"budget-of-learning","term":"Learning budget","category":"field-notes","kind":"guide","image":"budget-of-learning","tier":"operating","evidence":"editorial","sources":[],"related":["niche-warming","campaign-retrospective","distribution-is-the-moat"],"en":{"title":"A test also costs the time spent making sense of it.","dek":"A learning budget includes production, coordination, execution and analysis.","point":"A learning budget includes production, coordination, execution and analysis. It helps select interpretable experiments beyond publishing cost alone.","body":["Two equally priced tests can produce very different knowledge. One mixes accounts, formats and markets; another isolates a useful decision. Record full cost and expected decision before launching. A cheap but unreadable experiment can cost more than its quote suggests.","To choose between experiments, ask which decision each can actually change. If a test can neither alter allocation nor improve a brief, its value is uncertain. Exploratory campaigns may have other goals, but should name them. A budget becomes clearer when every cost connects to a question. This does not require predicting returns; it requires explaining what information would make the expenditure useful to the team."],"action":["Estimate coordination and analysis time.","Define the decision the test should inform."],"trap":"A proposed budget is neither spending authorization nor a return forecast.","quote":"A test also costs the time spent making sense of it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A test also costs the time spent making sense of it.","text":"A learning budget includes production, coordination, execution and analysis.","media":"/images/editorial/budget-of-learning.jpg"},{"label":"THE CONCEPT","title":"Learning budget","text":"A learning budget includes production, coordination, execution and analysis. It helps select interpretable experiments beyond publishing cost alone.","media":"/images/editorial/budget-of-learning.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A proposed budget is neither spending authorization nor a return forecast.","media":"/images/editorial/budget-of-learning.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Estimate coordination and analysis time.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/budget-of-learning.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define the decision the test should inform.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/budget-of-learning.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/budget-of-learning.jpg","width":1280,"height":960,"alt":{"en":"Two mechanical stopwatches mounted on a panel among historic control tower instruments."},"credit":"Wolfmann","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: c2e1d4fcce6ce0a6aa75abf5c414d1f5a0013fe8.","source":"https://commons.wikimedia.org/wiki/File:Bardufoss_Lufthavn_Airport_Norway_Avinor_UTSTILLING_teknisk_utstyr_Old_control_tower_technical_equipment_on_display_-_Excelsior_Park_Swiss_made_stopwatches_stoppeklokker_(2022-06-03)_IMG_2286.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"054","slug":"viral-hit","term":"Viral Hit","category":"lab","kind":"protocol","image":"viral-hit","tier":"canonical","evidence":"hypothesis","sources":[],"related":["viral-hit-rate","evidence-ladder","distribution-is-the-moat"],"en":{"title":"Viral compared with what?","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign.","point":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign. A fixed view threshold does not fit every context.","body":["A 40,000-view video means different things for an account usually reaching 600 and one usually reaching 500,000. These numbers are illustrative. Define the baseline before observing results. Otherwise you can move the threshold until it supports the story you wanted.","Keep the selected threshold and its rationale beside the result. A history-relative threshold can become unstable when an account has published very little. A comparable cohort may then be more informative, provided its composition is justified. The word viral should remain attached to a readable baseline. If no credible reference exists yet, describe the observed views and uncertainty rather than forcing a classification."],"action":["Choose a comparable historical baseline.","Set the threshold before reading results."],"trap":"A view spike is not proof of commercial impact.","quote":"Viral compared with what?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Viral compared with what?","text":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign.","media":"/images/editorial/viral-hit.jpg"},{"label":"THE CONCEPT","title":"Viral Hit","text":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign. A fixed view threshold does not fit every context.","media":"/images/editorial/viral-hit.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A view spike is not proof of commercial impact.","media":"/images/editorial/viral-hit.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose a comparable historical baseline.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/viral-hit.jpg"},{"label":"PUT IT TO WORK / 2","title":"Set the threshold before reading results.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/viral-hit.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/viral-hit.jpg","width":1280,"height":691,"alt":{"en":"A powerful ocean wave bursts into white spray against a rocky shoreline."},"credit":"Ronnie Robertson","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 778899c2be915c2aeae6bf20fe3ab48071988fdf.","source":"https://commons.wikimedia.org/wiki/File:Burgi_Wave_Burst_IMG_7243_(16591566349).jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"055","slug":"viral-hit-rate","term":"Viral Hit Rate","category":"lab","kind":"protocol","image":"viral-hit-rate","tier":"operating","evidence":"hypothesis","sources":[],"related":["median-vs-mean","viral-hit","distribution-is-the-moat"],"en":{"title":"The denominator is half the story.","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold.","point":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold. Interpretation depends on threshold, cohort and window.","body":["In a fictional example, four hits among one hundred eligible posts yield 4%. If twenty more are too recent to evaluate, show them separately. Do not silently add them to the denominator. Retain uncertainty too: four events offer limited stability for predicting the next series.","Also display results by creative concept. Ten versions of one idea do not represent ten independent discoveries. Post-level rate answers a production question; concept-level rate helps describe creative discovery. Both can be useful, but should not merge into one unexplained score. Keeping their denominators separate prevents a heavily repeated successful idea from being mistaken for a pipeline that repeatedly discovers unrelated winners."],"action":["Publish threshold, window and exclusions.","Show absolute counts beside the rate."],"trap":"Comparing rates with different eligibility criteria can mislead.","quote":"The denominator is half the story.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The denominator is half the story.","text":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold.","media":"/images/editorial/viral-hit-rate.jpg"},{"label":"THE CONCEPT","title":"Viral Hit Rate","text":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold. Interpretation depends on threshold, cohort and window.","media":"/images/editorial/viral-hit-rate.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Comparing rates with different eligibility criteria can mislead.","media":"/images/editorial/viral-hit-rate.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Publish threshold, window and exclusions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/viral-hit-rate.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show absolute counts beside the rate.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/viral-hit-rate.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/viral-hit-rate.jpg","width":1280,"height":854,"alt":{"en":"Raindrops cling to a car window, blurring the parked vehicles outside."},"credit":"Shixart1985","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b2960be3a0274e5d5f571933bde8e653e6b20033.","source":"https://commons.wikimedia.org/wiki/File:Close-up_of_the_rain_drops_on_a_car_window._Car_in_a_blurry_background.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"056","slug":"median-vs-mean","term":"Median vs mean","category":"lab","kind":"protocol","image":"median-vs-mean","tier":"operating","evidence":"hypothesis","sources":[],"related":["percentiles","viral-hit-rate","distribution-is-the-moat"],"en":{"title":"The average loves an overly good story.","dek":"The mean adds values and divides by their count.","point":"The mean adds values and divides by their count. The median describes the middle of a sorted series. They answer different questions.","body":["Fictional example: 100, 100, 100, 100 and 10,000 views. The mean is 2,080; the median is 100. The first describes theoretically spread volume; the second identifies the central post. Keep both alongside the distribution to distinguish an isolated hit from broad improvement.","In the example, removing the 10,000-view result brings the mean down to 100. This sensitivity check does not mean the hit should be discarded. It reveals dependence on one observation. A useful report keeps the complete result and context, then asks about repeatability rather than inventing it. The exceptional post may matter greatly while still telling us little about what an ordinary next post will achieve."],"action":["Show mean and median together.","Inspect extreme values."],"trap":"The median can also hide the economic importance of a few very large outcomes.","quote":"The average loves an overly good story.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The average loves an overly good story.","text":"The mean adds values and divides by their count.","media":"/images/editorial/median-vs-mean.jpg"},{"label":"THE CONCEPT","title":"Median vs mean","text":"The mean adds values and divides by their count. The median describes the middle of a sorted series. They answer different questions.","media":"/images/editorial/median-vs-mean.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The median can also hide the economic importance of a few very large outcomes.","media":"/images/editorial/median-vs-mean.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Show mean and median together.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/median-vs-mean.jpg"},{"label":"PUT IT TO WORK / 2","title":"Inspect extreme values.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/median-vs-mean.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/median-vs-mean.jpg","width":1280,"height":853,"alt":{"en":"Smooth, multicolored pebbles packed together on a beach."},"credit":"Quim Gil","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 87bd342bb93763993e78d946b54b3bf395b1b570.","source":"https://commons.wikimedia.org/wiki/File:Pebbles_in_Rethymno%27s_beach.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"057","slug":"percentiles","term":"Distribution percentiles","category":"lab","kind":"protocol","image":"percentiles","tier":"operating","evidence":"hypothesis","sources":[],"related":["power-law","median-vs-mean","distribution-is-the-moat"],"en":{"title":"P90 is not a new word for good.","dek":"A percentile locates a value in an ordered distribution.","point":"A percentile locates a value in an ordered distribution. P90 describes its upper region but depends on cohort size and definition.","body":["A percentile across ten posts is less stable than it looks on a dashboard. State the calculation method if tools disagree. Compare equally mature series and keep counts visible. A percentile describes observations; it does not guarantee future performance.","When reading change, show several points in the distribution. A stable median with a stronger upper region tells a different story from broad improvement. The first may suggest more positive extremes, but their cause remains to be understood. These summaries should open the content analysis rather than replace it. Show the same observation window and calculation method so apparent movement is not a reporting artifact."],"action":["Document the calculation convention.","Show each cohort’s size."],"trap":"A high percentile in a small series is not a reliable forecast.","quote":"P90 is not a new word for good.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"P90 is not a new word for good.","text":"A percentile locates a value in an ordered distribution.","media":"/images/editorial/percentiles.jpg"},{"label":"THE CONCEPT","title":"Distribution percentiles","text":"A percentile locates a value in an ordered distribution. P90 describes its upper region but depends on cohort size and definition.","media":"/images/editorial/percentiles.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A high percentile in a small series is not a reliable forecast.","media":"/images/editorial/percentiles.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Document the calculation convention.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/percentiles.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show each cohort’s size.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/percentiles.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/percentiles.jpg","width":1280,"height":853,"alt":{"en":"Layers of mountain ridges fade into blue haze beneath the distant Himalayas."},"credit":"Timothy A. Gonsalves","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 709838554486b27f57f1ad25af603f9799cbbb14.","source":"https://commons.wikimedia.org/wiki/File:Shivaliks_Himalayas_Aerial_Dehaze_Himachal_Feb20_R16_02827.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"058","slug":"power-law","term":"Distribution concentration","category":"lab","kind":"protocol","image":"power-law","tier":"operating","evidence":"hypothesis","sources":[],"related":["top-ten-accounts","percentiles","distribution-is-the-moat"],"en":{"title":"The hit makes noise. The rest explains the system.","dek":"Concentration measures the share of outcomes produced by a fraction of posts.","point":"Concentration measures the share of outcomes produced by a fraction of posts. An unequal distribution is not automatically evidence of a power law.","body":["Calculate the share of views from top posts, then inspect the rest. If one post carries nearly everything, total volume is fragile. That can still be viable if cost and repeatability are understood. Describing concentration beats attaching an untested mathematical label.","A ranked contribution chart often makes concentration visible without fitting a theoretical curve. Add counts and the observation window. Actually testing a power law requires a dedicated statistical method and comparison with alternative models. The expression should not decorate an outcome that is merely unequal. Descriptive reporting can still guide allocation well when it clearly shows which posts contribute and how much uncertainty remains about future repetition."],"action":["Measure the share carried by top posts.","Show results with and without the largest hit."],"trap":"Removing an outlier to improve the average’s story may erase an essential part of the phenomenon.","quote":"The hit makes noise. The rest explains the system.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The hit makes noise. The rest explains the system.","text":"Concentration measures the share of outcomes produced by a fraction of posts.","media":"/images/editorial/power-law.jpg"},{"label":"THE CONCEPT","title":"Distribution concentration","text":"Concentration measures the share of outcomes produced by a fraction of posts. An unequal distribution is not automatically evidence of a power law.","media":"/images/editorial/power-law.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Removing an outlier to improve the average’s story may erase an essential part of the phenomenon.","media":"/images/editorial/power-law.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Measure the share carried by top posts.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/power-law.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show results with and without the largest hit.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/power-law.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/power-law.jpg","width":1280,"height":720,"alt":{"en":"Lightning illuminates a storm cloud above a harbour pier and lighthouse."},"credit":"Maxime Raynal","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 74ed3615cd6743fb4e031d1d1b58a3fd45de2d23.","source":"https://commons.wikimedia.org/wiki/File:Port_and_lighthouse_overnight_storm_with_lightning_in_Port-la-Nouvelle.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"059","slug":"top-ten-accounts","term":"Account concentration","category":"lab","kind":"protocol","image":"top-ten-accounts","tier":"operating","evidence":"hypothesis","sources":[],"related":["matched-cohorts","power-law","distribution-is-the-moat"],"en":{"title":"The network works. Or one account carries it.","dek":"Account concentration shows which assets carry the total outcome.","point":"Account concentration shows which assets carry the total outcome. It complements post-level analysis by revealing structural dependence.","body":["Sum eligible outcomes by account over one window and rank contributions. Compare publishing volumes too: one account may dominate because it receives most resources. Ask whether that allocation reflects observed quality or operational habit.","For illustration, an account receiving half the creative work also produces half the views. Its volume dominance does not necessarily mean greater efficiency. Another, less supplied account may produce more outcome per resource. Compare those views while retaining differences in purpose and assigned creative quality. A portfolio decision needs both total contribution and a fair description of what each account was given a chance to do."],"action":["Compare contributions with allocated resources.","Record accounts with insufficient data."],"trap":"Low contribution does not prove an account is useless when its purpose differs.","quote":"The network works. Or one account carries it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The network works. Or one account carries it.","text":"Account concentration shows which assets carry the total outcome.","media":"/images/editorial/top-ten-accounts.jpg"},{"label":"THE CONCEPT","title":"Account concentration","text":"Account concentration shows which assets carry the total outcome. It complements post-level analysis by revealing structural dependence.","media":"/images/editorial/top-ten-accounts.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Low contribution does not prove an account is useless when its purpose differs.","media":"/images/editorial/top-ten-accounts.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Compare contributions with allocated resources.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/top-ten-accounts.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record accounts with insufficient data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/top-ten-accounts.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/top-ten-accounts.jpg","width":1280,"height":832,"alt":{"en":"The illuminated Price Building rises above surrounding rooftops in Quebec City at night."},"credit":"Wilfredor","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 806daa0796b8e1901acf5837aa1c26d99194be81.","source":"https://commons.wikimedia.org/wiki/File:Price_Building_illuminated_at_night_in_Quebec_City.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"060","slug":"matched-cohorts","term":"Matched cohorts","category":"lab","kind":"protocol","image":"matched-cohorts","tier":"operating","evidence":"hypothesis","sources":[],"related":["posting-time-myth","top-ten-accounts","distribution-is-the-moat"],"en":{"title":"Compare what is actually comparable.","dek":"A matched cohort aligns observations on known characteristics.","point":"A matched cohort aligns observations on known characteristics. It reduces some visible differences without automatically eliminating all confounding.","body":["For publishing-method comparisons, start with format, market, account age and measurement window. Retain unmatched cases separately rather than forcing implausible pairs. Unobserved variables remain a limitation. A matched comparison must explain group credibility, not merely display a gap.","Record excluded cases and their characteristics. If only the easiest accounts to compare remain, conclusions may not apply to the full network. A reproducible method lets another reader understand the population actually covered. Transparency about limits is more useful than presenting a selected sample as universal. The comparison can remain valuable, provided the claim stays inside the boundaries of the observations that support it."],"action":["Choose matching variables before analysis.","Publish exclusions and coverage."],"trap":"Matching is not randomization and does not establish causality by itself.","quote":"Compare what is actually comparable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Compare what is actually comparable.","text":"A matched cohort aligns observations on known characteristics.","media":"/images/editorial/matched-cohorts.jpg"},{"label":"THE CONCEPT","title":"Matched cohorts","text":"A matched cohort aligns observations on known characteristics. It reduces some visible differences without automatically eliminating all confounding.","media":"/images/editorial/matched-cohorts.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Matching is not randomization and does not establish causality by itself.","media":"/images/editorial/matched-cohorts.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose matching variables before analysis.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/matched-cohorts.jpg"},{"label":"PUT IT TO WORK / 2","title":"Publish exclusions and coverage.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/matched-cohorts.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/matched-cohorts.jpg","width":1280,"height":869,"alt":{"en":"A regular grid of windows covers the facade of the Conjunto Nacional building in São Paulo."},"credit":"Wilfredor","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 31c63c97787fe7ffbaeaa9334ac163366f311fbc.","source":"https://commons.wikimedia.org/wiki/File:Facade_of_the_Conjunto_Nacional_cropped_version.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"061","slug":"posting-time-myth","term":"Posting-time myth","category":"lab","kind":"protocol","image":"posting-time-myth","tier":"operating","evidence":"hypothesis","sources":[],"related":["posting-frequency","matched-cohorts","distribution-is-the-moat"],"en":{"title":"7:42 p.m. is not a strategy.","dek":"Posting-time effects may depend on audience and context.","point":"Posting-time effects may depend on audience and context. A universally optimal time is not demonstrated in this protocol.","body":["Allocate comparable content across predefined windows without reserving your strongest topics for a favorite slot. Measure at equal post ages. Separate weekday and local time if the sample supports that detail. Keep the verdict unknown until the test is run and analyzed.","Plan what happens if no clear difference appears. The team might choose the easiest window to operate and spend saved effort on creative work. That would still be useful information. An experiment does not need to uncover a spectacular trick to improve operations. Recording this decision beforehand prevents a null or uncertain outcome from being hidden simply because it does not support an exciting optimization headline."],"action":["Preregister time windows.","Distribute concepts across them."],"trap":"A screenshot of success at one time cannot identify the best posting time.","quote":"7:42 p.m. is not a strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"7:42 p.m. is not a strategy.","text":"Posting-time effects may depend on audience and context.","media":"/images/editorial/posting-time-myth.jpg"},{"label":"THE CONCEPT","title":"Posting-time myth","text":"Posting-time effects may depend on audience and context. A universally optimal time is not demonstrated in this protocol.","media":"/images/editorial/posting-time-myth.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A screenshot of success at one time cannot identify the best posting time.","media":"/images/editorial/posting-time-myth.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Preregister time windows.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-time-myth.jpg"},{"label":"PUT IT TO WORK / 2","title":"Distribute concepts across them.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-time-myth.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/posting-time-myth.jpg","width":1280,"height":853,"alt":{"en":"A close view of the ornate blue and gold Prague Astronomical Clock."},"credit":"Jorge Royan","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 39d974a96d456e41bea4f010599f4a383ce7d3cc.","source":"https://commons.wikimedia.org/wiki/File:The_Prague_Astronomical_Clock_in_Old_Town_-_8559.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"062","slug":"posting-frequency","term":"Posting frequency","category":"lab","kind":"protocol","image":"posting-frequency","tier":"operating","evidence":"hypothesis","sources":[],"related":["warming-study","posting-time-myth","distribution-is-the-moat"],"en":{"title":"Posting more: more chances or more noise?","dek":"A frequency test must separate total volume, per-post performance and production load.","point":"A frequency test must separate total volume, per-post performance and production load. Higher totals can coexist with weaker individual posts.","body":["Define two realistic cadences with comparable creative quality. Observe coordination costs and undelivered content. Do not conclude from average views alone: the network may seek more qualified visits at a manageable cost. No test result is supplied here.","A favorable total may also increase team fatigue or correction work. Record those effects in the review instead of treating them as outside the experiment. A suitable cadence depends on the whole system. Sustainable output with readable briefs may be preferable to a production spike that cannot survive the following week. This is an operating tradeoff to evaluate, not an assumption that lower frequency always performs better."],"action":["Set cadence, duration and primary metric.","Track total cost and per-post outcomes."],"trap":"Changing cadence and quality together prevents isolating frequency effects.","quote":"Posting more: more chances or more noise?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Posting more: more chances or more noise?","text":"A frequency test must separate total volume, per-post performance and production load.","media":"/images/editorial/posting-frequency.jpg"},{"label":"THE CONCEPT","title":"Posting frequency","text":"A frequency test must separate total volume, per-post performance and production load. Higher totals can coexist with weaker individual posts.","media":"/images/editorial/posting-frequency.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Changing cadence and quality together prevents isolating frequency effects.","media":"/images/editorial/posting-frequency.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Set cadence, duration and primary metric.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-frequency.jpg"},{"label":"PUT IT TO WORK / 2","title":"Track total cost and per-post outcomes.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-frequency.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/posting-frequency.jpg","width":1280,"height":853,"alt":{"en":"Illuminated buttons and rows of faders on a sound mixing console."},"credit":"Lchader","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: f656480410fd8f0e9890bb89a24528a9f4148722.","source":"https://commons.wikimedia.org/wiki/File:Audio_mixer_close_up.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"063","slug":"warming-study","term":"Warming protocol","category":"lab","kind":"protocol","image":"warming-study","tier":"operating","evidence":"hypothesis","sources":[],"related":["account-age","posting-frequency","distribution-is-the-moat"],"en":{"title":"Warming deserves more than an anecdote.","dek":"A warming protocol compares preparations defined before publishing.","point":"A warming protocol compares preparations defined before publishing. It should separate niche learning, account behavior and later outcomes.","body":["Plan comparable groups: general preparation, targeted preparation and control where suitable. Keep creative criteria and measurement age consistent. Define possible outcomes, including no difference. This document proposes a method; it does not claim an executed experiment.","Separate observations made during preparation from those collected after publishing. The first can show improved niche understanding without proving a distribution effect. Keeping these benefits distinct avoids an all-or-nothing verdict. The practice may support creative research even when a reach test remains inconclusive. Describe exactly which benefit was observed so a practical learning outcome does not silently become a claim about platform recommendation behavior."],"action":["Describe preparations precisely.","Plan handling of dropouts and missing data."],"trap":"A favorable observation does not establish that warming caused the result.","quote":"Warming deserves more than an anecdote.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Warming deserves more than an anecdote.","text":"A warming protocol compares preparations defined before publishing.","media":"/images/editorial/warming-study.jpg"},{"label":"THE CONCEPT","title":"Warming protocol","text":"A warming protocol compares preparations defined before publishing. It should separate niche learning, account behavior and later outcomes.","media":"/images/editorial/warming-study.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A favorable observation does not establish that warming caused the result.","media":"/images/editorial/warming-study.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe preparations precisely.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/warming-study.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan handling of dropouts and missing data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/warming-study.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/warming-study.jpg","width":1280,"height":811,"alt":{"en":"An elevated view of the glass greenhouse at Jevremovac Botanical Garden in Belgrade."},"credit":"Petar Milošević","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: bf57161b64196cd44da49bbcf409196ab2c904fd.","source":"https://commons.wikimedia.org/wiki/File:%D0%A1%D1%82%D0%B0%D0%BA%D0%BB%D0%B5%D1%9A%D0%B0%D0%BA,_%D0%91%D0%BE%D1%82%D0%B0%D0%BD%D0%B8%D1%87%D0%BA%D0%B0_%D0%B1%D0%B0%D1%88%D1%82%D0%B0_%D0%88%D0%B5%D0%B2%D1%80%D0%B5%D0%BC%D0%BE%D0%B2%D0%B0%D1%86_(greenhouse_Jevremovac_Botanical_Garden,_Belgrade,_Serbia).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"064","slug":"account-age","term":"Account age","category":"lab","kind":"protocol","image":"account-age","tier":"operating","evidence":"hypothesis","sources":[],"related":["slideshow-vs-video","warming-study","distribution-is-the-moat"],"en":{"title":"An old account is not a control group.","dek":"Account age can be associated with history, followers and behavior.","point":"Account age can be associated with history, followers and behavior. Comparing old and new accounts requires distinguishing those dimensions.","body":["An old account without recent activity is not equivalent to an established creator. Describe age, activity, audience and observable restriction history. Choose categories before searching for the split yielding the prettiest gap. Without comparable data, the verdict remains open.","If older accounts are the only ones surviving several cycles, they have already passed through selection. That history may explain part of their difference from new accounts. Keep cohort exits and inactive periods. Age is a convenient variable, but it does not summarize everything an account experienced. A credible analysis should resist treating a date field as a complete description of operational history and accumulated audience context."],"action":["Separate age from activity.","Account for available audience differences."],"trap":"Correlation with age may reflect selection among surviving accounts.","quote":"An old account is not a control group.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An old account is not a control group.","text":"Account age can be associated with history, followers and behavior.","media":"/images/editorial/account-age.jpg"},{"label":"THE CONCEPT","title":"Account age","text":"Account age can be associated with history, followers and behavior. Comparing old and new accounts requires distinguishing those dimensions.","media":"/images/editorial/account-age.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Correlation with age may reflect selection among surviving accounts.","media":"/images/editorial/account-age.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Separate age from activity.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-age.jpg"},{"label":"PUT IT TO WORK / 2","title":"Account for available audience differences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/account-age.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/account-age.jpg","width":1280,"height":853,"alt":{"en":"Growth rings and age markers across the cut trunk of an ancient tree."},"credit":"Thomas Quine","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 3daa3fc306039c48b7c0987c6b2b0724b8689c3b.","source":"https://commons.wikimedia.org/wiki/File:Tree_rings_of_1500_year_old_tree.ARW_(23821647991).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"065","slug":"slideshow-vs-video","term":"Slideshow vs video","category":"lab","kind":"protocol","image":"slideshow-vs-video","tier":"operating","evidence":"hypothesis","sources":[],"related":["formatted-vs-chaotic","account-age","distribution-is-the-moat"],"en":{"title":"Slideshow versus video: context comes first.","dek":"Comparing slideshow and video requires a comparable promise and audience.","point":"Comparing slideshow and video requires a comparable promise and audience. Reading behavior and available metrics may differ between formats.","body":["Turn one question into two suitable treatments without forcing video into an animated slideshow. Choose a useful shared metric, such as measurable qualified visits. Keep format-native metrics separate. The test compares content experiences, not file extensions.","Include production cost in the table. A video may achieve a stronger raw outcome with much more work, while a slideshow may make an explanation easier to revise. The choice depends on the editorial question and resources. Present the tradeoff rather than crowning a format for every situation. Also retain whether both treatments actually delivered equivalent information; unequal substance can otherwise masquerade as a format effect."],"action":["Keep the same user question.","Choose an interpretable shared measure."],"trap":"Comparing differently defined completion rates can manufacture a winner.","quote":"Slideshow versus video: context comes first.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Slideshow versus video: context comes first.","text":"Comparing slideshow and video requires a comparable promise and audience.","media":"/images/editorial/slideshow-vs-video.jpg"},{"label":"THE CONCEPT","title":"Slideshow vs video","text":"Comparing slideshow and video requires a comparable promise and audience. Reading behavior and available metrics may differ between formats.","media":"/images/editorial/slideshow-vs-video.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Comparing differently defined completion rates can manufacture a winner.","media":"/images/editorial/slideshow-vs-video.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep the same user question.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/slideshow-vs-video.jpg"},{"label":"PUT IT TO WORK / 2","title":"Choose an interpretable shared measure.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/slideshow-vs-video.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/slideshow-vs-video.jpg","width":1280,"height":853,"alt":{"en":"A strip of 8 mm film curls away from its reel."},"credit":"Coyau","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 5002c79b0b2e3888e3004386bf9c24c987c10f2c.","source":"https://commons.wikimedia.org/wiki/File:8_mm_Kodak_safety_film_reel_06.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"066","slug":"formatted-vs-chaotic","term":"Formatted vs chaotic","category":"lab","kind":"protocol","image":"formatted-vs-chaotic","tier":"operating","evidence":"hypothesis","sources":[],"related":["creative-diversity-test","slideshow-vs-video","distribution-is-the-moat"],"en":{"title":"Series or chaos? A test, not a taste war.","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats.","point":"A Formatted versus Chaotic test compares a recurring structure with multiple formats. It needs a shared editorial objective and documented variation.","body":["A series may improve operating consistency; a flexible account may explore more angles. Measure creative workload and concepts tested too. Otherwise you may compare a well-resourced system with an underfunded one. This protocol presumes no winner.","Archive the concepts actually published in each group. A chaotic account may appear stronger because it received the best subjects. A series may appear more stable because its variations were less ambitious. A creative record makes these differences discussable instead of hiding them behind a format label. The result should explain the tested systems, not imply that one loosely defined category has defeated another in every possible context."],"action":["Define fixed elements in each group.","Compare invested resources."],"trap":"One campaign’s outcome does not become a universal rule about formats.","quote":"Series or chaos? A test, not a taste war.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Series or chaos? A test, not a taste war.","text":"A Formatted versus Chaotic test compares a recurring structure with multiple formats.","media":"/images/editorial/formatted-vs-chaotic.jpg"},{"label":"THE CONCEPT","title":"Formatted vs chaotic","text":"A Formatted versus Chaotic test compares a recurring structure with multiple formats. It needs a shared editorial objective and documented variation.","media":"/images/editorial/formatted-vs-chaotic.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"One campaign’s outcome does not become a universal rule about formats.","media":"/images/editorial/formatted-vs-chaotic.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define fixed elements in each group.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/formatted-vs-chaotic.jpg"},{"label":"PUT IT TO WORK / 2","title":"Compare invested resources.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/formatted-vs-chaotic.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/formatted-vs-chaotic.jpg","width":1280,"height":843,"alt":{"en":"An upward view through the sweeping spiral staircase at the Vatican Museums."},"credit":"Colin","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 26b9dc66ea2c1b295e5c1834a652b763214cad24.","source":"https://commons.wikimedia.org/wiki/File:Vatican_Museums_Spiral_Staircase_Looking_Up_2012.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"067","slug":"creative-diversity-test","term":"Creative diversity","category":"lab","kind":"protocol","image":"creative-diversity-test","tier":"operating","evidence":"hypothesis","sources":[],"related":["native-features-test","formatted-vs-chaotic","distribution-is-the-moat"],"en":{"title":"Diversity also lives in what you learn.","dek":"A creative-diversity test examines meaningful variation rather than counting files.","point":"A creative-diversity test examines meaningful variation rather than counting files. It connects concepts with outcomes and their stability.","body":["Label angles, personas and situations before examining performance. Compare similar-volume groups with documented diversity differences. Keep costs visible: more angles may require more design work. Ask whether the difference improves useful learning, not merely outcome dispersion.","A blind review can help: hide results and ask several people to classify creative work using the taxonomy. Disagreements expose vague categories. This does not measure marketing impact, but checks whether the definition of diversity can be applied without already knowing winners. Keep ambiguous cases visible and revise the coding guide before using those categories to explain performance or allocate the next production budget."],"action":["Define a simple creative taxonomy.","Measure outcomes and design effort."],"trap":"A taxonomy invented after reading results can rationalize successes.","quote":"Diversity also lives in what you learn.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Diversity also lives in what you learn.","text":"A creative-diversity test examines meaningful variation rather than counting files.","media":"/images/editorial/creative-diversity-test.jpg"},{"label":"THE CONCEPT","title":"Creative diversity","text":"A creative-diversity test examines meaningful variation rather than counting files. It connects concepts with outcomes and their stability.","media":"/images/editorial/creative-diversity-test.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A taxonomy invented after reading results can rationalize successes.","media":"/images/editorial/creative-diversity-test.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define a simple creative taxonomy.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-diversity-test.jpg"},{"label":"PUT IT TO WORK / 2","title":"Measure outcomes and design effort.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-diversity-test.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/creative-diversity-test.jpg","width":1280,"height":676,"alt":{"en":"Colorful figures and decorative panels in a stained glass cathedral window."},"credit":"Pudelek; retouch by Albertus teolog","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: ab2b78f70b4197eba0649f9c964509668fa28271.","source":"https://commons.wikimedia.org/wiki/File:St_Vitus_Cathedral_-_Stained_glass_(retouch).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"068","slug":"native-features-test","term":"Native features","category":"lab","kind":"protocol","image":"native-features-test","tier":"operating","evidence":"hypothesis","sources":[],"related":["zero-view-rate","creative-diversity-test","distribution-is-the-moat"],"en":{"title":"Maybe it is not native. Maybe it is the feature.","dek":"A native-feature test separates a feature’s effect from its publishing channel.","point":"A native-feature test separates a feature’s effect from its publishing channel. Comparing whole workflows does not always allow that separation.","body":["If one group uses audio or formatting absent from the other, treatment no longer concerns upload method alone. Document features precisely. Depending on the question, accept that bundle of differences or design a narrower test. State honestly what the comparison measures.","A protocol may deliberately compare two complete experiences when that is the team’s actual decision. Name the treatment accordingly. The aim is not to remove all complexity but to avoid a narrow conclusion from a broad test. Keep the result’s wording at the scale of what changed. A workflow comparison can be practically useful without identifying the isolated contribution of every feature inside it."],"action":["Inventory feature differences.","Choose a feature test or a workflow test."],"trap":"A gap between workflows does not identify which component produced the effect.","quote":"Maybe it is not native. Maybe it is the feature.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Maybe it is not native. Maybe it is the feature.","text":"A native-feature test separates a feature’s effect from its publishing channel.","media":"/images/editorial/native-features-test.jpg"},{"label":"THE CONCEPT","title":"Native features","text":"A native-feature test separates a feature’s effect from its publishing channel. Comparing whole workflows does not always allow that separation.","media":"/images/editorial/native-features-test.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A gap between workflows does not identify which component produced the effect.","media":"/images/editorial/native-features-test.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Inventory feature differences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-features-test.jpg"},{"label":"PUT IT TO WORK / 2","title":"Choose a feature test or a workflow test.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/native-features-test.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/native-features-test.jpg","width":1280,"height":824,"alt":{"en":"Camera lenses of different sizes and focal lengths arranged on a shelf."},"credit":"Carlos Valenzuela Montuy","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 64ce48e9dc3b2aa2cc7497d42862acec291b1373.","source":"https://commons.wikimedia.org/wiki/File:Photographic_lenses_and_tubes_2025.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"069","slug":"zero-view-rate","term":"Zero-view rate","category":"lab","kind":"protocol","image":"zero-view-rate","tier":"operating","evidence":"hypothesis","sources":[],"related":["confidence-intervals","native-features-test","distribution-is-the-moat"],"en":{"title":"A zero rate deserves a complete definition.","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope.","point":"Zero-view rate depends on observation age, measurement source and eligibility scope. Missing data must remain separate.","body":["Count genuinely published posts observable at the selected window. Separate null values, collection failures and posts too young to evaluate. Show raw counts. A rate declining because a tool no longer retrieves problematic accounts does not necessarily indicate improvement.","Check collection before raising a performance alert. If several accounts lose data simultaneously, the problem may sit in the measurement tool. Preserve useful technical responses and the last valid observation. This avoids launching editorial fixes for a counter that simply was not refreshed. The operational next step should follow the evidence available, while the actual distribution outcome remains unknown until a reliable observation can be made."],"action":["Set observation age and source.","Keep an unknown-data category."],"trap":"Observed zero, missing zero and assumed zero are not interchangeable.","quote":"A zero rate deserves a complete definition.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A zero rate deserves a complete definition.","text":"Zero-view rate depends on observation age, measurement source and eligibility scope.","media":"/images/editorial/zero-view-rate.jpg"},{"label":"THE CONCEPT","title":"Zero-view rate","text":"Zero-view rate depends on observation age, measurement source and eligibility scope. Missing data must remain separate.","media":"/images/editorial/zero-view-rate.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Observed zero, missing zero and assumed zero are not interchangeable.","media":"/images/editorial/zero-view-rate.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Set observation age and source.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/zero-view-rate.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep an unknown-data category.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/zero-view-rate.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/zero-view-rate.jpg","width":1280,"height":853,"alt":{"en":"An empty swimming pool stands beside rubble at a demolished motel."},"credit":"Michael Rivera","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: f4de30510a8975e36ee0c17fdab5f9935d2799bb.","source":"https://commons.wikimedia.org/wiki/File:Empty_swimming_pool_in_front_of_demolished_Western_Motel,_Valdosta.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"070","slug":"confidence-intervals","term":"Uncertainty","category":"lab","kind":"protocol","image":"confidence-intervals","tier":"operating","evidence":"hypothesis","sources":[],"related":["survivorship-bias","zero-view-rate","distribution-is-the-moat"],"en":{"title":"Uncertainty is part of the result.","dek":"An interval expresses uncertainty under a method’s assumptions.","point":"An interval expresses uncertainty under a method’s assumptions. It does not fix a poor sample, incomplete measurement or confounding.","body":["Before choosing a formula, identify the independent unit: post, account or campaign. Posts from one account may share common factors. Treating all of them as independent can look overly precise. Publish the method, assumptions and data beyond its reach.","Explain what the interval does not cover: collection errors, selection bias or a changed definition may sit outside its calculation. Readers should distinguish statistical uncertainty from overall measurement quality. This makes a result less dramatic but more useful when deciding whether to act or measure better. Numerical precision should not suppress the practical question of whether the underlying observations represent the population and outcome being discussed."],"action":["Define the unit of analysis.","Explain the method and assumptions."],"trap":"A narrow interval does not guarantee a properly framed causal question.","quote":"Uncertainty is part of the result.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Uncertainty is part of the result.","text":"An interval expresses uncertainty under a method’s assumptions.","media":"/images/editorial/confidence-intervals.jpg"},{"label":"THE CONCEPT","title":"Uncertainty","text":"An interval expresses uncertainty under a method’s assumptions. It does not fix a poor sample, incomplete measurement or confounding.","media":"/images/editorial/confidence-intervals.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A narrow interval does not guarantee a properly framed causal question.","media":"/images/editorial/confidence-intervals.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the unit of analysis.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/confidence-intervals.jpg"},{"label":"PUT IT TO WORK / 2","title":"Explain the method and assumptions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/confidence-intervals.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/confidence-intervals.jpg","width":1280,"height":853,"alt":{"en":"Mist drifts across a still mountain lake around the silhouette of a small tree."},"credit":"Bernd Thaller","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: abf225ea99a36441f354adb2bc92f24ea474854f.","source":"https://commons.wikimedia.org/wiki/File:Receding_Fog_over_Lake_Altaussee.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"071","slug":"survivorship-bias","term":"Survivorship bias","category":"lab","kind":"protocol","image":"survivorship-bias","tier":"operating","evidence":"hypothesis","sources":[],"related":["regression-to-mean","confidence-intervals","distribution-is-the-moat"],"en":{"title":"The missing accounts had results too.","dek":"Survivorship bias appears when analysis retains only still-visible units.","point":"Survivorship bias appears when analysis retains only still-visible units. A network evaluated without abandoned accounts can look artificially strong.","body":["Keep exit reasons and last observed dates. Separate intentionally stopped, inaccessible and uncollected accounts. Portfolio analysis should begin with an initial cohort and explain what happened to it. Surviving assets answer a different question from the original investment.","Show a small cohort-status table: still active, intentionally stopped, inaccessible and unknown. Categories should reflect verified facts and dates. This explains why counts decline and prevents strong survivor outcomes from being presented as returns across every account originally launched. Keep unknown states separate instead of assigning a convenient reason for disappearance. The incomplete history is itself a limitation of what the final performance comparison can claim."],"action":["Freeze the initial cohort.","Record exits and their costs."],"trap":"Lost data must not be invented; report the coverage limitation.","quote":"The missing accounts had results too.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The missing accounts had results too.","text":"Survivorship bias appears when analysis retains only still-visible units.","media":"/images/editorial/survivorship-bias.jpg"},{"label":"THE CONCEPT","title":"Survivorship bias","text":"Survivorship bias appears when analysis retains only still-visible units. A network evaluated without abandoned accounts can look artificially strong.","media":"/images/editorial/survivorship-bias.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Lost data must not be invented; report the coverage limitation.","media":"/images/editorial/survivorship-bias.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Freeze the initial cohort.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/survivorship-bias.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record exits and their costs.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/survivorship-bias.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/survivorship-bias.jpg","width":1280,"height":853,"alt":{"en":"The rusted hull of a shipwreck rests in the surf off a sandy beach."},"credit":"Ximonic (Simo Räsänen)","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 06bc209cac48bb2a2a4f1a66a004ae8a68c74102.","source":"https://commons.wikimedia.org/wiki/File:Wreck_of_Cabo_de_Santa_Maria,_2010_December_-_4.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"072","slug":"regression-to-mean","term":"Regression to the mean","category":"lab","kind":"protocol","image":"regression-to-mean","tier":"operating","evidence":"hypothesis","sources":[],"related":["cohort-maturity","survivorship-bias","distribution-is-the-moat"],"en":{"title":"After a hit, returning to earth is not always a failure.","dek":"An extreme outcome can be followed by more ordinary outcomes.","point":"An extreme outcome can be followed by more ordinary outcomes. This possibility cautions against attributing every decline to the latest decision.","body":["After an exceptional post, compare subsequent output with the full history rather than the peak alone. Keep a change timeline. A new hook may coincide with a decline without causing it. Evaluating a change requires a suitable comparison, not the memory of the best day.","A review can show three references: the period before the hit, the hit itself and subsequent posts. This sometimes slows a premature diagnosis. It proves no cause, but reveals whether later results resemble ordinary activity more than an unprecedented collapse. Documented incidents still need separate investigation. The objective is to keep an exceptional observation from becoming the only standard against which every future post is judged."],"action":["Compare with a stable baseline.","Separate ordinary variation from verified incidents."],"trap":"This possible phenomenon should not be used to dismiss a real technical deterioration.","quote":"After a hit, returning to earth is not always a failure.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"After a hit, returning to earth is not always a failure.","text":"An extreme outcome can be followed by more ordinary outcomes.","media":"/images/editorial/regression-to-mean.jpg"},{"label":"THE CONCEPT","title":"Regression to the mean","text":"An extreme outcome can be followed by more ordinary outcomes. This possibility cautions against attributing every decline to the latest decision.","media":"/images/editorial/regression-to-mean.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This possible phenomenon should not be used to dismiss a real technical deterioration.","media":"/images/editorial/regression-to-mean.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Compare with a stable baseline.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/regression-to-mean.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate ordinary variation from verified incidents.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/regression-to-mean.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/regression-to-mean.jpg","width":1170,"height":1600,"alt":{"en":"An ornate antique pendulum clock with a white face and carved gold decoration."},"credit":"Christoph Braun","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b886568db215861a1a91c3da842925a719a0dd4c.","source":"https://commons.wikimedia.org/wiki/File:Pendulum_clock_by_Jacob_Kock,_antique_furniture_photography,_IMG_0931_edit.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"073","slug":"cohort-maturity","term":"Cohort maturity","category":"lab","kind":"protocol","image":"cohort-maturity","tier":"operating","evidence":"hypothesis","sources":[],"related":["attribution","regression-to-mean","distribution-is-the-moat"],"en":{"title":"Day seven does not exist for yesterday’s visitor.","dek":"Day-seven conversion should cover people given seven full days to convert.","point":"Day-seven conversion should cover people given seven full days to convert. Mixing mature and recent cohorts distorts comparisons.","body":["Define journey start and conversion. Compare cohorts at equal ages while showing missing data. Monthly purchases divided by monthly visits is not automatically a cohort conversion rate: buyers may have arrived long before the displayed window.","For daily cohorts, keep entry date and measurement cutoff. A table can show recent cohorts without calculating their final rate. This preserves visibility into new activity while protecting comparisons. Immature data is not bad data; it simply concerns a question whose full observation time has not elapsed. Make that distinction visible rather than silently including recent arrivals in a denominator they have not had time to complete."],"action":["Choose the starting event and outcome.","Exclude immature journeys from day-seven rates."],"trap":"A purchase during a period is not necessarily attributable to a visit in that period.","quote":"Day seven does not exist for yesterday’s visitor.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Day seven does not exist for yesterday’s visitor.","text":"Day-seven conversion should cover people given seven full days to convert.","media":"/images/editorial/cohort-maturity.jpg"},{"label":"THE CONCEPT","title":"Cohort maturity","text":"Day-seven conversion should cover people given seven full days to convert. Mixing mature and recent cohorts distorts comparisons.","media":"/images/editorial/cohort-maturity.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A purchase during a period is not necessarily attributable to a visit in that period.","media":"/images/editorial/cohort-maturity.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose the starting event and outcome.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/cohort-maturity.jpg"},{"label":"PUT IT TO WORK / 2","title":"Exclude immature journeys from day-seven rates.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/cohort-maturity.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/cohort-maturity.jpg","width":1280,"height":853,"alt":{"en":"A small tomato seedling pushes two green leaves above dry brown soil."},"credit":"Ksheera Piraati","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 4f0a3b5f6801bc6c97e59c31a53e6d0adbc51709.","source":"https://commons.wikimedia.org/wiki/File:Young_seedling_of_tomato_emerging_from_soil_-_India.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"074","slug":"attribution","term":"Attribution","category":"lab","kind":"protocol","image":"attribution","tier":"operating","evidence":"hypothesis","sources":[],"related":["views-to-buyers","cohort-maturity","distribution-is-the-moat"],"en":{"title":"A UTM tells you about the click. Not the whole story.","dek":"Campaign parameters describe an instrumented origin.","point":"Campaign parameters describe an instrumented origin. They do not alone prove a piece of content caused a purchase decision.","body":["Keep first touch, last link and customer-declared source separate. A personal recommendation may precede a tagged visit. Do not erase that nuance in one number. Unattributed share remains unknown; it is neither failure nor hidden success to claim.","This publication’s TokPortal links carry an editorial source and article identifier. They help recognize some visits, not reconstruct every prior exposure. A reader may return without parameters or on another device. Reporting should state coverage and avoid treating identifiable visits as the entirety of influence. Equally, unattributed outcomes should not be claimed for the publication merely because its content could theoretically have contributed earlier in the journey."],"action":["Name each attribution view precisely.","Deduplicate buyers across content."],"trap":"Adding assisted conversions from several articles can count the same customer repeatedly.","quote":"A UTM tells you about the click. Not the whole story.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A UTM tells you about the click. Not the whole story.","text":"Campaign parameters describe an instrumented origin.","media":"/images/editorial/attribution.jpg"},{"label":"THE CONCEPT","title":"Attribution","text":"Campaign parameters describe an instrumented origin. They do not alone prove a piece of content caused a purchase decision.","media":"/images/editorial/attribution.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Adding assisted conversions from several articles can count the same customer repeatedly.","media":"/images/editorial/attribution.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Name each attribution view precisely.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attribution.jpg"},{"label":"PUT IT TO WORK / 2","title":"Deduplicate buyers across content.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attribution.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/attribution.jpg","width":1280,"height":853,"alt":{"en":"Several railway tracks branch and converge between signals and overhead lines."},"credit":"Jim.henderson","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 91b61c40a65e86a0dbd42d4884667e2ae8eee52b.","source":"https://commons.wikimedia.org/wiki/File:South_Hills_Junction_tracks_jeh.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"075","slug":"views-to-buyers","term":"Views to buyers","category":"lab","kind":"protocol","image":"views-to-buyers","tier":"operating","evidence":"hypothesis","sources":[],"related":["experiment-preregistration","attribution","distribution-is-the-moat"],"en":{"title":"A million views can miss the problem.","dek":"Views measure exposure under the platform’s definition.","point":"Views measure exposure under the platform’s definition. New buyers measure a separate commercial outcome requiring its own definition and source.","body":["Track movement from content to visit, use and purchase without assuming everyone is identifiable. For first purchases, exclude renewals and tests under documented rules. More views may still support awareness; they should not be renamed customer growth.","An article can support several goals: understanding, operator recruitment or product discovery. Define which one is being evaluated before rewriting its CTA. A page without directly attributed purchases may still provide real value. The trap is confusing that possible value with an already demonstrated commercial outcome. Keep each objective and evidence source separate so useful recruitment or learning paths are not erased by an overly narrow sales metric."],"action":["Define the intended commercial outcome.","Retain identity-matching limitations."],"trap":"An opened checkout or preview is not a real payment.","quote":"A million views can miss the problem.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A million views can miss the problem.","text":"Views measure exposure under the platform’s definition.","media":"/images/editorial/views-to-buyers.jpg"},{"label":"THE CONCEPT","title":"Views to buyers","text":"Views measure exposure under the platform’s definition. New buyers measure a separate commercial outcome requiring its own definition and source.","media":"/images/editorial/views-to-buyers.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An opened checkout or preview is not a real payment.","media":"/images/editorial/views-to-buyers.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the intended commercial outcome.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/views-to-buyers.jpg"},{"label":"PUT IT TO WORK / 2","title":"Retain identity-matching limitations.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/views-to-buyers.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/views-to-buyers.jpg","width":1023,"height":680,"alt":{"en":"People move through a crowded night market in Kenting."},"credit":"Guess Tsai@flickr","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 3538298b12dbad52a12cca4548073dcb7c69fb22.","source":"https://commons.wikimedia.org/wiki/File:Crowd_at_the_Kenting_Night_Market_20100925.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"076","slug":"experiment-preregistration","term":"Preregistration","category":"lab","kind":"protocol","image":"experiment-preregistration","tier":"operating","evidence":"hypothesis","sources":[],"related":["stop-rules","views-to-buyers","distribution-is-the-moat"],"en":{"title":"Write possible verdicts before knowing the score.","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance.","point":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance. It limits stories reconstructed after observation.","body":["A dated document is enough to begin: hypothesis, groups, duration, primary metric, exclusions and expected decision. You can modify the plan when reality demands it, provided the previous version and explanation remain. Exploration is still possible; label it as exploration.","Add an acceptable conclusion for each outcome: favorable signal, uncertain difference or measurement failure. This often exposes protocols that have no response to negative results. A useful experiment should remain informative when it contradicts the initial plan. Otherwise it mainly produces retrospective justification. Recording these possibilities also helps reviewers distinguish the intended decision from additional questions discovered while the experiment was already underway."],"action":["Freeze a plan version before collection.","Log departures and exploratory analyses."],"trap":"Preregistering a poor protocol does not validate it; it makes its choices visible.","quote":"Write possible verdicts before knowing the score.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Write possible verdicts before knowing the score.","text":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance.","media":"/images/editorial/experiment-preregistration.jpg"},{"label":"THE CONCEPT","title":"Preregistration","text":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance. It limits stories reconstructed after observation.","media":"/images/editorial/experiment-preregistration.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Preregistering a poor protocol does not validate it; it makes its choices visible.","media":"/images/editorial/experiment-preregistration.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Freeze a plan version before collection.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/experiment-preregistration.jpg"},{"label":"PUT IT TO WORK / 2","title":"Log departures and exploratory analyses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/experiment-preregistration.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/experiment-preregistration.jpg","width":1280,"height":853,"alt":{"en":"Gloved hands write experimental observations in an open laboratory notebook."},"credit":"Katherine Stember","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: ccc145165e1317324120da4f6b9bea5c40079bd7.","source":"https://commons.wikimedia.org/wiki/File:Lab_Notebook.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"077","slug":"stop-rules","term":"Stop rules","category":"lab","kind":"protocol","image":"stop-rules","tier":"operating","evidence":"hypothesis","sources":[],"related":["evidence-ladder","experiment-preregistration","distribution-is-the-moat"],"en":{"title":"Knowing when to stop is part of the test.","dek":"A stop rule specifies when to end, pause or reconsider an experiment.","point":"A stop rule specifies when to end, pause or reconsider an experiment. It should account for expected information and operational constraints.","body":["Set a duration limit and incidents requiring a pause: missing data, wrong assets, changed scope. Stopping as soon as a number looks attractive can select favorable noise. Continuing indefinitely until success appears is no better method.","A pause for an incorrect file should preserve valid observations and identify affected posts. Do not automatically merge results before and after correction. Depending on the change, continue, restart part of the test or accept a limited conclusion. The stop rule protects interpretation as well as budget. Record who made the decision and why so a later reviewer can understand whether the final dataset still answers the original question."],"action":["Define deadline and pause criteria.","Separate operational stopping from statistical conclusions."],"trap":"An interrupted experiment need not have a verdict; it may simply be incomplete.","quote":"Knowing when to stop is part of the test.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Knowing when to stop is part of the test.","text":"A stop rule specifies when to end, pause or reconsider an experiment.","media":"/images/editorial/stop-rules.jpg"},{"label":"THE CONCEPT","title":"Stop rules","text":"A stop rule specifies when to end, pause or reconsider an experiment. It should account for expected information and operational constraints.","media":"/images/editorial/stop-rules.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An interrupted experiment need not have a verdict; it may simply be incomplete.","media":"/images/editorial/stop-rules.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define deadline and pause criteria.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/stop-rules.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate operational stopping from statistical conclusions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/stop-rules.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/stop-rules.jpg","width":1280,"height":853,"alt":{"en":"A rusted railway buffer and heavy bolts beside a moss-covered wooden sleeper."},"credit":"Dietmar Rabich","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b4d1327c14b2b9518d0812daf4f9dc941fcdf629.","source":"https://commons.wikimedia.org/wiki/File:Haltern_am_See,_Sythen,_ehemalige_Bahnstrecke_--_2022_--_9807.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"078","slug":"evidence-ladder","term":"Evidence ladder","category":"lab","kind":"protocol","image":"evidence-ladder","tier":"operating","evidence":"hypothesis","sources":[],"related":["viral-hit","stop-rules","distribution-is-the-moat"],"en":{"title":"A hypothesis needs a label, not a disguise.","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore.","point":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore. Every claim should retain provenance.","body":["Documentation may confirm a feature exists without proving its effect on reach. Internal observation may reveal a pattern without establishing a cause. Write the exact proposition supported by each source. Evidence level belongs to the claim, not author prestige or the number of links below it.","During review, underline verbs asserting a cause: increases, reduces, causes. Ask what evidence supports each one. A descriptive rewrite may be more accurate: a difference is observed and its cause remains unknown. This sentence-level work is more useful than a global “data-driven” badge above the article. Readers need to know which proposition a source actually supports, especially when one paragraph combines documented features with untested performance hypotheses."],"action":["Attach a source or label to each claim.","Keep unmeasured effects unknown."],"trap":"A promotional source does not become independent because another publication cites it.","quote":"A hypothesis needs a label, not a disguise.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A hypothesis needs a label, not a disguise.","text":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore.","media":"/images/editorial/evidence-ladder.jpg"},{"label":"THE CONCEPT","title":"Evidence ladder","text":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore. Every claim should retain provenance.","media":"/images/editorial/evidence-ladder.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A promotional source does not become independent because another publication cites it.","media":"/images/editorial/evidence-ladder.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach a source or label to each claim.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/evidence-ladder.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep unmeasured effects unknown.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/evidence-ladder.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/evidence-ladder.jpg","width":1080,"height":607,"alt":{"en":"Rough stone steps climb between large rocks and green plants."},"credit":"RedRyan101","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 94a102430cb60ab7c908d2ed9ea3509f3b61f39f.","source":"https://commons.wikimedia.org/wiki/File:Stone_stairs.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"079","slug":"ai-agd","term":"AI AGD","category":"machines","kind":"guide","image":"ai-agd","tier":"canonical","evidence":"editorial","sources":[],"related":["agentic-agd","agent-audit-log","distribution-is-the-moat"],"en":{"title":"AI can think about the system before filling the calendar.","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD.","point":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD. It does not imply fully autonomous execution.","body":["The first gain may be better idea classification rather than more videos. Ask an agent to find redundant concepts, overlooked audiences and unmeasured hypotheses. Compare its proposals with real context. A convincing list does not prove it understands your customers.","Give an agent ten briefs and ask where two accounts are saying the same thing. Require it to cite the relevant passages. This produces a checkable proposal rather than a general judgment. The value comes from decision support even if no additional post is produced. Keep corrections to its classification so later prompts can reflect the distinctions your team actually cares about."],"action":["Assign a bounded analytical task.","Verify classifications before using them."],"trap":"A model’s fluent writing can hide insufficient knowledge of actual conditions.","quote":"AI can think about the system before filling the calendar.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"AI can think about the system before filling the calendar.","text":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD.","media":"/images/editorial/ai-agd.jpg"},{"label":"THE CONCEPT","title":"AI AGD","text":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD. It does not imply fully autonomous execution.","media":"/images/editorial/ai-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A model’s fluent writing can hide insufficient knowledge of actual conditions.","media":"/images/editorial/ai-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Assign a bounded analytical task.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ai-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Verify classifications before using them.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ai-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/ai-agd.jpg","width":1280,"height":853,"alt":{"en":"A vintage mainframe computer with control buttons, reel storage, and cabinets of electronics."},"credit":"Pargon","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 4bca5422b5ac0db97ae1373679890f422c520f25.","source":"https://commons.wikimedia.org/wiki/File:Mainframe_Computer.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},{"id":"080","slug":"agentic-agd","term":"Agentic AGD","category":"machines","kind":"guide","image":"agentic-agd","tier":"canonical","evidence":"editorial","sources":[],"related":["human-api","ai-agd","distribution-is-the-moat"],"en":{"title":"A distribution agent is not a talking calendar.","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments.","point":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments. The agent operates within an explicitly defined scope.","body":["A useful agent knows which information is missing and which actions it may take. It can propose allocation, detect anomalies or prepare briefs. The loop should specify who approves budget changes and how execution stops. Without boundaries, an autonomy demo becomes operational debt.","Begin by having the agent propose the next experiment with supporting observations and limitations. A human can correct the plan before mutations occur. Keep those corrections because they expose still-implicit rules. The system becomes more autonomous when its rules are understood and checkable, not when approval is arbitrarily removed. This gives the team a concrete basis for expanding scope gradually."],"action":["Write the action scope.","Define exceptions that return to a human."],"trap":"An agent able to call a tool is not automatically authorized to use it live.","quote":"A distribution agent is not a talking calendar.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A distribution agent is not a talking calendar.","text":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments.","media":"/images/editorial/agentic-agd.jpg"},{"label":"THE CONCEPT","title":"Agentic AGD","text":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments. The agent operates within an explicitly defined scope.","media":"/images/editorial/agentic-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An agent able to call a tool is not automatically authorized to use it live.","media":"/images/editorial/agentic-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the action scope.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agentic-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define exceptions that return to a human.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agentic-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agentic-agd.jpg","width":1280,"height":720,"alt":{"en":"Yellow industrial robots handle kegs inside a brewery production area."},"credit":"Larry D. Moore","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 52b376103be14f0112d317a163fe9c74d08e6ffc.","source":"https://commons.wikimedia.org/wiki/File:Tour4_Spoetzl_Brewery_Shiner_Texas_2024.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"081","slug":"human-api","term":"Human API","category":"machines","kind":"guide","image":"human-api","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/"],"related":["mcp-orchestration","agentic-agd","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"Behind the API, someone actually opens the app.","dek":"A Human API exposes a software workflow partly executed by people.","point":"A Human API exposes a software workflow partly executed by people. In TokPortal’s context, orchestration and native interaction are separate layers.","body":["A call may create a mission rather than immediately publish a post. Integrations therefore need waiting, status and correction handling. Design around the real cycle: request received, work executed, result verified. Hiding latency behind instant success misrepresents what happened.","A client interface can show request accepted before publication verified. Add handling for delays and corrections. This matters for agents: they should not analyze a mission as though it were already a visible post. The software contract should respect the actual time of human work. Clear intermediate states make integrations more useful without promising instantaneous execution the underlying operation does not provide."],"action":["Separate acceptance from delivery.","Plan status feedback and correction handling."],"trap":"A successful HTTP response can confirm request creation without confirming final execution.","quote":"Behind the API, someone actually opens the app.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Behind the API, someone actually opens the app.","text":"A Human API exposes a software workflow partly executed by people.","media":"/images/editorial/human-api.jpg"},{"label":"THE CONCEPT","title":"Human API","text":"A Human API exposes a software workflow partly executed by people. In TokPortal’s context, orchestration and native interaction are separate layers.","media":"/images/editorial/human-api.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful HTTP response can confirm request creation without confirming final execution.","media":"/images/editorial/human-api.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Separate acceptance from delivery.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-api.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan status feedback and correction handling.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-api.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/human-api.jpg","width":1280,"height":960,"alt":{"en":"A worker operates an antique printing press inside a working print shop."},"credit":"Caelb375","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 2aa5baf9386557b730ec488a397287c9d71e5e4b.","source":"https://commons.wikimedia.org/wiki/File:Printing_at_Bay_View_Printing_Company.png","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},{"id":"082","slug":"mcp-orchestration","term":"MCP orchestration","category":"machines","kind":"guide","image":"mcp-orchestration","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["dry-run-contract","human-api","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"MCP connects tools. It does not write your strategy.","dek":"MCP lets an agent client discover and call tools exposed by a server.","point":"MCP lets an agent client discover and call tools exposed by a server. Its technical catalog still needs an objective and action boundaries.","body":["Read descriptions and annotations before composing a recipe. A read operation differs from paid creation. TokPortal’s documentation distinguishes local and remote servers. Choose transport for your environment and test the contract in preview before commercial execution.","A readable recipe names the intent before listing calls: prepare an account in a market, verify its state, organize publication. Each step should state what it requires from the previous one. Readers can then understand dependencies and see why synthetic preview identifiers must never pass into live operations. Tool availability is only one part of building a coherent, authorized workflow."],"action":["Discover the current catalog.","Separate read tools from mutations."],"trap":"A tool name is not enough to understand costs and side effects.","quote":"MCP connects tools. It does not write your strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"MCP connects tools. It does not write your strategy.","text":"MCP lets an agent client discover and call tools exposed by a server.","media":"/images/editorial/mcp-orchestration.jpg"},{"label":"THE CONCEPT","title":"MCP orchestration","text":"MCP lets an agent client discover and call tools exposed by a server. Its technical catalog still needs an objective and action boundaries.","media":"/images/editorial/mcp-orchestration.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A tool name is not enough to understand costs and side effects.","media":"/images/editorial/mcp-orchestration.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Discover the current catalog.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/mcp-orchestration.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate read tools from mutations.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/mcp-orchestration.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/mcp-orchestration.jpg","width":1280,"height":813,"alt":{"en":"Rows of terminals and connected wires on a telephone network patch panel."},"credit":"Dennis van Zuijlekom","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 48635187f29082eba162a0fa0936511cf975dcd3.","source":"https://commons.wikimedia.org/wiki/File:Krone_LSA-PLUS_Patch_Panel_(14672372192).png","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},{"id":"083","slug":"dry-run-contract","term":"Dry-run contract","category":"machines","kind":"guide","image":"dry-run-contract","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/sandbox/"],"related":["idempotency","mcp-orchestration","distribution-is-the-moat"],"tokportal":"sandbox","en":{"title":"A preview must know what it does not simulate.","dek":"A dry run validates a request without producing live effects under the service’s contract.","point":"A dry run validates a request without producing live effects under the service’s contract. It does not guarantee future capacity or outcomes.","body":["In TokPortal MCP, dry_run belongs at the top argument level, not inside body. The local version must support that contract. Read response fields for simulated and actual charges. Preview identifiers remain synthetic: moving live requires creating and using actual resources.","Show the mode, request and reported charges in the human-readable result. Do not say account created when the service only validated a preview. That wording prevents another agent from continuing work against an imaginary resource. The boundary should be both technical and understandable in the report, especially when output is copied into another task without the full execution history attached."],"action":["Check version and preview response.","Keep an explicit boundary before live execution."],"trap":"A successful preview neither authorizes spending nor reserves capacity.","quote":"A preview must know what it does not simulate.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A preview must know what it does not simulate.","text":"A dry run validates a request without producing live effects under the service’s contract.","media":"/images/editorial/dry-run-contract.jpg"},{"label":"THE CONCEPT","title":"Dry-run contract","text":"A dry run validates a request without producing live effects under the service’s contract. It does not guarantee future capacity or outcomes.","media":"/images/editorial/dry-run-contract.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful preview neither authorizes spending nor reserves capacity.","media":"/images/editorial/dry-run-contract.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check version and preview response.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/dry-run-contract.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep an explicit boundary before live execution.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/dry-run-contract.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/dry-run-contract.jpg","width":1280,"height":992,"alt":{"en":"Mary Jackson holds an aircraft model inside a wind tunnel at NASA Langley."},"credit":"NASA; restoration by Adam Cuerden","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 42976da6950d21d2f0ae93640659121b482a3bab.","source":"https://commons.wikimedia.org/wiki/File:Mary_Jackson_in_a_wind_tunnel_with_a_model_at_NASA_Langley.jpg","license":"Public domain","licenseUrl":"https://creativecommons.org/publicdomain/mark/1.0/"}},{"id":"084","slug":"idempotency","term":"Idempotency","category":"machines","kind":"guide","image":"idempotency","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["webhooks","dry-run-contract","distribution-is-the-moat"],"en":{"title":"Retry without ordering twice.","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract.","point":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract. It does not apply indiscriminately to every tool.","body":["After a timeout, do not assume nothing happened. Check state or reuse the same key for the same intent when supported. TokPortal documentation excludes some secret-bearing operations from replay. A fresh key on every retry defeats the protection you wanted.","Document what the application considers the same intent. Retrying after a lost response is not a new order; changing country or content may be. Make that distinction visible in the log. It prevents both costly duplicates and ambiguous replays after parameters change. When the service’s contract is unclear, inspect state before retrying rather than treating every timeout as proof of failure."],"action":["Keep one key per logical intent.","Review documented exceptions."],"trap":"Reusing a key for a different request can create contract ambiguity.","quote":"Retry without ordering twice.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Retry without ordering twice.","text":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract.","media":"/images/editorial/idempotency.jpg"},{"label":"THE CONCEPT","title":"Idempotency","text":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract. It does not apply indiscriminately to every tool.","media":"/images/editorial/idempotency.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Reusing a key for a different request can create contract ambiguity.","media":"/images/editorial/idempotency.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep one key per logical intent.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/idempotency.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review documented exceptions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/idempotency.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/idempotency.jpg","width":1280,"height":946,"alt":{"en":"Numbered mechanical counter wheels inside an analogue tape deck."},"credit":"Retired electrician","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e42ad2d38f4e8621abf96d9db7464bdb61b0c686.","source":"https://commons.wikimedia.org/wiki/File:Technics_RS-M270x_mechanical_counter.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"085","slug":"webhooks","term":"Webhooks","category":"machines","kind":"guide","image":"webhooks","tier":"operating","evidence":"editorial","sources":[],"related":["agent-budget","idempotency","distribution-is-the-moat"],"en":{"title":"A webhook reports an event. It does not replace your state.","dek":"A webhook sends an event to your integration.","point":"A webhook sends an event to your integration. Consumers should verify authenticity, handle repetition and reconcile state under the documented contract.","body":["Do not assume events arrive exactly once or in the expected order. Retain identifiers when provided and allow reading current state. Signing secrets belong in appropriate storage, not client code. Users then see progress grounded in verified events.","A consumer can retain the latest confirmed state and receipt time. If an event appears contradictory, reading source state can resolve it under the available contract. Keep an incident record without exposing the signing secret. Reliability is built in these recovery paths, not merely in receiving the first demonstration event. Test duplicate and delayed delivery cases before depending on the integration for unattended decisions."],"action":["Apply documented verification.","Plan deduplication and reconciliation."],"trap":"A received event is trustworthy only after service-appropriate checks.","quote":"A webhook reports an event. It does not replace your state.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A webhook reports an event. It does not replace your state.","text":"A webhook sends an event to your integration.","media":"/images/editorial/webhooks.jpg"},{"label":"THE CONCEPT","title":"Webhooks","text":"A webhook sends an event to your integration. Consumers should verify authenticity, handle repetition and reconcile state under the documented contract.","media":"/images/editorial/webhooks.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A received event is trustworthy only after service-appropriate checks.","media":"/images/editorial/webhooks.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Apply documented verification.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/webhooks.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan deduplication and reconciliation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/webhooks.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/webhooks.jpg","width":1280,"height":853,"alt":{"en":"A vintage telegraph machine and its brass components displayed on a wooden base."},"credit":"Homoatrox","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e87da8fd61b405505186536d68723e07cd1b94f9.","source":"https://commons.wikimedia.org/wiki/File:Telegraph_machine_in_DOSAAF_museum_(Minsk).jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"086","slug":"agent-budget","term":"Agent budgets","category":"machines","kind":"guide","image":"agent-budget","tier":"operating","evidence":"editorial","sources":[],"related":["agent-maturity","webhooks","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"An agent without a ceiling has no budget.","dek":"An agent budget defines authorized operations, limits and renewal conditions.","point":"An agent budget defines authorized operations, limits and renewal conditions. It should distinguish immediate spending, recurring charges and estimates.","body":["Read current prices and account state before proposing a plan. Preview prepares a decision; authorization defines what can execute. Keep estimated and actual spending separate. A loop restarting tasks after errors should still respect the original ceiling.","An approval interface can separate immediate cost from estimated recurring commitment and identify anything not priced. A human then approves a concrete scope. If the plan changes, compare its new cost with that authorization rather than assuming the first approval covers every future extension. Preserve the original scope in the log so later retries and revisions can be assessed against the same boundary."],"action":["Define scope, ceiling and duration.","Stop mutations when the limit is reached."],"trap":"An available balance is not authorization to spend all of it.","quote":"An agent without a ceiling has no budget.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An agent without a ceiling has no budget.","text":"An agent budget defines authorized operations, limits and renewal conditions.","media":"/images/editorial/agent-budget.jpg"},{"label":"THE CONCEPT","title":"Agent budgets","text":"An agent budget defines authorized operations, limits and renewal conditions. It should distinguish immediate spending, recurring charges and estimates.","media":"/images/editorial/agent-budget.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An available balance is not authorization to spend all of it.","media":"/images/editorial/agent-budget.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define scope, ceiling and duration.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-budget.jpg"},{"label":"PUT IT TO WORK / 2","title":"Stop mutations when the limit is reached.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-budget.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agent-budget.jpg","width":1280,"height":850,"alt":{"en":"A wall covered with electricity meters, junction boxes, and cables in Kolkata."},"credit":"Jorge Royan","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 9fd2f2f167bccd31d986f87d485e162e7cd15e8d.","source":"https://commons.wikimedia.org/wiki/File:India_-_Kolkata_electricity_meters_-_3832.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"087","slug":"agent-maturity","term":"AGD maturity model","category":"machines","kind":"guide","image":"agent-maturity","tier":"operating","evidence":"editorial","sources":[],"related":["api-slop","agent-budget","distribution-is-the-moat"],"en":{"title":"Autonomy is a ladder, not a switch.","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy.","point":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy. Levels describe responsibility, not medals.","body":["A team can be advanced in analysis and manual in publishing. Identify decisions delegated to the system and human recovery options. Moving up only helps if control quality follows. Keeping spending approval can remain rational even when briefs are fully automated.","For every stage, ask how an error is detected and who can correct it. Reversible creative classification and live purchasing have different consequences. You can therefore delegate them differently without inconsistency. The maturity model makes those choices explicit instead of pushing the whole organization toward a maximum level. Operational readiness matters more than how autonomous the workflow sounds in a presentation."],"action":["Map responsibility at each step.","Automate where errors can be detected and recovered."],"trap":"The most autonomous level is not necessarily best for every organization.","quote":"Autonomy is a ladder, not a switch.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Autonomy is a ladder, not a switch.","text":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy.","media":"/images/editorial/agent-maturity.jpg"},{"label":"THE CONCEPT","title":"AGD maturity model","text":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy. Levels describe responsibility, not medals.","media":"/images/editorial/agent-maturity.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The most autonomous level is not necessarily best for every organization.","media":"/images/editorial/agent-maturity.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Map responsibility at each step.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-maturity.jpg"},{"label":"PUT IT TO WORK / 2","title":"Automate where errors can be detected and recovered.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-maturity.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agent-maturity.jpg","width":1280,"height":3090,"alt":{"en":"A tall metal escape ladder with a protective cage beside a building."},"credit":"Frank C. Müller","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 140892ac870d0b5d45c28cc5b523aa6a5fecfdcf.","source":"https://commons.wikimedia.org/wiki/File:Fluchtleiter_(fcm).jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"088","slug":"api-slop","term":"API Slop","category":"machines","kind":"guide","image":"api-slop","tier":"editorial","evidence":"editorial","sources":[],"related":["content-routing","agent-maturity","distribution-is-the-moat"],"en":{"title":"Your API is not a distribution strategy.","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context.","point":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context. It targets strategy, not APIs themselves.","body":["An API can orchestrate human execution, manage approvals or make outcomes readable. Trouble starts when technical ease becomes the sole publishing criterion. Ask each delivery: why this content on this account? If the answer is only “because we can,” pause the queue.","A queue rule can reject an asset when no account rationale is supplied. Rejection does not prove the content is bad; it means its destination is unexplained. This useful friction prevents easy delivery from becoming editorial policy. The team can correct routing or revisit the idea before creating more versions. Automation then protects a meaningful decision instead of multiplying an unexamined one."],"action":["Attach an editorial rationale to each routing choice.","Reject duplication without distinct value."],"trap":"API does not mean poor reach; no general penalty is demonstrated here.","quote":"Your API is not a distribution strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your API is not a distribution strategy.","text":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context.","media":"/images/editorial/api-slop.jpg"},{"label":"THE CONCEPT","title":"API Slop","text":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context. It targets strategy, not APIs themselves.","media":"/images/editorial/api-slop.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"API does not mean poor reach; no general penalty is demonstrated here.","media":"/images/editorial/api-slop.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach an editorial rationale to each routing choice.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/api-slop.jpg"},{"label":"PUT IT TO WORK / 2","title":"Reject duplication without distinct value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/api-slop.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/api-slop.jpg","width":1280,"height":721,"alt":{"en":"A dense tangle of cables running through a service shaft."},"credit":"Dmitry G","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 6391382f4065ce09c9bf83beda2b64ca4092f673.","source":"https://commons.wikimedia.org/wiki/File:Cable_salad_in_shaft.JPG","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"089","slug":"content-routing","term":"Content routing","category":"machines","kind":"guide","image":"content-routing","tier":"operating","evidence":"editorial","sources":[],"related":["creative-clustering","api-slop","distribution-is-the-moat"],"en":{"title":"Good content can land on the wrong account.","dek":"Routing connects creative work to an account by audience, persona, market and purpose.","point":"Routing connects creative work to an account by audience, persona, market and purpose. It is an editorial decision before a technical operation.","body":["An agent can propose matches from metadata but should be able to abstain. Expert content does not automatically suit a student account because the product is the same. Keep a short rationale and rejection criteria. Difficult routing often reveals insufficiently distinct account briefs.","Keep the assignment rationale with the post. During review, compare obvious matches with uncertain ones. This can improve briefs or taxonomy instead of prompting blind account changes. A useful routing record explains why the content was placed there at decision time even if outcomes disappoint. It prevents hindsight from rewriting the original reason and makes the next matching decision easier to evaluate."],"action":["Define eligibility criteria.","Explicitly allow no suitable account."],"trap":"Forcing a match everywhere turns a library into a duplication engine.","quote":"Good content can land on the wrong account.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Good content can land on the wrong account.","text":"Routing connects creative work to an account by audience, persona, market and purpose.","media":"/images/editorial/content-routing.jpg"},{"label":"THE CONCEPT","title":"Content routing","text":"Routing connects creative work to an account by audience, persona, market and purpose. It is an editorial decision before a technical operation.","media":"/images/editorial/content-routing.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Forcing a match everywhere turns a library into a duplication engine.","media":"/images/editorial/content-routing.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define eligibility criteria.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-routing.jpg"},{"label":"PUT IT TO WORK / 2","title":"Explicitly allow no suitable account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-routing.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/content-routing.jpg","width":1280,"height":814,"alt":{"en":"A red and yellow railway switch lever beside branching tracks."},"credit":"W.carter","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 277cd29bdacbcd6cde447a2c17d6fa9aae9a42ed.","source":"https://commons.wikimedia.org/wiki/File:Railway_switch_lever_on_Gr%C3%B6t%C3%B6.jpg","license":"Public domain","licenseUrl":"https://creativecommons.org/publicdomain/mark/1.0/"}},{"id":"090","slug":"creative-clustering","term":"Creative clustering","category":"machines","kind":"guide","image":"creative-clustering","tier":"operating","evidence":"editorial","sources":[],"related":["anomaly-detection","content-routing","distribution-is-the-moat"],"en":{"title":"Group ideas without erasing their differences.","dek":"Creative clustering groups content under chosen criteria.","point":"Creative clustering groups content under chosen criteria. Groups should be interpretable and checked before informing allocation.","body":["A model may group videos by background while their promises differ. Define angle, format and situation. Review a sample of human-machine disagreements. The goal is not a perfect taxonomy but recoverable, useful creative decisions.","Use a few annotated examples as references and retain cases belonging to several groups. An ambiguous category is better than artificial precision. If the agent mostly classifies scenery, rewrite the instruction around the problem addressed. Grouping should help retrieve ideas rather than merely fill a metadata column. A small review set can reveal whether the labels preserve useful distinctions across genuinely different creative treatments."],"action":["Define each classification dimension.","Review ambiguous cases."],"trap":"Visual similarity does not prove similar intent or audience.","quote":"Group ideas without erasing their differences.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Group ideas without erasing their differences.","text":"Creative clustering groups content under chosen criteria.","media":"/images/editorial/creative-clustering.jpg"},{"label":"THE CONCEPT","title":"Creative clustering","text":"Creative clustering groups content under chosen criteria. Groups should be interpretable and checked before informing allocation.","media":"/images/editorial/creative-clustering.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Visual similarity does not prove similar intent or audience.","media":"/images/editorial/creative-clustering.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define each classification dimension.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-clustering.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review ambiguous cases.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-clustering.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/creative-clustering.jpg","width":1280,"height":851,"alt":{"en":"Small square mosaic tiles form a geometric pattern in warm pink and brown shades."},"credit":"Asturio Cantabrio","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 20f204ef32026a23142fa474e049e98a441a1058.","source":"https://commons.wikimedia.org/wiki/File:Mosaic_tile_works_ac_(1).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"091","slug":"anomaly-detection","term":"Anomaly detection","category":"machines","kind":"guide","image":"anomaly-detection","tier":"operating","evidence":"editorial","sources":[],"related":["human-review","creative-clustering","distribution-is-the-moat"],"en":{"title":"A useful alert tells you what to inspect.","dek":"Anomaly detection flags deviation from a defined baseline.","point":"Anomaly detection flags deviation from a defined baseline. It should distinguish collection issues, operating changes and distribution outcomes.","body":["Start with interpretable alerts: missing expected publication, delayed data, spending beyond limits. Add performance deviations with thresholds suited to variability. Every alert should include facts, period and next check. Dramatic notifications without context exhaust teams more than they protect them.","An alert saying data has not updated since the expected cutoff is more actionable than an unexplained red score. It identifies what to check before concluding that performance declined. Include the last reliable value and source. The operator then receives a small investigation ready to begin rather than vague concern to interpret. That specificity also helps distinguish measurement failures from genuine changes over time."],"action":["Attach a next check to every alert.","Measure false positives."],"trap":"An anomaly is an investigation signal, not an identified cause.","quote":"A useful alert tells you what to inspect.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A useful alert tells you what to inspect.","text":"Anomaly detection flags deviation from a defined baseline.","media":"/images/editorial/anomaly-detection.jpg"},{"label":"THE CONCEPT","title":"Anomaly detection","text":"Anomaly detection flags deviation from a defined baseline. It should distinguish collection issues, operating changes and distribution outcomes.","media":"/images/editorial/anomaly-detection.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An anomaly is an investigation signal, not an identified cause.","media":"/images/editorial/anomaly-detection.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach a next check to every alert.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/anomaly-detection.jpg"},{"label":"PUT IT TO WORK / 2","title":"Measure false positives.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/anomaly-detection.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/anomaly-detection.jpg","width":1280,"height":676,"alt":{"en":"An oscilloscope displays a bright cyan waveform on its screen."},"credit":"Pittigrilli","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: d96ff7da85e43d6db955879d46cdfb25af8152c7.","source":"https://commons.wikimedia.org/wiki/File:Tektronix_Oscilloscope_475A.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"092","slug":"human-review","term":"Human review","category":"machines","kind":"guide","image":"human-review","tier":"operating","evidence":"editorial","sources":[],"related":["source-of-truth","anomaly-detection","distribution-is-the-moat"],"en":{"title":"Human review should contain a real decision.","dek":"Useful human review exposes the action, consequences and evidence to check.","point":"Useful human review exposes the action, consequences and evidence to check. An approval button without context offers only an illusion of control.","body":["Show account, asset, text, cost and changes since the last version. Separate editorial approval from financial authorization. If everything is urgent, little gets reviewed. Reserve interruptions for decisions where an informed human can meaningfully change the outcome.","Review can highlight changes since the previous version rather than redisplay the entire dossier. A CTA change calls for a different decision from a market or cost change. This helps humans focus attention where it matters. Approval should remain attached to the version actually reviewed. If execution uses another version, the system should detect that mismatch rather than relying on a generic historical approval flag."],"action":["Show a concrete version for approval.","Define exactly what approval covers."],"trap":"A human in the loop does not prove they received enough information.","quote":"Human review should contain a real decision.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Human review should contain a real decision.","text":"Useful human review exposes the action, consequences and evidence to check.","media":"/images/editorial/human-review.jpg"},{"label":"THE CONCEPT","title":"Human review","text":"Useful human review exposes the action, consequences and evidence to check. An approval button without context offers only an illusion of control.","media":"/images/editorial/human-review.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A human in the loop does not prove they received enough information.","media":"/images/editorial/human-review.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Show a concrete version for approval.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-review.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define exactly what approval covers.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-review.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/human-review.jpg","width":1280,"height":720,"alt":{"en":"A small watchmaker’s lathe and precision tools arranged on a wooden workbench."},"credit":"Helge Klaus Rieder","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: cb4dd8d8f2b3704fe001b9f15e3859db0abaaf46.","source":"https://commons.wikimedia.org/wiki/File:Roscheiderhof-lg1-uhrmacher-2a.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},{"id":"093","slug":"source-of-truth","term":"Source of truth","category":"machines","kind":"guide","image":"source-of-truth","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["seo-agd","human-review","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"Documentation that says no beats a page promising everything.","dek":"A technical source of truth describes an interface’s current capabilities.","point":"A technical source of truth describes an interface’s current capabilities. A broader marketing page may describe services not fully exposed through that interface.","body":["While preparing this publication, TokPortal MCP documentation stated that YouTube bundle creation was unavailable through the API. Examples should retain that limit even when other pages mention YouTube more broadly. Cite dated documentation and check the schema before proposing a command.","When pages disagree, record their URLs, date and the scope of each statement. A tutorial may need correction even when the broader service has not changed. For executable examples, the capability of the specific endpoint is decisive. This prevents older marketing copy from becoming an invalid command and makes the limitation understandable without implying that every other interface has exactly the same scope."],"action":["Check the scope of the interface being used.","Preserve explicit limitations in tutorials."],"trap":"A feature of the broader service is not necessarily available in every API or MCP tool.","quote":"Documentation that says no beats a page promising everything.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Documentation that says no beats a page promising everything.","text":"A technical source of truth describes an interface’s current capabilities.","media":"/images/editorial/source-of-truth.jpg"},{"label":"THE CONCEPT","title":"Source of truth","text":"A technical source of truth describes an interface’s current capabilities. A broader marketing page may describe services not fully exposed through that interface.","media":"/images/editorial/source-of-truth.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A feature of the broader service is not necessarily available in every API or MCP tool.","media":"/images/editorial/source-of-truth.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check the scope of the interface being used.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/source-of-truth.jpg"},{"label":"PUT IT TO WORK / 2","title":"Preserve explicit limitations in tutorials.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/source-of-truth.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/source-of-truth.jpg","width":1280,"height":960,"alt":{"en":"Wooden card catalog cabinets line an ornate room at the Bibliothèque Mazarine in Paris."},"credit":"Marie-Lan Nguyen","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: aa901e1af91616911bfefd4fb878f826cf0a4646.","source":"https://commons.wikimedia.org/wiki/File:Salle_des_catalogues_de_la_Bibliotheque_Mazarine_Paris.jpg","license":"CC BY 2.0 fr","licenseUrl":"https://creativecommons.org/licenses/by/2.0/fr/deed.en"}},{"id":"094","slug":"seo-agd","term":"SEO AGD","category":"machines","kind":"guide","image":"seo-agd","tier":"canonical","evidence":"editorial","sources":[],"related":["pseo-agd","source-of-truth","distribution-is-the-moat"],"en":{"title":"A video can have a second life in search.","dek":"SEO AGD explores social content and properties appearing in search engines and platform search.","point":"SEO AGD explores social content and properties appearing in search engines and platform search. This possibility guarantees neither indexing nor ranking.","body":["Start with a question the content actually answers. Make context explicit in the title, caption or available transcript. Check that the public page is accessible. Content should remain useful in the feed: turning every sentence into keyword repetition can harm it without improving discovery.","A social tutorial can lead to a longer explanation preserving steps and limitations. The page then extends the subject instead of copying the caption. Check that the link makes sense to a viewer discovering the video without knowing the brand. Search extends useful information; it should not justify pointless duplication. Keep each surface valuable in its own context while making the connection understandable."],"action":["Connect content to a specific intent.","Check public access and useful textual elements."],"trap":"Crawler accessibility does not guarantee indexing or citation.","quote":"A video can have a second life in search.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A video can have a second life in search.","text":"SEO AGD explores social content and properties appearing in search engines and platform search.","media":"/images/editorial/seo-agd.jpg"},{"label":"THE CONCEPT","title":"SEO AGD","text":"SEO AGD explores social content and properties appearing in search engines and platform search. This possibility guarantees neither indexing nor ranking.","media":"/images/editorial/seo-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Crawler accessibility does not guarantee indexing or citation.","media":"/images/editorial/seo-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect content to a specific intent.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/seo-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check public access and useful textual elements.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/seo-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/seo-agd.jpg","width":1280,"height":851,"alt":{"en":"The Mount Pleasant radio telescope dish stands beneath dramatic clouds."},"credit":"Noodle snacks","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 3a1c174c71682755dd6d3a18004c19581e92f287.","source":"https://commons.wikimedia.org/wiki/File:Mount_Pleasant_Radio_Telescope.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},{"id":"095","slug":"pseo-agd","term":"pSEO AGD","category":"machines","kind":"guide","image":"pseo-agd","tier":"canonical","evidence":"documented","sources":["https://developers.google.com/search/docs/essentials/spam-policies"],"related":["llm-quoting","seo-agd","distribution-is-the-moat"],"en":{"title":"Programmatic content needs a reason for every page.","dek":"pSEO AGD systematically organizes social content around distinct search intents.","point":"pSEO AGD systematically organizes social content around distinct search intents. Volume does not excuse redundant pages or posts.","body":["A question database can feed several formats when each answer brings a distinct application. Reject country or tool permutations that change nothing substantive. The system should block content without new information. Useful scale lives in structure and checks, not an obligation to fill a sitemap.","Add a distinct decision or problem field to the writing queue. Two subjects leading to the same example and answer may deserve one more complete page. The check can therefore reduce planned volume. That is healthy system behavior: covering an intent well beats multiplying its phrasings. Scaling should make meaningful coverage easier while preserving the ability to reject output that adds nothing for readers."],"action":["Deduplicate intents before writing.","Require specific value in each output."],"trap":"Google can treat mass production without added user value as abusive.","quote":"Programmatic content needs a reason for every page.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Programmatic content needs a reason for every page.","text":"pSEO AGD systematically organizes social content around distinct search intents.","media":"/images/editorial/pseo-agd.jpg"},{"label":"THE CONCEPT","title":"pSEO AGD","text":"pSEO AGD systematically organizes social content around distinct search intents. Volume does not excuse redundant pages or posts.","media":"/images/editorial/pseo-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Google can treat mass production without added user value as abusive.","media":"/images/editorial/pseo-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Deduplicate intents before writing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/pseo-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Require specific value in each output.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/pseo-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/pseo-agd.jpg","width":1280,"height":960,"alt":{"en":"Antique printing presses displayed in a room with tiled floors."},"credit":"Vis M","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: acd22a5143a3826240ee4c7c5e9cb05d628f1bd4.","source":"https://commons.wikimedia.org/wiki/File:Printing_press_05.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"096","slug":"llm-quoting","term":"LLM quoting","category":"machines","kind":"guide","image":"llm-quoting","tier":"operating","evidence":"editorial","sources":[],"related":["knowledge-graph","pseo-agd","distribution-is-the-moat"],"en":{"title":"To be cited, first be quotable.","dek":"Citable content clearly states a proposition, scope and provenance.","point":"Citable content clearly states a proposition, scope and provenance. Machine-oriented markup or files do not guarantee citation by an assistant.","body":["Place a self-contained definition near the start, then expand examples and limitations. Do not use an attractive number without a method. Keep sources accessible and text readable without mandatory interaction. A short answer can be extracted correctly when it already contains necessary qualifications.","Read the definition as if it were extracted alone. If an essential limitation appears six paragraphs later, the excerpt may distort the claim. Move the qualification closer. This also helps human readers scanning the page before deciding whether to read the full reasoning. Clear structure improves extractability without requiring a promise that any specific assistant will discover, select or cite the page."],"action":["Write a self-contained definition.","Attach provenance, date and limits."],"trap":"An llms.txt file can orient reading; no promise of adoption is made here.","quote":"To be cited, first be quotable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"To be cited, first be quotable.","text":"Citable content clearly states a proposition, scope and provenance.","media":"/images/editorial/llm-quoting.jpg"},{"label":"THE CONCEPT","title":"LLM quoting","text":"Citable content clearly states a proposition, scope and provenance. Machine-oriented markup or files do not guarantee citation by an assistant.","media":"/images/editorial/llm-quoting.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An llms.txt file can orient reading; no promise of adoption is made here.","media":"/images/editorial/llm-quoting.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a self-contained definition.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/llm-quoting.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach provenance, date and limits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/llm-quoting.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/llm-quoting.jpg","width":1280,"height":960,"alt":{"en":"Wooden letterpress blocks of different sizes arranged into a dense typographic pattern."},"credit":"Michellecornelison","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 7cc619ddea58b31ed187119b2477ae1fd51f29bb.","source":"https://commons.wikimedia.org/wiki/File:Wood_letterpress_type.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"097","slug":"knowledge-graph","term":"AGD content graph","category":"machines","kind":"guide","image":"knowledge-graph","tier":"operating","evidence":"documented","sources":["https://developers.google.com/search/docs/crawling-indexing/links-crawlable"],"related":["multilingual-seo","llm-quoting","distribution-is-the-moat"],"en":{"title":"A good link continues an idea.","dek":"An editorial graph connects parent concepts, neighbors and applications.","point":"An editorial graph connects parent concepts, neighbors and applications. Its usefulness comes from meaningful relationships, not automatically added link counts.","body":["Account Isolation naturally leads to Content Isolation: one differentiates accounts, the other what they publish. An MCP link fits when the reader moves into orchestration. Give anchors labels describing the next step. Crawlable links are still invitations addressed to a person first.","Avoid sending every article to the same three pages without reason. Relationships should follow the argument: a zero-view note leads to diagnosis and measurement quality, while a creative essay leads to personas and formats. The graph becomes navigable when every link announces a useful neighboring question. Automated suggestions can help, but should still be checked against what the source article actually discusses."],"action":["Connect parent, neighbors and practical application.","Avoid vague anchors."],"trap":"Internal linking does not compensate for articles lacking their own substance.","quote":"A good link continues an idea.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A good link continues an idea.","text":"An editorial graph connects parent concepts, neighbors and applications.","media":"/images/editorial/knowledge-graph.jpg"},{"label":"THE CONCEPT","title":"AGD content graph","text":"An editorial graph connects parent concepts, neighbors and applications. Its usefulness comes from meaningful relationships, not automatically added link counts.","media":"/images/editorial/knowledge-graph.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Internal linking does not compensate for articles lacking their own substance.","media":"/images/editorial/knowledge-graph.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect parent, neighbors and practical application.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/knowledge-graph.jpg"},{"label":"PUT IT TO WORK / 2","title":"Avoid vague anchors.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/knowledge-graph.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/knowledge-graph.jpg","width":1280,"height":719,"alt":{"en":"Old suspension bridge cables and metal remains stand among dense woodland vegetation."},"credit":"Rosser1954","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: acd6ffe8ea4180573853b3383994387b3cecec5a.","source":"https://commons.wikimedia.org/wiki/File:Old_Suspension_Bridge_cables,_Ballochmyle,_East_Ayrshire.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"098","slug":"multilingual-seo","term":"Multilingual publishing","category":"machines","kind":"guide","image":"multilingual-seo","tier":"operating","evidence":"documented","sources":["https://developers.google.com/search/docs/specialty/international/localized-versions"],"related":["structured-editorial","knowledge-graph","distribution-is-the-moat"],"en":{"title":"Two languages, two real reading experiences.","dek":"A multilingual publication gives each version a stable URL and connects matching translations.","point":"A multilingual publication gives each version a stable URL and connects matching translations. Each language should remain readable and coherent throughout.","body":["Language switching should preserve the article rather than always return home. Cultural references may need rewriting. Hreflang links identify variants while each version has its own canonical URL. Check navigation, alternative text and error messages, often forgotten after body translation.","French and English versions can share a translation identifier while keeping their own metadata. This simplifies language switching, corrections and link checks. If a translation is missing, do not create a false variant filled with the other language. Flag the gap in the pipeline and publish only complete versions. A consistent route map should connect equivalents rather than make search engines or readers guess which page matches."],"action":["Connect equivalent variants.","Check language across all interfaces."],"trap":"Multilingual annotations aid interpretation; they do not guarantee ranking.","quote":"Two languages, two real reading experiences.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Two languages, two real reading experiences.","text":"A multilingual publication gives each version a stable URL and connects matching translations.","media":"/images/editorial/multilingual-seo.jpg"},{"label":"THE CONCEPT","title":"Multilingual publishing","text":"A multilingual publication gives each version a stable URL and connects matching translations. Each language should remain readable and coherent throughout.","media":"/images/editorial/multilingual-seo.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Multilingual annotations aid interpretation; they do not guarantee ranking.","media":"/images/editorial/multilingual-seo.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect equivalent variants.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/multilingual-seo.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check language across all interfaces.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/multilingual-seo.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/multilingual-seo.jpg","width":1280,"height":732,"alt":{"en":"Street signs show the same road name in multiple languages and scripts."},"credit":"Libresocietycy","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 53ac8f0d645a00b01319f0f754395057ffdf40ec.","source":"https://commons.wikimedia.org/wiki/File:Multilingual_street_sign_in_Kormacit.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"099","slug":"structured-editorial","term":"Structured editorial","category":"machines","kind":"guide","image":"structured-editorial","tier":"operating","evidence":"editorial","sources":[],"related":["agent-audit-log","multilingual-seo","distribution-is-the-moat"],"en":{"title":"A strict schema frees the voice. It does not write it.","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links.","point":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links. It cannot guarantee an interesting article by itself.","body":["Separate mechanical validation from review: unique slugs and image provenance can be checked automatically. The soundness of an opinion and usefulness of an example need judgment. A mature pipeline also blocks broken references and missing translations instead of publishing a skeleton because its JSON is valid.","FEEDRAID’s supplied schema requires two languages, an image with provenance, stories, body text and explicit limitations. Validation also checks references to other articles. These constraints make seeding reproducible. Review still owns subject distinctiveness and example relevance, neither of which structure alone certifies. Treat automated checks as necessary publishing conditions rather than a substitute for deciding whether the piece is actually worth reading."],"action":["Validate structure and relationships before publishing.","Review the text for its own value."],"trap":"A schema-compliant article can still be repetitive or useless.","quote":"A strict schema frees the voice. It does not write it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A strict schema frees the voice. It does not write it.","text":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links.","media":"/images/editorial/structured-editorial.jpg"},{"label":"THE CONCEPT","title":"Structured editorial","text":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links. It cannot guarantee an interesting article by itself.","media":"/images/editorial/structured-editorial.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A schema-compliant article can still be repetitive or useless.","media":"/images/editorial/structured-editorial.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Validate structure and relationships before publishing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/structured-editorial.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review the text for its own value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/structured-editorial.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/structured-editorial.jpg","width":1280,"height":960,"alt":{"en":"Metal Thai printing type sorted into compartments of a large wooden case."},"credit":"Paul_012","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 4171d3715c8c192eb700f3e595e112c6dee117bc.","source":"https://commons.wikimedia.org/wiki/File:Thai_metal_type,_Bangkok_National_Museum.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},{"id":"100","slug":"agent-audit-log","term":"Agent audit log","category":"machines","kind":"guide","image":"agent-audit-log","tier":"operating","evidence":"editorial","sources":[],"related":["ai-agd","structured-editorial","distribution-is-the-moat"],"en":{"title":"The log that makes tomorrow understandable.","dek":"An agent log connects intent, tool, result and next decision.","point":"An agent log connects intent, tool, result and next decision. It should retain useful evidence without exposing keys, secrets or unnecessary personal data.","body":["Record request identifiers and relevant status instead of full responses potentially containing secrets. Separate preview from live execution. When an incident occurs, the log should reveal what was requested and confirmed. An enthusiastic narrative is not an execution trace.","A readable log can show intent received, preview completed, approval obtained and execution confirmed. Missing stages remain missing. This chain supports recovery after interruption without assuming everything happened. It also makes correction easier by separating the agent’s plan from effects actually confirmed by the service. Keep the report precise enough that another operator can continue without reconstructing meaning from enthusiastic but ambiguous progress messages."],"action":["Log intent, mode and confirmed state.","Redact secrets and minimize retained data."],"trap":"A log should distinguish attempted actions from genuinely completed ones.","quote":"The log that makes tomorrow understandable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The log that makes tomorrow understandable.","text":"An agent log connects intent, tool, result and next decision.","media":"/images/editorial/agent-audit-log.jpg"},{"label":"THE CONCEPT","title":"Agent audit log","text":"An agent log connects intent, tool, result and next decision. It should retain useful evidence without exposing keys, secrets or unnecessary personal data.","media":"/images/editorial/agent-audit-log.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A log should distinguish attempted actions from genuinely completed ones.","media":"/images/editorial/agent-audit-log.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Log intent, mode and confirmed state.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-audit-log.jpg"},{"label":"PUT IT TO WORK / 2","title":"Redact secrets and minimize retained data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-audit-log.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agent-audit-log.jpg","width":1280,"height":1420,"alt":{"en":"Labeled decks of punched computer cards packed into a storage box."},"credit":"ArnoldReinhold","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b8ab119149236be900f3661af56ce7f925753d6f.","source":"https://commons.wikimedia.org/wiki/File:PunchCardDecks.agr.jpg","license":"CC BY-SA 2.5","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.5"}}],"lang":"en"}]}]
