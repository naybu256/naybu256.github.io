14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero article-hero-with-case","children":["$","img",null,{"src":"/images/editorial/creative-matrix.jpg","alt":"Colorful Amsterdam canal houses and illuminated windows reflected in the water at blue hour.","width":1280,"height":720,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Colorful_windows_and_canal_houses_at_blue_hour_with_water_reflection_in_Damrak_Amsterdam_Netherlands.jpg","children":"Basile Morin"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/4.0","children":"CC BY-SA 4.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],["$","a",null,{"href":"#case-notes","children":"02 / Watch & break down"}],["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"A creative matrix crosses variation dimensions: audience, problem, angle and format. It helps select experiments rather than mechanically filling every cell."}]]}],["$","section",null,{"id":"case-notes","className":"case-notes","children":[["$","$L18","lego-fashion-reinterpretation",{"example":"$1:props:children:1:props:article:examples:0","lens":"Place the original post in a meaningful cell, then describe a different cell for your own product. Change the viewer’s problem or the evidence being offered. Merely changing production cosmetics would not test the matrix’s underlying idea."}]]}],["$","$L19",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Start with a few credible combinations. One problem may deserve a demo and a narrative without needing a meme. Record why each combination could work. Empty cells are useful: sometimes they reveal a missing idea rather than insufficient output."}],["$","p","1",{"children":"An interesting cell should become a brief. Write the opening situation, the difference offered and the question to measure. If none of those sentences comes easily, leave the cell empty. The matrix is a selection tool: its value may be reducing productions that do not yet have a subject. A small set of explainable experiments is easier to learn from than an exhaustive but arbitrary catalog."}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Use the grid to expose missing ideas, not to manufacture copies."}],["$","p",null,{"children":"A creative matrix becomes useful when its axes represent meaningful choices. Audience situation against proof device is usually more informative than background colour against narrator voice. A study workflow can be shown through a real demonstration, a mistake being corrected or a comparison of two outputs. Each cell should imply a different viewer experience. If the cells merely rename the same script, the grid is hiding a shortage of concepts."}],["$","figure",null,{"className":"editorial-diagram diagram-compare","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"Axes that change the experience"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Audience situation",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Audience situation"}],["$","p",null,{"children":"The real moment in which the viewer needs help."}],false]}]]}],["$","li","Proof device",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Proof device"}],["$","p",null,{"children":"A demo, contrast, story or visible transformation."}],false]}]]}],["$","li","Editorial angle",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Editorial angle"}],["$","p",null,{"children":"The specific observation that makes this version worth seeing."}],false]}]]}]]}],"$L1a"]}],["$L1b","$L1c"]]}],false,false,"$L1d","$undefined","$L1e","$L1f","$L20","$L21"]}],"$L22"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L23","016",{"a":{"id":"016","author":"valentine","slug":"account-persona","category":"creative","term":"Account Persona","kind":"essay","image":"account-persona","media":{"kind":"photograph","src":"/images/editorial/account-persona.jpg","width":1280,"height":875,"alt":{"en":"Carved stone theatrical masks displayed among the ruins of Ostia Antica."},"credit":"Dennis G. Jarvis","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 5a244f48cf59ebe7c71fe44087df41410beb2633.","source":"https://commons.wikimedia.org/wiki/File:Italy_-_Ostia_Antica_-_Theatre_Masks_(5149585364).jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"},"en":{"title":"How to Build a Social Media Persona: The Duolingo Example","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."},"readingMinutes":4},"lang":"en"}],["$","$L23","032",{"a":{"id":"032","author":"valentine","slug":"format-fatigue","category":"creative","term":"Format fatigue","kind":"essay","image":"format-fatigue","media":"$1:props:children:1:props:previous:media","en":{"title":"TikTok Content Fatigue: When to Refresh a Recurring Format","dek":"Format fatigue is a hypothesis about weakening response after repetition."},"readingMinutes":3},"lang":"en"}],["$","$L23","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
1a:["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]
1b:["$","p","0",{"children":"Choose a small number of cells deliberately. Write why each combination might help the intended viewer and what a useful result would look like. Leave irrelevant combinations empty. The point is not to exhaust the Cartesian product or make production appear scientific. During review, distinguish a promising audience situation from a promising execution within it. Keep enough context to return to a cell later with a better example. A matrix should make editorial judgement more explicit; it cannot automate the judgement away by adding more rows."}]
1c:["$","p","1",{"children":"LEGO's reported fashion reinterpretations provide a concrete way to think about a creative matrix. The source material remains recognisable while its expression changes. For your own product, build the matrix around meaningful dimensions: audience problem, use case, proof and narrative device. Do not fill every cell automatically. Some combinations will have nothing useful to say, and rejecting them is part of the work. Select a few cells that produce distinct questions, then brief original executions. The matrix earns its place when it reveals ideas the team would otherwise miss, not when it turns one thin premise into a spreadsheet full of deliverables."}]
1d:["$","blockquote",null,{"children":["“","The matrix that stops fifty copies from being born.","”"]}]
1e:["$","$L19",null,{"a":"$1:props:children:1:props:article","lang":"en","number":2}]
1f:["$","section",null,{"id":"practice","children":[["$","h2",null,{"children":"Put it to work."}],["$","ol",null,{"className":"checklist","children":[["$","li","0",{"children":[["$","span",null,{"children":["0",1]}],"Cross three audiences with three relevant angles."]}],["$","li","1",{"children":[["$","span",null,{"children":["0",2]}],"Reject combinations without an editorial reason."]}]]}]]}]
