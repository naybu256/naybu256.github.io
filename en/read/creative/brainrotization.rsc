13:["$","header",null,{"className":"article-header","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","a",null,{"href":"/en/","children":"THE ORGANIC CLUB"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/en/topics/creative/","children":"Creative culture"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"Brainrotization"}]]}],["$","div",null,{"className":"mono acid","style":{"marginTop":28},"children":["POINT OF VIEW"," ","· ","028"]}],["$","h1",null,{"children":"Brainrot Marketing: When Internet Culture Helps a Brand"}],["$","p",null,{"className":"article-dek","children":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}],["$","div",null,{"className":"byline","children":[["$","a",null,{"href":"/en/about/#valentine","className":"author-signature","children":[["$","img",null,{"src":"/images/authors/valentine.jpg","alt":"","width":48,"height":48}],["$","span",null,{"children":["Valentine",["$","small",null,{"children":"Creative culture"}]]}]]}],["$","span",null,{"className":"muted","children":["08/09/2026"," ","· ",2," min"]}],["$","span",null,{"className":"evidence-tag","children":"Editorial analysis"}]]}]]}]
14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/brainrotization.jpg","alt":"A row of illuminated arcade cabinets in a games exhibition.","width":1280,"height":850,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Arcade_machines_-_13332978733.jpg","children":"Staffan Vilcans"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/2.0","children":"CC BY-SA 2.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/creative/brainrotization/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats. It describes neither a medical condition nor a cognitive measurement."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Absurdity can create a shared language, but it can also erase the subject. Ask what remains after the joke: an idea, a recognized problem, a useful memory? Frenetic editing need not be condemned by default. It should pass the same coherence test as the quietest video."}],["$","p","1",{"children":"Absurd content can still identify its status: sketch, metaphor or invented example. That framing prevents a joke from becoming commercial evidence in an out-of-context screenshot. Work on the punchline and legibility together. Audiences can enjoy chaotic form without wanting to decode an incomprehensible demonstration. The useful question is whether the chosen absurdity sharpens the point or merely delays its arrival."}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Absurdity still needs an editorial job."}],["$","p",null,{"children":"Fast, surreal or deliberately excessive content can create a strong account language. It can also hide the fact that the piece communicates nothing beyond its own stimulation. Ask what the absurdity does. Does it make a familiar frustration visible, create a character relationship or give the audience a shared joke? If removing the effects leaves no recognisable situation, the brief may be outsourcing its point of view to editing."}],["$","figure",null,{"className":"editorial-diagram diagram-compare","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"What is the absurdity doing?"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Recognition",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Recognition"}],["$","p",null,{"children":"Exaggerates a situation the audience already understands."}],false]}]]}],["$","li","Character",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Character"}],["$","p",null,{"children":"Makes the account’s personality more legible."}],false]}]]}],["$","li","Noise",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Noise"}],["$","p",null,{"children":"Adds stimulation without changing the meaning."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Keep the account’s intended audience in the review. A team can enjoy an in-joke that its prospective viewers do not understand, or attract an audience whose interest never connects to the product. Compare an absurd treatment with a more direct one around the same promise when the question matters. Record qualitative responses as well as distribution. Do not turn a successful chaotic post into a rule that every explanation should become harder to follow. Cultural fluency includes knowing when a clear demonstration is more interesting than another layer of irony."}]]]}],false,false,"$L19","$undefined","$L1a","$L1b","$L1c","$L1d"]}],"$L1e"]}]
