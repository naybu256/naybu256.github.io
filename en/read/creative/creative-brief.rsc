3:["$","div",null,{"lang":"en","children":[["$","$Le",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI Content for Social Media: How to Avoid Generic Output","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"Account Isolation in AGD: Build Distinct Social Accounts","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Native Posting vs API Posting on TikTok: What Can You Test?","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"TokPortal MCP Tutorial: Preview an AI Workflow with Dry Run","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"AGD for TikTok 101: Accounts, Content and Your First Tests","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"Content Isolation: How to Differentiate a Multi-Account Strategy","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"How AGD Changes the Competition for Organic Reach","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"AGD vs Phone Farms: Strategy, Accounts and Infrastructure","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"How to Build an AGD Strategy with Your Existing Tools","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"AGD Marketing Principles: A Practical Editorial Framework","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"AGD Marketing Mistakes: Volume, Copying and False Promises","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"What Is a Native TikTok Account? Context and Limitations","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"How to Build a Social Media Persona: The Duolingo Example","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"TikTok Hook Examples: Replace Clickbait with a Clear Payoff","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"TikTok Content Series: Build a Repeatable Format","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"AI Personas for Social Media: Character Design and Disclosure","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"Persona-Based AGD: Give Each Account a Distinct Voice","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"TikTok Slideshow Strategy: Story Structure for AGD","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"How to Structure a TikTok Slideshow as a Story","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Educational TikTok Content: Turn a Real Process into a Story","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"Brand Memes on TikTok: What Ryanair’s Persona Can Teach You","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"TikTok Product Discovery: Lessons from the Ocean Spray Video","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"How to Write a TikTok Creative Brief with a Concrete Example","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"How to Build a TikTok Creative Library from Real Examples","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"TikTok Content Fatigue: When to Refresh a Recurring Format","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"Creative Testing Matrix: Lessons from LEGO’s Instagram Reel","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"TikTok Account Warming: Define a Relevant, Testable Routine","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native TikTok Posting: Workflow, Features and Quality Checks","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Native Account Warming: Actions, Records and Limits","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"US TikTok Accounts: Geography, Setup and Audience Limits","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Geo-Posting for TikTok: Location Context vs Audience Targeting","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"How to Reach US TikTok Audiences from Abroad","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"TikTok Content Localization: Go Beyond Translation","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"Social Media Account Brief: Audience, Voice and Publishing Rules","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"Social Publishing Handoffs: What to Give Your Operator","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"TikTok Publishing Schedule: Plan Windows, Not Magic Minutes","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"How to Organize a Multi-Account Social Media Inventory","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Why Does My TikTok Have Zero Views? A Diagnostic Workflow","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"TikTok Shadowban or Low Reach? How to Investigate","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"TikTok Publishing Failures: Separate Upload, Access and Reach","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic Brand Accounts: Native Content and Transparent Identity","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"Reddit Marketing and AGD: Contribute Before You Promote","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Community Marketing: How Brands Join Existing Conversations","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"Social Media Content Rights: A Publishing Checklist","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"AGD Campaign Review: Creative, Distribution and Evidence","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"How to Budget an AGD Experiment: Costs and Learning Goals","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"What Counts as a Viral TikTok? Define the Comparison","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"TikTok Viral Hit Rate: Define Attempts and Measure Outcomes","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"TikTok Analytics: Average vs Median Views Explained","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"Social Media Analytics: How to Read Performance Percentiles","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"Why a Few TikTok Posts Can Dominate Your Reach","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"Multi-Account Analytics: Measure Performance Concentration","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"How to Compare TikTok Campaigns with Matched Cohorts","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"Best Time to Post on TikTok? Test Timing Without the Myths","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"How Often Should You Post on TikTok? Design a Useful Test","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Does TikTok Account Warming Work? An Experiment Protocol","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"Does TikTok Account Age Affect Reach? What to Compare","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"TikTok Slideshows vs Videos: How to Compare the Formats","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"TikTok Content Strategy: Recurring Series vs Spontaneous Posts","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"TikTok Creative Testing: Compare Ideas, Not Just Edits","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"TikTok Native Features: Test Their Creative Contribution","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"How to Measure Your TikTok Zero-View Rate","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Social Media Experiments: Confidence Intervals Explained","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"TikTok Case Studies and Survivorship Bias: What Is Missing?","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"Why TikTok Views Drop After a Viral Post","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Campaign Cohort Analysis: Compare Equally Mature Results","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"TikTok Marketing Attribution: UTMs, Visits and First Purchases","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"From TikTok Views to Sales: Measure the Customer Journey","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Social Media Experiment Template: Write the Plan First","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"When to Stop an AGD Experiment: Budget and Evidence Rules","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"How to Evaluate AGD Claims: Documentation, Examples and Tests","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI for AGD Marketing: From Creative Brief to Publishing Workflow","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"Agentic AGD: What an AI Distribution Agent Should Do","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"TokPortal’s Human API: Briefs, Native Actions and Receipts","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"TokPortal MCP Workflows: Connect AI to Social Operations","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"What Does a TokPortal Dry Run Do? Preview Scope and Limits","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"API Retry Safety: Avoid Duplicate Social Publishing Operations","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"Social Publishing Webhooks: Events, Status and Recovery","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"How to Set a Budget for an AI Marketing Agent","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"AI Marketing Automation: When to Increase Agent Autonomy","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Social Media API Automation: Keep the Editorial Brief Intact","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Content Routing for Multiple Social Accounts","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"How to Organize Social Creative by Idea and Mechanism","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"Social Media Monitoring: Build Useful Operational Alerts","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human Review for AI Content: Approve the Version That Ships","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Marketing Automation Records: Build a Reliable Source of Truth","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"AGD and SEO: Turn Social Ideas into Searchable Articles","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic SEO for AGD: Structure Useful, Distinct Pages","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"Writing AGD Content That Search and AI Can Cite","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"Internal Linking for AGD Content: Connect Concepts Clearly","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Multilingual Content Strategy: When to Expand Your AGD Site","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"AGD Article Schema: Structure Text, Stories and Real Examples","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"AI Agent Audit Logs: Trace Marketing Actions and Decisions","dek":"An agent log connects intent, tool, result and next decision."}}]}],"$Lf","$L10"]}]
11:T5a3,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://theorganiclub.com/en/read/creative/creative-brief/#article","headline":"How to Write a TikTok Creative Brief with a Concrete Example","description":"An AGD creative brief connects audience, promise, format and hypothesis.","inLanguage":"en","datePublished":"2026-09-08T12:00:00Z","dateModified":"2026-09-09T07:56:36.337Z","image":["https://theorganiclub.com/images/editorial/creative-brief.jpg"],"author":{"@type":"Organization","name":"Valentine","url":"https://theorganiclub.com/en/about/#valentine","image":"https://theorganiclub.com/images/authors/valentine.jpg"},"publisher":{"@type":"Organization","name":"THE ORGANIC CLUB","url":"https://theorganiclub.com"},"mainEntityOfPage":"https://theorganiclub.com/en/read/creative/creative-brief/","articleSection":"Creative culture","wordCount":789,"citation":["https://www.tiktok.com/@emilymariko/video/7010506729012219141","https://media.lsu.co.uk/2021/10/12/tiktok-food-trends/"]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"THE ORGANIC CLUB","item":"https://theorganiclub.com/en/"},{"@type":"ListItem","position":2,"name":"Creative culture","item":"https://theorganiclub.com/en/topics/creative/"},{"@type":"ListItem","position":3,"name":"How to Write a TikTok Creative Brief with a Concrete Example","item":"https://theorganiclub.com/en/read/creative/creative-brief/"}]}]}1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],["$","$L12",null,{"article":{"id":"029","slug":"creative-brief","term":"Creative Brief","category":"creative","kind":"guide","image":"creative-brief","tier":"operating","evidence":"editorial","sources":[],"related":["hook-payoff","brainrotization","distribution-is-the-moat"],"en":{"title":"How to Write a TikTok Creative Brief with a Concrete Example","dek":"An AGD creative brief connects audience, promise, format and hypothesis.","point":"An AGD creative brief connects audience, promise, format and hypothesis. It gives a creator direction and an analyst an interpretable question.","body":["Replace “make a viral video” with “test whether this friction resonates with students revising.” List requirements, freedoms and boundaries. A useful constraint explains its role: the first screen should make the situation visible, not merely contain a keyword.","Add the sentence a viewer should be able to repeat afterward. It is not a mandatory slogan but a comprehension check. If the creative team proposes a better way to convey the idea, the brief should allow it. The document sets the job’s objective without confusing that objective with the first imagined solution. This distinction keeps constraints useful while preserving the creator’s judgment."],"action":["Write the learning question.","Define what the creator can choose freely."],"trap":"An overly prescriptive brief can eliminate the variation the test was meant to explore.","quote":"A good brief starts with what we want to learn.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A good brief starts with what we want to learn.","text":"An AGD creative brief connects audience, promise, format and hypothesis.","media":"/images/editorial/creative-brief.jpg"},{"label":"THE CONCEPT","title":"Creative Brief","text":"An AGD creative brief connects audience, promise, format and hypothesis. It gives a creator direction and an analyst an interpretable question.","media":"/images/editorial/creative-brief.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An overly prescriptive brief can eliminate the variation the test was meant to explore.","media":"/images/editorial/creative-brief.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the learning question.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-brief.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define what the creator can choose freely.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-brief.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"A brief should make the review easier before production begins.","paragraphs":["Write the audience situation, the claim and the evidence before choosing an effect or a format. A useful brief might ask whether a visible before-and-after helps a certain viewer understand a workflow. A weak brief asks for three viral videos with different hooks. The first gives the team a question it can answer. The second turns every result into an argument about taste, energy or whether the creator tried hard enough.","Include what must stay fixed and what the production is allowed to change. Specify the source material, rights context and the person who can approve the final version. Give examples of the desired mechanism without asking a creator to imitate someone’s identity or reproduce their clip. During review, compare the finished asset with the original learning question. A technically polished video can still fail the brief; a rough prototype can be useful if it resolves a decision before expensive production. Keep that distinction visible in how the team labels and evaluates work.","Emily Mariko's recipe is useful as a reference for a concrete transformation. The reported ingredients and the finished bowl give the viewer something specific to understand and potentially try. Translate that clarity into the brief rather than copying the setting or aesthetic. Name the starting state, the visible action and the result. Add the one detail that makes this example worth showing instead of describing in a sentence. For a software tutorial, that might be the awkward source file or the inspection step that proves the output is usable. The brief should tell an editor where the explanation becomes visible, not merely request an engaging video."],"diagram":{"kind":"flow","title":"A brief an editor can review","items":[{"label":"Question","detail":"What do we want to learn about this audience or explanation?","value":0},{"label":"Evidence","detail":"What must the viewer actually see?","value":0},{"label":"Boundary","detail":"What can change, and what would invalidate the comparison?","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Use the example to name a mechanism worth exploring, such as a reveal or a clear process. Then write an original brief for your own subject. A reference should clarify a decision, not substitute for creative authorship.","caseIds":["emily-mariko-salmon"]},"examples":[{"id":"emily-mariko-salmon","platform":"tiktok","url":"https://www.tiktok.com/@emilymariko/video/7010506729012219141","creator":"Emily Mariko","title":"A repeatable lunch becomes a repeatable content idea","description":"Observed refrigerator/freezer access, microwave action, rice over pieces of salmon, avocado being cut, and the finished bowl served with kimchi while Emily eats with chopsticks.","mechanism":"A practical transformation progresses from ingredients to a finished meal. The final eating scene makes the promised result visible.","limitation":"Documents one recipe demonstration. It cannot establish the number of people who cooked it or purchased ingredients because of it.","observationBasis":"Playback started and changing visual sequences inspected on 9 September 2026. Audio and every frame were not independently reviewed.","checkedAt":"2026-09-09T00:00:00Z","references":["https://media.lsu.co.uk/2021/10/12/tiktok-food-trends/"],"screenshot":{"src":"/images/social/emily-mariko-finish.jpg","alt":"Emily Mariko eating the finished salmon-and-rice bowl with chopsticks, with kimchi on the counter.","source":"https://www.tiktok.com/@emilymariko/video/7010506729012219141","capturedAt":"2026-09-09T00:00:00Z"},"breakdown":{"format":"Process → finished result → use","audience":"Someone who wants a practical idea for making lunch.","productRole":"The meal is demonstrated and used. A software adaptation needs its own visible proof.","beats":[{"label":"Give the process a subject","observed":"The cooking sequence works with salmon and rice, alongside kitchen preparation.","reading":"Ingredients give the viewer something concrete to follow. For a software demo, start with the actual input: a document, a messy list or a task the audience already recognises."},{"label":"Show the transformation","observed":"The inspected sequence includes microwave use, avocado preparation and assembly of the bowl.","reading":"The sequence earns its finish through intermediate actions. Removing every step may make a video shorter while also removing the evidence that makes its promise credible."},{"label":"Use what you made","observed":"Emily eats from the completed bowl, with kimchi visible on the table.","reading":"The closing action answers the practical question. A product demo can do the same by using the output to complete a task, rather than ending on the tool’s logo."}],"transfer":{"title":"Finish the job on camera.","scenario":"Original concept for a subscription tracker.","hook":"I checked which subscriptions I was still paying for.","visual":"Use a sample account you own. Show the recurring-charge list, find one forgotten test subscription and demonstrate where a person would manage it. Keep sensitive account details out of the recording.","keep":"A recognisable starting mess and a final action that resolves it.","change":"The audience problem and the proof. A cooking clip is a structural reference, not a finance testimonial.","measure":"Log the destination post and the same observation age for each version. Distinguish completion of the video from clicks or actions in the product."}}}],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:56:36.337Z","author":"valentine","media":{"kind":"photograph","src":"/images/editorial/creative-brief.jpg","width":1280,"height":924,"alt":{"en":"An archival photograph of printers working at benches in the Deli Courant typesetting workshop."},"credit":"Rijksmuseum","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: bdc598ccc83875350e8488c22995634e31cdafff.","source":"https://commons.wikimedia.org/wiki/File:Zetterij_van_de_Deli_Courant,_NG-1990-14-39.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},"lang":"en","next":{"id":"030","slug":"hook-payoff","term":"Hook & payoff","category":"creative","kind":"guide","image":"hook-payoff","tier":"operating","evidence":"editorial","sources":[],"related":["creative-library","creative-brief","distribution-is-the-moat"],"en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise.","point":"The payoff is the narrative or practical answer to the opening promise. Its alignment with the hook is checked in the content, not only in a retention curve.","body":["If the opening promises an expensive mistake, show the mistake and how to avoid it. A vague revelation in the final second does not repay the promise. Read the sequence as a contract: what did the viewer agree to by staying? This check may remove a strong but misleading opening.","A simple audit shows only the beginning and asks what a person expects. Then reveal the ending. The gap between expectation and answer helps expose unintended promises. This feedback is not a representative measurement of your market, but it can uncover incoherence before full production. Keep the observed confusion in the brief so the next revision addresses a concrete problem rather than somebody’s vague preference."],"action":["Write promise and resolution side by side.","Check that the resolution is clearly shown."],"trap":"Keeping an audience through confusion is not the same as delivering value.","quote":"The hook’s promise must be paid back.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The hook’s promise must be paid back.","text":"The payoff is the narrative or practical answer to the opening promise.","media":"/images/editorial/hook-payoff.jpg"},{"label":"THE CONCEPT","title":"Hook & payoff","text":"The payoff is the narrative or practical answer to the opening promise. Its alignment with the hook is checked in the content, not only in a retention curve.","media":"/images/editorial/hook-payoff.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Keeping an audience through confusion is not the same as delivering value.","media":"/images/editorial/hook-payoff.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write promise and resolution side by side.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/hook-payoff.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check that the resolution is clearly shown.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/hook-payoff.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"Make the ending answer the exact question the opening creates.","paragraphs":["A curiosity gap is useful when the viewer can understand what is missing. An object appears to do something impossible. A familiar task produces the wrong result. A claim conflicts with what is visible. These openings create an obligation. If the ending supplies an unrelated product pitch, the audience has been asked to stay for one reason and rewarded with another. A stronger CTA continues the original problem instead of changing the subject at the last moment.","Review the opening and ending side by side before approving the middle. State the promise in ordinary language and point to the frame or explanation that fulfils it. If the payoff relies on a detail too small to see, the video has not delivered merely because the editor knows it is there. For an educational piece, consider revealing the basic answer early and using the rest to explain why. Holding attention through understanding can be more valuable than withholding an answer that was never complicated. Test the structure with the audience rather than declaring one universal rule for hooks.","The Zach King reference gives the hook a debt: an apparently impossible action creates a question that the post must answer. That is different from promising a secret and filling the middle with unrelated advice. For a product demonstration, write the debt in plain language before editing. The viewer might be asking how the messy input became a usable output, which step disappeared or what the catch is. Make the payoff show the answer rather than merely repeat the product's name. A useful editing review asks whether the first frame and final explanation belong to the same question. If they do not, the hook has sold a different video."],"diagram":{"kind":"timeline","title":"The promise must survive the edit","items":[{"label":"Open question","detail":"The viewer knows what they want explained.","value":0},{"label":"Useful progression","detail":"Each moment moves toward that explanation.","value":0},{"label":"Payoff","detail":"The ending fulfils the opening before asking for more.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"The real post is a useful reference for a visible question and a reveal. We can analyse that structure while leaving retention, rewatching and commercial impact unclaimed unless the creator supplies reliable data.","caseIds":["zach-king-broom"]},"examples":[{"id":"zach-king-broom","platform":"tiktok","url":"https://www.tiktok.com/@zachking/video/6768504823336815877","creator":"Zach King","title":"An impossible image earns its explanation","description":"Zach King in a wizard-style outfit appears to float along a road on a broom. A later frame reveals his feet on a skateboard and a large panel beside his legs.","mechanism":"An impossible-looking opening creates a concrete question; the later reveal shows the physical setup.","limitation":"Illustrates a visual hook paired with a reveal. It does not reveal completion rate, rewatch rate or the production cost.","observationBasis":"Playback started and changing visual sequences inspected on 9 September 2026. Audio and every frame were not independently reviewed.","checkedAt":"2026-09-09T00:00:00Z","references":["https://www.com.cuhk.edu.hk/publication/lin-journal-2023-theorising.pdf"],"screenshot":{"src":"/images/social/zach-king-playback.jpg","alt":"Zach King in a wizard-style outfit appearing to ride a broom along a road.","source":"https://www.tiktok.com/@zachking/video/6768504823336815877","capturedAt":"2026-09-09T00:00:00Z"},"breakdown":{"format":"Impossible image → physical reveal","audience":"A viewer who wants to work out how the image was made.","productRole":"The craft is the subject. The clip does not demonstrate a SaaS product.","beats":[{"label":"Open a specific question","observed":"A wizard-costumed rider appears to travel on a broom above the road.","reading":"The visual makes the question legible before an explanation is necessary: what is supporting him? A vague promise to reveal a secret would ask the viewer to supply that curiosity themselves."},{"label":"Keep the object in view","observed":"The broom, rider and road stay part of the moving scene.","reading":"A reveal needs something to explain. Preserving the object lets the viewer compare the initial impression with the later setup instead of receiving an unrelated punchline."},{"label":"Pay the question back","observed":"Later frames expose the skateboard and the panel beside the rider’s legs.","reading":"The payoff changes how the earlier image is understood. For a product demonstration, the equivalent is showing the actual action that produced the surprising result."}],"transfer":{"title":"Make the result strange; make the explanation real.","scenario":"Original concept for a notes app.","hook":"This clean meeting summary started as this mess.","visual":"Start with your own readable summary beside a visibly messy test transcript. Show the real import, the generated draft and the manual correction of one important detail.","keep":"One concrete puzzle and a payoff the viewer can inspect.","change":"Use a genuine product transformation. Do not fake an instant result with a cut that conceals required work.","measure":"Track whether viewers reach the reveal and whether product questions concern the demonstrated job. Record the version of the first frame separately from the underlying concept."}}}],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:56:36.337Z","author":"valentine","media":{"kind":"photograph","src":"/images/editorial/hook-payoff.jpg","width":1280,"height":1623,"alt":{"en":"A fishing figure silhouetted atop a lighthouse beneath a warm orange sunset."},"credit":"Petar Milošević","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e99fef0dea0e1c8e1ae36c1a45caa61d9cde8705.","source":"https://commons.wikimedia.org/wiki/File:Fishing_by_lighthouse_at_sunset_(Adriatic_Sea).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"previous":{"id":"028","slug":"brainrotization","term":"Brainrotization","category":"creative","kind":"essay","image":"brainrotization","tier":"editorial","evidence":"editorial","sources":[],"related":["creative-brief","product-discovery","distribution-is-the-moat"],"en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats.","point":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats. It describes neither a medical condition nor a cognitive measurement.","body":["Absurdity can create a shared language, but it can also erase the subject. Ask what remains after the joke: an idea, a recognized problem, a useful memory? Frenetic editing need not be condemned by default. It should pass the same coherence test as the quietest video.","Absurd content can still identify its status: sketch, metaphor or invented example. That framing prevents a joke from becoming commercial evidence in an out-of-context screenshot. Work on the punchline and legibility together. Audiences can enjoy chaotic form without wanting to decode an incomprehensible demonstration. The useful question is whether the chosen absurdity sharpens the point or merely delays its arrival."],"action":["Summarize the message without describing effects.","Test understanding with the intended audience."],"trap":"Provocative cultural language does not justify claims about audience health or attention.","quote":"Marketing caught brainrot. What next?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Marketing caught brainrot. What next?","text":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats.","media":"/images/editorial/brainrotization.jpg"},{"label":"THE CONCEPT","title":"Brainrotization","text":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats. It describes neither a medical condition nor a cognitive measurement.","media":"/images/editorial/brainrotization.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Provocative cultural language does not justify claims about audience health or attention.","media":"/images/editorial/brainrotization.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Summarize the message without describing effects.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/brainrotization.jpg"},{"label":"PUT IT TO WORK / 2","title":"Test understanding with the intended audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/brainrotization.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"Absurdity still needs an editorial job.","paragraphs":["Fast, surreal or deliberately excessive content can create a strong account language. It can also hide the fact that the piece communicates nothing beyond its own stimulation. Ask what the absurdity does. Does it make a familiar frustration visible, create a character relationship or give the audience a shared joke? If removing the effects leaves no recognisable situation, the brief may be outsourcing its point of view to editing.","Keep the account’s intended audience in the review. A team can enjoy an in-joke that its prospective viewers do not understand, or attract an audience whose interest never connects to the product. Compare an absurd treatment with a more direct one around the same promise when the question matters. Record qualitative responses as well as distribution. Do not turn a successful chaotic post into a rule that every explanation should become harder to follow. Cultural fluency includes knowing when a clear demonstration is more interesting than another layer of irony."],"diagram":{"kind":"compare","title":"What is the absurdity doing?","items":[{"label":"Recognition","detail":"Exaggerates a situation the audience already understands.","value":0},{"label":"Character","detail":"Makes the account’s personality more legible.","value":0},{"label":"Noise","detail":"Adds stimulation without changing the meaning.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"The example offers a specific creative use of exaggeration or character. Our interpretation concerns that visible choice. It is not evidence that higher edit density, irony or surrealism universally improves audience response.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"valentine","media":{"kind":"photograph","src":"/images/editorial/brainrotization.jpg","width":1280,"height":850,"alt":{"en":"A row of illuminated arcade cabinets in a games exhibition."},"credit":"Staffan Vilcans","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: a43ae782ce93d9fa18b56b39cb11d8b819098d53.","source":"https://commons.wikimedia.org/wiki/File:Arcade_machines_-_13332978733.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}}}],"$L13","$L14","$L15","$L16"]}]
