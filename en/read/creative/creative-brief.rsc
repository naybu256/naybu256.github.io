15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],["$","a",null,{"href":"#case-notes","children":"02 / Watch & break down"}],["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/creative/creative-brief/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"An AGD creative brief connects audience, promise, format and hypothesis. It gives a creator direction and an analyst an interpretable question."}]]}],["$","section",null,{"id":"case-notes","className":"case-notes","children":[["$","$L18","emily-mariko-salmon",{"example":"$1:props:children:1:props:article:examples:0","lens":"Use the example to name a mechanism worth exploring, such as a reveal or a clear process. Then write an original brief for your own subject. A reference should clarify a decision, not substitute for creative authorship."}]]}],["$","$L19",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","$1a","0",{"children":[["$","$1a","0",{"children":[["$","p","0",{"children":["Replace “make a viral video” with “test whether this friction resonates with students revising.” List requirements, freedoms and boundaries. A useful constraint explains its role: the first screen should make the situation visible, not merely contain a keyword."]}]]}]]}],["$","$1a","1",{"children":[["$","$1a","0",{"children":[["$","p","0",{"children":["Add the sentence a viewer should be able to repeat afterward. It is not a mandatory slogan but a comprehension check. If the creative team proposes a better way to convey the idea, the brief should allow it. The document sets the job’s objective without confusing that objective with the first imagined solution. This distinction keeps constraints useful while preserving the creator’s judgment."]}]]}]]}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"A brief should make the review easier before production begins."}],[["$","$1a","0",{"children":[["$","p","0",{"children":["Write the audience situation, the claim and the evidence before choosing an effect or a format. A useful brief might ask whether a visible before-and-after helps a certain viewer understand a workflow. A weak brief asks for three viral videos with different hooks. The first gives the team a question it can answer. The second turns every result into an argument about taste, energy or whether the creator tried hard enough."]}]]}]],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"A brief an editor can review"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Question",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Question"}],["$","p",null,{"children":"What do we want to learn about this audience or explanation?"}],false]}]]}],["$","li","Evidence",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Evidence"}],["$","p",null,{"children":"What must the viewer actually see?"}],false]}]]}],["$","li","Boundary",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Boundary"}],"$L1b",false]}]]}]]}],"$L1c"]}],["$L1d","$L1e"]]}],false,false,"$L1f","$undefined","$L20","$L21","$L22","$L23"]}],"$L24"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L25","030",{"a":{"id":"030","author":"valentine","slug":"hook-payoff","category":"creative","term":"Hook & payoff","kind":"guide","image":"hook-payoff","media":"$1:props:children:1:props:next:media","en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise."},"readingMinutes":5},"lang":"en"}],["$","$L25","028",{"a":{"id":"028","author":"valentine","slug":"brainrotization","category":"creative","term":"Brainrotization","kind":"essay","image":"brainrotization","media":"$1:props:children:1:props:previous:media","en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."},"readingMinutes":2},"lang":"en"}],["$","$L25","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://theorganiclub.com/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://theorganiclub.com/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
