22:["$","section",null,{"id":"practice","children":[["$","h2",null,{"children":"Put it to work."}],["$","ol",null,{"className":"checklist","children":[["$","li","0",{"children":[["$","span",null,{"children":["0",1]}],"Define the recurring promise in one sentence."]}],["$","li","1",{"children":[["$","span",null,{"children":["0",2]}],"Prepare ten episodes with different lessons."]}]]}]]}]
23:["$","section",null,{"id":"sources","children":[["$","h2",null,{"children":"Notes & sources."}],["$","p",null,{"className":"caveat","children":[["$","strong",null,{"children":"The limit. "}],"Recognizing a format does not guarantee the next episode offers anything new."]}],["$","div",null,{"className":"sources","children":[["$","span",null,{"className":"mono acid","children":"SOURCES & PROVENANCE"}],["$","p",null,{"children":"Further reading is linked throughout this article. Worked examples explain a process; they are not campaign results."}],["$","p",null,{"className":"editorial-note","children":["THE ORGANIC CLUB is an editorial project initiated by TokPortal. That relationship is separate from the evidence behind claims. Editorial signatures and image credits are explained in our policy."," ",["$","a",null,{"href":"/en/about/","children":"Our editorial policy →"}]]}]]}]]}]
