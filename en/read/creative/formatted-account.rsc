13:["$","header",null,{"className":"article-header","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","a",null,{"href":"/en/","children":"THE ORGANIC CLUB"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/en/topics/creative/","children":"Creative culture"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"Formatted Account"}]]}],["$","div",null,{"className":"mono acid","style":{"marginTop":28},"children":["FIELD GUIDE"," ","· ","019"]}],["$","h1",null,{"children":"TikTok Content Series: Build a Repeatable Format"}],["$","p",null,{"className":"article-dek","children":"A Formatted Account uses a repeatable creative structure an audience can recognize."}],["$","div",null,{"className":"byline","children":[["$","a",null,{"href":"/en/about/#valentine","className":"author-signature","children":[["$","img",null,{"src":"/images/authors/valentine.jpg","alt":"","width":48,"height":48}],["$","span",null,{"children":["Valentine",["$","small",null,{"children":"Creative culture"}]]}]]}],["$","span",null,{"className":"muted","children":["08/09/2026"," ","· ",3," min"]}],["$","span",null,{"className":"evidence-tag","children":"Editorial analysis"}]]}]]}]
14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero article-hero-with-case","children":["$","img",null,{"src":"/images/editorial/formatted-account.jpg","alt":"Repeating rounded concrete balconies on Chicago’s River City apartments.","width":1280,"height":960,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:River_City,_Wells_Street_and_Polk_Street,_Chicago,_IL_-_54519335782.jpg","children":"w_lemay"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/2.0","children":"CC BY-SA 2.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],["$","a",null,{"href":"#case-notes","children":"02 / Watch & break down"}],["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/creative/formatted-account/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"A Formatted Account uses a repeatable creative structure an audience can recognize. Repetition concerns the promise, not necessarily the substance."}]]}],["$","section",null,{"id":"case-notes","className":"case-notes","children":[["$","$L18","khaby-apple-del-piero",{"example":"$1:props:children:1:props:article:examples:0","lens":"Look for the repeatable viewing grammar in the example. Then distinguish the episode’s actual substance from the shell that could recur. Public familiarity with a format does not establish that repetition alone caused its results."}]]}],["$","$L19",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","$1a","0",{"children":[["$","$1a","0",{"children":[["$","p","0",{"children":["“One setting, one avoided mistake” is a format: every episode can teach something different. A colored background with three arbitrary sentences is only a template. Record what stays fixed and what varies. That separation makes testing clearer while preventing the series from exhausting itself."]}]]}]]}],["$","$1a","1",{"children":[["$","$1a","0",{"children":[["$","p","0",{"children":["A useful episode may slightly break its format to serve the subject. Keep the promise but adjust length when the explanation requires it. Record that exception so it is not confused with a strategic change. Consistency helps readers recognize what they receive; it should not become a restriction that prevents explanation. A format earns its place by making good ideas easier to deliver."]}]]}]]}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"A series is a promise with room for a new answer."}],[["$","$1a","0",{"children":[["$","p","0",{"children":["The best reason to repeat a format is that viewers understand what kind of reward they are about to receive. A recurring repair demonstration, a one-question explanation or a before-and-after process can remove orientation work without making every episode identical. The stable structure creates room for the variable that matters: a different problem, object, misconception or result. If only the headline changes, the series is probably running out of editorial material."]}]]}]],["$","figure",null,{"className":"editorial-diagram diagram-compare","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"The anatomy of a repeatable format"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Fixed",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fixed"}],["$","p",null,{"children":"The promise and viewing grammar people recognise."}],false]}]]}],["$","li","Variable",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Variable"}],["$","p",null,{"children":"The new problem, object or evidence in this episode."}],false]}]]}],["$","li","Testable",{"children":["$L1b","$L1c"]}]]}],"$L1d"]}],["$L1e","$L1f"]]}],false,false,"$L20","$undefined","$L21","$L22","$L23","$L24"]}],"$L25"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L26","020",{"a":{"id":"020","author":"valentine","slug":"chaotic-account","category":"creative","term":"Chaotic Account","kind":"essay","image":"chaotic-account","media":"$1:props:children:1:props:next:media","en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template."},"readingMinutes":3},"lang":"en"}],["$","$L26","018",{"a":{"id":"018","author":"valentine","slug":"faceless-account","category":"creative","term":"Faceless Account","kind":"guide","image":"faceless-account","media":"$1:props:children:1:props:previous:media","en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible."},"readingMinutes":7},"lang":"en"}],["$","$L26","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://theorganiclub.com/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://theorganiclub.com/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
