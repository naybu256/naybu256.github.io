3:["$","div",null,{"lang":"en","children":[["$","$Le",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI Content for Social Media: How to Avoid Generic Output","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"Account Isolation in AGD: Build Distinct Social Accounts","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Native Posting vs API Posting on TikTok: What Can You Test?","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"TokPortal MCP Tutorial: Preview an AI Workflow with Dry Run","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"AGD for TikTok 101: Accounts, Content and Your First Tests","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"Content Isolation: How to Differentiate a Multi-Account Strategy","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"How AGD Changes the Competition for Organic Reach","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"AGD vs Phone Farms: Strategy, Accounts and Infrastructure","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"How to Build an AGD Strategy with Your Existing Tools","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"AGD Marketing Principles: A Practical Editorial Framework","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"AGD Marketing Mistakes: Volume, Copying and False Promises","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"What Is a Native TikTok Account? Context and Limitations","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"How to Build a Social Media Persona: The Duolingo Example","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"TikTok Hook Examples: Replace Clickbait with a Clear Payoff","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"TikTok Content Series: Build a Repeatable Format","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"AI Personas for Social Media: Character Design and Disclosure","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"Persona-Based AGD: Give Each Account a Distinct Voice","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"TikTok Slideshow Strategy: Story Structure for AGD","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"How to Structure a TikTok Slideshow as a Story","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Educational TikTok Content: Turn a Real Process into a Story","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"Brand Memes on TikTok: What Ryanair’s Persona Can Teach You","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"TikTok Product Discovery: Lessons from the Ocean Spray Video","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"How to Write a TikTok Creative Brief with a Concrete Example","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"How to Build a TikTok Creative Library from Real Examples","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"TikTok Content Fatigue: When to Refresh a Recurring Format","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"Creative Testing Matrix: Lessons from LEGO’s Instagram Reel","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"TikTok Account Warming: Define a Relevant, Testable Routine","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native TikTok Posting: Workflow, Features and Quality Checks","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Native Account Warming: Actions, Records and Limits","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"US TikTok Accounts: Geography, Setup and Audience Limits","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Geo-Posting for TikTok: Location Context vs Audience Targeting","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"How to Reach US TikTok Audiences from Abroad","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"TikTok Content Localization: Go Beyond Translation","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"Social Media Account Brief: Audience, Voice and Publishing Rules","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"Social Publishing Handoffs: What to Give Your Operator","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"TikTok Publishing Schedule: Plan Windows, Not Magic Minutes","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"How to Organize a Multi-Account Social Media Inventory","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Why Does My TikTok Have Zero Views? A Diagnostic Workflow","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"TikTok Shadowban or Low Reach? How to Investigate","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"TikTok Publishing Failures: Separate Upload, Access and Reach","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic Brand Accounts: Native Content and Transparent Identity","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"Reddit Marketing and AGD: Contribute Before You Promote","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Community Marketing: How Brands Join Existing Conversations","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"Social Media Content Rights: A Publishing Checklist","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"AGD Campaign Review: Creative, Distribution and Evidence","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"How to Budget an AGD Experiment: Costs and Learning Goals","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"What Counts as a Viral TikTok? Define the Comparison","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"TikTok Viral Hit Rate: Define Attempts and Measure Outcomes","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"TikTok Analytics: Average vs Median Views Explained","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"Social Media Analytics: How to Read Performance Percentiles","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"Why a Few TikTok Posts Can Dominate Your Reach","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"Multi-Account Analytics: Measure Performance Concentration","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"How to Compare TikTok Campaigns with Matched Cohorts","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"Best Time to Post on TikTok? Test Timing Without the Myths","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"How Often Should You Post on TikTok? Design a Useful Test","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Does TikTok Account Warming Work? An Experiment Protocol","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"Does TikTok Account Age Affect Reach? What to Compare","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"TikTok Slideshows vs Videos: How to Compare the Formats","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"TikTok Content Strategy: Recurring Series vs Spontaneous Posts","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"TikTok Creative Testing: Compare Ideas, Not Just Edits","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"TikTok Native Features: Test Their Creative Contribution","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"How to Measure Your TikTok Zero-View Rate","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Social Media Experiments: Confidence Intervals Explained","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"TikTok Case Studies and Survivorship Bias: What Is Missing?","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"Why TikTok Views Drop After a Viral Post","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Campaign Cohort Analysis: Compare Equally Mature Results","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"TikTok Marketing Attribution: UTMs, Visits and First Purchases","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"From TikTok Views to Sales: Measure the Customer Journey","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Social Media Experiment Template: Write the Plan First","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"When to Stop an AGD Experiment: Budget and Evidence Rules","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"How to Evaluate AGD Claims: Documentation, Examples and Tests","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI for AGD Marketing: From Creative Brief to Publishing Workflow","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"Agentic AGD: What an AI Distribution Agent Should Do","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"TokPortal’s Human API: Briefs, Native Actions and Receipts","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"TokPortal MCP Workflows: Connect AI to Social Operations","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"What Does a TokPortal Dry Run Do? Preview Scope and Limits","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"API Retry Safety: Avoid Duplicate Social Publishing Operations","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"Social Publishing Webhooks: Events, Status and Recovery","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"How to Set a Budget for an AI Marketing Agent","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"AI Marketing Automation: When to Increase Agent Autonomy","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Social Media API Automation: Keep the Editorial Brief Intact","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Content Routing for Multiple Social Accounts","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"How to Organize Social Creative by Idea and Mechanism","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"Social Media Monitoring: Build Useful Operational Alerts","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human Review for AI Content: Approve the Version That Ships","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Marketing Automation Records: Build a Reliable Source of Truth","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"AGD and SEO: Turn Social Ideas into Searchable Articles","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic SEO for AGD: Structure Useful, Distinct Pages","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"Writing AGD Content That Search and AI Can Cite","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"Internal Linking for AGD Content: Connect Concepts Clearly","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Multilingual Content Strategy: When to Expand Your AGD Site","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"AGD Article Schema: Structure Text, Stories and Real Examples","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"AI Agent Audit Logs: Trace Marketing Actions and Decisions","dek":"An agent log connects intent, tool, result and next decision."}}]}],"$Lf","$L10"]}]
11:T5c3,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://theorganiclub.com/en/read/creative/formatted-account/#article","headline":"TikTok Content Series: Build a Repeatable Format","description":"A Formatted Account uses a repeatable creative structure an audience can recognize.","inLanguage":"en","datePublished":"2026-09-08T12:00:00Z","dateModified":"2026-09-09T07:41:56.167Z","image":["https://theorganiclub.com/images/editorial/formatted-account.jpg"],"author":{"@type":"Organization","name":"Valentine","url":"https://theorganiclub.com/en/about/#valentine","image":"https://theorganiclub.com/images/authors/valentine.jpg"},"publisher":{"@type":"Organization","name":"THE ORGANIC CLUB","url":"https://theorganiclub.com"},"mainEntityOfPage":"https://theorganiclub.com/en/read/creative/formatted-account/","articleSection":"Creative culture","wordCount":542,"citation":["https://www.tiktok.com/@khaby.lame/video/6964004569479204101","https://newsroom.tiktok.com/khaby-lame-100-million-followers-congratulations?lang=en-150"]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"THE ORGANIC CLUB","item":"https://theorganiclub.com/en/"},{"@type":"ListItem","position":2,"name":"Creative culture","item":"https://theorganiclub.com/en/topics/creative/"},{"@type":"ListItem","position":3,"name":"TikTok Content Series: Build a Repeatable Format","item":"https://theorganiclub.com/en/read/creative/formatted-account/"}]}]}1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],["$","$L12",null,{"article":{"id":"019","slug":"formatted-account","term":"Formatted Account","category":"creative","kind":"guide","image":"formatted-account","tier":"operating","evidence":"editorial","sources":[],"related":["chaotic-account","faceless-account","distribution-is-the-moat"],"en":{"title":"TikTok Content Series: Build a Repeatable Format","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize.","point":"A Formatted Account uses a repeatable creative structure an audience can recognize. Repetition concerns the promise, not necessarily the substance.","body":["“One setting, one avoided mistake” is a format: every episode can teach something different. A colored background with three arbitrary sentences is only a template. Record what stays fixed and what varies. That separation makes testing clearer while preventing the series from exhausting itself.","A useful episode may slightly break its format to serve the subject. Keep the promise but adjust length when the explanation requires it. Record that exception so it is not confused with a strategic change. Consistency helps readers recognize what they receive; it should not become a restriction that prevents explanation. A format earns its place by making good ideas easier to deliver."],"action":["Define the recurring promise in one sentence.","Prepare ten episodes with different lessons."],"trap":"Recognizing a format does not guarantee the next episode offers anything new.","quote":"A recurring format beats an empty template.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A recurring format beats an empty template.","text":"A Formatted Account uses a repeatable creative structure an audience can recognize.","media":"/images/editorial/formatted-account.jpg"},{"label":"THE CONCEPT","title":"Formatted Account","text":"A Formatted Account uses a repeatable creative structure an audience can recognize. Repetition concerns the promise, not necessarily the substance.","media":"/images/editorial/formatted-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Recognizing a format does not guarantee the next episode offers anything new.","media":"/images/editorial/formatted-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the recurring promise in one sentence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/formatted-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Prepare ten episodes with different lessons.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/formatted-account.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"A series is a promise with room for a new answer.","paragraphs":["The best reason to repeat a format is that viewers understand what kind of reward they are about to receive. A recurring repair demonstration, a one-question explanation or a before-and-after process can remove orientation work without making every episode identical. The stable structure creates room for the variable that matters: a different problem, object, misconception or result. If only the headline changes, the series is probably running out of editorial material.","Write the format as a contract with fixed and variable parts. Keep the opening situation, proof device or closing question stable where that helps comprehension. Change the actual problem and evidence. During review, ask whether the new episode teaches something the previous one did not. Maintain an archive of attempted variations so repetition is intentional rather than accidental. A formatted account can still experiment; it simply changes one part of a recognisable structure at a time. The format is valuable when it makes the next useful idea easier to understand, not when it fills a calendar without decisions.","A recurring format gives a collaboration somewhere to land. In the Khaby reference, the cited interview and caption identify a guest and an apple premise; the account's established identity is the context for that collaboration. The broader lesson is to decide which part of your series remains stable when a new guest, product or problem appears. It might be the question, the reveal or the way a common complication is examined. Write a version with an unfamiliar subject to test the structure. If the format only works with one exceptional guest, it may be a successful episode rather than a sustainable programme."],"diagram":{"kind":"compare","title":"The anatomy of a repeatable format","items":[{"label":"Fixed","detail":"The promise and viewing grammar people recognise.","value":0},{"label":"Variable","detail":"The new problem, object or evidence in this episode.","value":0},{"label":"Testable","detail":"One deliberate change whose effect you can discuss.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Look for the repeatable viewing grammar in the example. Then distinguish the episode’s actual substance from the shell that could recur. Public familiarity with a format does not establish that repetition alone caused its results.","caseIds":["khaby-apple-del-piero"]},"examples":[{"id":"khaby-apple-del-piero","platform":"tiktok","url":"https://www.tiktok.com/@khaby.lame/video/6964004569479204101","creator":"Khabane lame","title":"A recurring comic persona meets a guest","description":"Khaby Lame’s post involves an apple and footballer Alessandro Del Piero. TikTok’s interview identifies the collaboration, and the official caption dedicates the apple to Del Piero.","mechanism":"Use a recurring premise as the stable part of a collaboration. The guest is the variable; the audience still needs to recognize what the account is for.","limitation":"Verifies the collaboration and its apple premise. Full visual sequencing was not independently observed, and no retention or follower-growth claim is inferred.","observationBasis":"Source-described; full video not independently watched; post identity checked through official oEmbed","checkedAt":"2026-09-08T00:00:00Z","references":["https://newsroom.tiktok.com/khaby-lame-100-million-followers-congratulations?lang=en-150"]}],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"valentine","media":{"kind":"photograph","src":"/images/editorial/formatted-account.jpg","width":1280,"height":960,"alt":{"en":"Repeating rounded concrete balconies on Chicago’s River City apartments."},"credit":"w_lemay","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 23b78937a31d7f80187e6a7a408758763669adfd.","source":"https://commons.wikimedia.org/wiki/File:River_City,_Wells_Street_and_Polk_Street,_Chicago,_IL_-_54519335782.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},"lang":"en","next":{"id":"020","slug":"chaotic-account","term":"Chaotic Account","category":"creative","kind":"essay","image":"chaotic-account","tier":"operating","evidence":"editorial","sources":[],"related":["ai-persona","formatted-account","distribution-is-the-moat"],"en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template.","point":"A Chaotic Account allows several formats rather than one rigid template. In AGD, chaotic means flexible, not devoid of audience or logic.","body":["A founder can post a screenshot, an anecdote and a demo without losing their voice. The connection is their view of work. Organize content by purpose: explain, entertain, expose friction. Otherwise the week’s strongest post becomes an excuse to chase every trend.","Imagine a week built around missed appointments: a meme, an anecdote and a practical demonstration. Formats change while the problem remains recognizable. Compare responses within that content family. You can learn which treatment clarifies the situation without reducing the entire editorial direction to the format producing the biggest spike. This preserves flexibility while providing a meaningful basis for the next creative decision."],"action":["Keep a common audience across formats.","Label each post by purpose."],"trap":"Format diversity can complicate attribution; document what actually changed.","quote":"A chaotic account still has a point of view.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A chaotic account still has a point of view.","text":"A Chaotic Account allows several formats rather than one rigid template.","media":"/images/editorial/chaotic-account.jpg"},{"label":"THE CONCEPT","title":"Chaotic Account","text":"A Chaotic Account allows several formats rather than one rigid template. In AGD, chaotic means flexible, not devoid of audience or logic.","media":"/images/editorial/chaotic-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Format diversity can complicate attribution; document what actually changed.","media":"/images/editorial/chaotic-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep a common audience across formats.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/chaotic-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Label each post by purpose.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/chaotic-account.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"Change the surface without losing the narrator.","paragraphs":["A chaotic account can move from a joke to a demonstration to an unexpected reply while remaining recognisable. The continuity may live in its obsessions, timing or point of view rather than its visual template. That is different from publishing whatever the team happens to have ready. An editorial identity gives viewers a reason to accept a surprising post because it still feels like something this account would notice.","Write a small set of behavioural rules instead of a rigid layout guide. Define the kinds of tension the account enjoys, the subjects it understands and the claims it will not make. Review a mixed batch together and ask which post breaks the identity. Keep the discussion separate from whether each post is individually funny. When testing chaos against a recurring series, compare similar audiences and useful promises, not a carefully produced experiment against leftovers. A flexible account still needs records of its concepts, otherwise nobody can explain what the apparent randomness is teaching the team.","A chaotic account still needs a writer's room, even if that room is one person and a notes app. Keep a short list of recurring tensions, references the audience understands and lines the brand will not cross. The apparent disorder can live in the timing, the escalation or the visual treatment. The underlying promise should remain legible. Without that core, the account becomes a random collection of internet gestures, and every new post has to earn recognition from zero. The Duo example below offers a way to discuss serial fiction; it is not permission to copy the character or claim that shock alone caused the campaign's response."],"diagram":{"kind":"flow","title":"Coherence beneath changing formats","items":[{"label":"Point of view","detail":"A recognisable way of noticing the world.","value":0},{"label":"Boundaries","detail":"Subjects and claims that belong to this identity.","value":0},{"label":"Surprise","detail":"A new execution that still feels editorially plausible.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"The example shows a brand or creator making an unusual creative choice. Ask why the choice fits that identity. It does not establish that random publishing or constant format changes are a reliable strategy.","caseIds":["duolingo-dead-duo"]},"examples":[{"id":"duolingo-dead-duo","platform":"tiktok","url":"https://www.tiktok.com/@duolingo/video/7470561342009707822","creator":"Duolingo","title":"Duolingo turns a plot twist into a participation prompt","description":"Duo is struck by a Cybertruck in a staged gag; the owl then flies through exaggerated digital scenery. The observed embed thumbnail shows the mascot with crossed-out eyes against a sky.","mechanism":"Build a recurring character with recognizable motives before asking viewers to join its story. A sequel can create anticipation when the audience understands the premise.","limitation":"Shows a brand using serial fiction and a direct audience prompt. It does not establish that this particular post caused app installs or paid subscriptions.","observationBasis":"Source-described; full video not independently watched; public embed thumbnail and identity checked","checkedAt":"2026-09-08T00:00:00Z","references":["https://www.fastcompany.com/91313082/duolingo-dead-duo-owl-social-media-campaign"],"screenshot":{"src":"/images/social/duolingo-embed.jpg","alt":"Public tiktok player preview of Duolingo: Duolingo turns a plot twist into a participation prompt","source":"https://www.tiktok.com/@duolingo/video/7470561342009707822","capturedAt":"2026-09-08T00:00:00Z"}}],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"valentine","media":{"kind":"photograph","src":"/images/editorial/chaotic-account.jpg","width":1280,"height":960,"alt":{"en":"Graffiti, wall paintings, and parked bicycles on an Amsterdam street."},"credit":"Fons Heijnsbroek","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: d99302b5d7a919d63639110e4b3951ed8c4c5f9f.","source":"https://commons.wikimedia.org/wiki/File:Wall-paintings_and_urban_art_on_the_walls_in_Amsterdam_city.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},"previous":{"id":"018","slug":"faceless-account","term":"Faceless Account","category":"creative","kind":"guide","image":"faceless-account","tier":"operating","evidence":"editorial","sources":[],"related":["formatted-account","hook-slop","distribution-is-the-moat"],"en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible.","point":"A faceless TikTok creative needs a visible subject and a repeatable way to explain it. Finch’s seasonal-challenge post uses a character, familiar actions and completion cards to make a feature concrete. The example is branded animation, with an inspectable relationship between the scene and the product.","body":["Removing the presenter does not remove the editorial job. Somebody still has to decide what the viewer should recognise, what changes on screen and why the next scene belongs there. Finch’s post gives those decisions a simple structure: an ordinary action, a corresponding goal card and a completion cue. The same visual language can carry several examples without changing the subject.","That makes the clip useful to study alongside creator-led app demonstrations. One relies on a person explaining a problem; the other uses an animated world and interface elements. Both give the product a concrete role. Choose between those approaches by asking which can show your actual workflow clearly and which your team can maintain, rather than treating faceless content as an excuse to ship interchangeable slides."],"action":["Choose one feature and one ordinary action that makes it understandable.","Keep the same interface cues across scenes and show a truthful completion state.","Label animation as an explainer when it does not show a live interaction.","Review the asset, source files, publishing destination and observation window together."],"trap":"The Finch video is an animated feature explanation. Its public page does not establish paid versus organic distribution, feature adoption, retention or health outcomes.","quote":"A format needs something real to explain.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A format needs something real to explain.","text":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible.","media":"/images/editorial/faceless-account.jpg"},{"label":"THE CONCEPT","title":"Faceless Account","text":"A faceless TikTok creative needs a visible subject and a repeatable way to explain it. Finch’s seasonal-challenge post uses a character, familiar actions and completion cards to make a feature concrete. The example is branded animation, with an inspectable relationship between the scene and the product.","media":"/images/editorial/faceless-account.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The Finch video is an animated feature explanation. Its public page does not establish paid versus organic distribution, feature adoption, retention or health outcomes.","media":"/images/editorial/faceless-account.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose one feature and one ordinary action that makes it understandable.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/faceless-account.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep the same interface cues across scenes and show a truthful completion state.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/faceless-account.jpg"},{"label":"PUT IT TO WORK / 3","title":"Label animation as an explainer when it does not show a live interaction.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/faceless-account.jpg"},{"label":"PUT IT TO WORK / 4","title":"Review the asset, source files, publishing destination and observation window together.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/faceless-account.jpg"}]}]},"workshops":[{"id":"video","title":"Prepare the actual video slot, not just the caption","intro":"In the archived editor capture, the interface shows Video, Carousel and Story options, plus a target publishing period. The API example below is a separate documented slot-configuration preview; the screenshot alone does not establish the API contract.","endpoint":"PUT /api/ext/bundles/{id}/videos/{position}","code":"{\n  \"tool\": \"tokportal_configure_bundle_video\",\n  \"arguments\": {\n    \"id\": \"<real-bundle-uuid>\",\n    \"position\": 1,\n    \"body\": {\n      \"video_type\": \"video\",\n      \"video_url\": \"<public_url returned by your video upload>\",\n      \"description\": \"A practical example of organising freelance subscriptions.\",\n      \"target_publish_date\": \"<valid future date: YYYY-MM-DD>\",\n      \"ai_content_disclaimer\": false,\n      \"auto_publish\": false\n    },\n    \"dry_run\": true\n  }\n}","language":"json","explain":"Replace the marked values with an authorized real bundle, a media URL you control and a valid future date. This is a dry-run template, not an executed campaign. The archived UI shows a two-day period for that captured example; use the current API validation response to determine the dates accepted for your own request.","checks":[{"label":"Choose the correct media fields","detail":"A video needs video_url and description. A TikTok carousel instead needs carousel_images and tiktok_sound_url."},{"label":"Use a valid window","detail":"Allow at least three days while account creation is pending, or one day for delivered/existing accounts. Check the current response and limits."},{"label":"Read the preview result","detail":"Check the simulation markers and date validation. If INVALID_DATE includes details.earliest_allowed, use that returned limit to revise the proposed date. Never copy preview IDs into live requests."}],"sources":["https://developers.tokportal.com/mcp/","https://developers.tokportal.com/use-cases/no-code/mp4-delivered-account-preview/"],"checkedAt":"2026-09-09T11:43:29.854908Z","capture":{"src":"/images/tokportal/tokportal-video-editor.png","width":650,"height":565,"alt":"Two real TokPortal editor views showing media format, caption and target publishing period.","caption":"Two cropped views of the real video editor, captured 8 September 2026. Historical dates shown; use a valid future window for a new task.","source":"https://app.tokportal.com/dashboard"}}],"schemaVersion":2,"deepDive":{"heading":"Give each scene a job in the feature explanation.","paragraphs":["The keepsake scene works as an explanatory unit because the action and the card belong to the same idea. The viewer can connect the scene to the completion cue without learning an entirely new visual system. A useful creative brief would record that relationship, then list the next actions that can fit it. This is how a format becomes repeatable at the level of meaning. Merely exporting more scenes in the same colours would preserve the styling while leaving the story without a rule. Keep a small storyboard that shows the action, the corresponding product element and the reason the transition belongs there.","Animation gives an editor control over emphasis, but it also changes the kind of evidence on screen. The Finch clip illustrates a feature through designed scenes and UI cards. It does not let us test the real interaction, its loading state or any eligibility rules. For your own product, decide which explanation the viewer needs. An animation can clarify a concept; a screen recording can show where to tap. If you combine them, make the handoff legible and keep both faithful to the current product. A beautiful scene that implies a feature you do not offer creates a support problem after the view.","A reusable format also needs a production budget. List the assets the next episode would require: the character or narrator, the interface state, the motion, any sound and the product facts that need checking. A format that needs a new miniature film every week may be worthwhile, but it has different economics from a screen recording. Keep source files and label their relationship to the shipped version. That makes a correction possible when a feature name or interface changes, and it stops the team from confusing a folder of polished exports with a maintained publishing system.","To adapt the structure, sketch three goal examples for a product you actually use. Give each one a recognisable action and a true completion state. Keep the visual grammar fixed while the situation changes. You can then ask a useful creative question: which situation makes the feature easiest to understand? If you change the character, pacing, opening claim and goal at once, the next result will tell you much less about the source of the difference. This is a proposed experiment, so write the comparison and observation window before any posts go live.","An account can carry this format as one part of its editorial promise. Other posts may need a person, a screen recording or a direct answer to a user question. Keep those decisions connected to the audience’s task. At publication, check that the caption calls the asset what it is and that the link leads to the feature being explained. The TokPortal workflow below shows how a video slot can hold the media, caption and schedule together. It cannot convert an animated scene into proof of a live product interaction; that distinction belongs in the creative review."],"diagram":{"kind":"flow","title":"From a daily action to a visible completion cue","items":[{"label":"Action","detail":"Choose an ordinary situation the viewer can recognise.","value":0},{"label":"Product element","detail":"Show the goal or feature that corresponds to it.","value":0},{"label":"Changed state","detail":"Make completion visible without inventing a result.","value":0},{"label":"Next example","detail":"Repeat the relationship with a distinct situation.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Compare the animated action with the goal card next to it. The connection between them is the part worth borrowing for another product.","caseIds":["finch-seasonal-challenge"]},"examples":[{"id":"finch-seasonal-challenge","platform":"tiktok","url":"https://www.tiktok.com/@finchcare/video/7680612839656082702","creator":"Finch","title":"Finch: show the feature without a talking head","description":"An animated Finch bird acts out a seasonal challenge. Goal cards receive checkmarks; later scenes show multiple goals and a tree-shaped reward badge.","mechanism":"One recurring visual grammar connects a task, its completion and a reward. The product remains the subject while animation supplies the movement.","limitation":"This is branded animation with feature UI cards, not a live app walkthrough or UGC. No claim about organic reach, paid amplification, conversions or health outcomes is supported.","observationBasis":"Playback started and visual sequence inspected on 9 September 2026. Muted observation; no audio transcription or product test.","checkedAt":"2026-09-09T00:00:00Z","references":["https://www.tiktok.com/@finchcare/video/7680612839656082702","https://apps.apple.com/fr/app/finch-self-care-pet/id1528595748"],"frames":[{"src":"/images/social/finch-demo.jpg","alt":"Finch’s animated bird placing a keepsake beside a checked goal card.","source":"https://www.tiktok.com/@finchcare/video/7680612839656082702","capturedAt":"2026-09-09T00:00:00Z","crop":{"x":326,"y":16,"width":388,"height":688}}],"screenshot":{"src":"/images/social/finch-goals.jpg","alt":"Finch’s seasonal challenge explainer showing several goal cards with completion checkmarks.","source":"https://www.tiktok.com/@finchcare/video/7680612839656082702","capturedAt":"2026-09-09T00:00:00Z","crop":{"x":326,"y":16,"width":388,"height":688}},"breakdown":{"format":"Animated action → task card → completion","audience":"An app user who needs to understand what a seasonal challenge involves.","productRole":"The feature’s goals and completion cues remain visible inside the animation.","beats":[{"label":"Make the feature concrete","observed":"A seasonal challenge title introduces an illustrated bird, followed by a scene involving a keepsake.","reading":"The scene gives the feature an action instead of introducing it as a bundle of benefits. The visual is branded animation, so it should be read as explanation rather than proof of a live tap sequence."},{"label":"Connect the scene to the interface","observed":"A goal card appears alongside the action and receives a checkmark.","reading":"The card connects the story to a recognisable product element. It keeps the animation from floating free of the thing the account is explaining."},{"label":"Repeat a legible rule","observed":"Several goal cards with completion cues lead into reward imagery, including a tree-shaped badge.","reading":"The same action-to-completion relationship can organise multiple examples. Repetition helps explain the feature; it does not tell us how many viewers completed a goal or returned to the app."}],"transfer":{"title":"Give a faceless format something real to demonstrate.","scenario":"Original brief for a habit-tracker feature explainer.","hook":"Here is what completing one small goal looks like.","visual":"Animate one ordinary task next to a truthful representation of your app’s goal card. Show how the card changes when complete. If this is an animation, label it as an explainer and keep the actual interaction requirements accurate.","keep":"A visible link between action, interface state and outcome.","change":"Use your own character, graphics and product flow. The useful structure is not permission to reuse Finch’s artwork.","measure":"Compare which goal examples produce questions about the feature. Distinguish video engagement, feature use and longer-term retention in your own records."}}}],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T11:43:29.854908Z","author":"valentine","media":{"kind":"photograph","src":"/images/editorial/faceless-account.jpg","width":1280,"height":853,"alt":{"en":"A motorcyclist appears as a dark silhouette between headlights on a street at night."},"credit":"Tiomax80","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 28b410648b8d738726989e99d05ce42fe2b6b720.","source":"https://commons.wikimedia.org/wiki/File:Night_silhouettes._(9722264213).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}}}],"$L13","$L14","$L15","$L16"]}]
