3:["$","div",null,{"lang":"en","children":[["$","$Le",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI isn’t the problem. Sameness is.","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"50 accounts. One idea. Zero strategy.","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Does native really win? Show the data.","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"Your agent can publish. Teach it to wait.","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"One brand account cannot carry everything.","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"New subtitles do not make a new idea.","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"The feed did not add hours to the day.","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"Welcome to the feed arms race.","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Your SaaS competes with cat videos too.","dek":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"A row of phones is not a strategy.","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"AGD must outlive the name of its vendor.","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"A small manifesto for accounts with a reason to exist.","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"What we refuse to sell as growth.","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"Native is an environment, not a talisman.","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"A persona is not a photo and a name.","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"“Stop scrolling”: everybody is shouting the same thing.","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless. Not voiceless.","dek":"A Faceless Account creates content without relying on its operator’s visible face."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"A recurring format beats an empty template.","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"A chaotic account still has a point of view.","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"A synthetic character needs something to say.","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"One product. Three narrators. Three reasons.","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"A slideshow is a story, not a sliced PDF.","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"A little tension beats fifteen advice slides.","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Teach something before the final slide.","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"The joke should work without the logo.","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"The product enters when it becomes useful.","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Marketing caught brainrot. What next?","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"A good brief starts with what we want to learn.","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"The hook’s promise must be paid back.","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"Your creative library is not a final_final folder.","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"The format works. Until it just repeats.","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"The matrix that stops fifty copies from being born.","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"Warm an account without invoking magic.","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native posting: the action matters, so does the brief.","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Warming is not a robot dance.","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"A US account does not guarantee a US audience.","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Localization starts before the publish button.","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"Launching in the US from abroad: start with the scene.","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"Translate the words. Then rebuild the situation.","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"The account brief fits on one page.","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"The handoff that prevents “I thought you meant”.","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"A publishing window beats a sacred minute.","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"Your network starts with an accurate inventory.","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Zero views is not a diagnosis.","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"Shadowban is sometimes the name we give the unknown.","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"Different failures hidden inside “it does not work”.","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic does not mean undercover.","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"On Reddit, context is the entrance.","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Participate before distributing.","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"An asset folder needs evidence, not assumptions.","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"A retrospective starts with what we do not know.","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"A test also costs the time spent making sense of it.","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"Viral compared with what?","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"The denominator is half the story.","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"The average loves an overly good story.","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"P90 is not a new word for good.","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"The hit makes noise. The rest explains the system.","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"The network works. Or one account carries it.","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"Compare what is actually comparable.","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"7:42 p.m. is not a strategy.","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"Posting more: more chances or more noise?","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Warming deserves more than an anecdote.","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"An old account is not a control group.","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"Slideshow versus video: context comes first.","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"Series or chaos? A test, not a taste war.","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"Diversity also lives in what you learn.","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"Maybe it is not native. Maybe it is the feature.","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"A zero rate deserves a complete definition.","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Uncertainty is part of the result.","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"The missing accounts had results too.","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"After a hit, returning to earth is not always a failure.","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Day seven does not exist for yesterday’s visitor.","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"A UTM tells you about the click. Not the whole story.","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"A million views can miss the problem.","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Write possible verdicts before knowing the score.","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"Knowing when to stop is part of the test.","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"A hypothesis needs a label, not a disguise.","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI can think about the system before filling the calendar.","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"A distribution agent is not a talking calendar.","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"Behind the API, someone actually opens the app.","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"MCP connects tools. It does not write your strategy.","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"A preview must know what it does not simulate.","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"Retry without ordering twice.","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"A webhook reports an event. It does not replace your state.","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"An agent without a ceiling has no budget.","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"Autonomy is a ladder, not a switch.","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Your API is not a distribution strategy.","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Good content can land on the wrong account.","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"Group ideas without erasing their differences.","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"A useful alert tells you what to inspect.","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human review should contain a real decision.","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Documentation that says no beats a page promising everything.","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"A video can have a second life in search.","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic content needs a reason for every page.","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"To be cited, first be quotable.","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"A good link continues an idea.","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Two languages, two real reading experiences.","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"A strict schema frees the voice. It does not write it.","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"The log that makes tomorrow understandable.","dek":"An agent log connects intent, tool, result and next decision."}}]}],"$Lf","$L10"]}]
11:T4a7,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://naybu256.github.io/en/read/creative/ai-sameness/#article","headline":"AI isn’t the problem. Sameness is.","description":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute.","inLanguage":"en","datePublished":"2026-09-08T12:00:00Z","dateModified":"2026-09-08T17:06:44.287Z","image":["https://naybu256.github.io/images/signal.jpg"],"author":{"@type":"Organization","name":"FEEDRAID Editorial","url":"https://naybu256.github.io/en/about/"},"publisher":{"@type":"Organization","name":"FEEDRAID","url":"https://naybu256.github.io"},"mainEntityOfPage":"https://naybu256.github.io/en/read/creative/ai-sameness/","articleSection":"Creative culture","wordCount":218,"citation":[]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"FEEDRAID","item":"https://naybu256.github.io/en/"},{"@type":"ListItem","position":2,"name":"Creative culture","item":"https://naybu256.github.io/en/topics/creative/"},{"@type":"ListItem","position":3,"name":"AI isn’t the problem. Sameness is.","item":"https://naybu256.github.io/en/read/creative/ai-sameness/"}]}]}1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],["$","$L12",null,{"article":{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","kind":"essay","image":"ai-sameness","tier":"editorial","evidence":"editorial","sources":[],"related":["hook-slop","content-isolation","account-persona"],"en":{"title":"AI isn’t the problem. Sameness is.","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute.","point":"AI Slop describes output that puts volume ahead of distinctiveness and usefulness. It is an editorial judgment about the result, not an automatic diagnosis based on which tool made it.","body":["Sometimes you recognize the brief before you understand the video. Two seconds of surprise, a voice that never doubts, three benefits, an imaginary button. The issue is not that a machine speaks. It is that nobody seems to have anything to say.","AI can widen the creative field: prototype a setting, try a narrative, visualize something impossible to film. It can also compress twenty perspectives into one perfectly forgettable average. Output speed cannot distinguish those uses.","In an AGD network, diversity should survive the removal of account names. Mix nine posts from three personas and ask someone to reconstruct the groups. If the only difference is subtitle color, you have probably distributed a template rather than identities.","Before adding variants, change a fundamental choice: the conflict, the intended audience or the knowledge offered. An idea worth a human version may deserve a synthetic version too. The reverse does not become true because a subscription includes a thousand generations."],"action":["Mix nine posts and test whether personas remain recognizable.","Change the perspective before the rendering.","Delete passages that communicate nothing."],"trap":"High output does not demonstrate creative diversity or audience satisfaction.","quote":"Your generator doesn’t need a better prompt. Your account needs a point of view.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your generator doesn’t need a better prompt. Your account needs a point of view.","text":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"AI Slop","text":"AI Slop describes output that puts volume ahead of distinctiveness and usefulness. It is an editorial judgment about the result, not an automatic diagnosis based on which tool made it.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"High output does not demonstrate creative diversity or audience satisfaction.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Mix nine posts and test whether personas remain recognizable.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Change the perspective before the rendering.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 3","title":"Delete passages that communicate nothing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"illustration","src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"en":"An analogue CRT monitor projects a green signal into a dark room."},"credit":"FEEDRAID Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/signal.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"}},"lang":"en","next":{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","kind":"guide","image":"account-isolation","tier":"canonical","evidence":"editorial","sources":[],"related":["content-isolation","multi-account-strategy","account-persona"],"en":{"title":"50 accounts. One idea. Zero strategy.","dek":"Account Isolation: differentiate the voices before multiplying the profiles.","point":"Account Isolation is the AGD principle that gives every account a sufficiently distinct identity, audience and purpose to operate as an independent editorial surface.","body":["A different avatar does not create a new audience. If every account describes the same product with the same humor for the same people, you have mostly multiplied the credentials to manage. The network exists technically; its editorial logic is still missing.","Consider a note-taking app. One account can cover lectures, another fiction writing, another meeting notes. The demonstrations share a product, but their situations, references and success criteria change. That distance makes the experiments readable.","Write three sentences for each account: who it addresses, what it promises and what it refuses to publish. The last one does the most work. It stops every success elsewhere in the network from becoming an instruction to copy.","Isolation here is not a method for hiding account relationships or bypassing enforcement. It concerns distribution diversity. An audience that understands who is speaking is a more durable asset than infrastructure designed to remain incomprehensible."],"action":["Define an audience, a promise and a refusal for each account.","Compare comments for genuinely different uses.","Revise accounts whose roles overlap."],"trap":"Editorial differentiation should not be confused with technical concealment.","quote":"Another account is only useful when it brings another perspective.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Another account is only useful when it brings another perspective.","text":"Account Isolation: differentiate the voices before multiplying the profiles.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Account Isolation","text":"Account Isolation is the AGD principle that gives every account a sufficiently distinct identity, audience and purpose to operate as an independent editorial surface.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Editorial differentiation should not be confused with technical concealment.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define an audience, a promise and a refusal for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Compare comments for genuinely different uses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 3","title":"Revise accounts whose roles overlap.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"illustration","src":"/images/current.jpg","width":1536,"height":1024,"alt":{"en":"Silver fish diverge into separate directions through a dark ocean."},"credit":"FEEDRAID Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/current.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"}},"previous":{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","tier":"canonical","evidence":"editorial","sources":[],"related":["account-isolation","content-isolation","content-saturation"],"en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","point":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","body":["The pitch fits in a browser tab: one generator, a few prompts, fifty videos. The problem starts after export. Who watches? Why should that person stop at this account instead of the next one? Production has a button. Distribution still needs a reason to exist.","A brand account is often asked to reassure, sell, entertain, recruit and explain. Every post negotiates with the others. AGD separates those jobs. One account explores student frustrations; another challenges work habits; a third demonstrates a product in context. One company, three editorial promises.","The trap is reading this architecture as a volume recipe. Thirty accounts running the same edit do not represent thirty ideas. They mostly multiply coordination, repetition and unanswered questions. Diversification lives in what a viewer receives, not in the number of rows in a spreadsheet.","AGD is a proposed framework drawn from the TokPortal blueprint, not an academic consensus or a reach guarantee. Its value depends on the experiments it helps run. The useful question is whether a network reveals something that one account would hide. Can the signal be connected to an angle, an audience or a format?","Build a small network whose differences you can explain. Document the failures alongside the breakout posts. And keep a commercial measure next to views: somebody enjoying your edit does not necessarily have a problem your product solves."],"action":["Write a different editorial promise for each account.","Attach each post to a hypothesis and an audience.","Measure by cohort, then inspect qualified visits."],"trap":"A clone network can increase output without adding a single perspective.","quote":"The next advantage is knowing where an idea deserves to live.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The next advantage is knowing where an idea deserves to live.","text":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account-Generated Distribution","text":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A clone network can increase output without adding a single perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a different editorial promise for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach each post to a hypothesis and an audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 3","title":"Measure by cohort, then inspect qualified visits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"video":{"src":"/video/below-the-surface.mp4","poster":"/images/iceberg.jpg","caption":{"en":"Below the surface — animated original illustration. No audio."},"tracks":{"en":"/video/intro-en.vtt"}},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"FEEDRAID Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"}}}],"$L13","$L14","$L15","$L16"]}]
