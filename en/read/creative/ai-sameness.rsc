13:["$","header",null,{"className":"article-header","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","a",null,{"href":"/en/","children":"FEEDRAID"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/en/topics/creative/","children":"Creative culture"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"AI Slop"}]]}],["$","div",null,{"className":"mono acid","style":{"marginTop":28},"children":["POINT OF VIEW"," ","· ","002"]}],["$","h1",null,{"children":"AI isn’t the problem. Sameness is."}],["$","p",null,{"className":"article-dek","children":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}],["$","div",null,{"className":"byline","children":[["$","span",null,{"className":"author-mark","children":"F↗"}],["$","a",null,{"href":"/en/about/","children":"The editorial desk"}],["$","span",null,{"className":"muted","children":["08/09/2026"," ","· ",2," min"]}],["$","span",null,{"className":"evidence-tag","children":"Editorial analysis"}]]}]]}]
