14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/story-slideshow.jpg","alt":"An analogue cinema projector displayed outside the Onomichi Cinema Museum.","width":1280,"height":851,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Onomichi_Cinema_Museum_film_projector_ac_(1).jpg","children":"Asturio Cantabrio"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/4.0","children":"CC BY-SA 4.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/creative/story-slideshow/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"A Story Slideshow organizes a sequence around a situation and its resolution. Its value is narrative; it does not depend on a magic slide count."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Open with a concrete choice: recover your notes or improvise in front of a client. Show what complicates the choice and what resolves it. A product can enter when it becomes useful. Remove it from the draft: if the entire scene collapses, you may have written an ad without a story."}],["$","p","1",{"children":"Write two endings before production: one shows what the person learned, another immediately pushes a purchase. If the first better serves the subject, keep it. A CTA can follow without stealing the resolution. Readers should distinguish the story’s value from the commercial next step. This also makes it possible to test that next step without rebuilding the entire narrative each time."}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Give the small story an actual turn."}],["$","p",null,{"children":"A story does not need a dramatic life event. It can begin with a reasonable assumption, encounter one detail that breaks it and end with a better decision. For a product article, that might be someone discovering that their beautifully organised notes still contain no usable next step. The turn gives the reader a reason to reconsider the opening. Without it, the sequence is often a list of advice wearing story-shaped typography."}],["$","figure",null,{"className":"editorial-diagram diagram-timeline","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"The smallest useful story"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Before",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Before"}],["$","p",null,{"children":"A believable assumption or working situation."}],false]}]]}],["$","li","Turn",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Turn"}],["$","p",null,{"children":"One detail makes the old interpretation insufficient."}],false]}]]}],["$","li","After",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"After"}],["$","p",null,{"children":"A different decision follows from that detail."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Draft the story in three plain sentences before making slides. State the situation, the interruption and the consequence. Then ask what needs to be shown rather than explained. A real interface detail or a clearly labelled illustrative example can carry the turn more effectively than another abstract slogan. Keep fictional scenarios identifiable as examples; do not present them as customer research. Let the product enter when it has a role in resolving the problem. If it appears only as an unrelated final slide, the story and the commercial intention probably belong to different briefs."}]]]}],false,false,"$L19","$undefined","$L1a","$L1b","$L1c","$L1d"]}],"$L1e"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L1f","025",{"a":{"id":"025","author":"valentine","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","kind":"guide","image":"educational-slideshow","media":"$1:props:children:1:props:next:media","en":{"title":"Educational TikTok Content: Turn a Real Process into a Story","dek":"An educational slideshow communicates usable knowledge during reading."},"readingMinutes":4},"lang":"en"}],["$","$L1f","023",{"a":{"id":"023","author":"valentine","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","kind":"guide","image":"slideshow-agd","media":"$1:props:children:1:props:previous:media","en":{"title":"TikTok Slideshow Strategy: Story Structure for AGD","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."},"readingMinutes":2},"lang":"en"}],["$","$L1f","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://theorganiclub.com/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://theorganiclub.com/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
