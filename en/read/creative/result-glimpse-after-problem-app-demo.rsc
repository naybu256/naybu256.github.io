3:["$","div",null,{"lang":"en","children":[["$","$Lf",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI Content for Social Media: How to Avoid Generic Output","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"Account Isolation in AGD: Build Distinct Social Accounts","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Native Posting vs API Posting on TikTok: What Can You Test?","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"TokPortal MCP Tutorial: Preview an AI Workflow with Dry Run","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"AGD for TikTok 101: Accounts, Content and Your First Tests","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"Content Isolation: How to Differentiate a Multi-Account Strategy","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"How AGD Changes the Competition for Organic Reach","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"AGD vs Phone Farms: Strategy, Accounts and Infrastructure","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"How to Build an AGD Strategy with Your Existing Tools","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"AGD Marketing Principles: A Practical Editorial Framework","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"AGD Marketing Mistakes: Volume, Copying and False Promises","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"What Is a Native TikTok Account? Context and Limitations","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"How to Build a Social Media Persona: The Duolingo Example","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"TikTok Hook Examples: Replace Clickbait with a Clear Payoff","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"TikTok Content Series: Build a Repeatable Format","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"AI Personas for Social Media: Character Design and Disclosure","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"Persona-Based AGD: Give Each Account a Distinct Voice","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"TikTok Slideshow Strategy: Story Structure for AGD","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"How to Structure a TikTok Slideshow as a Story","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Educational TikTok Content: Turn a Real Process into a Story","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"Brand Memes on TikTok: What Ryanair’s Persona Can Teach You","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"TikTok Product Discovery: Lessons from the Ocean Spray Video","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"How to Write a TikTok Creative Brief with a Concrete Example","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"How to Build a TikTok Creative Library from Real Examples","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"TikTok Content Fatigue: When to Refresh a Recurring Format","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"Creative Testing Matrix: Lessons from LEGO’s Instagram Reel","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"TikTok Account Warming: Define a Relevant, Testable Routine","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native TikTok Posting: Workflow, Features and Quality Checks","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Native Account Warming: Actions, Records and Limits","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"US TikTok Accounts: Geography, Setup and Audience Limits","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Geo-Posting for TikTok: Location Context vs Audience Targeting","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"How to Reach US TikTok Audiences from Abroad","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"TikTok Content Localization: Go Beyond Translation","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"Social Media Account Brief: Audience, Voice and Publishing Rules","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"Social Publishing Handoffs: What to Give Your Operator","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"TikTok Publishing Schedule: Plan Windows, Not Magic Minutes","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"How to Organize a Multi-Account Social Media Inventory","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Why Does My TikTok Have Zero Views? A Diagnostic Workflow","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"TikTok Shadowban or Low Reach? How to Investigate","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"TikTok Publishing Failures: Separate Upload, Access and Reach","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic Brand Accounts: Native Content and Transparent Identity","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"Reddit Marketing and AGD: Contribute Before You Promote","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Community Marketing: How Brands Join Existing Conversations","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"Social Media Content Rights: A Publishing Checklist","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"AGD Campaign Review: Creative, Distribution and Evidence","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"How to Budget an AGD Experiment: Costs and Learning Goals","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"What Counts as a Viral TikTok? Define the Comparison","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"TikTok Viral Hit Rate: Define Attempts and Measure Outcomes","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"TikTok Analytics: Average vs Median Views Explained","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"Social Media Analytics: How to Read Performance Percentiles","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"Why a Few TikTok Posts Can Dominate Your Reach","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"Multi-Account Analytics: Measure Performance Concentration","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"How to Compare TikTok Campaigns with Matched Cohorts","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"Best Time to Post on TikTok? Test Timing Without the Myths","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"How Often Should You Post on TikTok? Design a Useful Test","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Does TikTok Account Warming Work? An Experiment Protocol","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"Does TikTok Account Age Affect Reach? What to Compare","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"TikTok Slideshows vs Videos: How to Compare the Formats","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"TikTok Content Strategy: Recurring Series vs Spontaneous Posts","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"TikTok Creative Testing: Compare Ideas, Not Just Edits","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"TikTok Native Features: Test Their Creative Contribution","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"How to Measure Your TikTok Zero-View Rate","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Social Media Experiments: Confidence Intervals Explained","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"TikTok Case Studies and Survivorship Bias: What Is Missing?","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"Why TikTok Views Drop After a Viral Post","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Campaign Cohort Analysis: Compare Equally Mature Results","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"TikTok Marketing Attribution: UTMs, Visits and First Purchases","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"From TikTok Views to Sales: Measure the Customer Journey","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Social Media Experiment Template: Write the Plan First","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"When to Stop an AGD Experiment: Budget and Evidence Rules","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"How to Evaluate AGD Claims: Documentation, Examples and Tests","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI for AGD Marketing: From Creative Brief to Publishing Workflow","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"Agentic AGD: What an AI Distribution Agent Should Do","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"TokPortal’s Human API: Briefs, Native Actions and Receipts","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"TokPortal MCP Workflows: Connect AI to Social Operations","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"What Does a TokPortal Dry Run Do? Preview Scope and Limits","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"API Retry Safety: Avoid Duplicate Social Publishing Operations","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"Social Publishing Webhooks: Events, Status and Recovery","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"How to Set a Budget for an AI Marketing Agent","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"AI Marketing Automation: When to Increase Agent Autonomy","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Social Media API Automation: Keep the Editorial Brief Intact","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Content Routing for Multiple Social Accounts","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"How to Organize Social Creative by Idea and Mechanism","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"Social Media Monitoring: Build Useful Operational Alerts","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human Review for AI Content: Approve the Version That Ships","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Marketing Automation Records: Build a Reliable Source of Truth","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"AGD and SEO: Turn Social Ideas into Searchable Articles","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic SEO for AGD: Structure Useful, Distinct Pages","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"Writing AGD Content That Search and AI Can Cite","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"Internal Linking for AGD Content: Connect Concepts Clearly","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Multilingual Content Strategy: When to Expand Your AGD Site","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"AGD Article Schema: Structure Text, Stories and Real Examples","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"AI Agent Audit Logs: Trace Marketing Actions and Decisions","dek":"An agent log connects intent, tool, result and next decision."}},{"id":"101","slug":"delivered-account-slot-approval-checklist","category":"machines","term":"Delivered-account slot approval","en":{"title":"How should you approve one delivered-account video slot after a dry run?","dek":"For an existing delivered account, the useful question is not what dry run is. It is how to turn one simulated slot configuration into a clear human go/no-go decision without leaking preview artifacts into live execution."}},{"id":"102","slug":"problem-first-or-screen-first-app-demo","category":"creative","term":"Problem-first opening","en":{"title":"Should your app demo start with the problem or the screen? Usually, name the problem first.","dek":"If the feature and promise stay fixed, leading with the user’s situation is often the more interpretable AGD test for app discovery content."}},{"id":"103","slug":"tokportal-video-reschedule-patch-or-put","category":"machines","term":"Endpoint choice for slot edits","en":{"title":"TokPortal video reschedule: use PATCH for partial edits, PUT for replacement","dek":"If a TokPortal video slot already contains the right media, the safer default for caption or date changes is PATCH. The docs make PUT a full replacement, which means omitted fields are cleared rather than preserved."}},{"id":"104","slug":"result-glimpse-after-problem-app-demo","category":"creative","term":"proof object","en":{"title":"After the problem hook, should an app demo show the result glimpse early? Usually, yes.","dek":"This is a narrower question than problem-first versus screen-first: once you have named the viewer’s job, an early glimpse of the finished output usually makes a search-intent demo easier to evaluate."}}]}],"$L10","$L11"]}]
12:T7c0,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://theorganiclub.com/en/read/creative/result-glimpse-after-problem-app-demo/#article","headline":"After the problem hook, should an app demo show the result glimpse early? Usually, yes.","description":"This is a narrower question than problem-first versus screen-first: once you have named the viewer’s job, an early glimpse of the finished output usually makes a search-intent demo easier to evaluate.","inLanguage":"en","datePublished":"2026-09-17T12:40:14.828Z","dateModified":"2026-09-17T12:40:14.828Z","image":["https://theorganiclub.com/images/daily/result-glimpse-after-problem-app-demo.jpg"],"author":{"@type":"Organization","name":"The Editorial Desk","url":"https://theorganiclub.com/en/about/#organic-club-editorial","image":"https://theorganiclub.com/images/authors/editorial-desk.jpg"},"publisher":{"@type":"Organization","name":"THE ORGANIC CLUB","url":"https://theorganiclub.com"},"mainEntityOfPage":"https://theorganiclub.com/en/read/creative/result-glimpse-after-problem-app-demo/","articleSection":"Creative culture","wordCount":2188,"citation":["https://newsroom.tiktok.com/creator-search-insights?lang=en","https://developers.tokportal.com/use-cases/no-code/mp4-delivered-account-preview/","https://support.tiktok.com/en/getting-started/for-you/test-for-you","https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","https://www.studyfetch.com/tools","https://developers.tokportal.com/mcp/"]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"THE ORGANIC CLUB","item":"https://theorganiclub.com/en/"},{"@type":"ListItem","position":2,"name":"Creative culture","item":"https://theorganiclub.com/en/topics/creative/"},{"@type":"ListItem","position":3,"name":"After the problem hook, should an app demo show the result glimpse early? Usually, yes.","item":"https://theorganiclub.com/en/read/creative/result-glimpse-after-problem-app-demo/"}]}]}14:T5bc,Below is a completed worked artifact for production use. Proposed data: Search job = “how to memorize biology terms fast.” Proposed data: Audience problem line = “I keep mixing up these four cell-respiration terms.” Proposed data: Proof object = “a review set titled Cell Respiration Review containing four mnemonic lines and one visible quiz card.” Human decision: Result glimpse should show the review-set title plus at least one mnemonic line in a single stable shot. Human decision: Inspectable return should hold long enough for a reviewer to read the title and two complete output lines without pausing. Filled decision rows: Row 1, opening problem: yes, speak or caption the exact study problem in plain language by second 1.5. Row 2, result glimpse: yes, show the completed review set between seconds 1.5 and 3.0; success means the artifact is recognisable as the solved state, not merely a decorative flash of interface chrome. Row 3, minimum steps: show only the note input and the mode selection needed to causally explain the output; omit account setup, idle loading, and unrelated menu tours. Row 4, inspectable return: hold on the generated set for roughly 2 to 3 seconds; success means an internal reviewer can verify title, topic match, and at least two readable lines. Row 5, usage moment: show one quiz card or recall check using the generated material; success means the output is used to complete the job, not just displayed as a claim.15:T49b,Worked example — HYPOTHETICAL SAMPLE INPUTS. Imagine a delivered account with bundle ID bnd_example_01 and slot position 1. The slot already contains a valid video_url, an approved description, and a TikTok sound URL. Editorial review decides only two things should change: the caption needs one clarification, and the acceptable publishing window should move from a start date of 2026-09-14 to an explicit UTC window spanning 2026-09-15T00:00:00Z through 2026-09-16T00:00:00Z. Because the media and platform-specific settings should remain untouched, the safer operation is a dry-run PATCH, not a reconstructive PUT. A hypothetical MCP-style request would look like this: {"name":"tokportal_patch_bundle_video","arguments":{"dry_run":true,"id":"bnd_example_01","position":1,"body":{"description":"Clarified caption for the same video asset.","target_publish_start_date":"2026-09-15T00:00:00Z","target_publish_end_date":"2026-09-16T00:00:00Z"}}}. The important point is not this exact JSON. It is the decision logic behind it: use PATCH because the intended edit is partial, and use dry_run because the same validation can be checked without producing live side effects [1][2].1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],["$","$L13",null,{"article":{"schemaVersion":2,"id":"104","slug":"result-glimpse-after-problem-app-demo","category":"creative","term":"proof object","kind":"guide","image":"result-glimpse-after-problem-app-demo","tier":"editorial","evidence":"editorial","sources":["https://newsroom.tiktok.com/creator-search-insights?lang=en","https://developers.tokportal.com/use-cases/no-code/mp4-delivered-account-preview/","https://support.tiktok.com/en/getting-started/for-you/test-for-you"],"related":["problem-first-or-screen-first-app-demo","attention-war","creative-brief","human-review"],"en":{"title":"After the problem hook, should an app demo show the result glimpse early? Usually, yes.","dek":"This is a narrower question than problem-first versus screen-first: once you have named the viewer’s job, an early glimpse of the finished output usually makes a search-intent demo easier to evaluate.","point":"For TikTok search-intent app demos, a practical default is problem → result glimpse → minimum steps → inspectable return.","body":["This article addresses a narrower editing decision than our separate piece on whether an app demo should begin with the problem or with the product screen. Here, assume the opening problem is already on screen. The next question is what to do immediately after that: cut into the workflow, or briefly show the finished output first. For search-intent demos, I think the stronger default is usually a short result glimpse. That framing is intentionally distinct from the opening-hook question: the earlier article is about the first orientation move; this one is about the proof move that follows it.","TikTok’s documentation provides context, not a creative rulebook. TikTok says Search helps people explore and learn, and says Creator Search Insights can surface often-searched and content-gap topics in select regions [1]. From that, the cautious inference is that query-fit matters. It does not follow that one edit sequence is officially preferred, or that a result glimpse will outperform every other structure. My claim is editorial and conditional: when someone arrives with a narrow practical query, a fast look at the solved state can help them decide sooner whether the video matches the job they came to solve.","The recurring app-demo failure is not “too little product.” It is procedure without destination. Teams say “show the feature,” then the video becomes taps, menus, and cursor movement before the audience knows what those actions are building toward. A result glimpse changes the meaning of the steps that follow. The viewer is no longer waiting to discover the point of the demo; they are watching how a visible output was produced. That difference matters most when the searcher is trying to answer a concrete question such as: Will this make a usable quiz card, a clean summary, a categorized expense sheet, or a caption draft I can actually inspect?","That is why I use the term proof object. A proof object is the specific finished artifact the viewer can judge on screen. It is not the feature category and not the marketing promise. “Study faster” is a claim. “A mnemonic list for four biology terms plus one quiz card” is a proof object. “Organize spending” is a claim. “A sheet with recurring subscriptions grouped by merchant and one flagged duplicate charge” is a proof object. Once the brief names the proof object, the editor can decide three concrete things: what counts as a recognisable result glimpse, which steps are truly necessary, and how long the video must return to the output for inspection.","A directly relevant archival case is the StudyFetch example, not because it proves performance, but because it is already an app-demo pattern. The archived case section should visibly show readers the post URL, references, and checked date: checked 2026-09-09, based on muted visual inspection, with limitations preserved. What is supportable from that archive is modest and useful: the creator introduces a specific memorisation task, the video shows a filmed laptop with the corresponding prompt, and a mnemonic answer is visible before the clip returns to the creator. That makes it a closer analogue for this article than a food-prep video. It shows problem continuity, visible product action, and a readable output without requiring us to infer unsupported steps or outcomes from a distant category.","$14","The execution criteria need to stay concrete because “show the result” is otherwise too loose to review. Result glimpse standard: the shot must answer “what got made?” within about one second, using legible output rather than a generic dashboard view. A glimpse does not need full readability, but it must identify the class of artifact: summary, mnemonic set, itinerary, checklist, or similar. Inspectable return standard: the later hold must let a reviewer confirm that the output materially matches the opening problem. For the study example, that means the terms shown belong to the stated biology task and the mnemonic content is readable enough for a human reviewer to judge whether it is at least plausibly on-topic. APIs do not assess that creative adequacy. That judgment remains editorial and human.","TokPortal is relevant only after the creative is chosen. Its documented delivered-account MP4 preview workflow can validate one exact slot-configuration request against the API’s configuration rules for the current request and current account state, without publishing, replacing the slot, or buying new capacity [2]. That means a team can separately check whether a specific bundle ID, slot position, caption, direct MP4 URL, and future publish date are structurally valid now [2]. It does not tell you whether the result glimpse is clear, whether the inspectable return is long enough, whether the proof object is convincing, or whether later media or platform checks will accept the file for publication [2]. Keep the layers separate: human editors assess creative quality; the dry run assesses request validity under the current contract.","A final boundary matters. TikTok’s For You documentation notes that recommendations depend on multiple factors, and that content not suitable for a broad audience may also be harder to find in search [3]. So even a very clear search-intent structure is not a guarantee of findability, distribution, or downstream product outcomes. The practical value of this framework is narrower: it helps teams build demos that answer a searcher’s job more legibly, document the proof object in the brief, and review the finished cut against explicit human criteria instead of vague taste alone."],"action":["Add two required fields to every app-demo brief: “Proof object” and “Result glimpse pass condition.”","Use this review checklist before approval. Human decision 1: Can a relevant viewer tell by second 3 what finished artifact the demo claims to produce? Human decision 2: During the later inspectable return, can a reviewer read enough output to judge whether it matches the opening problem?","When comparing edits, hold the opening problem constant and test only the post-problem sequence: Version A goes straight to steps; Version B adds a brief result glimpse before the same steps.","If using a delivered-account workflow, dry-run the final slot request separately to validate the current request and account state before any live action [2]."],"trap":"Do not confuse configuration validity with persuasive proof. A dry run can confirm that one slot request is structurally valid now [2]; it cannot tell you whether the creative shows a meaningful result glimpse or an inspectable return.","quote":"After the problem is named, the viewer usually needs proof before procedure.","stories":[{"id":"story-proof-object-brief","title":"Define the proof before the walkthrough","slides":[{"label":"Slide 1","title":"Wrong level of brief","text":"“Show the AI study feature” describes a product area, not the thing a viewer will judge on screen.","media":"/images/daily/result-glimpse-after-problem-app-demo.jpg"},{"label":"Slide 2","title":"Better brief","text":"Name the proof object: “Show a completed Cell Respiration Review with four mnemonic lines and one quiz card.”","media":"/images/daily/result-glimpse-after-problem-app-demo.jpg"},{"label":"Slide 3","title":"What changes","text":"Now the editor can define a real result glimpse, choose minimum causal steps, and require an inspectable return.","media":"/images/daily/result-glimpse-after-problem-app-demo.jpg"}]},{"id":"story-review-criteria","title":"Make the sequence reviewable","slides":[{"label":"Slide 1","title":"Result glimpse","text":"A reviewer should recognize the solved state quickly, even if every word is not yet readable.","media":"/images/daily/result-glimpse-after-problem-app-demo.jpg"},{"label":"Slide 2","title":"Inspectable return","text":"Later, the output must stay on screen long enough to read and judge against the opening problem.","media":"/images/daily/result-glimpse-after-problem-app-demo.jpg"},{"label":"Slide 3","title":"Human decision","text":"Ask: does this artifact actually answer the job stated in the first line? That is an editorial judgment, not an API check.","media":"/images/daily/result-glimpse-after-problem-app-demo.jpg"}]}]},"deepDive":{"heading":"Differentiate the opening question from the proof question","paragraphs":["Source summary [1]: TikTok says Search helps people explore and learn, and says Creator Search Insights can surface often-searched topics and content-gap topics in select regions. That supports the broad idea that creators should think about query alignment, but it does not prescribe a winning edit order.","Source summary [2]: TokPortal’s delivered-account MP4 preview flow checks one requested video-slot configuration on a real delivered account without publishing, replacing the slot, or purchasing capacity. The documentation explicitly limits the preview to current request validation and current account state; it does not prove later media reachability, later platform acceptance, publication, or audience outcome.","Source summary [3]: TikTok says For You recommendations reflect multiple factors and notes that content unsuitable for a broad audience may also be harder to find in search. This is a distribution boundary, not a creative endorsement of any specific demo structure.","The useful editorial distinction is this: article A asks whether to begin with the problem or the screen; article B asks what comes immediately after a problem-first opening. That separation reduces search-intent overlap and gives each page a distinct job. This page is about the proof object and its review criteria, not about the first-frame hook alone.","A good production rule is to separate proposed data from human judgment. Proposed data can include the query target, the proof object, the planned timestamps, and the slot request fields for a later dry run. Human decisions include whether the result glimpse is recognisable, whether the inspectable return is readable, whether the output actually addresses the opening problem, and whether the creative should ship at all. No API in the supplied material assesses those creative questions."],"diagram":{"kind":"compare","title":"Two adjacent but different app-demo questions","caption":"Editorial distinction to reduce overlap between related articles.","items":[{"label":"Opening question","detail":"Problem first or screen first? This is about the first orientation move.","value":1},{"label":"Current article","detail":"After a problem-first opening, show steps immediately or show a result glimpse first?","value":2},{"label":"Proof object","detail":"Define the exact finished artifact the viewer can judge.","value":3},{"label":"Review standard","detail":"Check recognisable glimpse first, readable inspection later.","value":4}]},"caseLens":"The StudyFetch archival case is the better fit because it is already an app-demo example. Its visible sequence supports a narrow structural lesson: a specific study problem leads into a corresponding product prompt and then a visible answer. Readers should also see its limitations and archival date clearly: checked 2026-09-09, muted visual inspection, no claim about endorsement, accuracy, distribution, or conversion.","caseIds":["studyfetch-mnemonic"]},"examples":[{"id":"studyfetch-mnemonic","platform":"tiktok","url":"https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","creator":"StudyFetchBella","title":"StudyFetch: make the study problem the opening","description":"The creator introduces a concrete memorisation task, then films the StudyFetch chat on a laptop. A prompt and its generated mnemonic are visible before the clip returns to the creator.","mechanism":"A narrow audience problem leads directly to the product operation that addresses it. The filmed screen gives the recommendation an inspectable object.","limitation":"The creator’s commercial relationship with StudyFetch was not verified. This visual inspection does not validate the educational answer or establish organic reach, paid amplification or conversions.","observationBasis":"Playback started and visual sequence inspected on 9 September 2026. Muted observation; no audio transcription or product test.","checkedAt":"2026-09-09T00:00:00Z","references":["https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","https://www.studyfetch.com/tools"],"frames":[{"src":"/images/social/studyfetch-hook.jpg","alt":"StudyFetchBella speaking to camera about a specific memorisation task.","source":"https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","capturedAt":"2026-09-09T00:00:00Z","crop":{"x":326,"y":16,"width":388,"height":688}}],"screenshot":{"src":"/images/social/studyfetch-demo.jpg","alt":"The StudyFetch chat interface on a filmed laptop, with an entered study question and a mnemonic answer.","source":"https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","capturedAt":"2026-09-09T00:00:00Z","crop":{"x":326,"y":16,"width":388,"height":688}},"breakdown":{"format":"Specific problem → filmed app → usable answer","audience":"A student trying to remember a defined set of terms.","productRole":"StudyFetch is shown answering the task introduced by the creator.","beats":[{"label":"Name the job before the app","observed":"The creator speaks to camera about memorising four terms and counts them on her fingers.","reading":"The opening lets a relevant viewer recognise their own problem. It gives the later app appearance a reason to be in the video, beyond a generic claim that AI saves time."},{"label":"Show the request","observed":"The view changes to a filmed laptop with StudyFetch’s chat and a prompt about the same memorisation task.","reading":"The continuity matters: the product addresses the exact problem introduced earlier. A cut to an unrelated dashboard would supply branding while withholding the useful connection."},{"label":"Expose the output","observed":"The answer contains a mnemonic with words mapped to the terms; the clip then returns to the creator.","reading":"The viewer can inspect what the tool produced. The output’s presence is observable; its accuracy and usefulness still require subject-matter checking. That distinction should survive any adaptation."}],"transfer":{"title":"One audience problem. One visible product action.","scenario":"Original brief for a study app demonstration.","hook":"I keep mixing up these four terms, so I tried this.","visual":"Use a study question you can verify. Show the problem, enter the request in the actual app and display the answer long enough to read. Correct any mistake on screen instead of hiding it in the edit.","keep":"The same problem across the opening, prompt and answer.","change":"Use your own subject, recording and explanation. Do not impersonate this creator or imply their endorsement.","measure":"Record the source clip, concept, account, post URL and publication date. Read product questions separately from generic reactions; use your own click and signup evidence for conversion claims."}}}],"workshops":[{"id":"video","title":"Prepare the actual video slot, not just the caption","intro":"In the archived editor capture, the interface shows Video, Carousel and Story options, plus a target publishing period. The API example below is a separate documented slot-configuration preview; the screenshot alone does not establish the API contract.","endpoint":"PUT /api/ext/bundles/{id}/videos/{position}","code":"{\n  \"tool\": \"tokportal_configure_bundle_video\",\n  \"arguments\": {\n    \"id\": \"<real-bundle-uuid>\",\n    \"position\": 1,\n    \"body\": {\n      \"video_type\": \"video\",\n      \"video_url\": \"<public_url returned by your video upload>\",\n      \"description\": \"A practical example of organising freelance subscriptions.\",\n      \"target_publish_date\": \"<valid future date: YYYY-MM-DD>\",\n      \"ai_content_disclaimer\": false,\n      \"auto_publish\": false\n    },\n    \"dry_run\": true\n  }\n}","language":"json","explain":"Replace the marked values with an authorized real bundle, a media URL you control and a valid future date. This is a dry-run template, not an executed campaign. The archived UI shows a two-day period for that captured example; use the current API validation response to determine the dates accepted for your own request.","checks":[{"label":"Choose the correct media fields","detail":"A video needs video_url and description. A TikTok carousel instead needs carousel_images and tiktok_sound_url."},{"label":"Use a valid window","detail":"Allow at least three days while account creation is pending, or one day for delivered/existing accounts. Check the current response and limits."},{"label":"Read the preview result","detail":"Check the simulation markers and date validation. If INVALID_DATE includes details.earliest_allowed, use that returned limit to revise the proposed date. Never copy preview IDs into live requests."}],"sources":["https://developers.tokportal.com/mcp/","https://developers.tokportal.com/use-cases/no-code/mp4-delivered-account-preview/"],"checkedAt":"2026-09-09T11:43:29.854908Z","capture":{"src":"/images/tokportal/tokportal-video-editor.png","width":650,"height":565,"alt":"Two real TokPortal editor views showing media format, caption and target publishing period.","caption":"Two cropped views of the real video editor, captured 8 September 2026. Historical dates shown; use a valid future window for a new task.","source":"https://app.tokportal.com/dashboard"}}],"author":"organic-club-editorial","publishedAt":"2026-09-17T12:40:14.828Z","updatedAt":"2026-09-17T12:40:14.828Z","media":{"kind":"illustration","src":"/images/daily/result-glimpse-after-problem-app-demo.jpg","width":1536,"height":1024,"alt":{"en":"Editorial illustration of an app demo setup with a user problem note in front and a finished digital output visible on a nearby screen."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration. Illustrative scene, not documentary evidence.","source":"https://theorganiclub.com/images/daily/result-glimpse-after-problem-app-demo.jpg","license":"Original artwork","licenseUrl":"https://theorganiclub.com/en/about/#images"}},"lang":"en","next":{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","tier":"canonical","evidence":"editorial","sources":[],"related":["account-isolation","content-isolation","content-saturation"],"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","point":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","body":["The pitch fits in a browser tab: one generator, a few prompts, fifty videos. The problem starts after export. Who watches? Why should that person stop at this account instead of the next one? Production has a button. Distribution still needs a reason to exist.","A brand account is often asked to reassure, sell, entertain, recruit and explain. Every post negotiates with the others. AGD separates those jobs. One account explores student frustrations; another challenges work habits; a third demonstrates a product in context. One company, three editorial promises.","The trap is reading this architecture as a volume recipe. Thirty accounts running the same edit do not represent thirty ideas. They mostly multiply coordination, repetition and unanswered questions. Diversification lives in what a viewer receives, not in the number of rows in a spreadsheet.","AGD is a proposed framework drawn from the TokPortal blueprint, not an academic consensus or a reach guarantee. Its value depends on the experiments it helps run. The useful question is whether a network reveals something that one account would hide. Can the signal be connected to an angle, an audience or a format?","Build a small network whose differences you can explain. Document the failures alongside the breakout posts. And keep a commercial measure next to views: somebody enjoying your edit does not necessarily have a problem your product solves."],"action":["Write a different editorial promise for each account.","Attach each post to a hypothesis and an audience.","Measure by cohort, then inspect qualified visits."],"trap":"A clone network can increase output without adding a single perspective.","quote":"The next advantage is knowing where an idea deserves to live.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The next advantage is knowing where an idea deserves to live.","text":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account-Generated Distribution","text":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A clone network can increase output without adding a single perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a different editorial promise for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach each post to a hypothesis and an audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 3","title":"Measure by cohort, then inspect qualified visits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"video":{"src":"/video/below-the-surface.mp4","poster":"/images/iceberg.jpg","caption":{"en":"Below the surface — animated original illustration. No audio."},"tracks":{"en":"/video/intro-en.vtt"}},"workshops":[{"id":"preview","title":"Preview an account with three video slots before committing credits","intro":"The archived builder shows account and video-package choices. This sample MCP request previews a package with one account and three video slots; it does not upload three video files.","endpoint":"POST /api/ext/bundles","code":"{\n  \"tool\": \"tokportal_create_bundle\",\n  \"arguments\": {\n    \"dry_run\": true,\n    \"body\": {\n      \"bundle_type\": \"account_and_videos\",\n      \"platform\": \"tiktok\",\n      \"country\": \"USA\",\n      \"videos_quantity\": 3,\n      \"edits_quantity\": 0,\n      \"wants_advanced_warming\": false,\n      \"auto_finalize_videos\": false\n    }\n  }\n}","language":"json","explain":"This is a sample request, not an executed order or a price quote. In REST, the equivalent simulation uses X-TokPortal-Dry-Run: true. Live creation debits credits immediately; the preview is the place to inspect the actual workspace-specific price.","checks":[{"label":"Read the quote","detail":"Read the quoted credit fields and cost_breakdown returned by the current contract. A simulation does not debit the live balance."},{"label":"Keep simulation separate","detail":"Returned simulation IDs are synthetic and cannot be reused in live requests. The simulation does not retain cross-call objects."},{"label":"Review the package","detail":"auto_finalize_videos is explicitly false here. Check the current review-window rules before any live execution."}],"sources":["https://developers.tokportal.com/sandbox/","https://developers.tokportal.com/mcp/"],"checkedAt":"2026-09-09T11:30:08.839243Z","capture":{"src":"/images/tokportal/tokportal-bundle-builder.png","width":731,"height":655,"alt":"TokPortal bundle builder showing platform and account-plus-video choices.","caption":"Actual TokPortal builder, captured 8 September 2026.","source":"https://app.tokportal.com/bundles/create"}}],"schemaVersion":2,"deepDive":{"heading":"The network should create information, not just inventory.","paragraphs":["The seductive spreadsheet has one row per account and one column per day. Fill the cells and it looks like a distribution system. But the empty column is usually the important one: why would someone follow this account instead of the other nineteen? Start there. An account for students revising for exams and an account for researchers managing citations can sell the same note-taking product while earning attention for entirely different reasons. Their comments should sound different. Their demonstrations should solve different moments. Their useful vocabulary should diverge before their publishing schedules do.","Treat the first network as a small editorial portfolio. Give each account a promise, a recognisable format and a question the team wants to answer. Then keep a record of failed ideas as carefully as the successful ones. If a tutorial attracts fewer views but produces people asking about the exact workflow your product solves, that may be more valuable than an unrelated joke. This is not permission to declare every low-view post a strategic success. It is a reason to define success before looking at the graph, and to connect distribution decisions to what the audience actually does next.","Here is the uncomfortable part for a product team: an excellent feature can remain culturally invisible. People do not encounter a roadmap. They encounter a person showing a task, an argument in a comment section, a ridiculous joke or an example that makes a problem suddenly recognisable. Distribution begins in those encounters. The account is useful when it has a reason to participate that survives beyond this week's launch. An account about the daily frustrations of independent editors, for example, can publish useful observations even when the product has nothing new to announce. That is an editorial asset. An account that only repeats release notes is a noticeboard with a username.","The Ocean Spray moment below is worth studying precisely because it resists the usual growth recipe. In the documented post, the bottle belongs to an activity and a mood; the viewer is not first asked to accept a marketing claim. That does not mean a brand can manufacture the same spontaneity on command. The transferable question is smaller: where does the product naturally enter something the audience already cares about? Start there, then make an original demonstration. The infrastructure matters after the idea has earned a place in the feed: getting the right asset onto the right account, preserving its context and learning from what happens next. Buying more output capacity before answering that question only makes the noticeboard bigger."],"diagram":{"kind":"flow","title":"From a pile of accounts to a useful network","items":[{"label":"Audience","detail":"Name a specific situation, not a demographic bucket.","value":0},{"label":"Promise","detail":"Give this account a reason to exist without the product link.","value":0},{"label":"Learning","detail":"Record what changed in qualified attention, not only output.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Look at how quickly the example establishes a reason to keep watching. That is the piece an AGD network needs to reproduce across distinct editorial identities. The public post shows a creative choice; it does not reveal the creator’s account portfolio or prove incremental sales.","caseIds":["doggface-morning-vibe"]},"examples":[{"id":"doggface-morning-vibe","platform":"tiktok","url":"https://www.tiktok.com/@420doggface208/video/6876424179084709126","creator":"doggface208","title":"A product becomes part of an ordinary moment","description":"Nathan Apodaca skateboards while drinking Ocean Spray cran-raspberry juice and lip-syncing Fleetwood Mac’s “Dreams”. The player thumbnail visibly shows the creator, roadside setting and bottle.","mechanism":"Make the product legible inside an activity people understand. This is a useful study of context and cultural participation, not a recipe for manufacturing spontaneity.","limitation":"Establishes a concrete creator-led moment later discussed by TikTok. It cannot isolate the sales contribution of this one video or guarantee repeatability.","observationBasis":"Source-described; full video not independently watched; public embed thumbnail and identity checked","checkedAt":"2026-09-08T00:00:00Z","references":["https://newsroom.tiktok.com/doggface-gives-the-world-a-smile-with-juice-a-skateboard-and-all-the-vibes?lang=en"],"screenshot":{"src":"/images/social/doggface-embed.jpg","alt":"Public tiktok player preview of doggface208: A product becomes part of an ordinary moment","source":"https://www.tiktok.com/@420doggface208/video/6876424179084709126","capturedAt":"2026-09-08T00:00:00Z"}}],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T11:30:08.839243Z","author":"organic-club-editorial","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://theorganiclub.com/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://theorganiclub.com/en/about/#images"}},"previous":{"schemaVersion":2,"id":"103","slug":"tokportal-video-reschedule-patch-or-put","category":"machines","term":"Endpoint choice for slot edits","kind":"guide","image":"tokportal-video-reschedule-patch-or-put","tier":"editorial","evidence":"editorial","sources":["https://developers.tokportal.com/configure-videos/","https://developers.tokportal.com/sandbox/","https://developers.tokportal.com/versioning/"],"related":["agent-first-dry-run","dry-run-contract","idempotency","agent-audit-log"],"en":{"title":"TokPortal video reschedule: use PATCH for partial edits, PUT for replacement","dek":"If a TokPortal video slot already contains the right media, the safer default for caption or date changes is PATCH. The docs make PUT a full replacement, which means omitted fields are cleared rather than preserved.","point":"Choose PATCH when you are changing lightweight metadata or the publish window on an existing slot. Reserve PUT for intentional full-slot replacement, and dry-run the write before any live execution.","body":["A narrow API choice can create a very practical editorial failure. Suppose a team has already configured a TokPortal video slot with the correct media, sound, and platform-specific fields. Later, someone only wants to adjust the caption or move the publishing window. At that moment, the question is not abstract REST style. It is whether the operator should resend the full slot with PUT or make a smaller change with PATCH. TokPortal’s current configuration docs answer that directly: single-slot PUT is a full-replace write, so omitted fields are cleared, while PATCH exists for lightweight metadata edits and rescheduling [1]. For an AI-assisted workflow, that distinction matters because “reconstruct the whole object from memory” is exactly where accidental field loss becomes likely.","The safest default is therefore simple: if the slot’s media configuration is already correct and you do not intend to redefine it, use PATCH. TokPortal documents PATCH /bundles/:id/videos/:position as the endpoint for updating external_ref, name, description, or schedule without re-uploading content [1]. The same page explicitly describes it as the reschedule endpoint, and the only place where the publishing window’s end day can be chosen [1]. That last detail is easy to miss. On configure PUT, target_publish_date represents a two-day window whose end is derived automatically; target_publish_end_date is not valid there [1]. So this is not only about reducing risk. It is also about choosing the endpoint that exposes the scheduling control you actually need.","PUT still has a valid role, but it is narrower than many operators assume. Use it when your intent is to define the slot’s complete configuration: media type, asset fields, caption, schedule, and any applicable extras. TokPortal warns that PUT /bundles/:id/videos/:position and batch PUT both replace the slot’s entire configuration, and a field you omit is cleared rather than preserved [1]. The docs also note a related change in validation behavior: an unrecognized field is now refused with 400 UNKNOWN_FIELD instead of being silently stripped in the full-replace flow [1]. That reduces one class of silent mistakes, but it does not solve the more ordinary one: sending a technically valid body that is incomplete for your real intent. In other words, a well-formed PUT can still be the wrong operational choice.","A reusable procedure for agents and human operators is: first classify the intended change, then choose the smallest write surface that matches it. Step 1: list the fields that truly need to change. Step 2: if the set is limited to external_ref, name, description, or scheduling fields, prefer PATCH [1]. Step 3: if the change requires redefining media or other slot-defining fields, prepare a full PUT body and treat it as authoritative replacement [1]. Step 4: run a dry run before live execution so the request goes through the same validation and pricing path but stops before the first write; TokPortal documents that a dry run creates no rows, debits no credits, and fires no webhook [2]. Step 5: only after validation passes should the operator send the real call. This sequence is a workflow choice, not a platform requirement. The platform requires valid inputs; the extra classification step is how you avoid self-inflicted configuration loss.","One more detail changes the practical rescheduling rule: PATCH is no longer a loophole around date validation. TokPortal’s docs state that rescheduling now obeys the same minimum lead time as configuration, with earlier dates rejected as INVALID_DATE and the response carrying details such as min_days_ahead and earliest_allowed [1]. The exact minimum depends on bundle state: today + 3 while an account is still being created, and today + 1 for a delivered or existing account, in UTC [1]. That means PATCH is safer for preserving slot fields, but not looser about scheduling. An agent that used to think “PATCH is just a harmless date tweak” should instead treat it as a real write subject to operational constraints.","$15","For agent design, this suggests a durable rule: do not let the endpoint be selected merely by which schema your system happens to cache. Let it be selected by intent. If intent equals “replace the whole slot,” use PUT. If intent equals “preserve the slot and alter only lightweight metadata or timing,” use PATCH [1]. Add two guardrails from the docs. First, log the API version and request ID headers returned by the server, because TokPortal treats the public API as a versioned stable contract and includes a request identifier for correlation [3]. Second, treat dry runs and live calls as separate states in your audit trail; the sandbox docs are explicit that dry-run identifiers are synthetic, do not exist live, and should not be carried into real requests [2]. That combination—intent-based endpoint choice, preview before write, and version-aware logging—is a more robust operating pattern than “always PUT the latest object.”"],"action":["Classify each requested slot edit as partial change or full replacement before choosing an endpoint.","Use PATCH for caption, name, external_ref, and schedule changes on an existing editable slot.","Use PUT only when you intend the body to become the slot’s entire authoritative configuration.","Dry-run every unfamiliar or consequential write, then repeat live only after reviewing validation output.","Store request ID, API version, and the exact request body used so later debugging is possible."],"trap":"The common mistake is assuming PUT behaves like a merge. In TokPortal’s documented contract, single-slot PUT is full replacement, so an omitted valid field can be cleared even when the request itself succeeds [1].","quote":"The right endpoint is not chosen by convenience. It is chosen by whether you mean to edit a slot or redefine it.","stories":[{"id":"story-endpoint-choice","title":"How to choose PATCH vs PUT","slides":[{"label":"1","title":"Start with intent","text":"Ask one question first: am I preserving this slot and changing only metadata or timing, or am I redefining the whole slot? Endpoint choice follows that answer, not habit.","media":"/images/daily/tokportal-video-reschedule-patch-or-put.jpg"},{"label":"2","title":"PATCH protects existing setup","text":"TokPortal documents PATCH for lightweight metadata edits and rescheduling. That makes it the safer default when media and platform-specific fields should stay as they are [1].","media":"/images/daily/tokportal-video-reschedule-patch-or-put.jpg"},{"label":"3","title":"PUT is authoritative replacement","text":"Use PUT when you want the submitted body to become the slot’s full configuration. If you omit a field, the docs say it is cleared rather than preserved [1].","media":"/images/daily/tokportal-video-reschedule-patch-or-put.jpg"}]},{"id":"story-dry-run-guardrail","title":"Why dry run belongs in the workflow","slides":[{"label":"1","title":"Validate before writing","text":"TokPortal’s dry run uses the same validation and pricing path as the real request, then stops before the first write [2].","media":"/images/daily/tokportal-video-reschedule-patch-or-put.jpg"},{"label":"2","title":"Separate preview from execution","text":"A simulated success is not a live change. No credits are debited, no row is written, and dry-run IDs are synthetic [2].","media":"/images/daily/tokportal-video-reschedule-patch-or-put.jpg"},{"label":"3","title":"Then execute live deliberately","text":"After the preview passes, resend the intended live request with the same carefully reviewed body. This is a workflow choice for safety, not a platform mandate.","media":"/images/daily/tokportal-video-reschedule-patch-or-put.jpg"}]}]},"deepDive":{"heading":"A small endpoint decision becomes an editorial reliability rule","paragraphs":["The interesting lesson here is broader than one reschedule endpoint. Many AI-assisted publishing failures do not come from dramatic bugs; they come from a mismatch between user intent and write semantics. Human operators often say “update the post,” but an API may distinguish between merge-like edits and authoritative replacement. TokPortal makes that distinction unusually explicit. PATCH is for limited metadata and schedule changes; PUT is full replacement [1]. If you are building an agent layer, that documented difference should become a routing rule rather than a note buried in a developer handbook.","That rule matters most when a slot contains platform-specific fields the reviewer is not looking at during the last-minute edit. A caption reviewer may not remember whether a TikTok sound URL, carousel assets, or other settings were already configured. Choosing PUT in that situation forces the system to restate everything correctly. Choosing PATCH lets the system preserve what is already correct while changing only the intended subset [1]. The advantage is not speed for its own sake. The advantage is narrower blast radius.","The sandbox docs strengthen this pattern because they let a team treat preview as part of the write process instead of a separate environment [2]. Dry run is not a marketing simulation and not a reach predictor; it is a contract-level rehearsal of the exact request path, with identical validation and pricing logic but no live side effects [2]. For editorial operations, that means you can check whether a reschedule is too early, whether a field combination is invalid, or whether your tool is accidentally using a synthetic ID—before any irreversible action occurs.","Finally, versioning is a quiet but useful part of the answer. TokPortal states a stable public API version and returns request IDs on every response [3]. That means a team can record not just that a slot failed to update, but under which contract version and which server-correlated request. The endpoint decision itself is editorially simple—PATCH for partial edits, PUT for replacement—but the durable practice is operational: choose by intent, preview before writing, and log enough context to explain what happened later."],"diagram":{"kind":"flow","title":"Endpoint selection for an existing video slot","caption":"Illustrative decision flow; values show layout only, not measured data.","items":[{"label":"1. Identify change","detail":"List only the fields you actually intend to alter.","value":20},{"label":"2. Partial fields only?","detail":"If the change is metadata or schedule, route toward PATCH.","value":40},{"label":"3. Need full redefinition?","detail":"If media or full slot config changes, prepare a complete PUT body.","value":60},{"label":"4. Dry-run validation","detail":"Preview the exact request before any live write.","value":80},{"label":"5. Execute live","detail":"Send the reviewed request and log version plus request ID.","value":100}]},"caseLens":"This article uses the documented video-slot workflow rather than a social post case because the core question is technical and operational. The relevant support asset is the video workshop: it frames a real slot as something configured with media, caption, and a publishing period. That makes the later PATCH-versus-PUT decision concrete. The workflow supports the analysis by showing where operators first define a slot, while the public API docs explain how later edits should be handled. Proposed safety habits here—intent classification, dry runs, and audit logging—are workflow choices layered on top of the documented API contract, not additional platform requirements.","caseIds":[]},"examples":[],"workshops":[{"id":"video","title":"Prepare the actual video slot, not just the caption","intro":"In the archived editor capture, the interface shows Video, Carousel and Story options, plus a target publishing period. The API example below is a separate documented slot-configuration preview; the screenshot alone does not establish the API contract.","endpoint":"PUT /api/ext/bundles/{id}/videos/{position}","code":"{\n  \"tool\": \"tokportal_configure_bundle_video\",\n  \"arguments\": {\n    \"id\": \"<real-bundle-uuid>\",\n    \"position\": 1,\n    \"body\": {\n      \"video_type\": \"video\",\n      \"video_url\": \"<public_url returned by your video upload>\",\n      \"description\": \"A practical example of organising freelance subscriptions.\",\n      \"target_publish_date\": \"<valid future date: YYYY-MM-DD>\",\n      \"ai_content_disclaimer\": false,\n      \"auto_publish\": false\n    },\n    \"dry_run\": true\n  }\n}","language":"json","explain":"Replace the marked values with an authorized real bundle, a media URL you control and a valid future date. This is a dry-run template, not an executed campaign. The archived UI shows a two-day period for that captured example; use the current API validation response to determine the dates accepted for your own request.","checks":[{"label":"Choose the correct media fields","detail":"A video needs video_url and description. A TikTok carousel instead needs carousel_images and tiktok_sound_url."},{"label":"Use a valid window","detail":"Allow at least three days while account creation is pending, or one day for delivered/existing accounts. Check the current response and limits."},{"label":"Read the preview result","detail":"Check the simulation markers and date validation. If INVALID_DATE includes details.earliest_allowed, use that returned limit to revise the proposed date. Never copy preview IDs into live requests."}],"sources":["https://developers.tokportal.com/mcp/","https://developers.tokportal.com/use-cases/no-code/mp4-delivered-account-preview/"],"checkedAt":"2026-09-09T11:43:29.854908Z","capture":{"src":"/images/tokportal/tokportal-video-editor.png","width":650,"height":565,"alt":"Two real TokPortal editor views showing media format, caption and target publishing period.","caption":"Two cropped views of the real video editor, captured 8 September 2026. Historical dates shown; use a valid future window for a new task.","source":"https://app.tokportal.com/dashboard"}}],"author":"organic-club-editorial","publishedAt":"2026-09-12T11:39:50.620Z","updatedAt":"2026-09-12T11:39:50.620Z","media":{"kind":"illustration","src":"/images/daily/tokportal-video-reschedule-patch-or-put.jpg","width":1536,"height":1024,"alt":{"en":"Editorial desk scene with scheduling notes and two workflow paths representing partial edit versus full replacement for a video slot."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration. Illustrative scene, not documentary evidence.","source":"https://theorganiclub.com/images/daily/tokportal-video-reschedule-patch-or-put.jpg","license":"Original artwork","licenseUrl":"https://theorganiclub.com/en/about/#images"}}}],"$L16","$L17","$L18","$L19"]}]
