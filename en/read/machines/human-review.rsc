15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/machines/human-review/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"Useful human review exposes the action, consequences and evidence to check. An approval button without context offers only an illusion of control."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Show account, asset, text, cost and changes since the last version. Separate editorial approval from financial authorization. If everything is urgent, little gets reviewed. Reserve interruptions for decisions where an informed human can meaningfully change the outcome."}],["$","p","1",{"children":"Review can highlight changes since the previous version rather than redisplay the entire dossier. A CTA change calls for a different decision from a market or cost change. This helps humans focus attention where it matters. Approval should remain attached to the version actually reviewed. If execution uses another version, the system should detect that mismatch rather than relying on a generic historical approval flag."}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Give the reviewer something definite to approve"}],["$","p",null,{"children":"A review step fails when the person sees a vague summary while the system later publishes a different file. Present the exact asset version, caption, account, destination and any cost or scheduling consequence. Highlight claims that need evidence and rights that still require confirmation. The reviewer should be able to reject one concrete issue without restarting the entire workflow. Keep the approved version immutable or record a new review when material changes occur. Approval should refer to a package, not to a mood in a conversation."}],["$","figure",null,{"className":"editorial-diagram diagram-timeline","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"Review the version that will ship"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Prepare",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Prepare"}],["$","p",null,{"children":"Exact asset, caption, account and scope."}],false]}]]}],["$","li","Decide",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Decide"}],["$","p",null,{"children":"Approve or reject a concrete package."}],false]}]]}],["$","li","Verify",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Verify"}],["$","p",null,{"children":"Check the published result against that version."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Scale review to the consequence. A harmless draft can move quickly; a public factual claim, sensitive asset or paid operation deserves closer inspection. Define which changes are material and which checks can be automated. After release, compare the published result with the approved package and retain the operation receipt. The reviewer is not an excuse for the system to stop validating obvious errors. Human judgement works best when routine checks have already passed and the remaining decision is clear, bounded and supported by the relevant evidence."}]]]}],false,false,"$L19","$undefined","$L1a","$L1b","$L1c","$L1d"]}],"$L1e"]}]
