sName":"mono","children":"REST EQUIVALENT"}],["$","code",null,{"children":"PUT /api/ext/bundles/{id}/videos/{position}"}]]}],["$","span",null,{"className":"mono muted","children":"ANNOTATED EXAMPLE"}],["$","$L23",null,{"lang":"en","text":"{\n  \"tool\": \"tokportal_configure_bundle_video\",\n  \"arguments\": {\n    \"id\": \"<real-bundle-uuid>\",\n    \"position\": 1,\n    \"body\": {\n      \"video_type\": \"video\",\n      \"video_url\": \"<public_url returned by your video upload>\",\n      \"description\": \"A practical example of organising freelance subscriptions.\",\n      \"target_publish_date\": \"<valid future date: YYYY-MM-DD>\",\n      \"ai_content_disclaimer\": false,\n      \"auto_publish\": false\n    },\n    \"dry_run\": true\n  }\n}","label":"MCP REQUEST"}],["$","p",null,{"children":"Replace the marked values with an authorized real bundle, a media URL you control and a valid future date. This is a dry-run template, not an executed campaign. The archived UI shows a two-day period for that captured example; use the current API validation response to determine the dates accepted for your own request."}],["$","ol",null,{"className":"workshop-checks","children":[["$","li","Choose the correct media fields",{"children":[["$","span",null,{"className":"mono acid","children":["0",1]}],["$","div",null,{"children":[["$","strong",null,{"children":"Choose the correct media fields"}],["$","p",null,{"children":"A video needs video_url and description. A TikTok carousel instead needs carousel_images and tiktok_sound_url."}]]}]]}],["$","li","Use a valid window",{"children":[["$","span",null,{"className":"mono acid","children":["0",2]}],["$","div",null,{"children":[["$","strong",null,{"children":"Use a valid window"}],["$","p",null,{"children":"Allow at least three days while account creation is pending, or one day for delivered/existing accounts. Check the current response and limits."}]]}]]}],["$","li","Inspect readiness",{"children":[["$","span",null,{"className":"mono acid","children":["0",3]}],"$L24"]}]]}],"$L25"]}]]]}]
