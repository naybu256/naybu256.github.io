14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/human-api.jpg","alt":"A worker operates an antique printing press inside a working print shop.","width":1280,"height":960,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Printing_at_Bay_View_Printing_Company.png","children":"Caelb375"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by/4.0","children":"CC BY 4.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],["$","a",null,{"href":"#tokportal-workflow","children":"↳ Inside TokPortal"}],["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/machines/human-api/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"A Human API exposes a software workflow partly executed by people. In TokPortal’s context, orchestration and native interaction are separate layers."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","$19","0",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["A call may create a mission rather than immediately publish a post. Integrations therefore need waiting, status and correction handling. Design around the real cycle: request received, work executed, result verified. Hiding latency behind instant success misrepresents what happened."]}]]}]]}],["$","$19","1",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["A client interface can show request accepted before publication verified. Add handling for delays and corrections. This matters for agents: they should not analyze a mission as though it were already a visible post. The software contract should respect the actual time of human work. Clear intermediate states make integrations more useful without promising instantaneous execution the underlying operation does not provide."]}]]}]]}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Make the handoff executable by a person"}],[["$","$19","0",{"children":[["$","p","0",{"children":["A human operator is not a magic endpoint that repairs every vague request. If the task is to publish a post, the handoff needs an account identifier, approved asset, caption, timing constraints and a definition of completion. Include the relevant rights and any feature that must be applied inside the platform. Replace instructions such as make it feel native with concrete observations the operator can act on. The human's judgement should be reserved for real ambiguity, not spent guessing which file named final is actually approved."]}]]}]],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"A useful operator contract"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Input",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Input"}],["$","p",null,{"children":"Account, approved version and publishing constraints."}],false]}]]}],["$","li","Decision",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Decision"}],["$","p",null,{"children":"Explicit room for judgement and escalation."}],false]}]]}],["$","li","Receipt",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Receipt"}],["$","p",null,{"children":"Result URL, time and any unresolved exception."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],["$L1a"]]}],false,"$L1b","$L1c",false,"$L1d","$L1e","$L1f","$L20"]}],"$L21"]}]
