1a:["$","section",null,{"id":"tokportal-workflow","className":"product-workshops","children":[["$","div",null,{"className":"case-intro","children":[["$","span",null,{"className":"mono acid","children":"INSIDE TOKPORTAL"}],["$","h2",null,{"children":"From the idea to the actual workflow."}],["$","p",null,{"children":"Product screens, documented tools and a practical way to connect them."}]]}],[["$","section","connect",{"className":"product-workshop","aria-labelledby":"workshop-connect","children":[["$","div",null,{"className":"workshop-label mono","children":[["$","span",null,{"className":"acid","children":["WORKBENCH / ","CONNECT"]}],["$","span",null,{"children":["DOCUMENTED · ","2026-09-09"]}]]}],["$","h3",null,{"id":"workshop-connect","children":"Connect an AI assistant to the actual TokPortal tools"}],["$","p",null,{"children":"The remote MCP address is the entry point for an assistant. The screenshot shows TokPortal’s real connection screen, including the authorisation step. Your API key does not belong in an editorial prompt."}],["$","figure",null,{"className":"product-capture","children":[["$","a",null,{"href":"/images/tokportal/tokportal-mcp-connect.png","target":"_blank","rel":"noopener noreferrer","aria-label":"Enlarge: TokPortal connection screen with the remote MCP URL and Claude connection steps.","children":["$","img",null,{"src":"/images/tokportal/tokportal-mcp-connect.png","alt":"TokPortal connection screen with the remote MCP URL and Claude connection steps.","width":930,"height":250,"loading":"lazy"}]}],["$","figcaption",null,{"children":["Actual TokPortal MCP connection screen, captured 8 September 2026."," ",["$","a",null,{"href":"https://app.tokportal.com/developer/connect-ai","target":"_blank","rel":"noopener noreferrer","children":"Product ↗"}]]}]]}],["$","div",null,{"className":"endpoint","children":[["$","span",null,{"className":"mono","children":"MCP CONNECTION"}],["$","code",null,{"children":"https://app.tokportal.com/api/ext/mcp"}]]}],["$","span",null,{"className":"mono muted","children":"AI PLANNING BRIEF"}],["$","$L22",null,{"lang":"en","text":"Inspect my existing TikTok accounts and the current credit rules.\nPrepare three distinct creative angles for a US audience.\nFor each, identify the account, required media and a valid publishing window.\nPreview any proposed creation with dry_run: true.\nReport credits_would_charge, recurring Coverage and missing inputs.\nDo not create or publish a live task.","label":"AI PLANNING BRIEF"}],["$","p",null,{"children":"Copy this as a planning brief after connecting your assistant. It asks for a concrete preview, not a pretend transcript of successful execution. Remote MCP supports the documented dry-run workflow; local tokportal-mcp needs version 1.15.1 or later."}],["$","ol",null,{"className":"workshop-checks","children":[["$","li","Read-only first",{"children":[["$","span",null,{"className":"mono acid","children":["0",1]}],["$","div",null,{"children":[["$","strong",null,{"children":"Read-only first"}],["$","p",null,{"children":"Choose read-only access when the job is inventory or analysis. Publishing requires an appropriately authorised connection."}]]}]]}],["$","li","Discover current tools",{"children":[["$","span",null,{"className":"mono acid","children":["0",2]}],["$","div",null,{"children":[["$","strong",null,{"children":"Discover current tools"}],["$","p",null,{"children":"Use the tool catalogue available in the connected workspace instead of assuming a capability from a marketing page."}]]}]]}],["$","li","Review before execution",{"children":[["$","span",null,{"className":"mono acid","children":["0",3]}],["$","div",null,{"children":[["$","strong",null,{"children":"Review before execution"}],["$","p",null,{"children":"Check destination, assets, price and review windows against the actual tool response."}]]}]]}]]}],["$","div",null,{"className":"workshop-sources mono","children":["READ THE CONTRACT"," ",[["$","a","https://developers.tokportal.com/mcp/",{"