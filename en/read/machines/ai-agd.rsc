4:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"AI can think about the system before filling the calendar. — THE ORGANIC CLUB"}],["$","meta","1",{"name":"description","content":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}],["$","meta","2",{"property":"og:title","content":"AI can think about the system before filling the calendar."}],["$","meta","3",{"property":"og:description","content":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}],["$","meta","4",{"property":"og:url","content":"https://naybu256.github.io/en/read/machines/ai-agd/"}],["$","meta","5",{"property":"og:type","content":"article"}],["$","meta","6",{"property":"og:locale","content":"en_US"}],["$","meta","7",{"property":"article:published_time","content":"2026-09-08T12:00:00Z"}],["$","meta","8",{"property":"article:modified_time","content":"2026-09-08T17:40:57.624Z"}],["$","meta","9",{"property":"og:image","content":"https://naybu256.github.io/images/editorial/ai-agd.jpg"}],["$","meta","10",{"property":"og:image:width","content":"1280"}],["$","meta","11",{"property":"og:image:height","content":"853"}],["$","meta","12",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","13",{"name":"twitter:title","content":"AI can think about the system before filling the calendar."}],["$","meta","14",{"name":"twitter:description","content":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}],["$","meta","15",{"name":"twitter:image","content":"https://naybu256.github.io/images/editorial/ai-agd.jpg"}],["$","link","16",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","17",{"rel":"canonical","href":"https://naybu256.github.io/en/read/machines/ai-agd/"}],["$","link","18",{"rel":"alternate","hrefLang":"en","href":"https://naybu256.github.io/en/read/machines/ai-agd/"}],["$","link","19",{"rel":"alternate","hrefLang":"x-default","href":"https://naybu256.github.io/en/read/machines/ai-agd/"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L6",null,{"fallback":"$7","children":["$","$L8",null,{"fallback":"$7","children":["$","$L9",null,{"providerId":"layout:/","segmentMap":{"children":["en","read","machines","ai-agd"]},"children":["$","$La",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"lang|en|d","fallback":["$","main",null,{"className":"main-shell","style":{"paddingTop":100,"minHeight":"80vh"},"children":[["$","span",null,{"className":"mono acid","children":"404 / SIGNAL LOST"}],["$","div",null,{"className":"page-heading","children":[["$","h1",null,{"children":"Off the current."}],["$","p",null,{"children":"This page does not exist."}],["$","a",null,{"className":"read-link","href":"/en/","children":"Back to feed ↗"}]]}]]}],"children":["$","$L9",null,{"providerId":"layout:/[lang]","segmentMap":{"children":["read","machines","ai-agd"]},"children":["$","$La",null,{"id":"layout:/[lang]","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"[\"lang|en|d\",\"read\",\"category|machines|d\",\"slug|ai-agd|d\"]","fallback":["$","main",null,{"className":"main-shell","style":{"paddingTop":100,"minHeight":"80vh"},"children":[["$","span",null,{"className":"mono acid","children":"404 / SIGNAL LOST"}],["$","div",null,{"className":"page-heading","children":[["$","h1",null,{"children":"Off the current."}],["$","p",null,{"children":"This page does not exist."}],["$","a",null,{"className":"read-link","href":"/en/","children":"Back to feed ↗"}]]}]]}],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L9",null,{"providerId":"page:/en/read/machines/ai-agd","segmentMap":{"children":["__PAGE__"]},"children":["$","$La",null,{"id":"page:/en/read/machines/ai-agd"}]}],null]}]}]}]}]}]}]}]}]}]}],null,null]
