14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/ai-agd.jpg","alt":"A vintage mainframe computer with control buttons, reel storage, and cabinets of electronics.","width":1280,"height":853,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Mainframe_Computer.jpg","children":"Pargon"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by/2.0","children":"CC BY 2.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],["$","a",null,{"href":"#tokportal-workflow","children":"↳ Inside TokPortal"}],["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/machines/ai-agd/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD. It does not imply fully autonomous execution."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","$19","0",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["The first gain may be better idea classification rather than more videos. Ask an agent to find redundant concepts, overlooked audiences and unmeasured hypotheses. Compare its proposals with real context. A convincing list does not prove it understands your customers."]}]]}]]}],["$","$19","1",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["Give an agent ten briefs and ask where two accounts are saying the same thing. Require it to cite the relevant passages. This produces a checkable proposal rather than a general judgment. The value comes from decision support even if no additional post is produced. Keep corrections to its classification so later prompts can reflect the distinctions your team actually cares about."]}]]}]]}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Automation should carry the brief, not erase it"}],[["$","$19","0",{"children":[["$","p","0",{"children":["An AI-assisted distribution workflow is only as coherent as the information it preserves between steps. A research note becomes a brief, a brief becomes a script, and a script becomes a publishing request. At each handoff, the original audience problem can disappear beneath generic instructions to make the content engaging. Keep the account promise, evidence, intended action and prohibited claims attached to the asset. The machine should receive enough context to reject a slick but irrelevant draft, not merely enough words to fill a template."]}]]}]],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"Preserve intent through the pipeline"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Brief",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Brief"}],["$","p",null,{"children":"Audience, promise, evidence and limits."}],false]}]]}],["$","li","Asset",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Asset"}],["$","p",null,{"children":"A version that can be reviewed against the brief."}],false]}]]}],["$","li","Release",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Release"}],["$","p",null,{"children":"An authorised action with a traceable result."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","$19","0",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["Separate creative suggestions from operational authority. A model can propose an angle without permission to spend money, publish or alter an account. Give each stage a clear output and a review condition. Record which version was accepted and why, then compare the published result with that approved version. The useful ambition is an operation that retains judgement while reducing repetitive work. If nobody can explain why a particular post exists or who authorised its release, the workflow has gained speed while losing its editorial centre."]}]]}]]}]]]}],false,"$L1a","$L1b","$undefined","$L1c","$L1d","$L1e","$L1f"]}],"$L20"]}]
