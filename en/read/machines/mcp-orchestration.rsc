14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/mcp-orchestration.jpg","alt":"Rows of terminals and connected wires on a telephone network patch panel.","width":1280,"height":813,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Krone_LSA-PLUS_Patch_Panel_(14672372192).png","children":"Dennis van Zuijlekom"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/2.0","children":"CC BY-SA 2.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],["$","a",null,{"href":"#tokportal-workflow","children":"↳ Inside TokPortal"}],["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/machines/mcp-orchestration/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"MCP lets an agent client discover and call tools exposed by a server. Its technical catalog still needs an objective and action boundaries."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Read descriptions and annotations before composing a recipe. A read operation differs from paid creation. TokPortal’s documentation distinguishes local and remote servers. Choose transport for your environment and test the contract in preview before commercial execution."}],["$","p","1",{"children":"A readable recipe names the intent before listing calls: prepare an account in a market, verify its state, organize publication. Each step should state what it requires from the previous one. Readers can then understand dependencies and see why synthetic preview identifiers must never pass into live operations. Tool availability is only one part of building a coherent, authorized workflow."}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"A tool catalogue is not an operating plan"}],["$","p",null,{"children":"MCP makes tools discoverable to an assistant, but discoverability does not decide when a tool should be used. The orchestrator still needs to understand the account, the intended action, the input contract and the side effects. Read tool descriptions and current documentation before constructing a workflow. A list operation, a preview and a purchase may sit beside each other in the same catalogue while requiring different authority. Preserve that distinction in the plan and in the interface shown to the person approving consequential work."}],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"From discoverable tools to a reviewable action"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Discover",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Discover"}],["$","p",null,{"children":"Read the current tool contract and side effects."}],false]}]]}],["$","li","Prepare",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Prepare"}],["$","p",null,{"children":"Resolve inputs and inspect any supported preview."}],false]}]]}],["$","li","Reconcile",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Reconcile"}],["$","p",null,{"children":"Store identifiers and verify the returned state."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Build the sequence around evidence returned by each step. Resolve identifiers before preparing an action, preview where supported, inspect cost and scope, then execute only the authorised operation. Store the resulting identifiers so later status checks refer to the same task. Do not infer success from a fluent assistant message or from the absence of a thrown error. A useful MCP integration makes the underlying operation easier to inspect. It should not hide uncertainty behind a conversational layer that sounds more complete than the tool response actually is."}]]]}],false,"$L19","$L1a",false,"$L1b","$L1c","$L1d","$L1e"]}],"$L1f"]}]
