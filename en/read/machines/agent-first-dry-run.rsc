inalize_videos\": false\n    }\n  }\n}","label":"MCP · DRY RUN"}],["$","p",null,{"children":"This is a sample request, not an executed order or a price quote. In REST, the equivalent simulation uses X-TokPortal-Dry-Run: true. Live creation debits credits immediately; the preview is the place to inspect the actual workspace-specific price."}],["$","ol",null,{"className":"workshop-checks","children":[["$","li","Read the quote",{"children":[["$","span",null,{"className":"mono acid","children":["0",1]}],["$","div",null,{"children":[["$","strong",null,{"children":"Read the quote"}],["$","p",null,{"children":"Read the quoted credit fields and cost_breakdown returned by the current contract. A simulation does not debit the live balance."}]]}]]}],["$","li","Keep simulation separate",{"children":[["$","span",null,{"className":"mono acid","children":["0",2]}],["$","div",null,{"children":[["$","strong",null,{"children":"Keep simulation separate"}],["$","p",null,{"children":"Returned simulation IDs are synthetic and cannot be reused in live requests. The simulation does not retain cross-call objects."}]]}]]}],["$","li","Review the package",{"children":[["$","span",null,{"className":"mono acid","children":["0",3]}],["$","div",null,{"children":[["$","strong",null,{"children":"Review the package"}],["$","p",null,{"children":"auto_finalize_videos is explicitly false here. Check the current review-window rules before any live execution."}]]}]]}]]}],["$","div",null,{"className":"workshop-sources mono","children":["READ THE CONTRACT"," ",[["$","a","https://developers.tokportal.com/sandbox/",{"href":"https://developers.tokportal.com/sandbox/","target":"_blank","rel":"noopener noreferrer","children":["sandbox"," ","↗"]}],["$","a","https://developers.tokportal.com/mcp/",{"href":"https://developers.tokportal.com/mcp/","target":"_blank","rel":"noopener noreferrer","children":["mcp"," ","↗"]}]]]}]]}]
