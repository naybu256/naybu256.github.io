13:["$","header",null,{"className":"article-header","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","a",null,{"href":"/en/","children":"THE ORGANIC CLUB"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/en/topics/machines/","children":"Machines & humans"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"Agentic AGD"}]]}],["$","div",null,{"className":"mono acid","style":{"marginTop":28},"children":["FIELD GUIDE"," ","· ","005"]}],["$","h1",null,{"children":"TokPortal MCP Tutorial: Preview an AI Workflow with Dry Run"}],["$","p",null,{"className":"article-dek","children":"A real MCP workflow starts with a readable preview, not a surprise charge."}],["$","div",null,{"className":"byline","children":[["$","a",null,{"href":"/en/about/#jet","className":"author-signature","children":[["$","img",null,{"src":"/images/authors/jet.jpg","alt":"","width":48,"height":48}],["$","span",null,{"children":["Jet",["$","small",null,{"children":"AI workflows & the Lab"}]]}]]}],["$","span",null,{"className":"muted","children":["08/09/2026"," ","· ",5," min"]}],["$","span",null,{"className":"evidence-tag","children":"Documentation cited"}]]}]]}]
14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/agent-first-dry-run.jpg","alt":"A red railway signal glows against a deep blue evening sky.","width":1280,"height":976,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Red_railway_signal_at_dusk.jpg","children":"W.carter"}]," · ",["$","a",null,{"href":"https://creativecommons.org/publicdomain/zero/1.0/deed.en","children":"CC0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],["$","a",null,{"href":"#tokportal-workflow","children":"↳ Inside TokPortal"}],["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/machines/agent-first-dry-run/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"TokPortal MCP exposes social operations to an agent. A preview uses top-level dry_run: true, with creation parameters inside body; the decision to execute live remains a separate step."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","$19","0",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["An agent executing everything quickly is not necessarily a good operator. In a paid workflow, its first useful skill is explaining what it will trigger: country, platform, account and immediate or recurring costs."]}]]}]]}],["$","$19","1",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["The remote server is https://app.tokportal.com/api/ext/mcp. The local package documentation requires version 1.15.1 or later for reliable previews: version 1.15.0 advertised an argument it did not forward correctly. That detail matters more than an impressive agent demo."]}]]}]]}],["$","$19","2",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["Read available countries, prices and balance first. To preview a US TikTok account, tokportal_create_bundle accepts dry_run: true and a body containing bundle_type: account_only, platform: tiktok and country: USA. The response should distinguish simulated credits from charged credits."]}]]}]]}],["$","$19","3",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["Preview identifiers are synthetic. Never reuse them in production. After approval, create real resources and continue with their live identifiers. YouTube bundle creation is not supported through this API in the documentation consulted."]}]]}]]}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Make the preview a contract a person can inspect."}],[["$","$19","0",{"children":[["$","p","0",{"children":["A dry run earns its name when the reviewer can explain what will happen next without reading the agent’s optimistic narration. For a publishing job, that means the intended account, asset version, caption, time window, cost scope and the action that would cross into real execution. A preview that returns a plausible success message but hides these choices has only moved uncertainty into a nicer interface. Give the reviewer a concrete difference between the current state and the proposed state."]}]]}]],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"A reviewable execution boundary"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Propose",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Propose"}],["$","p",null,{"children":"Show the exact account, asset and intended action."}],false]}]]}],["$","li","Inspect",{"children":["$L1a","$L1b"]}],"$L1c"]}],"$L1d"]}],["$L1e","$L1f","$L20"]]}],false,"$L21","$L22",false,"$L23","$L24","$L25","$L26"]}],"$L27"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L28","081",{"a":{"id":"081","author":"jet","slug":"human-api","category":"machines","term":"Human API","kind":"guide","image":"human-api","media":{"kind":"photograph","src":"/images/editorial/human-api.jpg","width":1280,"height":960,"alt":{"en":"A worker operates an antique printing press inside a working print shop."},"credit":"Caelb375","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 2aa5baf9386557b730ec488a397287c9d71e5e4b.","source":"https://commons.wikimedia.org/wiki/File:Printing_at_Bay_View_Printing_Company.png","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"},"en":{"title":"TokPortal’s Human API: Briefs, Native Actions and Receipts","dek":"A Human API exposes a software workflow partly executed by people."},"readingMinutes":3},"lang":"en"}],["$","$L28","080",{"a":{"id":"080","author":"jet","slug":"agentic-agd","category":"machines","term":"Agentic AGD","kind":"guide","image":"agentic-agd","media":{"kind":"photograph","src":"/images/editorial/agentic-agd.jpg","width":1280,"height":720,"alt":{"en":"Yellow industrial robots handle kegs inside a brewery production area."},"credit":"Larry D. Moore","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 52b376103be14f0112d317a163fe9c74d08e6ffc.","source":"https://commons.wikimedia.org/wiki/File:Tour4_Spoetzl_Brewery_Shiner_Texas_2024.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"},"en":{"title":"Agentic AGD: What an AI Distribution Agent Should Do","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."},"readingMinutes":3},"lang":"en"}],["$","$L28","084",{"a":{"id":"084","author":"jet","slug":"idempotency","category":"machines","term":"Idempotency","kind":"guide","image":"idempotency","media":{"kind":"photograph","src":"/images/editorial/idempotency.jpg","width":1280,"height":946,"alt":{"en":"Numbered mechanical counter wheels inside an analogue tape deck."},"credit":"Retired electrician","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e42ad2d38f4e8621abf96d9db7464bdb61b0c686.","source":"https://commons.wikimedia.org/wiki/File:Technics_RS-M270x_mechanical_counter.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"},"en":{"title":"API Retry Safety: Avoid Duplicate Social Publishing Operations","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."},"readingMinutes":2},"lang":"en"}]]}]]}]
