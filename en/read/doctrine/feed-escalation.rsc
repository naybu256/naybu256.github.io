13:["$","header",null,{"className":"article-header","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","a",null,{"href":"/en/","children":"THE ORGANIC CLUB"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/en/topics/doctrine/","children":"The doctrine"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"Feed Escalation"}]]}],["$","div",null,{"className":"mono acid","style":{"marginTop":28},"children":["POINT OF VIEW"," ","· ","009"]}],["$","h1",null,{"children":"How AGD Changes the Competition for Organic Reach"}],["$","p",null,{"className":"article-dek","children":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}],["$","div",null,{"className":"byline","children":[["$","a",null,{"href":"/en/about/#spike","className":"author-signature","children":[["$","img",null,{"src":"/images/authors/spike.jpg","alt":"","width":48,"height":48}],["$","span",null,{"children":["Spike",["$","small",null,{"children":"Distribution & field notes"}]]}]]}],["$","span",null,{"className":"muted","children":["08/09/2026"," ","· ",2," min"]}],["$","span",null,{"className":"evidence-tag","children":"Editorial analysis"}]]}]]}]
14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/feed-escalation.jpg","alt":"Foaming waves surge against a dark stone seawall on the French Mediterranean coast.","width":1280,"height":856,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Waves_on_the_Th%C3%A9%C3%A2tre_de_la_Mer.jpg","children":"Christian Ferrer"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by/4.0","children":"CC BY 4.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds. It is not a scientific metric."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"When an editing effect becomes easy to reproduce, it stops being enough to distinguish a creator. You can escalate or change the game: a calm tutorial, an uncut demonstration, a specific opinion. Compare these options with the relevant audience rather than the creative director’s taste."}],["$","p","1",{"children":"Imagine two demonstrations of one feature. The first piles on effects and commentary; the second shows a complete operation with a few quiet annotations. Ask what viewers understand about the use case, not simply which edit appears more expensive. The calm format is not inherently superior. It deserves a place among options that can be evaluated with a clear audience and objective."}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"An arms race is also permission to change the game."}],["$","p",null,{"children":"When every edit adds another zoom, subtitle effect and sound cue, adding one more can feel like the only competitive move. But the audience does not experience your production effort; it experiences the resulting piece. A calm demonstration can be more distinctive than a frantic edit when the surrounding material is already loud. A single unbroken action can create stronger anticipation than a sequence of cuts that never lets the viewer understand the task."}],["$","figure",null,{"className":"editorial-diagram diagram-compare","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"Two ways to create attention"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Density",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Density"}],["$","p",null,{"children":"Multiple changes compete to keep the viewer stimulated."}],false]}]]}],["$","li","Clarity",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Clarity"}],["$","p",null,{"children":"A legible action gives the viewer a reason to keep watching."}],false]}]]}],["$","li","Tension",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Tension"}],["$","p",null,{"children":"An unfinished question makes the next moment matter."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Write two briefs around the same useful promise. In one, build attention through density; in the other, use clarity, restraint or an unresolved action. Keep the product claim and intended audience comparable enough that the review is meaningful. Ask what each treatment helps the viewer understand, not only which style the team prefers. A win for the quieter version would not establish a new universal rule about slow content. It would tell you something about this promise, this audience and these executions. The point is to keep creative options open when a production habit starts masquerading as strategy."}]]]}],false,false,"$L19","$undefined","$L1a","$L1b","$L1c","$L1d"]}],"$L1e"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L1f","010",{"a":{"id":"010","author":"spike","slug":"attention-war","category":"doctrine","term":"Attention War","kind":"essay","image":"attention-war","media":"$1:props:children:1:props:next:media","en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos."},"readingMinutes":7},"lang":"en"}],["$","$L1f","008",{"a":{"id":"008","author":"spike","slug":"content-saturation","category":"doctrine","term":"Content Saturation","kind":"essay","image":"content-saturation","media":"$1:props:children:1:props:previous:media","en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention."},"readingMinutes":2},"lang":"en"}],["$","$L1f","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
