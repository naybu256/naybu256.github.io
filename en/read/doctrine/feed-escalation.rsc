3:["$","div",null,{"lang":"en","children":[["$","$Le",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI Content for Social Media: How to Avoid Generic Output","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"Account Isolation in AGD: Build Distinct Social Accounts","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Native Posting vs API Posting on TikTok: What Can You Test?","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"TokPortal MCP Tutorial: Preview an AI Workflow with Dry Run","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"AGD for TikTok 101: Accounts, Content and Your First Tests","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"Content Isolation: How to Differentiate a Multi-Account Strategy","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"How AGD Changes the Competition for Organic Reach","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"AGD vs Phone Farms: Strategy, Accounts and Infrastructure","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"How to Build an AGD Strategy with Your Existing Tools","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"AGD Marketing Principles: A Practical Editorial Framework","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"AGD Marketing Mistakes: Volume, Copying and False Promises","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"What Is a Native TikTok Account? Context and Limitations","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"How to Build a Social Media Persona: The Duolingo Example","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"TikTok Hook Examples: Replace Clickbait with a Clear Payoff","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"TikTok Content Series: Build a Repeatable Format","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"AI Personas for Social Media: Character Design and Disclosure","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"Persona-Based AGD: Give Each Account a Distinct Voice","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"TikTok Slideshow Strategy: Story Structure for AGD","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"How to Structure a TikTok Slideshow as a Story","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Educational TikTok Content: Turn a Real Process into a Story","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"Brand Memes on TikTok: What Ryanair’s Persona Can Teach You","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"TikTok Product Discovery: Lessons from the Ocean Spray Video","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"How to Write a TikTok Creative Brief with a Concrete Example","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"How to Build a TikTok Creative Library from Real Examples","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"TikTok Content Fatigue: When to Refresh a Recurring Format","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"Creative Testing Matrix: Lessons from LEGO’s Instagram Reel","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"TikTok Account Warming: Define a Relevant, Testable Routine","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native TikTok Posting: Workflow, Features and Quality Checks","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Native Account Warming: Actions, Records and Limits","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"US TikTok Accounts: Geography, Setup and Audience Limits","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Geo-Posting for TikTok: Location Context vs Audience Targeting","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"How to Reach US TikTok Audiences from Abroad","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"TikTok Content Localization: Go Beyond Translation","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"Social Media Account Brief: Audience, Voice and Publishing Rules","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"Social Publishing Handoffs: What to Give Your Operator","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"TikTok Publishing Schedule: Plan Windows, Not Magic Minutes","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"How to Organize a Multi-Account Social Media Inventory","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Why Does My TikTok Have Zero Views? A Diagnostic Workflow","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"TikTok Shadowban or Low Reach? How to Investigate","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"TikTok Publishing Failures: Separate Upload, Access and Reach","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic Brand Accounts: Native Content and Transparent Identity","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"Reddit Marketing and AGD: Contribute Before You Promote","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Community Marketing: How Brands Join Existing Conversations","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"Social Media Content Rights: A Publishing Checklist","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"AGD Campaign Review: Creative, Distribution and Evidence","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"How to Budget an AGD Experiment: Costs and Learning Goals","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"What Counts as a Viral TikTok? Define the Comparison","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"TikTok Viral Hit Rate: Define Attempts and Measure Outcomes","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"TikTok Analytics: Average vs Median Views Explained","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"Social Media Analytics: How to Read Performance Percentiles","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"Why a Few TikTok Posts Can Dominate Your Reach","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"Multi-Account Analytics: Measure Performance Concentration","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"How to Compare TikTok Campaigns with Matched Cohorts","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"Best Time to Post on TikTok? Test Timing Without the Myths","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"How Often Should You Post on TikTok? Design a Useful Test","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Does TikTok Account Warming Work? An Experiment Protocol","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"Does TikTok Account Age Affect Reach? What to Compare","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"TikTok Slideshows vs Videos: How to Compare the Formats","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"TikTok Content Strategy: Recurring Series vs Spontaneous Posts","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"TikTok Creative Testing: Compare Ideas, Not Just Edits","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"TikTok Native Features: Test Their Creative Contribution","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"How to Measure Your TikTok Zero-View Rate","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Social Media Experiments: Confidence Intervals Explained","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"TikTok Case Studies and Survivorship Bias: What Is Missing?","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"Why TikTok Views Drop After a Viral Post","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Campaign Cohort Analysis: Compare Equally Mature Results","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"TikTok Marketing Attribution: UTMs, Visits and First Purchases","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"From TikTok Views to Sales: Measure the Customer Journey","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Social Media Experiment Template: Write the Plan First","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"When to Stop an AGD Experiment: Budget and Evidence Rules","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"How to Evaluate AGD Claims: Documentation, Examples and Tests","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI for AGD Marketing: From Creative Brief to Publishing Workflow","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"Agentic AGD: What an AI Distribution Agent Should Do","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"TokPortal’s Human API: Briefs, Native Actions and Receipts","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"TokPortal MCP Workflows: Connect AI to Social Operations","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"What Does a TokPortal Dry Run Do? Preview Scope and Limits","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"API Retry Safety: Avoid Duplicate Social Publishing Operations","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"Social Publishing Webhooks: Events, Status and Recovery","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"How to Set a Budget for an AI Marketing Agent","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"AI Marketing Automation: When to Increase Agent Autonomy","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Social Media API Automation: Keep the Editorial Brief Intact","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Content Routing for Multiple Social Accounts","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"How to Organize Social Creative by Idea and Mechanism","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"Social Media Monitoring: Build Useful Operational Alerts","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human Review for AI Content: Approve the Version That Ships","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Marketing Automation Records: Build a Reliable Source of Truth","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"AGD and SEO: Turn Social Ideas into Searchable Articles","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic SEO for AGD: Structure Useful, Distinct Pages","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"Writing AGD Content That Search and AI Can Cite","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"Internal Linking for AGD Content: Connect Concepts Clearly","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Multilingual Content Strategy: When to Expand Your AGD Site","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"AGD Article Schema: Structure Text, Stories and Real Examples","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"AI Agent Audit Logs: Trace Marketing Actions and Decisions","dek":"An agent log connects intent, tool, result and next decision."}}]}],"$Lf","$L10"]}]
11:T52b,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://naybu256.github.io/en/read/doctrine/feed-escalation/#article","headline":"How AGD Changes the Competition for Organic Reach","description":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds.","inLanguage":"en","datePublished":"2026-09-08T12:00:00Z","dateModified":"2026-09-09T07:41:56.167Z","image":["https://naybu256.github.io/images/editorial/feed-escalation.jpg"],"author":{"@type":"Organization","name":"Spike","url":"https://naybu256.github.io/en/about/#spike","image":"https://naybu256.github.io/images/authors/spike.jpg"},"publisher":{"@type":"Organization","name":"THE ORGANIC CLUB","url":"https://naybu256.github.io"},"mainEntityOfPage":"https://naybu256.github.io/en/read/doctrine/feed-escalation/","articleSection":"The doctrine","wordCount":368,"citation":[]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"THE ORGANIC CLUB","item":"https://naybu256.github.io/en/"},{"@type":"ListItem","position":2,"name":"The doctrine","item":"https://naybu256.github.io/en/topics/doctrine/"},{"@type":"ListItem","position":3,"name":"How AGD Changes the Competition for Organic Reach","item":"https://naybu256.github.io/en/read/doctrine/feed-escalation/"}]}]}1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],["$","$L12",null,{"article":{"id":"009","slug":"feed-escalation","term":"Feed Escalation","category":"doctrine","kind":"essay","image":"feed-escalation","tier":"editorial","evidence":"editorial","sources":[],"related":["attention-war","content-saturation","distribution-is-the-moat"],"en":{"title":"How AGD Changes the Competition for Organic Reach","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds.","point":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds. It is not a scientific metric.","body":["When an editing effect becomes easy to reproduce, it stops being enough to distinguish a creator. You can escalate or change the game: a calm tutorial, an uncut demonstration, a specific opinion. Compare these options with the relevant audience rather than the creative director’s taste.","Imagine two demonstrations of one feature. The first piles on effects and commentary; the second shows a complete operation with a few quiet annotations. Ask what viewers understand about the use case, not simply which edit appears more expensive. The calm format is not inherently superior. It deserves a place among options that can be evaluated with a clear audience and objective."],"action":["Test a calm format against a dense edit with a comparable promise.","Inspect qualitative feedback too."],"trap":"More stimulation does not necessarily mean more understanding.","quote":"Welcome to the feed arms race.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Welcome to the feed arms race.","text":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds.","media":"/images/editorial/feed-escalation.jpg"},{"label":"THE CONCEPT","title":"Feed Escalation","text":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds. It is not a scientific metric.","media":"/images/editorial/feed-escalation.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"More stimulation does not necessarily mean more understanding.","media":"/images/editorial/feed-escalation.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Test a calm format against a dense edit with a comparable promise.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/feed-escalation.jpg"},{"label":"PUT IT TO WORK / 2","title":"Inspect qualitative feedback too.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/feed-escalation.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"An arms race is also permission to change the game.","paragraphs":["When every edit adds another zoom, subtitle effect and sound cue, adding one more can feel like the only competitive move. But the audience does not experience your production effort; it experiences the resulting piece. A calm demonstration can be more distinctive than a frantic edit when the surrounding material is already loud. A single unbroken action can create stronger anticipation than a sequence of cuts that never lets the viewer understand the task.","Write two briefs around the same useful promise. In one, build attention through density; in the other, use clarity, restraint or an unresolved action. Keep the product claim and intended audience comparable enough that the review is meaningful. Ask what each treatment helps the viewer understand, not only which style the team prefers. A win for the quieter version would not establish a new universal rule about slow content. It would tell you something about this promise, this audience and these executions. The point is to keep creative options open when a production habit starts masquerading as strategy."],"diagram":{"kind":"compare","title":"Two ways to create attention","items":[{"label":"Density","detail":"Multiple changes compete to keep the viewer stimulated.","value":0},{"label":"Clarity","detail":"A legible action gives the viewer a reason to keep watching.","value":0},{"label":"Tension","detail":"An unfinished question makes the next moment matter.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Study whether the example holds attention through movement, information or anticipation. These are editorial interpretations of visible choices, not measurements of its retention curve. The creator’s private analytics remain unknown.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"spike","media":{"kind":"photograph","src":"/images/editorial/feed-escalation.jpg","width":1280,"height":856,"alt":{"en":"Foaming waves surge against a dark stone seawall on the French Mediterranean coast."},"credit":"Christian Ferrer","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 2eee3d863a69eda37f2744597749b83d169ccee1.","source":"https://commons.wikimedia.org/wiki/File:Waves_on_the_Th%C3%A9%C3%A2tre_de_la_Mer.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},"lang":"en","next":{"id":"010","slug":"attention-war","term":"Attention War","category":"doctrine","kind":"essay","image":"attention-war","tier":"editorial","evidence":"editorial","sources":[],"related":["agd-not-phone-farm","feed-escalation","distribution-is-the-moat"],"en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos.","point":"For an app, a useful AGD creative connects a recognisable audience problem to a visible product action. In this StudyFetch post, the creator introduces a specific memorisation task, shows the corresponding prompt on a laptop and exposes the generated answer. The connection is the lesson to study.","body":["A stranger scrolling past your app does not owe it a feature tour. Give them a problem worth staying for. The StudyFetch clip above does that with a narrow study task, then keeps the same task in view when the product appears. The app earns its place in the scene. You can examine that continuity without pretending to know what the post generated in installs or revenue.","This is a more useful reference for an app founder than an instruction to “be authentic”. The creator, question and product action fit together on screen. A different account could address a different kind of student or a different moment in their work, but the same edit cannot prove that a whole account network would perform. The unit we can inspect here is one published creative."],"action":["Write the exact audience question before drafting a product claim.","Record your own prompt, the returned answer and any necessary correction.","Assign a concept ID, account and destination URL to each version.","Check clicks and first purchases separately from views and comments."],"trap":"The creator’s commercial relationship, acquisition results and the correctness of the generated study answer were not independently verified.","quote":"Give the app a job in the story.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Give the app a job in the story.","text":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos.","media":"/images/editorial/attention-war.jpg"},{"label":"THE CONCEPT","title":"Attention War","text":"For an app, a useful AGD creative connects a recognisable audience problem to a visible product action. In this StudyFetch post, the creator introduces a specific memorisation task, shows the corresponding prompt on a laptop and exposes the generated answer. The connection is the lesson to study.","media":"/images/editorial/attention-war.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The creator’s commercial relationship, acquisition results and the correctness of the generated study answer were not independently verified.","media":"/images/editorial/attention-war.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the exact audience question before drafting a product claim.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attention-war.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record your own prompt, the returned answer and any necessary correction.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attention-war.jpg"},{"label":"PUT IT TO WORK / 3","title":"Assign a concept ID, account and destination URL to each version.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attention-war.jpg"},{"label":"PUT IT TO WORK / 4","title":"Check clicks and first purchases separately from views and comments.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/attention-war.jpg"}]}]},"workshops":[{"id":"video","title":"Prepare the actual video slot, not just the caption","intro":"TokPortal’s editor distinguishes Video, Carousel and Story, and asks for a target publishing period. The API follows the same operational idea: the content needs a valid format, accessible media and a usable window.","endpoint":"PUT /api/ext/bundles/{id}/videos/{position}","code":"{\n  \"tool\": \"tokportal_configure_bundle_video\",\n  \"arguments\": {\n    \"id\": \"<real-bundle-uuid>\",\n    \"position\": 1,\n    \"body\": {\n      \"video_type\": \"video\",\n      \"video_url\": \"<public_url returned by your video upload>\",\n      \"description\": \"A practical example of organising freelance subscriptions.\",\n      \"target_publish_date\": \"<valid future date: YYYY-MM-DD>\"\n    }\n  }\n}","language":"json","explain":"Replace the marked values with your actual upload and bundle. This template is intentionally not a runnable campaign. target_publish_date starts a two-day publishing window; it does not request an exact minute.","checks":[{"label":"Choose the correct media fields","detail":"A video needs video_url and description. A TikTok carousel instead needs carousel_images and tiktok_sound_url."},{"label":"Use a valid window","detail":"Allow at least three days while account creation is pending, or one day for delivered/existing accounts. Check the current response and limits."},{"label":"Inspect readiness","detail":"GET /api/ext/bundles/{id}/publish-readiness lists blockers without a debit or mutation. Review ignored_fields and the returned start/end dates."}],"sources":["https://developers.tokportal.com/mcp/"],"checkedAt":"2026-09-09T00:00:00Z","capture":{"src":"/images/tokportal/tokportal-video-editor.png","width":650,"height":565,"alt":"Two real TokPortal editor views showing media format, caption and target publishing period.","caption":"Two cropped views of the real video editor, captured 8 September 2026. Historical dates shown; use a valid future window for a new task.","source":"https://app.tokportal.com/dashboard"}}],"schemaVersion":2,"deepDive":{"heading":"Keep the same question from hook to answer.","paragraphs":["The first editorial decision is the audience’s job. In this case it is a specific memorisation problem, not “students who like technology”. That level of detail is what makes an account brief useful. A student preparing a presentation, someone revising a terminology list and someone organising lecture notes might all use the same product, but they would need different demonstrations. Write the task, the moment and the expected output before you write an opening line. Then check whether the actual product can deliver the output you are planning to show. If it cannot, change the concept instead of asking the edit to conceal the gap.","The camera’s move to the laptop is the hinge of the creative. It connects the recommendation to something a viewer can inspect: a question and its answer. The oblique screen recording is not pristine studio footage, and that should not become a new rule that roughness performs better. What matters for this reading is that the operation stays connected to the opening. In your own version, favour legibility. Crop out irrelevant browser chrome, make the input readable and leave enough time for a viewer to understand the output. A fast cut can create pace while still leaving the useful part impossible to examine.","For an AGD team, account differentiation should start before the recording. Give each account a reason to ask a different question of the product. One could centre on planning a revision session, another on checking understanding after a lecture, and another on making a group presentation. These are proposed editorial directions, not accounts we observed in the StudyFetch campaign. Each needs its own visible task and an honest voice. Repeating one script through several profiles gives you more publication instances; it does not automatically give you more audience insight.","Keep a creative record that survives the upload. Save the source of inspiration, your own recording, the concept ID, the changed variable and the final post URL. If a new opening performs differently, you need to know whether the demonstration also changed. Read comments for the job people are asking about, then compare that with the destination you offer. A viewer asking whether the app handles lecture recordings should not land on a page that says nothing about recordings. UTMs can help trace a visit; the purchase still needs its own event record. Treat a public view count as a reason to inspect a creative, not as a substitute for this chain.","At handoff, the operator should receive a finished package: original media with the necessary rights, a caption that matches the demonstrated task, an account identifier and a valid publishing window. TokPortal’s video-slot workflow below makes those inputs explicit. The product helps move an approved idea into an operational queue. The part it cannot decide for you is whether the original promise survives the upload. Watch the final asset once as somebody who has never heard of your app. If the product appears without answering the opening question, return to the brief."],"diagram":{"kind":"flow","title":"A product demo with an unbroken question","items":[{"label":"Audience task","detail":"Name the job in the viewer’s own context.","value":0},{"label":"Visible input","detail":"Show what you give the actual product.","value":0},{"label":"Inspectable output","detail":"Let the viewer understand what came back.","value":0},{"label":"Next action","detail":"Connect interest to a relevant destination.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Follow the same question across the creator segment, the filmed laptop and the answer. Each cut needs to keep that connection intact.","caseIds":["studyfetch-mnemonic"]},"examples":[{"id":"studyfetch-mnemonic","platform":"tiktok","url":"https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","creator":"StudyFetchBella","title":"StudyFetch: make the study problem the opening","description":"The creator introduces a concrete memorisation task, then films the StudyFetch chat on a laptop. A prompt and its generated mnemonic are visible before the clip returns to the creator.","mechanism":"A narrow audience problem leads directly to the product operation that addresses it. The filmed screen gives the recommendation an inspectable object.","limitation":"The creator’s commercial relationship with StudyFetch was not verified. This visual inspection does not validate the educational answer or establish organic reach, paid amplification or conversions.","observationBasis":"Playback started and visual sequence inspected on 9 September 2026. Muted observation; no audio transcription or product test.","checkedAt":"2026-09-09T00:00:00Z","references":["https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","https://www.studyfetch.com/tools"],"frames":[{"src":"/images/social/studyfetch-hook.jpg","alt":"StudyFetchBella speaking to camera about a specific memorisation task.","source":"https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","capturedAt":"2026-09-09T00:00:00Z","crop":{"x":326,"y":16,"width":388,"height":688}}],"screenshot":{"src":"/images/social/studyfetch-demo.jpg","alt":"The StudyFetch chat interface on a filmed laptop, with an entered study question and a mnemonic answer.","source":"https://www.tiktok.com/@studyfetchbella/video/7572316352451546399","capturedAt":"2026-09-09T00:00:00Z","crop":{"x":326,"y":16,"width":388,"height":688}},"breakdown":{"format":"Specific problem → filmed app → usable answer","audience":"A student trying to remember a defined set of terms.","productRole":"StudyFetch is shown answering the task introduced by the creator.","beats":[{"label":"Name the job before the app","observed":"The creator speaks to camera about memorising four terms and counts them on her fingers.","reading":"The opening lets a relevant viewer recognise their own problem. It gives the later app appearance a reason to be in the video, beyond a generic claim that AI saves time."},{"label":"Show the request","observed":"The view changes to a filmed laptop with StudyFetch’s chat and a prompt about the same memorisation task.","reading":"The continuity matters: the product addresses the exact problem introduced earlier. A cut to an unrelated dashboard would supply branding while withholding the useful connection."},{"label":"Expose the output","observed":"The answer contains a mnemonic with words mapped to the terms; the clip then returns to the creator.","reading":"The viewer can inspect what the tool produced. The output’s presence is observable; its accuracy and usefulness still require subject-matter checking. That distinction should survive any adaptation."}],"transfer":{"title":"One audience problem. One visible product action.","scenario":"Original brief for a study app demonstration.","hook":"I keep mixing up these four terms, so I tried this.","visual":"Use a study question you can verify. Show the problem, enter the request in the actual app and display the answer long enough to read. Correct any mistake on screen instead of hiding it in the edit.","keep":"The same problem across the opening, prompt and answer.","change":"Use your own subject, recording and explanation. Do not impersonate this creator or imply their endorsement.","measure":"Record the source clip, concept, account, post URL and publication date. Read product questions separately from generic reactions; use your own click and signup evidence for conversion claims."}}}],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T08:07:13.020Z","author":"spike","media":{"kind":"photograph","src":"/images/editorial/attention-war.jpg","width":1280,"height":720,"alt":{"en":"Crowds move below towering illuminated billboards in Times Square at night."},"credit":"ScottandYanling","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 5ddae25d04c3d3d4ad78cd0745a1f27946fe5fa5.","source":"https://commons.wikimedia.org/wiki/File:Times_Square_at_Night_with_crowds_of_people.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},"previous":{"id":"008","slug":"content-saturation","term":"Content Saturation","category":"doctrine","kind":"essay","image":"content-saturation","tier":"editorial","evidence":"editorial","sources":[],"related":["feed-escalation","content-isolation","distribution-is-the-moat"],"en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention.","point":"Content Saturation describes content supply exceeding available attention. Within AGD it is a thesis about competition, not an established universal measurement.","body":["Your actual competitor in a feed might be a joke a friend shared. A post does not win merely by beating another company’s post. It must earn a place in a session where nobody requested your product. Situational relevance becomes more useful than another arbitrary posting schedule.","For a tutorial, narrowing the promise may be the useful response. “Find a note during a call” describes a real moment; “be more productive” describes almost everything. A specific situation helps choose the opening screen, what to demonstrate and what to remove. Competition becomes a relevance question rather than a demand to make every piece louder, faster and longer."],"action":["Describe when the audience would need this content.","Remove introductions that delay its value."],"trap":"Content abundance does not by itself prove declining reach for every account.","quote":"The feed did not add hours to the day.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The feed did not add hours to the day.","text":"Content Saturation describes content supply exceeding available attention.","media":"/images/editorial/content-saturation.jpg"},{"label":"THE CONCEPT","title":"Content Saturation","text":"Content Saturation describes content supply exceeding available attention. Within AGD it is a thesis about competition, not an established universal measurement.","media":"/images/editorial/content-saturation.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Content abundance does not by itself prove declining reach for every account.","media":"/images/editorial/content-saturation.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe when the audience would need this content.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-saturation.jpg"},{"label":"PUT IT TO WORK / 2","title":"Remove introductions that delay its value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-saturation.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"Compete with the viewer’s next choice, not your rival’s calendar.","paragraphs":["Your next post does not enter an empty lane reserved for products in your category. It enters a session containing a message from a friend, a joke, a useful tutorial and a dozen things the viewer never asked to see. That changes the brief. “Our feature is better” may be true and still be irrelevant to the moment. Describe the situation in which the viewer would care, then make that situation recognisable before asking them to process the product.","Audit a proposed post by removing its introduction. If the useful part begins several sentences later, the viewer is paying an attention tax to reach it. Sometimes context is necessary, especially for a difficult explanation; the question is whether the context creates understanding or merely delays the point. Compare a concise version with a version that builds useful tension, using similar audiences and a consistent observation window. Do not turn content saturation into a universal explanation for weak results. It is a way to sharpen editorial choices, not a diagnosis you can attach to every declining graph."],"diagram":{"kind":"flow","title":"Earn the next few seconds","items":[{"label":"Recognise","detail":"Make a specific situation legible immediately.","value":0},{"label":"Deliver","detail":"Give the viewer information or a feeling worth staying for.","value":0},{"label":"Continue","detail":"Make the next action a natural extension of that value.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Notice what the post offers before it asks for anything. The example illustrates a way of competing for attention. It cannot measure how saturated an entire platform is, or predict how your own audience will respond.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"spike","media":{"kind":"photograph","src":"/images/editorial/content-saturation.jpg","width":1280,"height":720,"alt":{"en":"An elevated view of Shibuya Crossing surrounded by illuminated screens and city streets."},"credit":"David Kernan","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 3abb12c212e38c662a406c48dd9a526c881404f3.","source":"https://commons.wikimedia.org/wiki/File:Shibuya_Crossing,_Aerial.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}}}],"$L13","$L14","$L15","$L16"]}]
