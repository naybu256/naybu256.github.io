"className":"article-prose deep-dive","children":[["$","h2",null,{"children":"A label should not arrive before the evidence."}],["$","p",null,{"children":"When distribution changes abruptly, the pressure to name the cause is strong. Separate what is observed from what is inferred. A platform notification, a visible restriction and a drop in a metric are different pieces of information. Record them independently, with dates and the affected scope. The phrase shadowban can otherwise compress several unknowns into an explanation that nobody has actually tested."}],["$","figure",null,{"className":"editorial-diagram diagram-compare","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"Keep observation and interpretation apart"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Observed",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Observed"}],["$","p",null,{"children":"A dated status, notification or measurement."}],false]}]]}],["$","li","Inferred",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Inferred"}],["$","p",null,{"children":"A possible explanation that fits some of those facts."}],false]}]]}],["$","li","Needed",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Needed"}],["$","p",null,{"children":"The evidence that would distinguish it from alternatives."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Inspect publication status, account notices, content changes and the observation window before proposing a mechanism. Compare relevant history rather than the single best post the account ever produced. Avoid repeatedly changing multiple variables while investigating; doing so makes the next observation harder to interpret. If the available evidence cannot identify the cause, say exactly what remains unknown and what would help distinguish the plausible explanations. A careful diagnosis may be less satisfying than a confident theory, but it gives the operator a better next action."}]]]}],false,false,"$L19","$undefined","$L1a","$L1b","$L1c","$L1d"]}],"$L1e"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L1f","047",{"a":{"id":"047","author":"spike","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","kind":"guide","image":"distribution-failure","media":"$1:props:children:1:props:next:media","en":{"title":"TikTok Publishing Failures: Separate Upload, Access and Reach","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."},"readingMinutes":2},"lang":"en"}],["$","$L1f","045",{"a":{"id":"045","author":"spike","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","kind":"guide","image":"zero-views","media":"$1:props:children:1:props:previous:media","en":{"title":"Why Does My TikTok Have Zero Views? A Diagnostic Workflow","dek":"Stuck at 0 views describes low or absent distribution after publication."},"readingMinutes":3},"lang":"en"}],["$","$L1f","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
