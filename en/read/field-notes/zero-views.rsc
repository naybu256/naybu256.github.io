14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero","children":["$","img",null,{"src":"/images/editorial/zero-views.jpg","alt":"Rows of empty red seats inside a dark cinema auditorium.","width":1280,"height":720,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Empty_Movie_Theater_(54280927025).jpg","children":"Eden, Janine and Jim"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by/2.0","children":"CC BY 2.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],["$","a",null,{"href":"#analysis","children":["02 / ","The analysis"]}],["$","a",null,{"href":"#practice","children":["03 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["04 / ","Sources & limits"]}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"Stuck at 0 views describes low or absent distribution after publication. Without further evidence it identifies neither enforcement nor its cause."}]]}],["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Check publication state, accessibility, media processing and visible notifications. Record the post’s exact age at inspection. Compare it with content observed at the same age. Immediately deleting and reposting can destroy information needed to understand what happened."}],["$","p","1",{"children":"A useful report states when the post was published, when it was accessible and when its counter was still zero. This sounds less dramatic than an instant diagnosis but allows later verification. If the counter changes, preserve both observations. You then have an interpretable timeline instead of an isolated screenshot, and can distinguish delayed measurement from genuinely absent distribution without inventing the reason for either."}]]}],["$","blockquote",null,{"children":["“","Zero views is not a diagnosis.","”"]}],"$undefined",false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en","number":2}],["$","section",null,{"id":"practice","children":[["$","h2",null,{"children":"Put it to work."}],["$","ol",null,{"className":"checklist","children":[["$","li","0",{"children":[["$","span",null,{"children":["0",1]}],"Preserve URL, timestamp and notifications."]}],["$","li","1",{"children":[["$","span",null,{"children":["0",2]}],"Separate observation from explanatory hypotheses."]}]]}]]}],["$","section",null,{"id":"sources","children":[["$","h2",null,{"children":"What this does not prove."}],["$","p",null,{"className":"caveat","children":[["$","strong",null,{"children":"The limit. "}],"A zero in a tool can also indicate missing or delayed data."]}],["$","div",null,{"className":"sources","children":[["$","span",null,{"className":"mono acid","children":"SOURCES & PROVENANCE"}],["$","p",null,{"children":"Original analysis of the AGD framework provided by TokPortal, lexicon and doctrine (2026). Examples are illustrative. No proprietary study or customer outcome is claimed."}],["$","p",null,{"className":"editorial-note","children":["FEEDRAID is an editorial project initiated by TokPortal. That relationship is separate from the evidence behind claims. AI-assisted writing; no fictional journalist identities."," ",["$","a",null,{"href":"/en/about/","children":"Our editorial policy →"}]]}]]}]]}],["$","div",null,{"className":"next-read","children":[["$","span",null,{"className":"mono acid","children":"THE CURRENT CONTINUES"}],["$","h2",null,{"children":["$","a",null,{"href":"/en/read/field-notes/shadowban/","children":"Shadowban is sometimes the name we give the unknown."}]}],["$","a",null,{"href":"/en/read/field-notes/shadowban/","className":"read-link","children":["Next article"," ↗"]}]]}]]}],["$","aside",null,{"className":"article-aside right-aside","children":[["$","span",null,{"className":"mono muted","children":"CONNECTED IDEAS"}],[["$","a","046",{"href":"/en/read/field-notes/shadowban/","children":["Shadowban"," ↗"]}],["$","a","044",{"href":"/en/read/field-notes/account-inventory/","children":["Account inventory"," ↗"]}],["$","a","001",{"href":"/en/read/doctrine/distribution-is-the-moat/","children":["Account-Generated Distribution"," ↗"]}]]]}]]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L19","046",{"a":"$1:props:children:1:props:next","lang":"en"}],["$","$L19","044",{"a":"$1:props:children:1:props:previous","lang":"en"}],["$","$L19","001",{"a":{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","tier":"canonical","evidence":"editorial","sources":[],"related":["account-isolation","content-isolation","content-saturation"],"en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","point":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","body":["The pitch fits in a browser tab: one generator, a few prompts, fifty videos. The problem starts after export. Who watches? Why should that person stop at this account instead of the next one? Production has a button. Distribution still needs a reason to exist.","A brand account is often asked to reassure, sell, entertain, recruit and explain. Every post negotiates with the others. AGD separates those jobs. One account explores student frustrations; another challenges work habits; a third demonstrates a product in context. One company, three editorial promises.","The trap is reading this architecture as a volume recipe. Thirty accounts running the same edit do not represent thirty ideas. They mostly multiply coordination, repetition and unanswered questions. Diversification lives in what a viewer receives, not in the number of rows in a spreadsheet.","AGD is a proposed framework drawn from the TokPortal blueprint, not an academic consensus or a reach guarantee. Its value depends on the experiments it helps run. The useful question is whether a network reveals something that one account would hide. Can the signal be connected to an angle, an audience or a format?","Build a small network whose differences you can explain. Document the failures alongside the breakout posts. And keep a commercial measure next to views: somebody enjoying your edit does not necessarily have a problem your product solves."],"action":["Write a different editorial promise for each account.","Attach each post to a hypothesis and an audience.","Measure by cohort, then inspect qualified visits."],"trap":"A clone network can increase output without adding a single perspective.","quote":"The next advantage is knowing where an idea deserves to live.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The next advantage is knowing where an idea deserves to live.","text":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account-Generated Distribution","text":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A clone network can increase output without adding a single perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a different editorial promise for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach each post to a hypothesis and an audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 3","title":"Measure by cohort, then inspect qualified visits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"video":{"src":"/video/below-the-surface.mp4","poster":"/images/iceberg.jpg","caption":{"en":"Below the surface — animated original illustration. No audio."},"tracks":{"en":"/video/intro-en.vtt"}},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"FEEDRAID Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"}},"lang":"en"}]]}]]}]
