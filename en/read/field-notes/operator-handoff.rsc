13:["$","header",null,{"className":"article-header","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","a",null,{"href":"/en/","children":"THE ORGANIC CLUB"}],["$","span",null,{"children":"/"}],["$","a",null,{"href":"/en/topics/field-notes/","children":"Field notes"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"Operator handoff"}]]}],["$","div",null,{"className":"mono acid","style":{"marginTop":28},"children":["FIELD GUIDE"," ","· ","042"]}],["$","h1",null,{"children":"Social Publishing Handoffs: What to Give Your Operator"}],["$","p",null,{"className":"article-dek","children":"A handoff transfers an executable task with assets, constraints and success conditions."}],["$","div",null,{"className":"byline","children":[["$","a",null,{"href":"/en/about/#spike","className":"author-signature","children":[["$","img",null,{"src":"/images/authors/spike.jpg","alt":"","width":48,"height":48}],["$","span",null,{"children":["Spike",["$","small",null,{"children":"Distribution & field notes"}]]}]]}],["$","span",null,{"className":"muted","children":["08/09/2026"," ","· ",3," min"]}],["$","span",null,{"className":"evidence-tag","children":"Editorial analysis"}]]}]]}]
14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/operator-handoff.jpg","alt":"An empty recording studio with a mixing desk, speakers, and a glowing computer screen.","width":1280,"height":942,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:Mixing_at_Jackpot!_Recording_Studio_(Portland,_Oregon).jpg","children":"VACANT FEVER"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/2.0","children":"CC BY-SA 2.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
