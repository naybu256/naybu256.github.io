1a:["$","p","0",{"children":["Describe what the operator should do when the final preview differs from the approved plan. A missing sound, unavailable feature or unexpected account state should have a clear escalation path. Do not make improvisation the default simply because the publishing window is approaching. After execution, record the confirmed outcome and the original post URL where available. The handoff is complete when the next person can tell what happened, not when a chat message says “done”. That distinction matters even more when an agent prepares the package and a human performs the last step."]}]
1b:["$","section",null,{"id":"tokportal-workflow","className":"product-workshops","children":[["$","div",null,{"className":"case-intro","children":[["$","span",null,{"className":"mono acid","children":"INSIDE TOKPORTAL"}],["$","h2",null,{"children":"From the idea to the actual workflow."}],["$","p",null,{"children":"Product screens, documented tools and a practical way to connect them."}]]}],[["$","section","video",{"className":"product-workshop","aria-labelledby":"workshop-video","children":[["$","div",null,{"className":"workshop-label mono","children":[["$","span",null,{"className":"acid","children":["WORKBENCH / ","VIDEO"]}],["$","span",null,{"children":["DOCUMENTED · ","2026-09-09"]}]]}],["$","h3",null,{"id":"workshop-video","children":"Prepare the actual video slot, not just the caption"}],["$","p",null,{"children":"In the archived editor capture, the interface shows Video, Carousel and Story options, plus a target publishing period. The API example below is a separate documented slot-configuration preview; the screenshot alone does not establish the API contract."}],["$","figure",null,{"className":"product-capture","children":[["$","a",null,{"href":"/images/tokportal/tokportal-video-editor.png","target":"_blank","rel":"noopener noreferrer","aria-label":"Enlarge: Two real TokPortal editor views showing media format, caption and target publishing period.","children":["$","img",null,{"src":"/images/tokportal/tokportal-video-editor.png","alt":"Two real TokPortal editor views showing media format, caption and target publishing period.","width":650,"height":565,"loading":"lazy"}]}],["$","figcaption",null,{"children":["Two cropped views of the real video editor, captured 8 September 2026. Historical dates shown; use a valid future window for a new task."," ",["$","a",null,{"href":"https://app.tokportal.com/dashboard","target":"_blank","rel":"noopener noreferrer","children":"Product ↗"}]]}]]}],["$","div",null,{"className":"endpoint","children":[["$","span",null,{"className":"mono","children":"REST EQUIVALENT"}],["$","code",null,{"children":"PUT /api/ext/bundles/{id}/videos/{position}"}]]}],["$","span",null,{"className":"mono muted","children":"ANNOTATED EXAMPLE"}],["$","$L23",null,{"lang":"en","text":"{\n  \"tool\": \"tokportal_configure_bundle_video\",\n  \"arguments\": {\n    \"id\": \"<real-bundle-uuid>\",\n    \"position\": 1,\n    \"body\": {\n      \"video_type\": \"video\",\n      \"video_url\": \"<public_url returned by your video upload>\",\n      \"description\": \"A practical example of organising freelance subscriptions.\",\n      \"target_publish_date\": \"<valid future date: YYYY-MM-DD>\",\n      \"ai_content_disclaimer\": false,\n      \"auto_publish\": false\n    },\n    \"dry_run\": true\n  }\n}","label":"MCP REQUEST"}],["$","p",null,{"children":"Replace the marked values with an authorized real bundle, a media URL you control and a valid future date. This is a dry-run template, not an executed campaign. The archived UI shows a two-day period for that captured example; use the current API validation response to determine the dates accepted for your own request."}],["$","ol",null,{"className":"workshop-checks","children":[["$","li","Choose the correct media fields",{"children":[["$","span",null,{"className":"mono acid","children":["0",1]}],["$","div",null,{"children":[["$","strong",null,{"children":"Choose the correct media fields"}],["$","p",null,{"children":"A video needs video_url and description. A TikTok carousel instead needs carousel_images and tiktok_sound_url."}]]}]]}],["$","li","Use a valid window",{"children":[["$","span",null,{"className":"mono acid","children":["0",2]}],["$","div",null,{"children":[["$","strong",null,{"children":"Use a valid window"}],["$","p",null,{"children":"Allow at least three days while account creation is pending, or one day for delivered/existing accounts. Check the current response and limits."}]]}]]}],["$","li","Read the preview result",{"children":[["$","span",null,{"class