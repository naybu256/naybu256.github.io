4:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"The network works. Or one account carries it. — THE ORGANIC CLUB"}],["$","meta","1",{"name":"description","content":"Account concentration shows which assets carry the total outcome."}],["$","meta","2",{"property":"og:title","content":"The network works. Or one account carries it."}],["$","meta","3",{"property":"og:description","content":"Account concentration shows which assets carry the total outcome."}],["$","meta","4",{"property":"og:url","content":"https://naybu256.github.io/en/read/lab/top-ten-accounts/"}],["$","meta","5",{"property":"og:type","content":"article"}],["$","meta","6",{"property":"og:locale","content":"en_US"}],["$","meta","7",{"property":"article:published_time","content":"2026-09-08T12:00:00Z"}],["$","meta","8",{"property":"article:modified_time","content":"2026-09-08T17:40:57.624Z"}],["$","meta","9",{"property":"og:image","content":"https://naybu256.github.io/images/editorial/top-ten-accounts.jpg"}],["$","meta","10",{"property":"og:image:width","content":"1280"}],["$","meta","11",{"property":"og:image:height","content":"832"}],["$","meta","12",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","13",{"name":"twitter:title","content":"The network works. Or one account carries it."}],["$","meta","14",{"name":"twitter:description","content":"Account concentration shows which assets carry the total outcome."}],["$","meta","15",{"name":"twitter:image","content":"https://naybu256.github.io/images/editorial/top-ten-accounts.jpg"}],["$","link","16",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","17",{"rel":"canonical","href":"https://naybu256.github.io/en/read/lab/top-ten-accounts/"}],["$","link","18",{"rel":"alternate","hrefLang":"en","href":"https://naybu256.github.io/en/read/lab/top-ten-accounts/"}],["$","li