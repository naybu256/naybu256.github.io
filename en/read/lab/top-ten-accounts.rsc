ldren":[["$","h2",null,{"children":"The leaderboard can hide a fragile network"}],["$","p",null,{"children":"A leaderboard makes concentration look like a management system. The strongest accounts sit at the top, the weak ones disappear below the fold, and the meeting becomes a conversation about scaling the winners. Before doing that, inspect what the ranking actually rewards. Lifetime totals favour older accounts. Recent totals can favour higher posting volume. Revenue rankings can mix returning buyers with newly acquired customers. The same account may be excellent by one definition and ordinary by another. Label the measure, time window and account age before making a resource decision."}],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"Read beyond the top row"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Rank",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Rank"}],["$","p",null,{"children":"Use a defined metric and comparable window."}],false]}]]}],["$","li","Explain",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Explain"}],["$","p",null,{"children":"Separate age, volume and creative contribution."}],false]}]]}],["$","li","Stress-test",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Stress-test"}],["$","p",null,{"children":"Model dependence on the leading account."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Add a dependency question: what happens if the strongest account stops publishing for a week? This is a planning scenario, not a forecast of a platform restriction. Map who produces its material, which audience promise it owns and whether other accounts reach genuinely different people. Copying the top account's surface style across the network may increase similarity without reducing concentration. A healthier response can be to document the winning process, preserve distinct editorial roles and give weaker accounts specific experiments rather than a generic instruction to resemble the leader."}]]]}],false,false,"$L19","$undefined",false,"$L1a","$L1b","$L1c","$L1d"]}],"$L1e"]}]
