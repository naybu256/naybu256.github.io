4:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Does native really win? Show the data. — THE ORGANIC CLUB"}],["$","meta","1",{"name":"description","content":"“APIs kill reach.” Here is the protocol that claim would need."}],["$","meta","2",{"property":"og:title","content":"Does native really win? Show the data."}],["$","meta","3",{"property":"og:description","content":"“APIs kill reach.” Here is the protocol that claim would need."}],["$","meta","4",{"property":"og:url","content":"https://naybu256.github.io/en/read/lab/native-vs-api/"}],["$","meta","5",{"property":"og:type","content":"article"}],["$","meta","6",{"property":"og:locale","content":"en_US"}],["$","meta","7",{"property":"article:published_time","content":"2026-09-08T12:00:00Z"}],["$","meta","8",{"property":"article:modified_time","content":"2026-09-08T17:45:45.218Z"}],["$","meta","9",{"property":"og:image","content":"https://naybu256.github.io/images/editorial/native-vs-api.jpg"}],["$","meta","10",{"property":"og:image:width","content":"1280"}],["$","meta","11",{"property":"og:image:height","content":"849"}],["$","meta","12",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","13",{"name":"twitter:title","content":"Does native really win? Show the data."}],["$","meta","14",{"name":"twitter:description","content":"“APIs kill reach.” Here is the protocol that claim would need."}],["$","meta","15",{"name":"twitter:image","content":"https://naybu256.github.io/images/editorial/native-vs-api.jpg"}],["$","link","16",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","17",{"rel":"canonical","href":"https://naybu256.github.io/en/read/lab/native-vs-api/"}],["$","link","18",{"rel":"alternate","hrefLang":"en","href":"https://naybu256.github.io/en/read/lab/native-vs-api/"}],["$","link","19",{"rel":"alternate","hrefLang":"x-default","href":"https://naybu256.github.io/en/read/lab/native-vs-api/"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L6",null,{"fallback":"$7","children":["$","$L8",null,{"fallback":"$7","children":["$","$L9",null,{"providerId":"layout:/","segmentMap":{"children":["en","read","lab","native-vs-api"]},"children":["$","$La",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"lang|en|d","fallback":["$","main",null,{"className":"main-shell","style":{"paddingTop":100,"minHeight":"80vh"},"children":[["$","span",null,{"className":"mono acid","children":"404 / SIGNAL LOST"}],["$","div",null,{"className":"page-heading","children":[["$","h1",null,{"children":"Off the current."}],["$","p",null,{"children":"This page does not exist."}],["$","a",null,{"className":"read-link","href":"/en/","children":"Back to feed ↗"}]]}]]}],"children":["$","$L9",null,{"providerId":"layout:/[lang]","segmentMap":{"children":["read","lab","native-vs-api"]},"children":["$","$La",null,{"id":"layout:/[lang]","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"[\"lang|en|d\",\"read\",\"category|lab|d\",\"slug|native-vs-api|d\"]","fallback":["$","main",null,{"className":"main-shell","style":{"paddingTop":100,"minHeight":"80vh"},"children":[["$","span",null,{"className":"mono acid","children":"404 / SIGNAL LOST"}],["$","div",null,{"className":"page-heading","children":[["$","h1",null,{"children":"Off the current."}],["$","p",null,{"children":"This page does not exist."}],["$","a",null,{"className":"read-link","href":"/en/","children":"Back to feed ↗"}]]}]]}],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L9",null,{"providerId":"page:/en/read/lab/native-vs-api","segmentMap":{"children":["__PAGE__"]},"children":["$","$La",null,{"id":"page:/en/read/lab/native-vs-api"}]}],null]}]}]}]}]}]}]}]}]}]}],null,null]
