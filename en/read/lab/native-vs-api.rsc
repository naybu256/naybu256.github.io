19:["$","div",null,{"children":[["$","strong",null,{"children":"Context"}],["$","p",null,{"children":"Which account, audience and observation window were involved."}],false]}]
1a:["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]
1b:["$","p","0",{"children":"There are legitimate operational reasons to choose native execution: access to a particular creation surface, an operator’s ability to inspect the final preview, or a workflow the platform exposes only in its own app. Those are capability claims, not evidence of an automatic reach bonus. A useful pilot records the final asset, account context, feature set, publication status and observation window. It also accepts an inconclusive result. If the team cannot hold the creative package reasonably comparable, report the comparison as two production workflows rather than a verdict on an invisible algorithmic preference."}]
1c:["$","p","1",{"children":"Make a capability table for the actual publishing task before choosing a route. Does this post need a particular in-app effect, an authorised commercial sound, a collaboration setting or an interactive element? Can the supported API perform that operation for this account today? Which steps still require an operator, and how will completion be verified? A plain video upload and a feature-rich native post are different packages. Comparing them without listing those differences lets a technical preference masquerade as an explanation of audience response."}]
1d:["$","p","2",{"children":"A sensible operation can use more than one route. An API may be appropriate for a supported, repeatable task; an authorised native workflow may be appropriate when a necessary feature is not exposed through that interface. The choice should follow the creative requirements, reliability and cost. Keep a dated record of the capability decision because platform interfaces change. TokPortal's infrastructure is relevant to the execution side of that choice, but its availability does not establish that a native route receives an algorithmic bonus. To investigate distribution, design a comparison that separates the route from the creative features and account histories travelling with it."}]
1e:["$","section",null,{"id":"tokportal-workflow","className":"product-workshops","children":[["$","div",null,{"className":"case-intro","children":[["$","span",null,{"className":"mono acid","children":"INSIDE TOKPORTAL"}],["$","h2",null,{"children":"From the idea to the actual workflow."}],["$","p",null,{"children":"Product screens, documented tools and a practical way to connect them."}]]}],[["$","section","video",{"className":"product-workshop","aria-labelledby":"workshop-video","children":[["$","div",null,{"className":"workshop-label mono","children":[["$","span",null,{"className":"acid","children":["WORKBENCH / ","VIDEO"]}],["$","span",null,{"children":["DOCUMENTED · ","2026-09-09"]}]]}],["$","h3",null,{"id":"workshop-video","children":"Prepare the actual video slot, not just the caption"}],["$","p",null,{"children":"TokPortal’s editor distinguishes Video, Carousel and Story, and asks for a target publishing period. The API follows the same operational idea: the content needs a valid format, accessible media and a usable window."}],["$","figure",null,{"className":"product-capture","children":[["$","a",null,{"href":"/images/tokportal/tokportal-video-editor.png","target":"_blank","rel":"noopener noreferrer","aria-label":"Enlarge: Two real TokPortal editor views showing media format, caption and target publishing period.","children":["$","img",null,{"src":"/images/tokportal/tokportal-video-editor.png","alt":"Two real TokPortal editor views showing media format, caption and target publishing period.","width":650,"height":565,"loading":"lazy"}]}],["$","figcaption",null,{"children":["Two cropped views of the real video editor, captured 8 September 2026. Historical dates shown; use a valid future window for a new task."," ",["$","a",null,{"href":"https://app.tokportal.com/dashboard","target":"_blank","rel":"noopener noreferrer","children":"Product ↗"}]]}]]}],["$","div",null,{"className":"endpoint","children":[["$","span",null,{"className":"mono","children":"REST EQUIVALENT"}],["$","code",null,{"children":"PUT /api/ext/bundles/{id}/videos/{position}"}]]}],["$","span",null,{"className":"mono muted","children":"ANNOTATED EXAMPLE"}],["$","$L26",null,{"lang":"en","text":"{\n  \"tool\": \"tokportal_configure_bundle_video\",\n  \"arguments\": {\n    \"id\": \"<real-bundle-uuid>\",\n    \"position\": 1,\n    \"body\": {\n      \"video_type\": \"video\",\n      \"video_url\": \"<public_url returned by your video upload>\",\n      \"description\": \"A practical example of organising freelance subscriptions.\",\n      \"target_publish_date\": \"<valid future date: YYYY-MM-DD>\"\n    }\n  }\n}","label":"MCP REQUEST"}],["$","p",null,{"children":"Replace the marked values with your actual upload and bundle. This template is intentionally not a runnable campaign. target_publish_date starts a two-day publishing window; it does not request an exact minute."}],["$","ol",null,{"className":"workshop-checks","children":[["$","li","Choose the correct media fields",{"children":[["$","span",null,{"className":"mono acid","children":["0",1]}],["$","div",null,{"children":[["$","strong",null,{"children":"Choose the correct media fields"}],["$","p",null,{"children":"A video needs video_url and description. A TikTok carousel instead needs carousel_images and tiktok_sound_url."}]]}]]}],["$","li","Use a valid window",{"children":[["$","span",null,{"className":"mono acid","children":["0",2]}],["$","div",null,{"children":[["$","strong",null,{"children":"Use a valid window"}],["$","p",null,{"children":"Allow at least three days while account creation is pending, or one day for delivered/existing accounts. Check the current response and limits."}]]}]]}],["$","li","Inspect readiness",{"children":[["$","span",null,{"className":"mono acid","children":["0",3]}],["$","div",null,{"children":[["$","strong",null,{"children":"Inspect readiness"}],["$","p",null,{"children":"GET /api/ext/bundles/{id}/publish-readiness lists blockers without a debit or mutation. Review ignored_fields and the returned start/end dates."}]]}]]}]]}],["$","div",null,{"className":"workshop-sources mono","children":["READ THE CONTRACT"," ",["$L27"]]}]]}]]]}]
1f:["$","blockquote",null,{"children":["“","An operational preference is not a law of the algorithm.","”"]}]
