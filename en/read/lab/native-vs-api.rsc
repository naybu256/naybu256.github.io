22:["$","section",null,{"id":"sources","children":[["$","h2",null,{"children":"What this does not prove."}],["$","p",null,{"className":"caveat","children":[["$","strong",null,{"children":"The limit. "}],"Attributing a creative or account-age difference to the publishing channel."]}],["$","div",null,{"className":"sources","children":[["$","span",null,{"className":"mono acid","children":"SOURCES & PROVENANCE"}],["$","ul",null,{"children":[["$","li","https://developers.tiktok.com/doc/content-posting-api-get-started/",{"children":[["$","a",null,{"href":"https://developers.tiktok.com/doc/content-posting-api-get-started/","children":["developers.tiktok.com","/doc/content-posting-api-get-started/"]}]," ","· ","consulted September 8, 2026"]}],["$","li","https://developers.tokportal.com/",{"children":[["$","a",null,{"href":"https://developers.tokportal.com/","children":["developers.tokportal.com","/"]}]," ","· ","consulted September 8, 2026"]}]]}],["$","p",null,{"className":"editorial-note","children":["THE ORGANIC CLUB is an editorial project initiated by TokPortal. That relationship is separate from the evidence behind claims. Editorial signatures and image credits are explained in our policy."," ",["$","a",null,{"href":"/en/about/","children":"Our editorial policy →"}]]}]]}]]}]
