14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero","children":["$","img",null,{"src":"/images/editorial/creative-diversity-test.jpg","alt":"Colorful figures and decorative panels in a stained glass cathedral window.","width":1280,"height":676,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:St_Vitus_Cathedral_-_Stained_glass_(retouch).jpg","children":"Pudelek; retouch by Albertus teolog"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/4.0","children":"CC BY-SA 4.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],["$","a",null,{"href":"#analysis","children":["02 / ","The analysis"]}],["$","a",null,{"href":"#deep-dive","children":"03 / The breakdown"}],["$","a",null,{"href":"#case-notes","children":"04 / Real posts"}],false,["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"A creative-diversity test examines meaningful variation rather than counting files. It connects concepts with outcomes and their stability."}]]}],["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Label angles, personas and situations before examining performance. Compare similar-volume groups with documented diversity differences. Keep costs visible: more angles may require more design work. Ask whether the difference improves useful learning, not merely outcome dispersion."}],["$","p","1",{"children":"A blind review can help: hide results and ask several people to classify creative work using the taxonomy. Disagreements expose vague categories. This does not measure marketing impact, but checks whether the definition of diversity can be applied without already knowing winners. Keep ambiguous cases visible and revise the coding guide before using those categories to explain performance or allocate the next production budget."}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"Count distinct hypotheses, not exported files"}],["$","p",null,{"children":"A folder of thirty edits can contain one idea. Different subtitles, crops and backing tracks may help optimise execution, but they do not necessarily test different reasons for someone to care. Label each creative by the audience problem, claim, proof and narrative device before counting diversity. A price objection, a workflow demonstration and a surprising use case are meaningfully different propositions even when they use the same visual template. This distinction prevents a large production queue from masquerading as a broad exploration of demand."}],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"From variants to real exploration"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Problem",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Problem"}],["$","p",null,{"children":"Which audience tension does the post address?"}],false]}]]}],["$","li","Proof",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Proof"}],["$","p",null,{"children":"What makes the claim understandable or credible?"}],false]}]]}],["$","li","Device",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Device"}],["$","p",null,{"children":"How does the story deliver that evidence?"}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],[["$","p","0",{"children":"Choose a manageable set of hypotheses and give each enough execution quality to be a fair attempt. Keep the downstream destination coherent so a successful opening does not lead to an unrelated offer. After publication, review the comments for evidence about interpretation as well as the performance metrics. A low-view post that reveals a serious misunderstanding may improve the next brief. Preserve the labels and failed attempts in the creative library. Otherwise the team repeatedly rediscovers the same idea under new filenames and calls the repetition a learning system."}],"$L19"]]}],false,"$L1a",false,"$L1b","$undefined","$L1c","$L1d","$L1e","$L1f"]}],"$L20"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L21","068",{"a":{"id":"068","author":"jet","slug":"native-features-test","category":"lab","term":"Native features","kind":"protocol","image":"native-features-test","media":"$1:props:children:1:props:next:media","en":{"title":"TikTok Native Features: Test Their Creative Contribution","dek":"A native-feature test separates a feature’s effect from its publishing channel."},"readingMinutes":3},"lang":"en"}],["$","$L21","066",{"a":{"id":"066","author":"jet","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","kind":"protocol","image":"formatted-vs-chaotic","media":"$1:props:children:1:props:previous:media","en":{"title":"TikTok Content Strategy: Recurring Series vs Spontaneous Posts","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."},"readingMinutes":2},"lang":"en"}],["$","$L21","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://naybu256.github.io/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://naybu256.github.io/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
