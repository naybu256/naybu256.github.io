14:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero ","children":["$","img",null,{"src":"/images/editorial/attribution.jpg","alt":"Several railway tracks branch and converge between signals and overhead lines.","width":1280,"height":853,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":[["$","a",null,{"href":"https://commons.wikimedia.org/wiki/File:South_Hills_Junction_tracks_jeh.jpg","children":"Jim.henderson"}]," · ",["$","a",null,{"href":"https://creativecommons.org/licenses/by-sa/4.0","children":"CC BY-SA 4.0"}]," · ","Illustrative photograph. Cropped and resized."]}]]}]
15:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"IN THIS STORY"}],["$","a",null,{"href":"#definition","children":["01 / ","The essential"]}],false,["$","a",null,{"href":"#analysis","children":"03 / The argument"}],["$","a",null,{"href":"#deep-dive","children":"04 / Apply the idea"}],["$","a",null,{"href":"#tokportal-workflow","children":"↳ Inside TokPortal"}],["$","a",null,{"href":"#practice","children":["05 / ","In practice"]}],["$","a",null,{"href":"#sources","children":["06 / ","Sources & limits"]}],["$","a",null,{"href":"/en/read/lab/attribution/article.md","children":"↗ Plain-text edition"}],["$","a",null,{"href":"/en/lexicon/","children":["↗ ","The AGD lexicon"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"THE TAKEAWAY"}],["$","p",null,{"children":"Campaign parameters describe an instrumented origin. They do not alone prove a piece of content caused a purchase decision."}]]}],false,["$","$L18",null,{"a":"$1:props:children:1:props:article","lang":"en"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","$19","0",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["Keep first touch, last link and customer-declared source separate. A personal recommendation may precede a tagged visit. Do not erase that nuance in one number. Unattributed share remains unknown; it is neither failure nor hidden success to claim."]}]]}]]}],["$","$19","1",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["This publication’s TokPortal links carry an editorial source and article identifier. They help recognize some visits, not reconstruct every prior exposure. A reader may return without parameters or on another device. Reporting should state coverage and avoid treating identifiable visits as the entirety of influence. Equally, unattributed outcomes should not be claimed for the publication merely because its content could theoretically have contributed earlier in the journey."]}]]}]]}]]}],["$","section",null,{"id":"deep-dive","className":"article-prose deep-dive","children":[["$","h2",null,{"children":"A source label is an observation, not a biography"}],[["$","$19","0",{"children":[["$","p","0",{"children":["A visit carrying a campaign parameter tells you something useful about that visit. It does not tell you every influence that preceded it. Someone may discover a product in a video, search for it later, return from a bookmark and eventually buy after a support conversation. Conversely, a tagged visit can come from a link shared outside the original channel. Keep event-level evidence separate from a story about the person's entire journey. Mutable profile fields are especially dangerous when they overwrite the source attached to an earlier event."]}]]}]],["$","figure",null,{"className":"editorial-diagram diagram-flow","children":[["$","figcaption",null,{"children":[["$","span",null,{"className":"mono acid","children":"THE IDEA, UNPACKED"}],["$","h3",null,{"children":"Keep the evidence attached to the event"}]]}],["$","ol",null,{"className":"diagram-items","children":[["$","li","Visit",{"children":[["$","span",null,{"className":"diagram-index","children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Visit"}],["$","p",null,{"children":"Record the observed source and time."}],false]}]]}],["$","li","Identity",{"children":[["$","span",null,{"className":"diagram-index","children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Identity"}],["$","p",null,{"children":"Link events only through a justified, permitted method."}],false]}]]}],["$","li","Outcome",{"children":[["$","span",null,{"className":"diagram-index","children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Outcome"}],["$","p",null,{"children":"Distinguish first purchase from returning activity."}],false]}]]}]]}],["$","p",null,{"className":"diagram-caption","children":"Editorial model: a way to reason about the process, not measured platform results."}]]}],["$L1a"]]}],false,"$L1b","$L1c","$undefined","$L1d","$L1e","$L1f","$L20"]}],"$L21"]}]
16:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Other currents."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L22","075",{"a":{"id":"075","author":"jet","slug":"views-to-buyers","category":"lab","term":"Views to buyers","kind":"protocol","image":"views-to-buyers","media":"$1:props:children:1:props:next:media","en":{"title":"From TikTok Views to Sales: Measure the Customer Journey","dek":"Views measure exposure under the platform’s definition."},"readingMinutes":3},"lang":"en"}],["$","$L22","073",{"a":{"id":"073","author":"jet","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","kind":"protocol","image":"cohort-maturity","media":"$1:props:children:1:props:previous:media","en":{"title":"Campaign Cohort Analysis: Compare Equally Mature Results","dek":"Day-seven conversion should cover people given seven full days to convert."},"readingMinutes":3},"lang":"en"}],["$","$L22","001",{"a":{"id":"001","author":"organic-club-editorial","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"distribution-is-the-moat","media":{"kind":"illustration","src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"THE ORGANIC CLUB Studio","provenance":"Original AI-generated editorial illustration created for this publication on September 8, 2026. Not a documentary photograph.","source":"https://theorganiclub.com/images/iceberg.jpg","license":"Original artwork","licenseUrl":"https://theorganiclub.com/en/about/#images"},"en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."},"readingMinutes":5},"lang":"en"}]]}]]}]
