1a:["$","$19","0",{"children":[["$","$19","0",{"children":[["$","p","0",{"children":["Define the acquisition reference before comparing channels. A first positive payment, a trial signup and a returning purchase answer different questions. Preserve timestamps and original source parameters on the relevant events, respect consent requirements, and document missing attribution. Report both attributed outcomes and the unassigned portion so uncertainty stays visible. The goal is a decision-grade account of what can be traced, not a claim to know everything that caused a purchase. Useful attribution makes the next experiment clearer while leaving room for unobserved influences."]}]]}]]}]
1b:["$","section",null,{"id":"tokportal-workflow","className":"product-workshops","children":[["$","div",null,{"className":"case-intro","children":[["$","span",null,{"className":"mono acid","children":"INSIDE TOKPORTAL"}],["$","h2",null,{"children":"From the idea to the actual workflow."}],["$","p",null,{"children":"Product screens, documented tools and a practical way to connect them."}]]}],[["$","section","analytics",{"className":"product-workshop","aria-labelledby":"workshop-analytics","children":[["$","div",null,{"className":"workshop-label mono","children":[["$","span",null,{"className":"acid","children":["WORKBENCH / ","ANALYTICS"]}],["$","span",null,{"children":["DOCUMENTED · ","2026-09-09"]}]]}],["$","h3",null,{"id":"workshop-analytics","children":"Ask for a defined series, then interpret it"}],["$","p",null,{"children":"A common observation window is easier to maintain when the measurement request is explicit. This read-only example asks for daily gained views over a stated period; change the dates to your evaluation window."}],"$undefined",["$","div",null,{"className":"endpoint","children":[["$","span",null,{"className":"mono","children":"REST EQUIVALENT"}],["$","code",null,{"children":"GET /api/ext/analytics/series"}]]}],["$","span",null,{"className":"mono muted","children":"ANNOTATED EXAMPLE"}],["$","$L23",null,{"lang":"en","text":"{\n  \"tool\": \"tokportal_get_analytics_series\",\n  \"arguments\": {\n    \"metric\": \"views\",\n    \"granularity\": \"day\",\n    \"mode\": \"gained\",\n    \"from\": \"2026-09-01\",\n    \"to\": \"2026-09-07\"\n  }\n}","label":"MCP REQUEST"}],["$","p",null,{"children":"No chart of customer results is invented here. Read the returned series and its availability before drawing conclusions. Views describe distribution; first purchases and attribution still need their own event evidence."}],["$","ol",null,{"className":"workshop-checks","children":[["$","li","Read the contract",{"children":[["$","span",null,{"className":"mono acid","children":["0",1]}],["$","div",null,{"children":[["$","strong",null,{"children":"Read the contract"}],["$","p",null,{"children":"GET /api/ext/analytics/contract describes the available metrics and their meaning."}]]}]]}],["$","li","Respect missing data",{"children":[["$","span",null,{"className":"mono acid","children":["0",2]}],["$","div",null,{"children":[["$","strong",null,{"children":"Respect missing data"}],["$","p",null,{"children":"Series and exports depend on plan access. Missing or redacted values mean unavailable, not zero."}]]}]]}],["$","li","Compare like windows",{"children":[["$","span",null,{"className":"mono acid","children":["0",3]}],["$","div",null,{"children":[["$","strong",null,{"children":"Compare like windows"}],["$","p",null,{"children":"GET /api/ext/analytics/export/videos provides a plan-aware CSV for further analysis. Keep mature cohorts separate from recent posts."}]]}]]}]]}],["$","div",null,{"className":"workshop-sources mono","children":["READ THE CONTRACT"," ",[["$","a","https://developers.tokportal.com/analytics/",{"href":"https://developers.tokportal.com/analytics/","target":"_blank","rel":"noopener noreferrer","children":["analytics"," ","↗"]}],["$","a","https://developers.tokportal.com/mcp/",{"href":"https://developers.tokportal.com/mcp/","target":"_blank","rel":"noopener noreferrer","children":["mcp"," ","↗"]}]]]}]]}]]]}]
