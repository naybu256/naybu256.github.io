3:["$","div",null,{"lang":"en","children":[["$","$L12",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI Content for Social Media: How to Avoid Generic Output","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"Account Isolation in AGD: Build Distinct Social Accounts","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Native Posting vs API Posting on TikTok: What Can You Test?","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"TokPortal MCP Tutorial: Preview an AI Workflow with Dry Run","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"AGD for TikTok 101: Accounts, Content and Your First Tests","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"Content Isolation: How to Differentiate a Multi-Account Strategy","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"How AGD Changes the Competition for Organic Reach","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"AGD vs Phone Farms: Strategy, Accounts and Infrastructure","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"How to Build an AGD Strategy with Your Existing Tools","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"AGD Marketing Principles: A Practical Editorial Framework","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"AGD Marketing Mistakes: Volume, Copying and False Promises","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"What Is a Native TikTok Account? Context and Limitations","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"How to Build a Social Media Persona: The Duolingo Example","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"TikTok Hook Examples: Replace Clickbait with a Clear Payoff","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"TikTok Content Series: Build a Repeatable Format","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"AI Personas for Social Media: Character Design and Disclosure","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"Persona-Based AGD: Give Each Account a Distinct Voice","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"TikTok Slideshow Strategy: Story Structure for AGD","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"How to Structure a TikTok Slideshow as a Story","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Educational TikTok Content: Turn a Real Process into a Story","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"Brand Memes on TikTok: What Ryanair’s Persona Can Teach You","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"TikTok Product Discovery: Lessons from the Ocean Spray Video","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"How to Write a TikTok Creative Brief with a Concrete Example","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"How to Build a TikTok Creative Library from Real Examples","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"TikTok Content Fatigue: When to Refresh a Recurring Format","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"Creative Testing Matrix: Lessons from LEGO’s Instagram Reel","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"TikTok Account Warming: Define a Relevant, Testable Routine","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native TikTok Posting: Workflow, Features and Quality Checks","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Native Account Warming: Actions, Records and Limits","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"US TikTok Accounts: Geography, Setup and Audience Limits","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Geo-Posting for TikTok: Location Context vs Audience Targeting","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"How to Reach US TikTok Audiences from Abroad","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"TikTok Content Localization: Go Beyond Translation","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"Social Media Account Brief: Audience, Voice and Publishing Rules","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"Social Publishing Handoffs: What to Give Your Operator","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"TikTok Publishing Schedule: Plan Windows, Not Magic Minutes","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"How to Organize a Multi-Account Social Media Inventory","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Why Does My TikTok Have Zero Views? A Diagnostic Workflow","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"TikTok Shadowban or Low Reach? How to Investigate","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"TikTok Publishing Failures: Separate Upload, Access and Reach","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic Brand Accounts: Native Content and Transparent Identity","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"Reddit Marketing and AGD: Contribute Before You Promote","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Community Marketing: How Brands Join Existing Conversations","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"Social Media Content Rights: A Publishing Checklist","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"AGD Campaign Review: Creative, Distribution and Evidence","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"How to Budget an AGD Experiment: Costs and Learning Goals","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"What Counts as a Viral TikTok? Define the Comparison","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"TikTok Viral Hit Rate: Define Attempts and Measure Outcomes","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"TikTok Analytics: Average vs Median Views Explained","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"Social Media Analytics: How to Read Performance Percentiles","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"Why a Few TikTok Posts Can Dominate Your Reach","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"Multi-Account Analytics: Measure Performance Concentration","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"How to Compare TikTok Campaigns with Matched Cohorts","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"Best Time to Post on TikTok? Test Timing Without the Myths","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"How Often Should You Post on TikTok? Design a Useful Test","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Does TikTok Account Warming Work? An Experiment Protocol","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"Does TikTok Account Age Affect Reach? What to Compare","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"TikTok Slideshows vs Videos: How to Compare the Formats","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"TikTok Content Strategy: Recurring Series vs Spontaneous Posts","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"TikTok Creative Testing: Compare Ideas, Not Just Edits","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"TikTok Native Features: Test Their Creative Contribution","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"How to Measure Your TikTok Zero-View Rate","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Social Media Experiments: Confidence Intervals Explained","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"TikTok Case Studies and Survivorship Bias: What Is Missing?","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"Why TikTok Views Drop After a Viral Post","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Campaign Cohort Analysis: Compare Equally Mature Results","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"TikTok Marketing Attribution: UTMs, Visits and First Purchases","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"From TikTok Views to Sales: Measure the Customer Journey","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Social Media Experiment Template: Write the Plan First","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"When to Stop an AGD Experiment: Budget and Evidence Rules","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"How to Evaluate AGD Claims: Documentation, Examples and Tests","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI for AGD Marketing: From Creative Brief to Publishing Workflow","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"Agentic AGD: What an AI Distribution Agent Should Do","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"TokPortal’s Human API: Briefs, Native Actions and Receipts","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"TokPortal MCP Workflows: Connect AI to Social Operations","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"What Does a TokPortal Dry Run Do? Preview Scope and Limits","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"API Retry Safety: Avoid Duplicate Social Publishing Operations","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"Social Publishing Webhooks: Events, Status and Recovery","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"How to Set a Budget for an AI Marketing Agent","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"AI Marketing Automation: When to Increase Agent Autonomy","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Social Media API Automation: Keep the Editorial Brief Intact","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Content Routing for Multiple Social Accounts","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"How to Organize Social Creative by Idea and Mechanism","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"Social Media Monitoring: Build Useful Operational Alerts","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human Review for AI Content: Approve the Version That Ships","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Marketing Automation Records: Build a Reliable Source of Truth","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"AGD and SEO: Turn Social Ideas into Searchable Articles","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic SEO for AGD: Structure Useful, Distinct Pages","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"Writing AGD Content That Search and AI Can Cite","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"Internal Linking for AGD Content: Connect Concepts Clearly","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Multilingual Content Strategy: When to Expand Your AGD Site","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"AGD Article Schema: Structure Text, Stories and Real Examples","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"AI Agent Audit Logs: Trace Marketing Actions and Decisions","dek":"An agent log connects intent, tool, result and next decision."}},{"id":"101","slug":"delivered-account-slot-approval-checklist","category":"machines","term":"Delivered-account slot approval","en":{"title":"How should you approve one delivered-account video slot after a dry run?","dek":"For an existing delivered account, the useful question is not what dry run is. It is how to turn one simulated slot configuration into a clear human go/no-go decision without leaking preview artifacts into live execution."}},{"id":"102","slug":"problem-first-or-screen-first-app-demo","category":"creative","term":"Problem-first opening","en":{"title":"Should your app demo start with the problem or the screen? Usually, name the problem first.","dek":"If the feature and promise stay fixed, leading with the user’s situation is often the more interpretable AGD test for app discovery content."}}]}],"$L13","$L14"]}]
15:T4c8,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://theorganiclub.com/en/read/lab/power-law/#article","headline":"Why a Few TikTok Posts Can Dominate Your Reach","description":"Concentration measures the share of outcomes produced by a fraction of posts.","inLanguage":"en","datePublished":"2026-09-08T12:00:00Z","dateModified":"2026-09-09T07:41:56.167Z","image":["https://theorganiclub.com/images/editorial/power-law.jpg"],"author":{"@type":"Organization","name":"Jet","url":"https://theorganiclub.com/en/about/#jet","image":"https://theorganiclub.com/images/authors/jet.jpg"},"publisher":{"@type":"Organization","name":"THE ORGANIC CLUB","url":"https://theorganiclub.com"},"mainEntityOfPage":"https://theorganiclub.com/en/read/lab/power-law/","articleSection":"The Lab","wordCount":373,"citation":[]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"THE ORGANIC CLUB","item":"https://theorganiclub.com/en/"},{"@type":"ListItem","position":2,"name":"The Lab","item":"https://theorganiclub.com/en/topics/lab/"},{"@type":"ListItem","position":3,"name":"Why a Few TikTok Posts Can Dominate Your Reach","item":"https://theorganiclub.com/en/read/lab/power-law/"}]}]}1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}],["$","$L16",null,{"article":{"id":"058","slug":"power-law","term":"Distribution concentration","category":"lab","kind":"protocol","image":"power-law","tier":"operating","evidence":"hypothesis","sources":[],"related":["top-ten-accounts","percentiles","distribution-is-the-moat"],"en":{"title":"Why a Few TikTok Posts Can Dominate Your Reach","dek":"Concentration measures the share of outcomes produced by a fraction of posts.","point":"Concentration measures the share of outcomes produced by a fraction of posts. An unequal distribution is not automatically evidence of a power law.","body":["Calculate the share of views from top posts, then inspect the rest. If one post carries nearly everything, total volume is fragile. That can still be viable if cost and repeatability are understood. Describing concentration beats attaching an untested mathematical label.","A ranked contribution chart often makes concentration visible without fitting a theoretical curve. Add counts and the observation window. Actually testing a power law requires a dedicated statistical method and comparison with alternative models. The expression should not decorate an outcome that is merely unequal. Descriptive reporting can still guide allocation well when it clearly shows which posts contribute and how much uncertainty remains about future repetition."],"action":["Measure the share carried by top posts.","Show results with and without the largest hit."],"trap":"Removing an outlier to improve the average’s story may erase an essential part of the phenomenon.","quote":"The hit makes noise. The rest explains the system.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The hit makes noise. The rest explains the system.","text":"Concentration measures the share of outcomes produced by a fraction of posts.","media":"/images/editorial/power-law.jpg"},{"label":"THE CONCEPT","title":"Distribution concentration","text":"Concentration measures the share of outcomes produced by a fraction of posts. An unequal distribution is not automatically evidence of a power law.","media":"/images/editorial/power-law.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Removing an outlier to improve the average’s story may erase an essential part of the phenomenon.","media":"/images/editorial/power-law.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Measure the share carried by top posts.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/power-law.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show results with and without the largest hit.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/power-law.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"Heavy tails are not a licence to spray","paragraphs":["A few posts carrying much of a campaign's reach can be an operational fact without proving a particular mathematical distribution. Calling every uneven chart a power law gives the analysis more authority than it earned. Start with the observable concentration: how much of the total came from the largest posts, how many accounts contributed, and how much work sat behind the attempts? This is enough to ask useful budget questions. You do not need a grand theory of the feed to notice that the median attempt and the portfolio total tell different stories.","The tempting response is to publish more of everything. That works only if extra attempts preserve enough creative quality, account stewardship and learning capacity to be useful. Otherwise volume expands the bill while making the data harder to interpret. Allocate a bounded exploration budget, retain unsuccessful attempts in the record, and examine whether new concepts or repeated versions created the upside. A portfolio can justify experimentation. It does not justify assuming that the next thousand weak posts contain an inevitable winner."],"diagram":{"kind":"compare","title":"Concentration is a starting point","items":[{"label":"Observe","detail":"Measure how much a few posts contribute.","value":0},{"label":"Account","detail":"Include the cost of every attempted concept.","value":0},{"label":"Decide","detail":"Fund bounded exploration with explicit learning questions.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Use the example to discuss an unusual creative outcome. Do not infer a universal distribution from a selection of famous posts.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"jet","media":{"kind":"photograph","src":"/images/editorial/power-law.jpg","width":1280,"height":720,"alt":{"en":"Lightning illuminates a storm cloud above a harbour pier and lighthouse."},"credit":"Maxime Raynal","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 74ed3615cd6743fb4e031d1d1b58a3fd45de2d23.","source":"https://commons.wikimedia.org/wiki/File:Port_and_lighthouse_overnight_storm_with_lightning_in_Port-la-Nouvelle.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},"lang":"en","next":{"id":"059","slug":"top-ten-accounts","term":"Account concentration","category":"lab","kind":"protocol","image":"top-ten-accounts","tier":"operating","evidence":"hypothesis","sources":[],"related":["matched-cohorts","power-law","distribution-is-the-moat"],"en":{"title":"Multi-Account Analytics: Measure Performance Concentration","dek":"Account concentration shows which assets carry the total outcome.","point":"Account concentration shows which assets carry the total outcome. It complements post-level analysis by revealing structural dependence.","body":["Sum eligible outcomes by account over one window and rank contributions. Compare publishing volumes too: one account may dominate because it receives most resources. Ask whether that allocation reflects observed quality or operational habit.","For illustration, an account receiving half the creative work also produces half the views. Its volume dominance does not necessarily mean greater efficiency. Another, less supplied account may produce more outcome per resource. Compare those views while retaining differences in purpose and assigned creative quality. A portfolio decision needs both total contribution and a fair description of what each account was given a chance to do."],"action":["Compare contributions with allocated resources.","Record accounts with insufficient data."],"trap":"Low contribution does not prove an account is useless when its purpose differs.","quote":"The network works. Or one account carries it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The network works. Or one account carries it.","text":"Account concentration shows which assets carry the total outcome.","media":"/images/editorial/top-ten-accounts.jpg"},{"label":"THE CONCEPT","title":"Account concentration","text":"Account concentration shows which assets carry the total outcome. It complements post-level analysis by revealing structural dependence.","media":"/images/editorial/top-ten-accounts.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Low contribution does not prove an account is useless when its purpose differs.","media":"/images/editorial/top-ten-accounts.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Compare contributions with allocated resources.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/top-ten-accounts.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record accounts with insufficient data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/top-ten-accounts.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"The leaderboard can hide a fragile network","paragraphs":["A leaderboard makes concentration look like a management system. The strongest accounts sit at the top, the weak ones disappear below the fold, and the meeting becomes a conversation about scaling the winners. Before doing that, inspect what the ranking actually rewards. Lifetime totals favour older accounts. Recent totals can favour higher posting volume. Revenue rankings can mix returning buyers with newly acquired customers. The same account may be excellent by one definition and ordinary by another. Label the measure, time window and account age before making a resource decision.","Add a dependency question: what happens if the strongest account stops publishing for a week? This is a planning scenario, not a forecast of a platform restriction. Map who produces its material, which audience promise it owns and whether other accounts reach genuinely different people. Copying the top account's surface style across the network may increase similarity without reducing concentration. A healthier response can be to document the winning process, preserve distinct editorial roles and give weaker accounts specific experiments rather than a generic instruction to resemble the leader."],"diagram":{"kind":"flow","title":"Read beyond the top row","items":[{"label":"Rank","detail":"Use a defined metric and comparable window.","value":0},{"label":"Explain","detail":"Separate age, volume and creative contribution.","value":0},{"label":"Stress-test","detail":"Model dependence on the leading account.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"A visible account demonstrates an editorial identity. Its public page does not reveal the economics or resilience of the wider operation.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"jet","media":{"kind":"photograph","src":"/images/editorial/top-ten-accounts.jpg","width":1280,"height":832,"alt":{"en":"The illuminated Price Building rises above surrounding rooftops in Quebec City at night."},"credit":"Wilfredor","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 806daa0796b8e1901acf5837aa1c26d99194be81.","source":"https://commons.wikimedia.org/wiki/File:Price_Building_illuminated_at_night_in_Quebec_City.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},"previous":{"id":"057","slug":"percentiles","term":"Distribution percentiles","category":"lab","kind":"protocol","image":"percentiles","tier":"operating","evidence":"hypothesis","sources":[],"related":["power-law","median-vs-mean","distribution-is-the-moat"],"en":{"title":"Social Media Analytics: How to Read Performance Percentiles","dek":"A percentile locates a value in an ordered distribution.","point":"A percentile locates a value in an ordered distribution. P90 describes its upper region but depends on cohort size and definition.","body":["A percentile across ten posts is less stable than it looks on a dashboard. State the calculation method if tools disagree. Compare equally mature series and keep counts visible. A percentile describes observations; it does not guarantee future performance.","When reading change, show several points in the distribution. A stable median with a stronger upper region tells a different story from broad improvement. The first may suggest more positive extremes, but their cause remains to be understood. These summaries should open the content analysis rather than replace it. Show the same observation window and calculation method so apparent movement is not a reporting artifact."],"action":["Document the calculation convention.","Show each cohort’s size."],"trap":"A high percentile in a small series is not a reliable forecast.","quote":"P90 is not a new word for good.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"P90 is not a new word for good.","text":"A percentile locates a value in an ordered distribution.","media":"/images/editorial/percentiles.jpg"},{"label":"THE CONCEPT","title":"Distribution percentiles","text":"A percentile locates a value in an ordered distribution. P90 describes its upper region but depends on cohort size and definition.","media":"/images/editorial/percentiles.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A high percentile in a small series is not a reliable forecast.","media":"/images/editorial/percentiles.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Document the calculation convention.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/percentiles.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show each cohort’s size.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/percentiles.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"A percentile needs a population","paragraphs":["The phrase top ten percent sounds precise until you ask: of what? Your own posts this month, all posts in a format, or a hand-picked list of successful accounts? A percentile is a position inside a defined population. Change the population and the same post can move without receiving a single additional view. Keep the inclusion rules and observation age beside the chart. For small samples, avoid decorating unstable cut points with impressive decimals. A ranked list of actual posts may communicate more than a polished percentile table.","Use percentiles to discuss the range an operation experiences. The lower end helps expose failures that an average can conceal; the middle describes ordinary output; the upper end shows upside. Do not turn those descriptions into guaranteed future bands. If a new cohort contains different countries, account ages or creative formats, it is not automatically comparable with the previous one. Annotate the change and, where possible, show matched groups. The practical benefit is better questions about the shape of results, not a new way to label every post a winner."],"diagram":{"kind":"flow","title":"Read the percentile label completely","items":[{"label":"Population","detail":"Name every rule for inclusion.","value":0},{"label":"Age","detail":"Measure posts after a comparable elapsed period.","value":0},{"label":"Position","detail":"Describe rank without promising the next result.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"A public hit is usually selected because it is unusual. It is a poor reference population for a percentile calculation.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"jet","media":{"kind":"photograph","src":"/images/editorial/percentiles.jpg","width":1280,"height":853,"alt":{"en":"Layers of mountain ridges fade into blue haze beneath the distant Himalayas."},"credit":"Timothy A. Gonsalves","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 709838554486b27f57f1ad25af603f9799cbbb14.","source":"https://commons.wikimedia.org/wiki/File:Shivaliks_Himalayas_Aerial_Dehaze_Himachal_Feb20_R16_02827.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}}}],"$L17","$L18","$L19","$L1a"]}]
