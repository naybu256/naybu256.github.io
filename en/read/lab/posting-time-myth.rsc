3:["$","div",null,{"lang":"en","children":[["$","$L10",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","en":{"title":"What Is AGD Marketing? Account-Generated Distribution Explained","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","en":{"title":"AI Content for Social Media: How to Avoid Generic Output","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","en":{"title":"Account Isolation in AGD: Build Distinct Social Accounts","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","en":{"title":"Native Posting vs API Posting on TikTok: What Can You Test?","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","en":{"title":"TokPortal MCP Tutorial: Preview an AI Workflow with Dry Run","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","en":{"title":"AGD for TikTok 101: Accounts, Content and Your First Tests","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","en":{"title":"Content Isolation: How to Differentiate a Multi-Account Strategy","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","en":{"title":"Social Media Content Saturation: What It Means for AGD","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","en":{"title":"How AGD Changes the Competition for Organic Reach","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","en":{"title":"Organic Social Media for Apps: A StudyFetch TikTok Breakdown","dek":"A creator’s StudyFetch video moves from one awkward study problem to the actual app. Here is the structure an AGD team can use in its own product demos."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","en":{"title":"AGD vs Phone Farms: Strategy, Accounts and Infrastructure","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","en":{"title":"How to Build an AGD Strategy with Your Existing Tools","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","en":{"title":"AGD Marketing Principles: A Practical Editorial Framework","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","en":{"title":"AGD Marketing Mistakes: Volume, Copying and False Promises","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","en":{"title":"What Is a Native TikTok Account? Context and Limitations","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","en":{"title":"How to Build a Social Media Persona: The Duolingo Example","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","en":{"title":"TikTok Hook Examples: Replace Clickbait with a Clear Payoff","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","en":{"title":"Faceless TikTok Marketing: A Finch App Video Breakdown","dek":"Finch turns a seasonal challenge into a sequence of actions and goal cards. A practical look at faceless content that keeps the product visible."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","en":{"title":"TikTok Content Series: Build a Repeatable Format","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","en":{"title":"Duolingo’s TikTok Strategy: Character, Chaos and Continuity","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","en":{"title":"AI Personas for Social Media: Character Design and Disclosure","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","en":{"title":"Persona-Based AGD: Give Each Account a Distinct Voice","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","en":{"title":"TikTok Slideshow Strategy: Story Structure for AGD","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","en":{"title":"How to Structure a TikTok Slideshow as a Story","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","en":{"title":"Educational TikTok Content: Turn a Real Process into a Story","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","en":{"title":"Brand Memes on TikTok: What Ryanair’s Persona Can Teach You","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","en":{"title":"TikTok Product Discovery: Lessons from the Ocean Spray Video","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","en":{"title":"Brainrot Marketing: When Internet Culture Helps a Brand","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","en":{"title":"How to Write a TikTok Creative Brief with a Concrete Example","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","en":{"title":"TikTok Hooks and Payoffs: A Zach King Video Breakdown","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","en":{"title":"How to Build a TikTok Creative Library from Real Examples","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","en":{"title":"TikTok Content Fatigue: When to Refresh a Recurring Format","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","en":{"title":"Creative Testing Matrix: Lessons from LEGO’s Instagram Reel","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","en":{"title":"TikTok Account Warming: Define a Relevant, Testable Routine","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","en":{"title":"Native TikTok Posting: Workflow, Features and Quality Checks","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","en":{"title":"Native Account Warming: Actions, Records and Limits","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","en":{"title":"US TikTok Accounts: Geography, Setup and Audience Limits","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","en":{"title":"Geo-Posting for TikTok: Location Context vs Audience Targeting","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","en":{"title":"How to Reach US TikTok Audiences from Abroad","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","en":{"title":"TikTok Content Localization: Go Beyond Translation","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","en":{"title":"Social Media Account Brief: Audience, Voice and Publishing Rules","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","en":{"title":"Social Publishing Handoffs: What to Give Your Operator","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","en":{"title":"TikTok Publishing Schedule: Plan Windows, Not Magic Minutes","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","en":{"title":"How to Organize a Multi-Account Social Media Inventory","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","en":{"title":"Why Does My TikTok Have Zero Views? A Diagnostic Workflow","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","en":{"title":"TikTok Shadowban or Low Reach? How to Investigate","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","en":{"title":"TikTok Publishing Failures: Separate Upload, Access and Reach","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","en":{"title":"Organic Brand Accounts: Native Content and Transparent Identity","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","en":{"title":"Reddit Marketing and AGD: Contribute Before You Promote","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","en":{"title":"Community Marketing: How Brands Join Existing Conversations","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","en":{"title":"Social Media Content Rights: A Publishing Checklist","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","en":{"title":"AGD Campaign Review: Creative, Distribution and Evidence","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","en":{"title":"How to Budget an AGD Experiment: Costs and Learning Goals","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","en":{"title":"What Counts as a Viral TikTok? Define the Comparison","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","en":{"title":"TikTok Viral Hit Rate: Define Attempts and Measure Outcomes","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","en":{"title":"TikTok Analytics: Average vs Median Views Explained","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","en":{"title":"Social Media Analytics: How to Read Performance Percentiles","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","en":{"title":"Why a Few TikTok Posts Can Dominate Your Reach","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","en":{"title":"Multi-Account Analytics: Measure Performance Concentration","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","en":{"title":"How to Compare TikTok Campaigns with Matched Cohorts","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","en":{"title":"Best Time to Post on TikTok? Test Timing Without the Myths","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","en":{"title":"How Often Should You Post on TikTok? Design a Useful Test","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","en":{"title":"Does TikTok Account Warming Work? An Experiment Protocol","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","en":{"title":"Does TikTok Account Age Affect Reach? What to Compare","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","en":{"title":"TikTok Slideshows vs Videos: How to Compare the Formats","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","en":{"title":"TikTok Content Strategy: Recurring Series vs Spontaneous Posts","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","en":{"title":"TikTok Creative Testing: Compare Ideas, Not Just Edits","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","en":{"title":"TikTok Native Features: Test Their Creative Contribution","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","en":{"title":"How to Measure Your TikTok Zero-View Rate","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","en":{"title":"Social Media Experiments: Confidence Intervals Explained","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","en":{"title":"TikTok Case Studies and Survivorship Bias: What Is Missing?","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","en":{"title":"Why TikTok Views Drop After a Viral Post","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","en":{"title":"Campaign Cohort Analysis: Compare Equally Mature Results","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","en":{"title":"TikTok Marketing Attribution: UTMs, Visits and First Purchases","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","en":{"title":"From TikTok Views to Sales: Measure the Customer Journey","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","en":{"title":"Social Media Experiment Template: Write the Plan First","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","en":{"title":"When to Stop an AGD Experiment: Budget and Evidence Rules","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","en":{"title":"How to Evaluate AGD Claims: Documentation, Examples and Tests","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","en":{"title":"AI for AGD Marketing: From Creative Brief to Publishing Workflow","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","en":{"title":"Agentic AGD: What an AI Distribution Agent Should Do","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","en":{"title":"TokPortal’s Human API: Briefs, Native Actions and Receipts","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","en":{"title":"TokPortal MCP Workflows: Connect AI to Social Operations","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","en":{"title":"What Does a TokPortal Dry Run Do? Preview Scope and Limits","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","en":{"title":"API Retry Safety: Avoid Duplicate Social Publishing Operations","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","en":{"title":"Social Publishing Webhooks: Events, Status and Recovery","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","en":{"title":"How to Set a Budget for an AI Marketing Agent","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","en":{"title":"AI Marketing Automation: When to Increase Agent Autonomy","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","en":{"title":"Social Media API Automation: Keep the Editorial Brief Intact","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","en":{"title":"Content Routing for Multiple Social Accounts","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","en":{"title":"How to Organize Social Creative by Idea and Mechanism","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","en":{"title":"Social Media Monitoring: Build Useful Operational Alerts","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","en":{"title":"Human Review for AI Content: Approve the Version That Ships","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","en":{"title":"Marketing Automation Records: Build a Reliable Source of Truth","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","en":{"title":"AGD and SEO: Turn Social Ideas into Searchable Articles","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","en":{"title":"Programmatic SEO for AGD: Structure Useful, Distinct Pages","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","en":{"title":"Writing AGD Content That Search and AI Can Cite","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","en":{"title":"Internal Linking for AGD Content: Connect Concepts Clearly","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","en":{"title":"Multilingual Content Strategy: When to Expand Your AGD Site","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","en":{"title":"AGD Article Schema: Structure Text, Stories and Real Examples","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","en":{"title":"AI Agent Audit Logs: Trace Marketing Actions and Decisions","dek":"An agent log connects intent, tool, result and next decision."}},{"id":"101","slug":"delivered-account-slot-approval-checklist","category":"machines","term":"Delivered-account slot approval","en":{"title":"How should you approve one delivered-account video slot after a dry run?","dek":"For an existing delivered account, the useful question is not what dry run is. It is how to turn one simulated slot configuration into a clear human go/no-go decision without leaking preview artifacts into live execution."}},{"id":"102","slug":"problem-first-or-screen-first-app-demo","category":"creative","term":"Problem-first opening","en":{"title":"Should your app demo start with the problem or the screen? Usually, name the problem first.","dek":"If the feature and promise stay fixed, leading with the user’s situation is often the more interpretable AGD test for app discovery content."}},{"id":"103","slug":"tokportal-video-reschedule-patch-or-put","category":"machines","term":"Endpoint choice for slot edits","en":{"title":"TokPortal video reschedule: use PATCH for partial edits, PUT for replacement","dek":"If a TokPortal video slot already contains the right media, the safer default for caption or date changes is PATCH. The docs make PUT a full replacement, which means omitted fields are cleared rather than preserved."}},{"id":"104","slug":"result-glimpse-after-problem-app-demo","category":"creative","term":"proof object","en":{"title":"After the problem hook, should an app demo show the result glimpse early? Usually, yes.","dek":"This is a narrower question than problem-first versus screen-first: once you have named the viewer’s job, an early glimpse of the finished output usually makes a search-intent demo easier to evaluate."}}]}],"$L11","$L12"]}]
13:T4eb,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://theorganiclub.com/en/read/lab/posting-time-myth/#article","headline":"Best Time to Post on TikTok? Test Timing Without the Myths","description":"Posting-time effects may depend on audience and context.","inLanguage":"en","datePublished":"2026-09-08T12:00:00Z","dateModified":"2026-09-09T07:41:56.167Z","image":["https://theorganiclub.com/images/editorial/posting-time-myth.jpg"],"author":{"@type":"Organization","name":"Jet","url":"https://theorganiclub.com/en/about/#jet","image":"https://theorganiclub.com/images/authors/jet.jpg"},"publisher":{"@type":"Organization","name":"THE ORGANIC CLUB","url":"https://theorganiclub.com"},"mainEntityOfPage":"https://theorganiclub.com/en/read/lab/posting-time-myth/","articleSection":"The Lab","wordCount":537,"citation":[]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"THE ORGANIC CLUB","item":"https://theorganiclub.com/en/"},{"@type":"ListItem","position":2,"name":"The Lab","item":"https://theorganiclub.com/en/topics/lab/"},{"@type":"ListItem","position":3,"name":"Best Time to Post on TikTok? Test Timing Without the Myths","item":"https://theorganiclub.com/en/read/lab/posting-time-myth/"}]}]}1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$13"}}],["$","$L14",null,{"article":{"id":"061","slug":"posting-time-myth","term":"Posting-time myth","category":"lab","kind":"protocol","image":"posting-time-myth","tier":"operating","evidence":"hypothesis","sources":[],"related":["posting-frequency","matched-cohorts","distribution-is-the-moat"],"en":{"title":"Best Time to Post on TikTok? Test Timing Without the Myths","dek":"Posting-time effects may depend on audience and context.","point":"Posting-time effects may depend on audience and context. A universally optimal time is not demonstrated in this protocol.","body":["Allocate comparable content across predefined windows without reserving your strongest topics for a favorite slot. Measure at equal post ages. Separate weekday and local time if the sample supports that detail. Keep the verdict unknown until the test is run and analyzed.","Plan what happens if no clear difference appears. The team might choose the easiest window to operate and spend saved effort on creative work. That would still be useful information. An experiment does not need to uncover a spectacular trick to improve operations. Recording this decision beforehand prevents a null or uncertain outcome from being hidden simply because it does not support an exciting optimization headline."],"action":["Preregister time windows.","Distribute concepts across them."],"trap":"A screenshot of success at one time cannot identify the best posting time.","quote":"7:42 p.m. is not a strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"7:42 p.m. is not a strategy.","text":"Posting-time effects may depend on audience and context.","media":"/images/editorial/posting-time-myth.jpg"},{"label":"THE CONCEPT","title":"Posting-time myth","text":"Posting-time effects may depend on audience and context. A universally optimal time is not demonstrated in this protocol.","media":"/images/editorial/posting-time-myth.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A screenshot of success at one time cannot identify the best posting time.","media":"/images/editorial/posting-time-myth.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Preregister time windows.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-time-myth.jpg"},{"label":"PUT IT TO WORK / 2","title":"Distribute concepts across them.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-time-myth.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"The clock is often taking credit for the creative","paragraphs":["Picture an illustrative workflow: the team schedules routine explainers in the morning and saves its strongest demonstrations for the evening. Evening posts then receive more views. The dashboard has found an association, but the scheduling habit offers a competing explanation. Better material and a different time arrived together. Moving every explainer to the evening would not necessarily reproduce the demonstrations' response. Before declaring a magic hour, inspect who chose each slot, which formats were assigned to it and whether posts were measured after the same elapsed time.","A useful test starts with a narrower decision, such as whether two feasible windows differ for one account and one recurring format. Assign comparable planned posts across those windows before publishing, keep the observation period fixed, and record exceptions rather than quietly replacing them. Repeat across enough independent occasions to avoid building a schedule around one lucky day. If the audience spans time zones, document whose clock you mean. The result can inform this operation under these conditions; it is not a universal calendar of when the internet is receptive."],"diagram":{"kind":"compare","title":"Three explanations for an evening spike","items":[{"label":"Timing","detail":"The audience may be more available then.","value":0},{"label":"Selection","detail":"The team may reserve stronger work for that slot.","value":0},{"label":"Maturity","detail":"Older posts may have had more time to accumulate views.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"Compare the example's opening and payoff with your own material before assigning its outcome to the time displayed beside it.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"jet","media":{"kind":"photograph","src":"/images/editorial/posting-time-myth.jpg","width":1280,"height":853,"alt":{"en":"A close view of the ornate blue and gold Prague Astronomical Clock."},"credit":"Jorge Royan","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 39d974a96d456e41bea4f010599f4a383ce7d3cc.","source":"https://commons.wikimedia.org/wiki/File:The_Prague_Astronomical_Clock_in_Old_Town_-_8559.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},"lang":"en","next":{"id":"062","slug":"posting-frequency","term":"Posting frequency","category":"lab","kind":"protocol","image":"posting-frequency","tier":"operating","evidence":"hypothesis","sources":[],"related":["warming-study","posting-time-myth","distribution-is-the-moat"],"en":{"title":"How Often Should You Post on TikTok? Design a Useful Test","dek":"A frequency test must separate total volume, per-post performance and production load.","point":"A frequency test must separate total volume, per-post performance and production load. Higher totals can coexist with weaker individual posts.","body":["Define two realistic cadences with comparable creative quality. Observe coordination costs and undelivered content. Do not conclude from average views alone: the network may seek more qualified visits at a manageable cost. No test result is supplied here.","A favorable total may also increase team fatigue or correction work. Record those effects in the review instead of treating them as outside the experiment. A suitable cadence depends on the whole system. Sustainable output with readable briefs may be preferable to a production spike that cannot survive the following week. This is an operating tradeoff to evaluate, not an assumption that lower frequency always performs better."],"action":["Set cadence, duration and primary metric.","Track total cost and per-post outcomes."],"trap":"Changing cadence and quality together prevents isolating frequency effects.","quote":"Posting more: more chances or more noise?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Posting more: more chances or more noise?","text":"A frequency test must separate total volume, per-post performance and production load.","media":"/images/editorial/posting-frequency.jpg"},{"label":"THE CONCEPT","title":"Posting frequency","text":"A frequency test must separate total volume, per-post performance and production load. Higher totals can coexist with weaker individual posts.","media":"/images/editorial/posting-frequency.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Changing cadence and quality together prevents isolating frequency effects.","media":"/images/editorial/posting-frequency.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Set cadence, duration and primary metric.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-frequency.jpg"},{"label":"PUT IT TO WORK / 2","title":"Track total cost and per-post outcomes.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/posting-frequency.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"Frequency changes the production system too","paragraphs":["Increasing output changes more than the number of chances to reach someone. It can shorten research, reduce review, repeat ideas and make the account's promise harder to recognise. A frequency test that ignores those changes may attribute a creative quality problem to audience fatigue, or mistake extra total reach for a better process. Decide whether the question concerns reach per post, total useful reach, buyer response, or production efficiency. These outcomes can move in opposite directions without any contradiction. The team needs to know which trade-off it is willing to accept.","Keep a record of production time and distinct concepts as well as published units. Three edits of one idea are not three independent discoveries about the audience. If a higher cadence works only while a person absorbs unpaid overtime, the apparent efficiency is incomplete. Use a bounded trial with a review date, compare equally mature posts, and watch whether comments show confusion or repetition. A sustainable schedule leaves enough capacity to learn from responses. Publishing faster than the team can understand its own output is an expensive form of scrolling."],"diagram":{"kind":"flow","title":"What a cadence change really touches","items":[{"label":"Capacity","detail":"Research, editing, review and response time.","value":0},{"label":"Output","detail":"Posts, distinct concepts and useful audience contact.","value":0},{"label":"Cost","detail":"Hours and spend required to sustain the routine.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"The public post illustrates one execution. Its account's visible posting calendar does not reveal the labour behind the cadence.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"jet","media":{"kind":"photograph","src":"/images/editorial/posting-frequency.jpg","width":1280,"height":853,"alt":{"en":"Illuminated buttons and rows of faders on a sound mixing console."},"credit":"Lchader","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: f656480410fd8f0e9890bb89a24528a9f4148722.","source":"https://commons.wikimedia.org/wiki/File:Audio_mixer_close_up.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"previous":{"id":"060","slug":"matched-cohorts","term":"Matched cohorts","category":"lab","kind":"protocol","image":"matched-cohorts","tier":"operating","evidence":"hypothesis","sources":[],"related":["posting-time-myth","top-ten-accounts","distribution-is-the-moat"],"en":{"title":"How to Compare TikTok Campaigns with Matched Cohorts","dek":"A matched cohort aligns observations on known characteristics.","point":"A matched cohort aligns observations on known characteristics. It reduces some visible differences without automatically eliminating all confounding.","body":["For publishing-method comparisons, start with format, market, account age and measurement window. Retain unmatched cases separately rather than forcing implausible pairs. Unobserved variables remain a limitation. A matched comparison must explain group credibility, not merely display a gap.","Record excluded cases and their characteristics. If only the easiest accounts to compare remain, conclusions may not apply to the full network. A reproducible method lets another reader understand the population actually covered. Transparency about limits is more useful than presenting a selected sample as universal. The comparison can remain valuable, provided the claim stays inside the boundaries of the observations that support it."],"action":["Choose matching variables before analysis.","Publish exclusions and coverage."],"trap":"Matching is not randomization and does not establish causality by itself.","quote":"Compare what is actually comparable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Compare what is actually comparable.","text":"A matched cohort aligns observations on known characteristics.","media":"/images/editorial/matched-cohorts.jpg"},{"label":"THE CONCEPT","title":"Matched cohorts","text":"A matched cohort aligns observations on known characteristics. It reduces some visible differences without automatically eliminating all confounding.","media":"/images/editorial/matched-cohorts.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Matching is not randomization and does not establish causality by itself.","media":"/images/editorial/matched-cohorts.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose matching variables before analysis.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/matched-cohorts.jpg"},{"label":"PUT IT TO WORK / 2","title":"Publish exclusions and coverage.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/matched-cohorts.jpg"}]}]},"workshops":[],"schemaVersion":2,"deepDive":{"heading":"Match the things that can explain the result","paragraphs":["Two groups are not comparable merely because they contain the same number of posts. If one group uses experienced accounts and polished demonstrations while the other uses new accounts and unfinished jokes, a difference in views cannot cleanly answer a question about posting method. Write down the factors likely to affect the outcome before looking at results. Account age, format, topic, country, publication period and observation age are candidates, not a universal checklist. Choose the factors that matter to the specific decision and preserve enough data to inspect them.","Matching reduces visible imbalance; it does not eliminate hidden differences or replace random assignment. Be explicit about which posts could not be matched and why. Throwing away inconvenient cases can make a comparison look tidy while narrowing the conclusion to a very selective group. Report the remaining sample and the practical size of the difference, not only whether the groups moved in different directions. If the design cannot distinguish the explanations, call it an observational comparison and use it to plan a cleaner next test."],"diagram":{"kind":"compare","title":"Similar enough to answer which question?","items":[{"label":"Creative","detail":"Compare like formats and audience problems.","value":0},{"label":"Account","detail":"Record history and context before treatment.","value":0},{"label":"Timing","detail":"Use aligned publication and observation windows.","value":0}],"caption":"Editorial model: a way to reason about the process, not measured platform results."},"caseLens":"A public example is a creative reference, not a matched control for an account whose history you cannot observe.","caseIds":[]},"examples":[],"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-09T07:41:56.167Z","author":"jet","media":{"kind":"photograph","src":"/images/editorial/matched-cohorts.jpg","width":1280,"height":869,"alt":{"en":"A regular grid of windows covers the facade of the Conjunto Nacional building in São Paulo."},"credit":"Wilfredor","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 31c63c97787fe7ffbaeaa9334ac163366f311fbc.","source":"https://commons.wikimedia.org/wiki/File:Facade_of_the_Conjunto_Nacional_cropped_version.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}}}],"$L15","$L16","$L17","$L18"]}]
