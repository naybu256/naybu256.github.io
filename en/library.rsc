3:["$","div",null,{"lang":"en","children":[["$","$Lf",null,{"lang":"en","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","fr":{"title":"Le contenu est gratuit. La distribution ne l’est pas.","dek":"Tout le monde peut produire. Presque personne ne sait distribuer. Bienvenue de l’autre côté de l’iceberg."},"en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","fr":{"title":"L’IA n’est pas le problème. Le même contenu, si.","dek":"Des visages parfaits, des scripts interchangeables. La créativité ne se mesure pas en exports par minute."},"en":{"title":"AI isn’t the problem. Sameness is.","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","fr":{"title":"50 comptes. Une seule idée. Zéro stratégie.","dek":"Account Isolation : différencier les voix avant de multiplier les profils."},"en":{"title":"50 accounts. One idea. Zero strategy.","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","fr":{"title":"Le natif gagne-t-il vraiment ? Montrez les données.","dek":"L’API tue la portée ? Voici le protocole qu’il faudrait avant de l’affirmer."},"en":{"title":"Does native really win? Show the data.","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","fr":{"title":"Ton agent sait publier. Apprends-lui à attendre.","dek":"Un vrai workflow MCP commence par une simulation lisible, pas par une dépense surprise."},"en":{"title":"Your agent can publish. Teach it to wait.","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","fr":{"title":"Un compte de marque ne peut pas tout porter.","dek":"Une Multi-Account Strategy distribue les expériences d’une marque entre plusieurs comptes différenciés."},"en":{"title":"One brand account cannot carry everything.","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","fr":{"title":"Changer les sous-titres ne crée pas une idée.","dek":"Content Isolation maintient une différenciation créative substantielle entre comptes : récit, angle, format ou objectif."},"en":{"title":"New subtitles do not make a new idea.","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","fr":{"title":"Le feed n’a pas gagné des heures dans la journée.","dek":"Content Saturation décrit un excès d’offre de contenus par rapport à l’attention disponible."},"en":{"title":"The feed did not add hours to the day.","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","fr":{"title":"Bienvenue dans la course aux feeds armés.","dek":"Feed Escalation est notre expression éditoriale pour l’intensification des formats, des volumes et de l’optimisation dans les feeds."},"en":{"title":"Welcome to the feed arms race.","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","fr":{"title":"Ton SaaS affronte aussi les vidéos de chats.","dek":"Attention War désigne, dans notre vocabulaire culturel, la concurrence pour une attention limitée entre contenus, personnes et plateformes."},"en":{"title":"Your SaaS competes with cat videos too.","dek":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","fr":{"title":"Une rangée de téléphones n’est pas une stratégie.","dek":"Phone Farming décrit une infrastructure d’exploitation de comptes sur des environnements mobiles."},"en":{"title":"A row of phones is not a strategy.","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","fr":{"title":"L’AGD doit survivre au nom de son fournisseur.","dek":"L’AGD est un cadre de stratégie."},"en":{"title":"AGD must outlive the name of its vendor.","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","fr":{"title":"Le petit manifeste des comptes qui ont une raison d’être.","dek":"Les principes AGD articulent différenciation des comptes, diversité créative, exécution contextualisée et apprentissage mesurable."},"en":{"title":"A small manifesto for accounts with a reason to exist.","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","fr":{"title":"Ce qu’on refuse de vendre comme du growth.","dek":"Les anti-principes AGD ciblent les clones, le volume sans diversité, les certitudes sans données et les moyennes sans contexte."},"en":{"title":"What we refuse to sell as growth.","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","fr":{"title":"Natif : un environnement, pas un talisman.","dek":"Dans le lexique AGD, un Native Account est créé et entretenu dans l’environnement réel de l’application grand public."},"en":{"title":"Native is an environment, not a talisman.","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","fr":{"title":"Un persona, ce n’est pas une photo et un prénom.","dek":"Un Account Persona est l’identité récurrente qui donne un point de vue au compte : qui parle, à qui, et pourquoi revenir.."},"en":{"title":"A persona is not a photo and a name.","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","fr":{"title":"« Stop scrolling » : tout le monde hurle la même chose.","dek":"Hook Slop désigne des accroches intenses mais interchangeables, détachées de la valeur réelle du contenu."},"en":{"title":"“Stop scrolling”: everybody is shouting the same thing.","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","fr":{"title":"Sans visage. Pas sans voix.","dek":"Un Faceless Account produit sans dépendre du visage visible de son opérateur."},"en":{"title":"Faceless. Not voiceless.","dek":"A Faceless Account creates content without relying on its operator’s visible face."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","fr":{"title":"Un format récurrent vaut mieux qu’un template vide.","dek":"Un Formatted Account repose sur une structure créative répétable que le public peut reconnaître."},"en":{"title":"A recurring format beats an empty template.","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","fr":{"title":"Le compte chaotique a quand même une ligne.","dek":"Un Chaotic Account accepte plusieurs formats plutôt qu’un gabarit rigide."},"en":{"title":"A chaotic account still has a point of view.","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","fr":{"title":"Le personnage synthétique doit avoir quelque chose à dire.","dek":"Une AI Persona utilise largement l’IA pour son apparence, sa voix ou sa production."},"en":{"title":"A synthetic character needs something to say.","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","fr":{"title":"Même produit. Trois narrateurs. Trois bonnes raisons.","dek":"Persona AGD organise le réseau autour de personnages éditoriaux distincts plutôt qu’autour de comptes de marque génériques.."},"en":{"title":"One product. Three narrators. Three reasons.","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","fr":{"title":"Le carrousel est une histoire, pas un PDF découpé.","dek":"Slideshow AGD utilise des comptes qui publient des carrousels ou diaporamas natifs."},"en":{"title":"A slideshow is a story, not a sliced PDF.","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","fr":{"title":"Une petite tension vaut quinze slides de conseils.","dek":"Le Story Slideshow organise une séquence autour d’une situation et de sa résolution."},"en":{"title":"A little tension beats fifteen advice slides.","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","fr":{"title":"Apprendre quelque chose avant la dernière slide.","dek":"Un carrousel pédagogique transmet une connaissance applicable pendant la lecture."},"en":{"title":"Teach something before the final slide.","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","fr":{"title":"La blague doit marcher sans le logo.","dek":"Un Meme Slideshow construit sa séquence autour d’une observation culturelle ou d’une chute."},"en":{"title":"The joke should work without the logo.","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","fr":{"title":"Le produit entre en scène quand il sert à quelque chose.","dek":"Un contenu de découverte produit présente un outil à l’intérieur d’un usage intelligible."},"en":{"title":"The product enters when it becomes useful.","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","fr":{"title":"Le marketing a attrapé le brainrot. Et après ?","dek":"Brainrotization est un mot de notre registre culturel pour les formats rapides, absurdes et compressés des feeds."},"en":{"title":"Marketing caught brainrot. What next?","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","fr":{"title":"Un bon brief commence par ce qu’on veut apprendre.","dek":"Un brief créatif AGD relie public, promesse, format et hypothèse."},"en":{"title":"A good brief starts with what we want to learn.","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","fr":{"title":"La promesse du hook doit être remboursée.","dek":"Le payoff est la réponse narrative ou pratique à la promesse initiale."},"en":{"title":"The hook’s promise must be paid back.","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","fr":{"title":"Votre bibliothèque créative n’est pas un dossier final_final.","dek":"Une bibliothèque créative organise les concepts, versions, droits et résultats."},"en":{"title":"Your creative library is not a final_final folder.","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","fr":{"title":"Le format marche. Jusqu’au jour où il se répète.","dek":"La fatigue de format est une hypothèse sur une réponse qui s’affaiblit à force de répétition."},"en":{"title":"The format works. Until it just repeats.","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","fr":{"title":"La matrice qui empêche cinquante copies de naître.","dek":"Une matrice créative croise des dimensions de variation : public, problème, angle, format."},"en":{"title":"The matrix that stops fifty copies from being born.","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","fr":{"title":"Réchauffer un compte sans invoquer la magie.","dek":"Niche Warming consiste à explorer des contenus de niche dans l’application, avec des recherches, des vues et des interactions authentiques."},"en":{"title":"Warm an account without invoking magic.","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","fr":{"title":"Publier en natif : le geste compte, le brief aussi.","dek":"Native Posting désigne une publication effectuée dans l’interface grand public de la plateforme."},"en":{"title":"Native posting: the action matters, so does the brief.","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","fr":{"title":"Le warming n’est pas une danse de robots.","dek":"Native Warming se déroule dans l’application réelle avec des interactions ordinaires et authentiques."},"en":{"title":"Warming is not a robot dance.","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","fr":{"title":"Un compte américain ne garantit pas une audience américaine.","dek":"Un Geo-Targeted Account est établi et opéré dans le marché visé."},"en":{"title":"A US account does not guarantee a US audience.","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","fr":{"title":"La localisation commence avant le bouton publier.","dek":"Geo-Posting consiste à publier depuis un compte opéré dans le marché cible."},"en":{"title":"Localization starts before the publish button.","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","fr":{"title":"Lancer aux US depuis ailleurs : commencer par la scène.","dek":"Un lancement international exige une offre compréhensible et une situation d’usage locale."},"en":{"title":"Launching in the US from abroad: start with the scene.","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","fr":{"title":"Traduire les mots. Puis refaire la situation.","dek":"La localisation adapte le sens, les références et les usages."},"en":{"title":"Translate the words. Then rebuild the situation.","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","fr":{"title":"Le brief de compte tient sur une page.","dek":"Un brief de compte fixe sa promesse, son audience, sa voix et ses frontières."},"en":{"title":"The account brief fits on one page.","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","fr":{"title":"Le handoff qui évite le « je pensais que ».","dek":"Un handoff transmet une tâche exécutable avec ses fichiers, contraintes et conditions de réussite."},"en":{"title":"The handoff that prevents “I thought you meant”.","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","fr":{"title":"Une fenêtre de publication vaut mieux qu’une heure fétiche.","dek":"Une fenêtre de publication décrit l’intervalle acceptable pour une tâche."},"en":{"title":"A publishing window beats a sacred minute.","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","fr":{"title":"Ton réseau commence par un inventaire fiable.","dek":"Un inventaire AGD relie chaque compte à son rôle, son marché, son responsable et son état observé."},"en":{"title":"Your network starts with an accurate inventory.","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","fr":{"title":"Zéro vue n’est pas un diagnostic.","dek":"Stuck at 0 views décrit une observation de distribution faible ou nulle après publication."},"en":{"title":"Zero views is not a diagnosis.","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","fr":{"title":"Le shadowban est parfois le nom qu’on donne à l’inconnu.","dek":"Shadowban est un terme informel pour une suppression de distribution supposée sans notification explicite."},"en":{"title":"Shadowban is sometimes the name we give the unknown.","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","fr":{"title":"Sept états différents cachés dans « ça ne marche pas ».","dek":"Une défaillance de distribution peut concerner l’accès au compte, une fonction, un contenu retiré, une publication absente ou une portée faible."},"en":{"title":"Different failures hidden inside “it does not work”.","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","fr":{"title":"Organique ne veut pas dire clandestin.","dek":"Un contenu peut être utile, natif et commercial à la fois."},"en":{"title":"Organic does not mean undercover.","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","fr":{"title":"Sur Reddit, le contexte est la porte d’entrée.","dek":"Reddit AGD adapte la différenciation des comptes à une participation légitime dans des communautés."},"en":{"title":"On Reddit, context is the entrance.","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","fr":{"title":"Participer avant de distribuer.","dek":"Une communauté ne se réduit pas à un canal d’acquisition."},"en":{"title":"Participate before distributing.","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","fr":{"title":"Le dossier d’assets a besoin de preuves, pas de suppositions.","dek":"Un registre de provenance relie images, sons et vidéos à leur origine et aux conditions d’utilisation vérifiées."},"en":{"title":"An asset folder needs evidence, not assumptions.","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","fr":{"title":"Le post-mortem commence par ce qu’on ne sait pas.","dek":"Une rétrospective AGD relie objectifs, exécution, observations et décisions."},"en":{"title":"A retrospective starts with what we do not know.","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","fr":{"title":"Le coût d’un test, c’est aussi le temps perdu à le comprendre.","dek":"Un budget d’apprentissage inclut production, coordination, exécution et analyse."},"en":{"title":"A test also costs the time spent making sense of it.","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","fr":{"title":"Viral par rapport à quoi ?","dek":"Un Viral Hit est un résultat de distribution inhabituellement élevé par rapport à une référence définie : compte, cohorte ou campagne."},"en":{"title":"Viral compared with what?","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","fr":{"title":"Le dénominateur est la moitié de l’histoire.","dek":"Le Viral Hit Rate est la proportion de publications admissibles qui dépassent un seuil d’outlier défini à l’avance."},"en":{"title":"The denominator is half the story.","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","fr":{"title":"La moyenne adore les histoires trop belles.","dek":"La moyenne additionne les valeurs puis divise par leur nombre."},"en":{"title":"The average loves an overly good story.","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","fr":{"title":"P90 n’est pas un nouveau mot pour « bon ».","dek":"Un percentile situe une valeur dans une distribution ordonnée."},"en":{"title":"P90 is not a new word for good.","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","fr":{"title":"Le hit fait du bruit. Le reste raconte le système.","dek":"La concentration mesure la part du résultat portée par une fraction des posts."},"en":{"title":"The hit makes noise. The rest explains the system.","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","fr":{"title":"Le réseau tourne. Ou un seul compte le porte.","dek":"La concentration par compte indique quels actifs portent le résultat total."},"en":{"title":"The network works. Or one account carries it.","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","fr":{"title":"Comparer ce qui peut vraiment l’être.","dek":"Une cohorte appariée rapproche des observations sur des caractéristiques connues."},"en":{"title":"Compare what is actually comparable.","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","fr":{"title":"19 h 42 n’est pas une stratégie.","dek":"L’effet de l’heure de publication dépend potentiellement du public et du contexte."},"en":{"title":"7:42 p.m. is not a strategy.","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","fr":{"title":"Publier plus : davantage de chances ou davantage de bruit ?","dek":"Un test de fréquence doit distinguer volume total, performance par post et charge de production."},"en":{"title":"Posting more: more chances or more noise?","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","fr":{"title":"Le warming mérite mieux qu’une anecdote.","dek":"Un protocole de warming compare des préparations définies avant publication."},"en":{"title":"Warming deserves more than an anecdote.","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","fr":{"title":"Un vieux compte n’est pas un groupe de contrôle.","dek":"L’âge d’un compte peut être lié à son historique, ses abonnés et ses habitudes."},"en":{"title":"An old account is not a control group.","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","fr":{"title":"Le carrousel contre la vidéo : mauvaise question sans contexte.","dek":"Comparer carrousel et vidéo exige une promesse et un public comparables."},"en":{"title":"Slideshow versus video: context comes first.","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","fr":{"title":"La série ou le chaos ? Un test, pas une guerre de goûts.","dek":"Un test Formatted versus Chaotic compare une structure récurrente à plusieurs formats."},"en":{"title":"Series or chaos? A test, not a taste war.","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","fr":{"title":"La diversité se mesure aussi dans ce qu’on apprend.","dek":"Un test de diversité créative examine des variations substantielles plutôt qu’un simple compte de fichiers."},"en":{"title":"Diversity also lives in what you learn.","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","fr":{"title":"Ce n’est peut-être pas le natif. C’est peut-être la fonction.","dek":"Un test de fonctionnalités natives distingue l’effet d’une fonction du canal de publication."},"en":{"title":"Maybe it is not native. Maybe it is the feature.","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","fr":{"title":"Un taux de zéro mérite une définition entière.","dek":"Le taux de publications à zéro vue dépend d’un âge d’observation, d’une source de mesure et d’un périmètre admissible."},"en":{"title":"A zero rate deserves a complete definition.","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","fr":{"title":"L’intervalle d’incertitude fait partie du résultat.","dek":"Un intervalle exprime l’incertitude sous les hypothèses d’une méthode."},"en":{"title":"Uncertainty is part of the result.","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","fr":{"title":"Les comptes disparus avaient aussi des résultats.","dek":"Le biais de survivance apparaît quand l’analyse ne conserve que les unités encore visibles."},"en":{"title":"The missing accounts had results too.","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","fr":{"title":"Après un hit, le retour sur terre n’est pas toujours une panne.","dek":"Un résultat extrême peut être suivi de résultats plus ordinaires."},"en":{"title":"After a hit, returning to earth is not always a failure.","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","fr":{"title":"J7 n’existe pas pour un visiteur arrivé hier.","dek":"Une conversion à J7 doit porter sur des personnes ayant eu sept jours complets pour convertir."},"en":{"title":"Day seven does not exist for yesterday’s visitor.","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","fr":{"title":"Un UTM dit d’où vient le clic. Pas toute l’histoire.","dek":"Les paramètres de campagne décrivent une origine instrumentée."},"en":{"title":"A UTM tells you about the click. Not the whole story.","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","fr":{"title":"Un million de vues peut rater le problème.","dek":"Les vues mesurent une exposition selon la définition de la plateforme."},"en":{"title":"A million views can miss the problem.","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","fr":{"title":"Écrire le verdict possible avant de connaître le score.","dek":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue."},"en":{"title":"Write possible verdicts before knowing the score.","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","fr":{"title":"Savoir arrêter fait partie du test.","dek":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience."},"en":{"title":"Knowing when to stop is part of the test.","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","fr":{"title":"Une hypothèse mérite une étiquette, pas un déguisement.","dek":"L’échelle AGD distingue documentation de plateforme, données propriétaires méthodiques, expériences contrôlées, observations répétées, hypothèses et folklore."},"en":{"title":"A hypothesis needs a label, not a disguise.","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","fr":{"title":"L’IA peut penser le système avant de remplir le calendrier.","dek":"AI AGD désigne l’usage de l’IA pour planifier, produire, analyser ou orchestrer l’AGD."},"en":{"title":"AI can think about the system before filling the calendar.","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","fr":{"title":"Un agent de distribution n’est pas un calendrier qui parle.","dek":"Agentic AGD organise des décisions récurrentes entre comptes, contenus, marchés et expériences."},"en":{"title":"A distribution agent is not a talking calendar.","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","fr":{"title":"Derrière l’API, quelqu’un ouvre vraiment l’app.","dek":"Une Human API expose un workflow logiciel dont une partie est exécutée par des personnes."},"en":{"title":"Behind the API, someone actually opens the app.","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","fr":{"title":"Le MCP relie des outils. Il n’écrit pas ta stratégie.","dek":"MCP permet à un client d’agent de découvrir et appeler des outils exposés par un serveur."},"en":{"title":"MCP connects tools. It does not write your strategy.","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","fr":{"title":"Une simulation doit savoir ce qu’elle ne simule pas.","dek":"Un dry run valide une requête sans produire ses effets réels selon le contrat du service."},"en":{"title":"A preview must know what it does not simulate.","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","fr":{"title":"Réessayer sans commander deux fois.","dek":"L’idempotence évite qu’une même intention répétée produise plusieurs effets lorsque l’opération et son contrat la prennent en charge."},"en":{"title":"Retry without ordering twice.","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","fr":{"title":"Le webhook annonce un fait. Il ne remplace pas ton état.","dek":"Un webhook transmet un événement vers votre intégration."},"en":{"title":"A webhook reports an event. It does not replace your state.","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","fr":{"title":"Un agent sans plafond n’a pas un budget.","dek":"Un budget d’agent définit les opérations autorisées, les limites et les conditions de renouvellement."},"en":{"title":"An agent without a ceiling has no budget.","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","fr":{"title":"L’autonomie est une échelle, pas un interrupteur.","dek":"Le modèle AGD distingue exécution manuelle, assistance IA, orchestration approuvée, gestion agentique et autonomie étendue."},"en":{"title":"Autonomy is a ladder, not a switch.","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","fr":{"title":"Ton API n’est pas une stratégie de distribution.","dek":"API Slop critique un usage qui envoie massivement des contenus indifférenciés sans attention aux comptes ni au contexte."},"en":{"title":"Your API is not a distribution strategy.","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","fr":{"title":"Le bon contenu peut atterrir sur le mauvais compte.","dek":"Le routage relie une création à un compte selon public, persona, marché et objectif."},"en":{"title":"Good content can land on the wrong account.","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","fr":{"title":"Classer des idées sans gommer leurs différences.","dek":"Le clustering créatif rapproche des contenus selon des critères choisis."},"en":{"title":"Group ideas without erasing their differences.","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","fr":{"title":"Une alerte utile doit dire quoi regarder.","dek":"La détection d’anomalies signale un écart à une référence définie."},"en":{"title":"A useful alert tells you what to inspect.","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","fr":{"title":"La validation humaine doit porter sur une vraie décision.","dek":"Une validation humaine utile expose l’action, ses conséquences et les éléments à vérifier."},"en":{"title":"Human review should contain a real decision.","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","fr":{"title":"La doc qui dit non vaut mieux que la landing qui dit tout.","dek":"La source de vérité technique décrit les capacités actuelles d’une interface."},"en":{"title":"Documentation that says no beats a page promising everything.","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","fr":{"title":"Une vidéo peut avoir une deuxième vie dans la recherche.","dek":"SEO AGD explore la visibilité de contenus et propriétés sociales dans les moteurs et la recherche interne des plateformes."},"en":{"title":"A video can have a second life in search.","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","fr":{"title":"Le programmatique a besoin d’une raison par page.","dek":"pSEO AGD organise systématiquement des contenus sociaux autour d’intentions de recherche distinctes."},"en":{"title":"Programmatic content needs a reason for every page.","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","fr":{"title":"Pour être cité, commencer par être citable.","dek":"Un contenu citable formule clairement une proposition, sa portée et sa provenance."},"en":{"title":"To be cited, first be quotable.","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","fr":{"title":"Un bon lien continue une idée.","dek":"Un graphe éditorial relie concepts parents, voisins et applications."},"en":{"title":"A good link continues an idea.","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","fr":{"title":"Deux langues, deux vraies lectures.","dek":"Une publication multilingue donne une URL stable à chaque version et relie les traductions correspondantes."},"en":{"title":"Two languages, two real reading experiences.","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","fr":{"title":"Un schéma strict libère la voix. Il ne l’écrit pas.","dek":"Un schéma éditorial impose les éléments nécessaires à une publication : identité, traduction, média, stories, texte, sources et liens."},"en":{"title":"A strict schema frees the voice. It does not write it.","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","fr":{"title":"Le journal qui permet de comprendre le lendemain.","dek":"Un journal d’agent relie intention, outil, résultat et décision suivante."},"en":{"title":"The log that makes tomorrow understandable.","dek":"An agent log connects intent, tool, result and next decision."}}]}],"$L10","$L11"]}]
1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","header",null,{"className":"page-heading","children":[["$","span",null,{"className":"mono acid","children":["THE ARCHIVE / ",100]}],["$","h1",null,{"children":"Nothing gets lost."}],["$","p",null,{"children":"Essays, guides and Lab notebooks. Your saved reads stay on this device."}]]}],["$","$L12",null,{"items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"iceberg","tier":"canonical","evidence":"editorial","sources":[],"related":["account-isolation","content-isolation","content-saturation"],"fr":{"title":"Le contenu est gratuit. La distribution ne l’est pas.","dek":"Tout le monde peut produire. Presque personne ne sait distribuer. Bienvenue de l’autre côté de l’iceberg.","point":"L’Account-Generated Distribution (AGD) organise des comptes sociaux différenciés comme une infrastructure de distribution organique. Multiplier les comptes n’a de sens que si les publics, les voix et les contenus se différencient.","body":["Le pitch tient dans un onglet : un générateur, quelques prompts, cinquante vidéos. Le problème arrive après l’export. Qui va regarder ? Pourquoi cette personne s’arrêterait-elle sur ce compte plutôt que sur le prochain ? La production a un bouton. La distribution réclame encore une raison d’exister.","Un compte de marque doit souvent tout faire : rassurer, vendre, faire rire, recruter, expliquer. Chaque post négocie avec les autres. L’AGD propose de séparer ces rôles. Un compte peut explorer les galères d’étudiants ; un autre démonter des habitudes de travail ; un troisième montrer le produit en situation. Même entreprise, trois contrats éditoriaux.","Le piège consiste à prendre ce schéma pour une recette de volume. Trente comptes qui publient le même montage ne représentent pas trente idées. Ils multiplient surtout le travail de coordination, les risques de répétition et les questions sans réponse. La diversification se juge dans ce que reçoit le lecteur, pas dans le nombre de lignes d’un tableau.","L’AGD est ici un cadre proposé à partir du blueprint TokPortal, pas un consensus académique ni une promesse de portée. Il vaut ce que valent les expériences qu’il permet de conduire. Le test intéressant : apprend-on quelque chose qu’un compte unique aurait masqué ? Peut-on attribuer ce signal à un angle, à un public, à un format ?","Construisez donc un petit réseau dont vous pouvez expliquer chaque différence. Documentez les contenus qui échouent autant que ceux qui décollent. Et gardez une mesure commerciale à côté des vues : une audience qui admire un montage n’a pas forcément un problème que votre produit résout."],"action":["Écrire une promesse éditoriale distincte par compte.","Associer chaque publication à une hypothèse et à un public.","Mesurer les résultats par cohorte, puis les visites qualifiées."],"trap":"Un réseau de clones peut augmenter votre production sans ajouter une seule perspective.","quote":"Le prochain avantage ne sera pas de produire plus. Ce sera de savoir où une idée mérite de vivre.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le prochain avantage ne sera pas de produire plus. Ce sera de savoir où une idée mérite de vivre.","text":"Tout le monde peut produire. Presque personne ne sait distribuer. Bienvenue de l’autre côté de l’iceberg.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Account-Generated Distribution","text":"L’Account-Generated Distribution (AGD) organise des comptes sociaux différenciés comme une infrastructure de distribution organique. Multiplier les comptes n’a de sens que si les publics, les voix et les contenus se différencient.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un réseau de clones peut augmenter votre production sans ajouter une seule perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire une promesse éditoriale distincte par compte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Associer chaque publication à une hypothèse et à un public.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 3","title":"Mesurer les résultats par cohorte, puis les visites qualifiées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","point":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","body":["The pitch fits in a browser tab: one generator, a few prompts, fifty videos. The problem starts after export. Who watches? Why should that person stop at this account instead of the next one? Production has a button. Distribution still needs a reason to exist.","A brand account is often asked to reassure, sell, entertain, recruit and explain. Every post negotiates with the others. AGD separates those jobs. One account explores student frustrations; another challenges work habits; a third demonstrates a product in context. One company, three editorial promises.","The trap is reading this architecture as a volume recipe. Thirty accounts running the same edit do not represent thirty ideas. They mostly multiply coordination, repetition and unanswered questions. Diversification lives in what a viewer receives, not in the number of rows in a spreadsheet.","AGD is a proposed framework drawn from the TokPortal blueprint, not an academic consensus or a reach guarantee. Its value depends on the experiments it helps run. The useful question is whether a network reveals something that one account would hide. Can the signal be connected to an angle, an audience or a format?","Build a small network whose differences you can explain. Document the failures alongside the breakout posts. And keep a commercial measure next to views: somebody enjoying your edit does not necessarily have a problem your product solves."],"action":["Write a different editorial promise for each account.","Attach each post to a hypothesis and an audience.","Measure by cohort, then inspect qualified visits."],"trap":"A clone network can increase output without adding a single perspective.","quote":"The next advantage is knowing where an idea deserves to live.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The next advantage is knowing where an idea deserves to live.","text":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account-Generated Distribution","text":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A clone network can increase output without adding a single perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a different editorial promise for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach each post to a hypothesis and an audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 3","title":"Measure by cohort, then inspect qualified visits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"video":{"src":"/video/below-the-surface.mp4","poster":"/images/iceberg.jpg","caption":{"fr":"Sous la surface — animation d’une illustration originale. Sans audio.","en":"Below the surface — animated original illustration. No audio."},"tracks":{"fr":"/video/intro-fr.vtt","en":"/video/intro-en.vtt"}},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","kind":"essay","image":"signal","tier":"editorial","evidence":"editorial","sources":[],"related":["hook-slop","content-isolation","account-persona"],"fr":{"title":"L’IA n’est pas le problème. Le même contenu, si.","dek":"Des visages parfaits, des scripts interchangeables. La créativité ne se mesure pas en exports par minute.","point":"AI Slop désigne ici une production qui privilégie le volume à la singularité et à l’utilité. C’est un jugement éditorial sur le résultat, pas un diagnostic automatique fondé sur l’outil utilisé.","body":["On reconnaît parfois le brief avant de comprendre la vidéo. Une surprise de deux secondes, une voix qui ne doute jamais, trois bénéfices, un bouton imaginaire. Le problème n’est pas que la machine parle. C’est que personne ne semble avoir quelque chose à dire.","L’IA peut élargir le terrain créatif : prototyper un décor, essayer un récit, rendre visible une idée impossible à filmer. Elle peut aussi comprimer vingt points de vue en une moyenne parfaitement oubliable. Le débit ne départage pas ces deux usages.","Dans un réseau AGD, la diversité doit rester visible après avoir retiré les noms de comptes. Faites ce test : mélangez neuf publications issues de trois personas et demandez à quelqu’un de retrouver les familles. Si la seule différence est la couleur des sous-titres, vous avez probablement distribué un template, pas des identités.","Avant d’ajouter des variantes, changez une décision de fond : le conflit raconté, le public visé, le savoir apporté. Une idée qui mérite une version humaine mérite parfois une version synthétique. L’inverse ne devient pas vrai parce qu’un abonnement permet mille générations."],"action":["Mélanger neuf posts et tester la reconnaissance des personas.","Changer le point de vue avant de changer le rendu.","Supprimer tout passage qui ne porte aucune information."],"trap":"Un taux de production élevé ne prouve ni la diversité créative ni la satisfaction du public.","quote":"Votre générateur n’a pas besoin d’un meilleur prompt. Votre compte a besoin d’un point de vue.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Votre générateur n’a pas besoin d’un meilleur prompt. Votre compte a besoin d’un point de vue.","text":"Des visages parfaits, des scripts interchangeables. La créativité ne se mesure pas en exports par minute.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"AI Slop","text":"AI Slop désigne ici une production qui privilégie le volume à la singularité et à l’utilité. C’est un jugement éditorial sur le résultat, pas un diagnostic automatique fondé sur l’outil utilisé.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un taux de production élevé ne prouve ni la diversité créative ni la satisfaction du public.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Mélanger neuf posts et tester la reconnaissance des personas.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Changer le point de vue avant de changer le rendu.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 3","title":"Supprimer tout passage qui ne porte aucune information.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"AI isn’t the problem. Sameness is.","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute.","point":"AI Slop describes output that puts volume ahead of distinctiveness and usefulness. It is an editorial judgment about the result, not an automatic diagnosis based on which tool made it.","body":["Sometimes you recognize the brief before you understand the video. Two seconds of surprise, a voice that never doubts, three benefits, an imaginary button. The issue is not that a machine speaks. It is that nobody seems to have anything to say.","AI can widen the creative field: prototype a setting, try a narrative, visualize something impossible to film. It can also compress twenty perspectives into one perfectly forgettable average. Output speed cannot distinguish those uses.","In an AGD network, diversity should survive the removal of account names. Mix nine posts from three personas and ask someone to reconstruct the groups. If the only difference is subtitle color, you have probably distributed a template rather than identities.","Before adding variants, change a fundamental choice: the conflict, the intended audience or the knowledge offered. An idea worth a human version may deserve a synthetic version too. The reverse does not become true because a subscription includes a thousand generations."],"action":["Mix nine posts and test whether personas remain recognizable.","Change the perspective before the rendering.","Delete passages that communicate nothing."],"trap":"High output does not demonstrate creative diversity or audience satisfaction.","quote":"Your generator doesn’t need a better prompt. Your account needs a point of view.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your generator doesn’t need a better prompt. Your account needs a point of view.","text":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"AI Slop","text":"AI Slop describes output that puts volume ahead of distinctiveness and usefulness. It is an editorial judgment about the result, not an automatic diagnosis based on which tool made it.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"High output does not demonstrate creative diversity or audience satisfaction.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Mix nine posts and test whether personas remain recognizable.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Change the perspective before the rendering.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 3","title":"Delete passages that communicate nothing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","kind":"guide","image":"current","tier":"canonical","evidence":"editorial","sources":[],"related":["content-isolation","multi-account-strategy","account-persona"],"fr":{"title":"50 comptes. Une seule idée. Zéro stratégie.","dek":"Account Isolation : différencier les voix avant de multiplier les profils.","point":"Account Isolation est le principe AGD qui donne à chaque compte une identité, un public et un rôle suffisamment distincts pour en faire une surface éditoriale autonome.","body":["Un avatar différent ne crée pas une nouvelle audience. Si vos comptes racontent tous le même produit avec le même humour au même public, vous avez surtout multiplié les accès à gérer. Le réseau existe techniquement ; sa logique éditoriale reste à inventer.","Prenez une application de notes. Un compte peut traiter la prise de cours, un autre l’écriture de fiction, un troisième les comptes rendus de réunion. Les démos partagent un produit, mais les situations, les références et les critères de réussite changent. C’est cette distance qui rend les expériences lisibles.","Écrivez pour chaque compte trois phrases : à qui il parle, ce qu’il promet, ce qu’il refusera de publier. La dernière est la plus utile. Elle empêche chaque succès ailleurs dans le réseau de devenir une obligation de copier.","L’isolation ne désigne pas ici une méthode pour cacher des liens entre comptes ou contourner une sanction. Elle concerne la diversité de distribution. Une audience qui comprend qui lui parle est un actif plus durable qu’une architecture conçue pour rester incompréhensible."],"action":["Définir un public, une promesse et un refus par compte.","Comparer les commentaires pour repérer des usages distincts.","Réviser les comptes dont les rôles se confondent."],"trap":"Confondre différenciation éditoriale et dissimulation technique déforme le concept.","quote":"Un compte de plus ne vaut quelque chose que s’il apporte une différence.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un compte de plus ne vaut quelque chose que s’il apporte une différence.","text":"Account Isolation : différencier les voix avant de multiplier les profils.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Account Isolation","text":"Account Isolation est le principe AGD qui donne à chaque compte une identité, un public et un rôle suffisamment distincts pour en faire une surface éditoriale autonome.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Confondre différenciation éditoriale et dissimulation technique déforme le concept.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir un public, une promesse et un refus par compte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Comparer les commentaires pour repérer des usages distincts.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 3","title":"Réviser les comptes dont les rôles se confondent.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"50 accounts. One idea. Zero strategy.","dek":"Account Isolation: differentiate the voices before multiplying the profiles.","point":"Account Isolation is the AGD principle that gives every account a sufficiently distinct identity, audience and purpose to operate as an independent editorial surface.","body":["A different avatar does not create a new audience. If every account describes the same product with the same humor for the same people, you have mostly multiplied the credentials to manage. The network exists technically; its editorial logic is still missing.","Consider a note-taking app. One account can cover lectures, another fiction writing, another meeting notes. The demonstrations share a product, but their situations, references and success criteria change. That distance makes the experiments readable.","Write three sentences for each account: who it addresses, what it promises and what it refuses to publish. The last one does the most work. It stops every success elsewhere in the network from becoming an instruction to copy.","Isolation here is not a method for hiding account relationships or bypassing enforcement. It concerns distribution diversity. An audience that understands who is speaking is a more durable asset than infrastructure designed to remain incomprehensible."],"action":["Define an audience, a promise and a refusal for each account.","Compare comments for genuinely different uses.","Revise accounts whose roles overlap."],"trap":"Editorial differentiation should not be confused with technical concealment.","quote":"Another account is only useful when it brings another perspective.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Another account is only useful when it brings another perspective.","text":"Account Isolation: differentiate the voices before multiplying the profiles.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Account Isolation","text":"Account Isolation is the AGD principle that gives every account a sufficiently distinct identity, audience and purpose to operate as an independent editorial surface.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Editorial differentiation should not be confused with technical concealment.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define an audience, a promise and a refusal for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Compare comments for genuinely different uses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 3","title":"Revise accounts whose roles overlap.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","kind":"protocol","image":"signal","tier":"canonical","evidence":"hypothesis","sources":["https://developers.tiktok.com/doc/content-posting-api-get-started/","https://developers.tokportal.com/"],"related":["native-posting","niche-warming","matched-cohorts"],"tokportal":"native","fr":{"title":"Le natif gagne-t-il vraiment ? Montrez les données.","dek":"L’API tue la portée ? Voici le protocole qu’il faudrait avant de l’affirmer.","point":"Comparer Native Posting et publication par API exige des cohortes comparables et une durée d’observation identique. Aucun résultat expérimental n’est publié dans cette fiche : le verdict reste inconnu.","body":["Deux captures d’écran ne font pas une expérience. Un compte ancien publie en natif, un compte neuf passe par une API, puis quelqu’un attribue l’écart à la méthode d’envoi. L’âge, les abonnés, le sujet et la qualité du montage ont disparu du récit.","Le protocole commence avant la publication : définir les comptes admissibles, les formats, les pays et la fenêtre d’observation. Répartir les traitements dans des blocs comparables, puis conserver les échecs techniques. Une analyse limitée aux publications réussies répondrait à une autre question.","Les fonctions natives disponibles peuvent différer de celles d’une intégration. Distinguez donc deux tests : à contenu et fonctionnalités identiques, le canal change-t-il le résultat ? Et, dans un usage réel, l’accès à certains outils natifs change-t-il la performance de l’ensemble du workflow ?","TokPortal fournit un exemple de séparation entre orchestration par API et exécution humaine dans les applications. Cela décrit une architecture ; ce n’est pas une preuve de supériorité algorithmique. Nous publierions une conclusion seulement avec une méthode et des observations vérifiables."],"action":["Préenregistrer cohortes, indicateur principal et durée.","Conserver les échecs dans le dénominateur pertinent.","Rapporter médiane, dispersion et incertitude."],"trap":"Attribuer au canal de publication une différence de création ou d’ancienneté.","quote":"Une préférence opérationnelle ne devient pas une loi de l’algorithme.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une préférence opérationnelle ne devient pas une loi de l’algorithme.","text":"L’API tue la portée ? Voici le protocole qu’il faudrait avant de l’affirmer.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Native Posting","text":"Comparer Native Posting et publication par API exige des cohortes comparables et une durée d’observation identique. Aucun résultat expérimental n’est publié dans cette fiche : le verdict reste inconnu.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Attribuer au canal de publication une différence de création ou d’ancienneté.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Préenregistrer cohortes, indicateur principal et durée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Conserver les échecs dans le dénominateur pertinent.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 3","title":"Rapporter médiane, dispersion et incertitude.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Does native really win? Show the data.","dek":"“APIs kill reach.” Here is the protocol that claim would need.","point":"Comparing Native Posting with API publishing requires comparable cohorts and identical observation windows. This note reports no experimental result: the verdict remains unknown.","body":["Two screenshots do not make an experiment. An established account posts natively, a new account uses an API, and someone attributes the gap to the upload method. Age, followers, topic and editing quality disappear from the story.","The protocol starts before publication: define eligible accounts, formats, countries and observation windows. Allocate treatments within comparable blocks and retain technical failures. An analysis restricted to successful publications would answer a different question.","Available native features can differ from an integration’s capabilities. Separate two tests: with identical content and features, does the publishing channel change results? And in actual use, does access to native tools change the performance of the complete workflow?","TokPortal illustrates the separation between API orchestration and human execution inside consumer apps. That describes an architecture; it does not prove algorithmic superiority. A conclusion would need a verifiable method and observations."],"action":["Preregister cohorts, primary metric and observation window.","Keep failures in the relevant denominator.","Report median, dispersion and uncertainty."],"trap":"Attributing a creative or account-age difference to the publishing channel.","quote":"An operational preference is not a law of the algorithm.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An operational preference is not a law of the algorithm.","text":"“APIs kill reach.” Here is the protocol that claim would need.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Native Posting","text":"Comparing Native Posting with API publishing requires comparable cohorts and identical observation windows. This note reports no experimental result: the verdict remains unknown.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Attributing a creative or account-age difference to the publishing channel.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Preregister cohorts, primary metric and observation window.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep failures in the relevant denominator.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 3","title":"Report median, dispersion and uncertainty.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","kind":"guide","image":"signal","tier":"canonical","evidence":"documented","sources":["https://developers.tokportal.com/mcp/","https://developers.tokportal.com/sandbox/"],"related":["human-api","agentic-agd","idempotency"],"tokportal":"sandbox","fr":{"title":"Ton agent sait publier. Apprends-lui à attendre.","dek":"Un vrai workflow MCP commence par une simulation lisible, pas par une dépense surprise.","point":"Le MCP TokPortal expose des opérations sociales à un agent. Une simulation utilise dry_run: true au niveau des arguments, avec les paramètres de création dans body ; la décision de passer en réel reste séparée.","body":["Un agent qui exécute tout très vite n’est pas nécessairement un bon opérateur. Sur un workflow payant, sa première compétence utile consiste à expliquer ce qu’il va déclencher : le pays, la plateforme, le compte et les coûts immédiats ou récurrents.","Le serveur distant se trouve à https://app.tokportal.com/api/ext/mcp. La documentation du paquet local demande la version 1.15.1 ou ultérieure pour une simulation fiable : la version 1.15.0 annonçait un argument qu’elle ne transmettait pas correctement. Ce détail compte plus qu’une jolie démo d’agent.","Demandez d’abord les pays disponibles, les prix et le solde. Pour prévisualiser un compte TikTok américain, l’opération tokportal_create_bundle accepte dry_run: true puis body avec bundle_type: account_only, platform: tiktok et country: USA. La réponse doit distinguer crédits simulés et crédits débités.","Les identifiants renvoyés par une simulation sont synthétiques. Ne les réutilisez pas en production. Après validation, créez les ressources réelles et poursuivez avec leurs identifiants. La création de bundles YouTube n’est pas disponible par cette API dans la documentation consultée."],"action":["Lire pays, prix et solde avant la simulation.","Vérifier credits_charged: 0 dans le résultat simulé.","Attendre un accord explicite avant une création réelle."],"trap":"Un dry run vérifie un contrat ; il ne réserve ni compte ni capacité réelle.","quote":"L’autonomie commence par savoir ce qui exige encore un feu vert.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"L’autonomie commence par savoir ce qui exige encore un feu vert.","text":"Un vrai workflow MCP commence par une simulation lisible, pas par une dépense surprise.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Agentic AGD","text":"Le MCP TokPortal expose des opérations sociales à un agent. Une simulation utilise dry_run: true au niveau des arguments, avec les paramètres de création dans body ; la décision de passer en réel reste séparée.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un dry run vérifie un contrat ; il ne réserve ni compte ni capacité réelle.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Lire pays, prix et solde avant la simulation.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Vérifier credits_charged: 0 dans le résultat simulé.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 3","title":"Attendre un accord explicite avant une création réelle.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Your agent can publish. Teach it to wait.","dek":"A real MCP workflow starts with a readable preview, not a surprise charge.","point":"TokPortal MCP exposes social operations to an agent. A preview uses top-level dry_run: true, with creation parameters inside body; the decision to execute live remains a separate step.","body":["An agent executing everything quickly is not necessarily a good operator. In a paid workflow, its first useful skill is explaining what it will trigger: country, platform, account and immediate or recurring costs.","The remote server is https://app.tokportal.com/api/ext/mcp. The local package documentation requires version 1.15.1 or later for reliable previews: version 1.15.0 advertised an argument it did not forward correctly. That detail matters more than an impressive agent demo.","Read available countries, prices and balance first. To preview a US TikTok account, tokportal_create_bundle accepts dry_run: true and a body containing bundle_type: account_only, platform: tiktok and country: USA. The response should distinguish simulated credits from charged credits.","Preview identifiers are synthetic. Never reuse them in production. After approval, create real resources and continue with their live identifiers. YouTube bundle creation is not supported through this API in the documentation consulted."],"action":["Read countries, prices and balance before previewing.","Check credits_charged: 0 in the simulated response.","Wait for explicit approval before live creation."],"trap":"A dry run validates a contract; it does not reserve real accounts or capacity.","quote":"Autonomy starts with knowing what still needs a green light.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Autonomy starts with knowing what still needs a green light.","text":"A real MCP workflow starts with a readable preview, not a surprise charge.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Agentic AGD","text":"TokPortal MCP exposes social operations to an agent. A preview uses top-level dry_run: true, with creation parameters inside body; the decision to execute live remains a separate step.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A dry run validates a contract; it does not reserve real accounts or capacity.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Read countries, prices and balance before previewing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check credits_charged: 0 in the simulated response.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 3","title":"Wait for explicit approval before live creation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"006","slug":"multi-account-strategy","term":"Multi-Account Strategy","category":"doctrine","kind":"essay","image":"iceberg","tier":"canonical","evidence":"editorial","sources":[],"related":["content-isolation","native-account","distribution-is-the-moat"],"fr":{"title":"Un compte de marque ne peut pas tout porter.","dek":"Une Multi-Account Strategy distribue les expériences d’une marque entre plusieurs comptes différenciés.","point":"Une Multi-Account Strategy distribue les expériences d’une marque entre plusieurs comptes différenciés. C’est la base organisationnelle de l’AGD, pas sa définition complète.","body":["Séparez les raisons de regarder avant de répartir les publications. Une app de cuisine peut parler de repas étudiants, de préparation du dimanche et de techniques de chef. La même recette ne remplit pas ces trois promesses. Le coût supplémentaire doit acheter de l’apprentissage, pas seulement plus de créneaux dans le calendrier.","Exemple de départ : deux comptes couvrent des usages différents d’un outil de notes, un troisième documente sa prise en main. Après un cycle, comparez les questions reçues. Si tous attirent exactement la même demande, revisitez leurs promesses avant de créer un quatrième profil. Le prochain compte doit résoudre un manque identifié."],"action":["Dessiner trois publics et un format adapté à chacun.","Nommer un responsable par compte."],"trap":"Des comptes supplémentaires sans hypothèse distincte rendent l’analyse plus bruyante.","quote":"Un compte de marque ne peut pas tout porter.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un compte de marque ne peut pas tout porter.","text":"Une Multi-Account Strategy distribue les expériences d’une marque entre plusieurs comptes différenciés.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Multi-Account Strategy","text":"Une Multi-Account Strategy distribue les expériences d’une marque entre plusieurs comptes différenciés. C’est la base organisationnelle de l’AGD, pas sa définition complète.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Des comptes supplémentaires sans hypothèse distincte rendent l’analyse plus bruyante.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Dessiner trois publics et un format adapté à chacun.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Nommer un responsable par compte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"One brand account cannot carry everything.","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts.","point":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts. It is AGD’s organizational foundation, not its complete definition.","body":["Separate reasons to watch before allocating posts. A cooking app can cover student meals, Sunday preparation and chef techniques. The same recipe does not fulfill all three promises. Extra operating cost should buy learning, not merely more calendar slots.","Consider two accounts covering different uses of a notes tool and a third documenting onboarding. After a cycle, compare the questions each receives. If all attract exactly the same requests, revisit their promises before creating a fourth profile. The next account should address an identified gap. Account count is an input to this decision, not evidence that the architecture works."],"action":["Map three audiences and a suitable format for each.","Assign an owner to every account."],"trap":"Extra accounts without distinct hypotheses make analysis noisier.","quote":"One brand account cannot carry everything.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"One brand account cannot carry everything.","text":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Multi-Account Strategy","text":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts. It is AGD’s organizational foundation, not its complete definition.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Extra accounts without distinct hypotheses make analysis noisier.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Map three audiences and a suitable format for each.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Assign an owner to every account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"007","slug":"content-isolation","term":"Content Isolation","category":"doctrine","kind":"essay","image":"iceberg","tier":"canonical","evidence":"editorial","sources":[],"related":["content-saturation","multi-account-strategy","distribution-is-the-moat"],"fr":{"title":"Changer les sous-titres ne crée pas une idée.","dek":"Content Isolation maintient une différenciation créative substantielle entre comptes : récit, angle, format ou objectif.","point":"Content Isolation maintient une différenciation créative substantielle entre comptes : récit, angle, format ou objectif. Elle complète l’Account Isolation, qui distingue les surfaces de distribution.","body":["Un même problème peut devenir une démo précise, une histoire de raté ou une comparaison d’habitudes. Ces versions apportent des informations différentes. Recolorer le même montage, en revanche, conserve sa structure et son point de vue. Archivez les concepts avec leurs déclinaisons pour savoir si vous testez une idée ou son emballage.","Prenez une vidéo de préparation d’examen. Une variante explique le planning ; une autre raconte un oubli ; une troisième compare deux méthodes de révision. Elles partagent une matière première mais changent la question traitée. Notez cette question dans le brief : elle devient un critère simple pour refuser une fausse nouvelle version."],"action":["Attribuer un identifiant au concept créatif.","Documenter ce que chaque version change pour le spectateur."],"trap":"La duplication peut donner l’illusion de beaucoup d’expériences alors qu’une seule idée tourne en boucle.","quote":"Changer les sous-titres ne crée pas une idée.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Changer les sous-titres ne crée pas une idée.","text":"Content Isolation maintient une différenciation créative substantielle entre comptes : récit, angle, format ou objectif.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Content Isolation","text":"Content Isolation maintient une différenciation créative substantielle entre comptes : récit, angle, format ou objectif. Elle complète l’Account Isolation, qui distingue les surfaces de distribution.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La duplication peut donner l’illusion de beaucoup d’expériences alors qu’une seule idée tourne en boucle.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Attribuer un identifiant au concept créatif.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Documenter ce que chaque version change pour le spectateur.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"New subtitles do not make a new idea.","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose.","point":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose. It complements Account Isolation, which differentiates distribution surfaces.","body":["One problem can become a precise demo, a failure story or a comparison of habits. Those versions offer different information. Recoloring an edit preserves its structure and perspective. Archive concepts with their variations so you know whether you are testing an idea or its packaging.","Take an exam-preparation video. One version explains scheduling, another tells a story about forgetting, and a third compares revision methods. They share raw material but change the question addressed. Record that question in the brief. It becomes a practical reason to reject a supposedly new version that merely changes its colors while preserving the same argument and viewing experience."],"action":["Assign an identifier to each creative concept.","Record what each version changes for the viewer."],"trap":"Duplication can make one looping idea look like many experiments.","quote":"New subtitles do not make a new idea.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"New subtitles do not make a new idea.","text":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Content Isolation","text":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose. It complements Account Isolation, which differentiates distribution surfaces.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Duplication can make one looping idea look like many experiments.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Assign an identifier to each creative concept.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record what each version changes for the viewer.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"008","slug":"content-saturation","term":"Content Saturation","category":"doctrine","kind":"essay","image":"iceberg","tier":"editorial","evidence":"editorial","sources":[],"related":["feed-escalation","content-isolation","distribution-is-the-moat"],"fr":{"title":"Le feed n’a pas gagné des heures dans la journée.","dek":"Content Saturation décrit un excès d’offre de contenus par rapport à l’attention disponible.","point":"Content Saturation décrit un excès d’offre de contenus par rapport à l’attention disponible. Dans le cadre AGD, c’est une thèse sur la concurrence, pas une mesure universelle établie.","body":["Votre vrai concurrent dans un feed peut être une blague envoyée par un ami. Un post ne gagne pas parce qu’il est meilleur que celui de l’entreprise voisine. Il doit mériter sa place dans une session où personne n’a demandé à voir votre produit. La pertinence situationnelle devient alors plus utile qu’une nouvelle cadence arbitraire.","Pour un tutoriel, la bonne réponse peut être de réduire l’ambition. « Retrouver une note pendant un appel » décrit un moment réel ; « devenir plus productif » décrit tout et rien. Une situation précise aide à choisir le premier écran, les éléments à montrer et ceux à couper. La concurrence devient alors une question de pertinence."],"action":["Décrire le moment où le public aurait besoin du contenu.","Supprimer les introductions qui retardent cette valeur."],"trap":"L’abondance de contenus ne démontre pas à elle seule une baisse de portée pour chaque compte.","quote":"Le feed n’a pas gagné des heures dans la journée.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le feed n’a pas gagné des heures dans la journée.","text":"Content Saturation décrit un excès d’offre de contenus par rapport à l’attention disponible.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Content Saturation","text":"Content Saturation décrit un excès d’offre de contenus par rapport à l’attention disponible. Dans le cadre AGD, c’est une thèse sur la concurrence, pas une mesure universelle établie.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"L’abondance de contenus ne démontre pas à elle seule une baisse de portée pour chaque compte.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Décrire le moment où le public aurait besoin du contenu.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Supprimer les introductions qui retardent cette valeur.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"The feed did not add hours to the day.","dek":"Content Saturation describes content supply exceeding available attention.","point":"Content Saturation describes content supply exceeding available attention. Within AGD it is a thesis about competition, not an established universal measurement.","body":["Your actual competitor in a feed might be a joke a friend shared. A post does not win merely by beating another company’s post. It must earn a place in a session where nobody requested your product. Situational relevance becomes more useful than another arbitrary posting schedule.","For a tutorial, narrowing the promise may be the useful response. “Find a note during a call” describes a real moment; “be more productive” describes almost everything. A specific situation helps choose the opening screen, what to demonstrate and what to remove. Competition becomes a relevance question rather than a demand to make every piece louder, faster and longer."],"action":["Describe when the audience would need this content.","Remove introductions that delay its value."],"trap":"Content abundance does not by itself prove declining reach for every account.","quote":"The feed did not add hours to the day.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The feed did not add hours to the day.","text":"Content Saturation describes content supply exceeding available attention.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Content Saturation","text":"Content Saturation describes content supply exceeding available attention. Within AGD it is a thesis about competition, not an established universal measurement.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Content abundance does not by itself prove declining reach for every account.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe when the audience would need this content.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Remove introductions that delay its value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"009","slug":"feed-escalation","term":"Feed Escalation","category":"doctrine","kind":"essay","image":"iceberg","tier":"editorial","evidence":"editorial","sources":[],"related":["attention-war","content-saturation","distribution-is-the-moat"],"fr":{"title":"Bienvenue dans la course aux feeds armés.","dek":"Feed Escalation est notre expression éditoriale pour l’intensification des formats, des volumes et de l’optimisation dans les feeds.","point":"Feed Escalation est notre expression éditoriale pour l’intensification des formats, des volumes et de l’optimisation dans les feeds. Ce n’est pas un indicateur scientifique.","body":["Quand un effet de montage devient facile à reproduire, il cesse de suffire à différencier un créateur. La réponse peut être de surenchérir ou de déplacer le jeu : un tutoriel calme, une démonstration sans coupe, une opinion précise. Ces options doivent se comparer auprès du public concerné, pas au goût du directeur créatif.","Imaginez deux démonstrations de la même fonctionnalité. La première accumule effets et commentaires ; la seconde montre une opération complète en silence avec quelques annotations. Le test intéressant porte sur ce que les lecteurs comprennent et retiennent de l’usage. Le format calme n’est pas supérieur par principe : il mérite simplement de rester dans le terrain des possibles."],"action":["Tester un format calme contre un montage dense à promesse comparable.","Regarder aussi les retours qualitatifs."],"trap":"Davantage de stimulation ne signifie pas nécessairement davantage de compréhension.","quote":"Bienvenue dans la course aux feeds armés.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Bienvenue dans la course aux feeds armés.","text":"Feed Escalation est notre expression éditoriale pour l’intensification des formats, des volumes et de l’optimisation dans les feeds.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Feed Escalation","text":"Feed Escalation est notre expression éditoriale pour l’intensification des formats, des volumes et de l’optimisation dans les feeds. Ce n’est pas un indicateur scientifique.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Davantage de stimulation ne signifie pas nécessairement davantage de compréhension.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Tester un format calme contre un montage dense à promesse comparable.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Regarder aussi les retours qualitatifs.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Welcome to the feed arms race.","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds.","point":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds. It is not a scientific metric.","body":["When an editing effect becomes easy to reproduce, it stops being enough to distinguish a creator. You can escalate or change the game: a calm tutorial, an uncut demonstration, a specific opinion. Compare these options with the relevant audience rather than the creative director’s taste.","Imagine two demonstrations of one feature. The first piles on effects and commentary; the second shows a complete operation with a few quiet annotations. Ask what viewers understand about the use case, not simply which edit appears more expensive. The calm format is not inherently superior. It deserves a place among options that can be evaluated with a clear audience and objective."],"action":["Test a calm format against a dense edit with a comparable promise.","Inspect qualitative feedback too."],"trap":"More stimulation does not necessarily mean more understanding.","quote":"Welcome to the feed arms race.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Welcome to the feed arms race.","text":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Feed Escalation","text":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds. It is not a scientific metric.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"More stimulation does not necessarily mean more understanding.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Test a calm format against a dense edit with a comparable promise.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Inspect qualitative feedback too.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"010","slug":"attention-war","term":"Attention War","category":"doctrine","kind":"essay","image":"iceberg","tier":"editorial","evidence":"editorial","sources":[],"related":["agd-not-phone-farm","feed-escalation","distribution-is-the-moat"],"fr":{"title":"Ton SaaS affronte aussi les vidéos de chats.","dek":"Attention War désigne, dans notre vocabulaire culturel, la concurrence pour une attention limitée entre contenus, personnes et plateformes.","point":"Attention War désigne, dans notre vocabulaire culturel, la concurrence pour une attention limitée entre contenus, personnes et plateformes. Le terme aide à penser le contexte de réception.","body":["Un utilisateur peut avoir un problème que votre app résout et n’avoir aucune envie d’en entendre parler maintenant. Le bon angle fait le pont : montrer une friction familière avant de présenter la solution. Inutile d’imiter l’entertainment jusqu’à perdre votre sujet ; une information vraiment utile peut être sa propre attraction.","Une app de budget peut parler du moment où trois abonnements se renouvellent le même jour. Le problème est immédiatement lisible sans présenter la marque. Si une méthode gratuite suffit à le résoudre, montrez-la aussi. Le produit trouvera sa place auprès des lecteurs dont les contraintes justifient une solution plus complète."],"action":["Écrire la situation vécue avant la phrase produit.","Vérifier que le contenu fonctionne sans son CTA."],"trap":"La rétention d’un spectacle sans rapport avec le produit ne prouve pas une intention d’achat.","quote":"Ton SaaS affronte aussi les vidéos de chats.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Ton SaaS affronte aussi les vidéos de chats.","text":"Attention War désigne, dans notre vocabulaire culturel, la concurrence pour une attention limitée entre contenus, personnes et plateformes.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Attention War","text":"Attention War désigne, dans notre vocabulaire culturel, la concurrence pour une attention limitée entre contenus, personnes et plateformes. Le terme aide à penser le contexte de réception.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La rétention d’un spectacle sans rapport avec le produit ne prouve pas une intention d’achat.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire la situation vécue avant la phrase produit.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Vérifier que le contenu fonctionne sans son CTA.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Your SaaS competes with cat videos too.","dek":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms.","point":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms. It helps describe the context in which a post is received.","body":["Someone can have a problem your app solves and still have no desire to hear about it right now. A useful angle bridges that gap: show a familiar friction before presenting a solution. There is no need to imitate entertainment until your topic disappears; useful information can be its own attraction.","A budgeting app can discuss three subscriptions renewing on the same day. The problem is understandable before the brand appears. If a free manual method solves it, show that method too. The product becomes relevant for readers whose constraints justify a more complete solution. This makes the content useful independently while leaving a concrete reason to investigate the tool further."],"action":["Write the lived situation before the product sentence.","Check that the content works without its CTA."],"trap":"Retention on unrelated entertainment does not prove buying intent.","quote":"Your SaaS competes with cat videos too.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your SaaS competes with cat videos too.","text":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Attention War","text":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms. It helps describe the context in which a post is received.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Retention on unrelated entertainment does not prove buying intent.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the lived situation before the product sentence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check that the content works without its CTA.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"011","slug":"agd-not-phone-farm","term":"Phone Farming","category":"doctrine","kind":"essay","image":"iceberg","tier":"operating","evidence":"editorial","sources":[],"related":["agd-without-tokportal","attention-war","distribution-is-the-moat"],"fr":{"title":"Une rangée de téléphones n’est pas une stratégie.","dek":"Phone Farming décrit une infrastructure d’exploitation de comptes sur des environnements mobiles.","point":"Phone Farming décrit une infrastructure d’exploitation de comptes sur des environnements mobiles. L’AGD décrit un modèle de distribution : les deux catégories ne sont pas synonymes.","body":["Un inventaire de matériel explique la capacité disponible, pas ce que les comptes racontent. Commencez par les publics, les droits d’accès et les responsabilités éditoriales. Déterminez ensuite les besoins d’exécution. Acheter de la capacité avant de savoir qui publie quoi transforme souvent une incertitude créative en coût fixe.","Une équipe peut avoir très peu de matériel et des rôles éditoriaux bien séparés. Une autre peut posséder une importante capacité sans savoir quoi publier. Comparez les systèmes sur leurs délais, leur fiabilité et la qualité des créations livrées. Le matériel devient une réponse à une contrainte mesurée, pas le décor d’une présentation de croissance."],"action":["Séparer le plan éditorial du plan d’infrastructure.","Calculer le coût de coordination par compte actif."],"trap":"Le nombre d’appareils ne mesure ni la qualité des comptes ni la diversité des audiences.","quote":"Une rangée de téléphones n’est pas une stratégie.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une rangée de téléphones n’est pas une stratégie.","text":"Phone Farming décrit une infrastructure d’exploitation de comptes sur des environnements mobiles.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Phone Farming","text":"Phone Farming décrit une infrastructure d’exploitation de comptes sur des environnements mobiles. L’AGD décrit un modèle de distribution : les deux catégories ne sont pas synonymes.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le nombre d’appareils ne mesure ni la qualité des comptes ni la diversité des audiences.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Séparer le plan éditorial du plan d’infrastructure.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Calculer le coût de coordination par compte actif.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"A row of phones is not a strategy.","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments.","point":"Phone Farming describes infrastructure for operating accounts across mobile environments. AGD describes a distribution model: the two categories are not synonyms.","body":["An equipment inventory explains available capacity, not what accounts say. Start with audiences, access rights and editorial responsibilities. Determine execution needs afterward. Buying capacity before knowing who publishes what often turns creative uncertainty into a fixed cost.","A team can have little equipment and clearly separated editorial roles. Another can possess substantial capacity without knowing what to publish. Compare systems on delivery times, reliability and the quality of delivered creative work. Hardware then answers a measured constraint rather than becoming scenery for a growth presentation. A photograph of devices cannot reveal whether the underlying accounts have a reason to exist."],"action":["Separate editorial planning from infrastructure planning.","Calculate coordination cost per active account."],"trap":"Device count measures neither account quality nor audience diversity.","quote":"A row of phones is not a strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A row of phones is not a strategy.","text":"Phone Farming describes infrastructure for operating accounts across mobile environments.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Phone Farming","text":"Phone Farming describes infrastructure for operating accounts across mobile environments. AGD describes a distribution model: the two categories are not synonyms.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Device count measures neither account quality nor audience diversity.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Separate editorial planning from infrastructure planning.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Calculate coordination cost per active account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"012","slug":"agd-without-tokportal","term":"AGD & infrastructure","category":"doctrine","kind":"essay","image":"iceberg","tier":"operating","evidence":"editorial","sources":[],"related":["ten-principles","agd-not-phone-farm","distribution-is-the-moat"],"fr":{"title":"L’AGD doit survivre au nom de son fournisseur.","dek":"L’AGD est un cadre de stratégie.","point":"L’AGD est un cadre de stratégie. TokPortal fournit une infrastructure utilisable pour son exécution. Une catégorie qui ne fonctionne qu’avec une marque ressemble surtout à une campagne.","body":["On peut commencer avec des comptes légitimes opérés par une équipe interne, des briefs et un tableur. Le choix d’un service apparaît quand la coordination, les marchés ou les interfaces deviennent des contraintes concrètes. Évaluez alors le périmètre, le coût et la responsabilité de chaque couche. L’outil doit répondre à un problème déjà formulé.","Un tableur partagé peut suffire à un premier cycle : compte, idée, fichier, statut et résultat observé. Quand les erreurs de transfert deviennent récurrentes, une interface peut apporter une vraie valeur. Évaluez-la sur ces erreurs précises. Ce raisonnement rend le choix du fournisseur explicable et permet aussi de constater quand aucun achat supplémentaire n’est nécessaire."],"action":["Décrire le workflow actuel sans aucun nom de produit.","Repérer son goulot d’étranglement avant de choisir une infrastructure."],"trap":"Cette publication est initiée par TokPortal ; ce lien ne transforme pas ses opinions en preuves indépendantes.","quote":"L’AGD doit survivre au nom de son fournisseur.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"L’AGD doit survivre au nom de son fournisseur.","text":"L’AGD est un cadre de stratégie.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"AGD & infrastructure","text":"L’AGD est un cadre de stratégie. TokPortal fournit une infrastructure utilisable pour son exécution. Une catégorie qui ne fonctionne qu’avec une marque ressemble surtout à une campagne.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Cette publication est initiée par TokPortal ; ce lien ne transforme pas ses opinions en preuves indépendantes.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Décrire le workflow actuel sans aucun nom de produit.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Repérer son goulot d’étranglement avant de choisir une infrastructure.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"AGD must outlive the name of its vendor.","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","point":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","body":["You can begin with legitimate accounts run by an internal team, briefs and a spreadsheet. A service becomes relevant when coordination, markets or interfaces create concrete constraints. Evaluate scope, cost and responsibility for each layer. The tool should answer a problem already articulated.","A shared sheet may cover a first cycle: account, idea, file, status and observed outcome. When transfer errors recur, an interface may add real value. Evaluate it against those specific errors. That reasoning makes vendor selection explainable and also reveals when no additional purchase is necessary. The category remains useful because its principles can guide work before a particular provider enters the process."],"action":["Describe the current workflow without product names.","Find its bottleneck before selecting infrastructure."],"trap":"This publication is initiated by TokPortal; that relationship does not turn its opinions into independent evidence.","quote":"AGD must outlive the name of its vendor.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"AGD must outlive the name of its vendor.","text":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"AGD & infrastructure","text":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This publication is initiated by TokPortal; that relationship does not turn its opinions into independent evidence.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe the current workflow without product names.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Find its bottleneck before selecting infrastructure.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"013","slug":"ten-principles","term":"AGD principles","category":"doctrine","kind":"essay","image":"iceberg","tier":"operating","evidence":"editorial","sources":[],"related":["anti-principles","agd-without-tokportal","distribution-is-the-moat"],"fr":{"title":"Le petit manifeste des comptes qui ont une raison d’être.","dek":"Les principes AGD articulent différenciation des comptes, diversité créative, exécution contextualisée et apprentissage mesurable.","point":"Les principes AGD articulent différenciation des comptes, diversité créative, exécution contextualisée et apprentissage mesurable. Ils servent de cadre de décision, pas de recette algorithmique.","body":["Donnez une identité aux comptes, une différence aux contenus, un contexte aux marchés. Testez les préférences natives quand elles importent. Examinez les distributions au-delà des moyennes. Documentez l’échec, le coût et les limites. Faites de l’automatisation un moyen de mieux décider. Et refusez qu’un succès isolé dispense d’expliquer la méthode.","Appliquez les principes à une décision banale : réutiliser un hit ailleurs. La différenciation demande de changer l’angle ; le contexte demande de vérifier le public ; la mesure demande de conserver la filiation du concept. Le manifeste devient ainsi un filtre de travail. Sans application de ce type, même une bonne doctrine finit en affiche murale."],"action":["Relire un plan avec ces principes avant son lancement.","Noter explicitement la décision que chaque principe modifie."],"trap":"Une doctrine récitée sans décision concrète devient une autre couche de jargon.","quote":"Le petit manifeste des comptes qui ont une raison d’être.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le petit manifeste des comptes qui ont une raison d’être.","text":"Les principes AGD articulent différenciation des comptes, diversité créative, exécution contextualisée et apprentissage mesurable.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"AGD principles","text":"Les principes AGD articulent différenciation des comptes, diversité créative, exécution contextualisée et apprentissage mesurable. Ils servent de cadre de décision, pas de recette algorithmique.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une doctrine récitée sans décision concrète devient une autre couche de jargon.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Relire un plan avec ces principes avant son lancement.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Noter explicitement la décision que chaque principe modifie.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"A small manifesto for accounts with a reason to exist.","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning.","point":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning. They form a decision framework, not an algorithmic recipe.","body":["Give accounts an identity, content a difference and markets a context. Test native preferences where they matter. Examine distributions beyond averages. Document failures, costs and limits. Use automation to improve decisions. Refuse to let one success replace an explanation of the method.","Apply the principles to an ordinary decision: reuse a hit elsewhere. Differentiation asks for a changed angle; context asks whether the audience fits; measurement asks that the concept’s lineage remain recorded. The manifesto becomes a working filter rather than a poster. You can still reuse material, but the reason and the meaningful changes should be visible to the person creating and evaluating it."],"action":["Review a plan against these principles before launch.","State which decision each principle changes."],"trap":"A doctrine repeated without concrete decisions becomes another layer of jargon.","quote":"A small manifesto for accounts with a reason to exist.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A small manifesto for accounts with a reason to exist.","text":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"AGD principles","text":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning. They form a decision framework, not an algorithmic recipe.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A doctrine repeated without concrete decisions becomes another layer of jargon.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Review a plan against these principles before launch.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"State which decision each principle changes.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"014","slug":"anti-principles","term":"AGD anti-principles","category":"doctrine","kind":"essay","image":"iceberg","tier":"operating","evidence":"editorial","sources":[],"related":["native-account","ten-principles","distribution-is-the-moat"],"fr":{"title":"Ce qu’on refuse de vendre comme du growth.","dek":"Les anti-principes AGD ciblent les clones, le volume sans diversité, les certitudes sans données et les moyennes sans contexte.","point":"Les anti-principes AGD ciblent les clones, le volume sans diversité, les certitudes sans données et les moyennes sans contexte. Ce sont des choix éditoriaux et opérationnels.","body":["Le problème des recettes miracles n’est pas seulement qu’elles peuvent être fausses. Elles empêchent souvent de poser la bonne question. Pourquoi ce contenu pour ce public ? Quel coût pour cet apprentissage ? Que ferait-on si le résultat était négatif ? Une pratique qui ne prévoit jamais d’échouer est rarement une expérience.","Lorsqu’un conseil arrive avec un résultat spectaculaire, demandez les essais qui ne figurent pas dans la capture. Le conseil peut rester intéressant même si son auteur n’a pas tout mesuré. Il change simplement de statut : piste à explorer, pas règle à imposer à l’équipe. Cette nuance évite de remplacer un dogme par un autre."],"action":["Exiger un dénominateur à chaque chiffre de réussite.","Écrire une condition d’arrêt avant de lancer."],"trap":"Être provocateur ne dispense pas d’être exact, même contre un conseil que l’on déteste.","quote":"Ce qu’on refuse de vendre comme du growth.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Ce qu’on refuse de vendre comme du growth.","text":"Les anti-principes AGD ciblent les clones, le volume sans diversité, les certitudes sans données et les moyennes sans contexte.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"AGD anti-principles","text":"Les anti-principes AGD ciblent les clones, le volume sans diversité, les certitudes sans données et les moyennes sans contexte. Ce sont des choix éditoriaux et opérationnels.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Être provocateur ne dispense pas d’être exact, même contre un conseil que l’on déteste.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Exiger un dénominateur à chaque chiffre de réussite.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Écrire une condition d’arrêt avant de lancer.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"What we refuse to sell as growth.","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context.","point":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context. These are editorial and operational choices.","body":["The problem with miracle recipes is not only that they may be wrong. They often prevent the useful questions. Why this content for this audience? What does this learning cost? What happens if the result is negative? A practice that never allows for failure is rarely an experiment.","When advice arrives with a spectacular result, ask about attempts missing from the screenshot. The advice may still be interesting even if its author measured little. Its status changes: a lead to explore, not a rule to impose. This distinction avoids replacing one dogma with another. Skepticism is useful when it clarifies the next test, not when it automatically dismisses every observation."],"action":["Require a denominator for every success number.","Write a stop condition before launching."],"trap":"Being provocative does not excuse inaccuracy, even about advice you hate.","quote":"What we refuse to sell as growth.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"What we refuse to sell as growth.","text":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"AGD anti-principles","text":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context. These are editorial and operational choices.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Being provocative does not excuse inaccuracy, even about advice you hate.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Require a denominator for every success number.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Write a stop condition before launching.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"015","slug":"native-account","term":"Native Account","category":"doctrine","kind":"essay","image":"iceberg","tier":"canonical","evidence":"editorial","sources":[],"related":["multi-account-strategy","anti-principles","distribution-is-the-moat"],"fr":{"title":"Natif : un environnement, pas un talisman.","dek":"Dans le lexique AGD, un Native Account est créé et entretenu dans l’environnement réel de l’application grand public.","point":"Dans le lexique AGD, un Native Account est créé et entretenu dans l’environnement réel de l’application grand public. La définition décrit le mode d’exécution.","body":["Un fonctionnement natif peut rendre accessibles les parcours et fonctions utilisés par les créateurs ordinaires. Il implique aussi des délais, des permissions et des tâches humaines à organiser. Rien dans cette définition ne garantit une audience. Un bon brief sépare donc les exigences d’exécution des objectifs de distribution que l’on mesurera ensuite.","Dans un brief, remplacez « compte de qualité » par des conditions vérifiables : accès opérationnel, profil conforme au plan et fonctions nécessaires disponibles. Ajoutez qui contrôle ces conditions et quand. Cette précision aide à résoudre un incident sans débattre d’un adjectif. La qualité créative et les résultats d’audience se jugent ensuite dans leurs propres observations."],"action":["Lister les fonctions réellement nécessaires dans l’application.","Définir les preuves d’exécution attendues."],"trap":"Le mot natif ne prouve pas que le contenu sera recommandé davantage.","quote":"Natif : un environnement, pas un talisman.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Natif : un environnement, pas un talisman.","text":"Dans le lexique AGD, un Native Account est créé et entretenu dans l’environnement réel de l’application grand public.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Native Account","text":"Dans le lexique AGD, un Native Account est créé et entretenu dans l’environnement réel de l’application grand public. La définition décrit le mode d’exécution.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le mot natif ne prouve pas que le contenu sera recommandé davantage.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Lister les fonctions réellement nécessaires dans l’application.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Définir les preuves d’exécution attendues.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Native is an environment, not a talisman.","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment.","point":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment. The definition describes execution.","body":["Native operation can provide access to the flows and features ordinary creators use. It also introduces timing, permissions and human tasks to organize. Nothing in this definition guarantees an audience. A good brief separates execution requirements from distribution outcomes measured afterward.","In a brief, replace “quality account” with checkable conditions: working access, a profile matching the plan and required features available. Add who checks them and when. This precision helps resolve incidents without debating an adjective. Creative quality and audience outcomes can then be judged from their own observations. Keeping these questions separate makes both procurement and editorial analysis easier to understand."],"action":["List the features actually needed inside the app.","Define expected execution evidence."],"trap":"The word native does not prove that content will receive more recommendations.","quote":"Native is an environment, not a talisman.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Native is an environment, not a talisman.","text":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Native Account","text":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment. The definition describes execution.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The word native does not prove that content will receive more recommendations.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"List the features actually needed inside the app.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define expected execution evidence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"016","slug":"account-persona","term":"Account Persona","category":"creative","kind":"essay","image":"signal","tier":"canonical","evidence":"editorial","sources":[],"related":["hook-slop","creative-matrix","distribution-is-the-moat"],"fr":{"title":"Un persona, ce n’est pas une photo et un prénom.","dek":"Un Account Persona est l’identité récurrente qui donne un point de vue au compte : qui parle, à qui, et pourquoi revenir..","point":"Un Account Persona est l’identité récurrente qui donne un point de vue au compte : qui parle, à qui, et pourquoi revenir.","body":["Écrivez les opinions que ce compte peut défendre et les sujets qu’il laisse aux autres. Une étudiante pressée ne commente pas une app comme un consultant en organisation. Le personnage se révèle dans le choix des détails, pas dans une biographie remplie d’adjectifs. Une persona fictive doit rester identifiable comme telle lorsqu’elle pourrait être prise pour une personne réelle.","Testez le personnage sur une contrariété. Que fait-il quand l’app ne résout pas tout ? Une voix crédible peut reconnaître une limite, proposer une alternative manuelle ou refuser un mauvais usage. Si le persona ne sait que vanter le produit, son identité risque de s’effacer dès que le public pose une question imprévue."],"action":["Écrire trois opinions et trois refus.","Tester la cohérence sur cinq scripts."],"trap":"Un témoignage inventé ne devient pas acceptable parce qu’il est prononcé par un persona.","quote":"Un persona, ce n’est pas une photo et un prénom.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un persona, ce n’est pas une photo et un prénom.","text":"Un Account Persona est l’identité récurrente qui donne un point de vue au compte : qui parle, à qui, et pourquoi revenir..","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Account Persona","text":"Un Account Persona est l’identité récurrente qui donne un point de vue au compte : qui parle, à qui, et pourquoi revenir.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un témoignage inventé ne devient pas acceptable parce qu’il est prononcé par un persona.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire trois opinions et trois refus.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Tester la cohérence sur cinq scripts.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A persona is not a photo and a name.","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return..","point":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.","body":["Write the opinions this account can defend and the topics it leaves to others. A rushed student does not discuss an app like an organizational consultant. Character appears through chosen details, not a biography full of adjectives. A fictional persona should be identifiable as such when it could be mistaken for a real person.","Test the character against a frustration. What happens when the app does not solve everything? A credible voice can acknowledge a limit, propose a manual workaround or reject an unsuitable use. If the persona only praises the product, its identity may collapse when the audience asks an unexpected question. A consistent boundary often reveals more character than another carefully chosen visual accessory."],"action":["Write three opinions and three refusals.","Test consistency across five scripts."],"trap":"An invented testimonial does not become acceptable because a persona delivers it.","quote":"A persona is not a photo and a name.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A persona is not a photo and a name.","text":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return..","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Account Persona","text":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An invented testimonial does not become acceptable because a persona delivers it.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write three opinions and three refusals.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Test consistency across five scripts.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"017","slug":"hook-slop","term":"Hook Slop","category":"creative","kind":"guide","image":"signal","tier":"editorial","evidence":"editorial","sources":[],"related":["faceless-account","account-persona","distribution-is-the-moat"],"fr":{"title":"« Stop scrolling » : tout le monde hurle la même chose.","dek":"Hook Slop désigne des accroches intenses mais interchangeables, détachées de la valeur réelle du contenu.","point":"Hook Slop désigne des accroches intenses mais interchangeables, détachées de la valeur réelle du contenu. C’est une critique éditoriale, pas une catégorie de plateforme.","body":["Une bonne accroche promet quelque chose que la suite tient. « J’ai perdu mes notes juste avant l’oral » crée une situation précise. « Cette app va changer ta vie » pourrait vendre n’importe quoi. Testez la première phrase avec la conclusion : si elles ne parlent pas du même problème, la rétention initiale risque de mesurer une déception retardée.","Essayez une réécriture sans impératif ni adjectif spectaculaire. Remplacez l’ordre de rester par la situation que vous allez résoudre. Si l’ouverture devient plus claire, vous avez gagné en précision. Mesurez ensuite la réponse au contenu complet : une accroche plus sobre peut attirer moins de curieux et davantage de personnes réellement concernées."],"action":["Relier l’accroche à une preuve visible.","Retirer les superlatifs qui n’ajoutent rien."],"trap":"Une meilleure rétention au début ne garantit pas que la promesse soit tenue ensuite.","quote":"« Stop scrolling » : tout le monde hurle la même chose.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"« Stop scrolling » : tout le monde hurle la même chose.","text":"Hook Slop désigne des accroches intenses mais interchangeables, détachées de la valeur réelle du contenu.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Hook Slop","text":"Hook Slop désigne des accroches intenses mais interchangeables, détachées de la valeur réelle du contenu. C’est une critique éditoriale, pas une catégorie de plateforme.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une meilleure rétention au début ne garantit pas que la promesse soit tenue ensuite.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Relier l’accroche à une preuve visible.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Retirer les superlatifs qui n’ajoutent rien.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"“Stop scrolling”: everybody is shouting the same thing.","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value.","point":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value. It is an editorial criticism, not a platform category.","body":["A good opening makes a promise the rest fulfills. “I lost my notes before the exam” creates a specific situation. “This app will change your life” could sell anything. Compare the first sentence with the conclusion: if they address different problems, early retention may measure delayed disappointment.","Try rewriting without commands or spectacular adjectives. Replace the demand to stay with the situation you will resolve. If the opening becomes clearer, precision has improved. Then evaluate the full piece: a quieter hook may attract fewer curious viewers and more people facing the actual problem. That possibility is worth testing, not asserting as a universal advantage of restrained creative work."],"action":["Connect the opening to visible evidence.","Remove superlatives that add nothing."],"trap":"Better opening retention does not guarantee that the promise is delivered later.","quote":"“Stop scrolling”: everybody is shouting the same thing.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"“Stop scrolling”: everybody is shouting the same thing.","text":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Hook Slop","text":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value. It is an editorial criticism, not a platform category.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Better opening retention does not guarantee that the promise is delivered later.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect the opening to visible evidence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Remove superlatives that add nothing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"018","slug":"faceless-account","term":"Faceless Account","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["formatted-account","hook-slop","distribution-is-the-moat"],"fr":{"title":"Sans visage. Pas sans voix.","dek":"Un Faceless Account produit sans dépendre du visage visible de son opérateur.","point":"Un Faceless Account produit sans dépendre du visage visible de son opérateur. Le format peut rester reconnaissable grâce au sujet, à la narration et aux choix visuels.","body":["Une capture d’écran annotée peut exprimer une opinion plus forte qu’un avatar parlant. Pour une app, montrez un usage et ses contraintes : une recherche ratée, un réglage utile, une décision. Le spectateur doit repartir avec quelque chose, même s’il ne rencontre jamais votre visage. Vérifiez les droits sur les séquences utilisées.","Pour une démo, utilisez votre propre capture avec des données fictives clairement identifiées. Zoomez sur l’action utile et retirez les informations personnelles. La narration peut porter sur une erreur fréquente ou une décision délicate. Ce travail donne une personnalité au contenu sans nécessiter un visage, un faux client ou une imitation de créateur connu."],"action":["Définir un langage visuel constant.","Filmer une action complète et compréhensible."],"trap":"L’absence de visage n’efface pas les obligations de transparence ni les droits des autres créateurs.","quote":"Sans visage. Pas sans voix.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Sans visage. Pas sans voix.","text":"Un Faceless Account produit sans dépendre du visage visible de son opérateur.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Faceless Account","text":"Un Faceless Account produit sans dépendre du visage visible de son opérateur. Le format peut rester reconnaissable grâce au sujet, à la narration et aux choix visuels.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"L’absence de visage n’efface pas les obligations de transparence ni les droits des autres créateurs.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir un langage visuel constant.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Filmer une action complète et compréhensible.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Faceless. Not voiceless.","dek":"A Faceless Account creates content without relying on its operator’s visible face.","point":"A Faceless Account creates content without relying on its operator’s visible face. Topic, narration and visual choices can still make it recognizable.","body":["An annotated screen recording can express a stronger opinion than a talking avatar. For an app, show a use and its constraints: a failed search, a useful setting, a decision. Viewers should leave with something even if they never see your face. Check rights to any footage used.","For a demo, use your own recording with clearly labeled fictional data. Focus on the useful action and remove personal information. Narration can address a common mistake or a difficult decision. This gives the content personality without needing a face, an invented customer or an imitation of a known creator. The audience still receives a concrete explanation it can assess independently."],"action":["Define a consistent visual language.","Record a complete, understandable action."],"trap":"An absent face does not erase transparency requirements or other creators’ rights.","quote":"Faceless. Not voiceless.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Faceless. Not voiceless.","text":"A Faceless Account creates content without relying on its operator’s visible face.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Faceless Account","text":"A Faceless Account creates content without relying on its operator’s visible face. Topic, narration and visual choices can still make it recognizable.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An absent face does not erase transparency requirements or other creators’ rights.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define a consistent visual language.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record a complete, understandable action.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"019","slug":"formatted-account","term":"Formatted Account","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["chaotic-account","faceless-account","distribution-is-the-moat"],"fr":{"title":"Un format récurrent vaut mieux qu’un template vide.","dek":"Un Formatted Account repose sur une structure créative répétable que le public peut reconnaître.","point":"Un Formatted Account repose sur une structure créative répétable que le public peut reconnaître. La répétition porte sur le contrat, pas nécessairement sur le contenu.","body":["« Un réglage, une erreur évitée » est un format : chaque épisode peut enseigner quelque chose de différent. Un fond coloré avec trois phrases quelconques est seulement un gabarit. Notez ce qui doit rester fixe et ce qui doit varier. Ce partage rend les tests plus lisibles tout en évitant que la série s’épuise en autoparodie.","Un bon épisode peut aussi casser légèrement le format pour servir son sujet. Conservez la promesse, mais adaptez la durée si l’explication l’exige. Documentez cette exception pour ne pas la confondre avec un changement de stratégie. La cohérence aide le lecteur à reconnaître ce qu’il reçoit ; elle ne doit pas devenir une contrainte qui empêche d’expliquer."],"action":["Définir la promesse récurrente en une phrase.","Préparer dix épisodes aux enseignements distincts."],"trap":"La reconnaissance du format ne garantit pas que le prochain épisode apporte une nouveauté.","quote":"Un format récurrent vaut mieux qu’un template vide.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un format récurrent vaut mieux qu’un template vide.","text":"Un Formatted Account repose sur une structure créative répétable que le public peut reconnaître.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Formatted Account","text":"Un Formatted Account repose sur une structure créative répétable que le public peut reconnaître. La répétition porte sur le contrat, pas nécessairement sur le contenu.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La reconnaissance du format ne garantit pas que le prochain épisode apporte une nouveauté.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir la promesse récurrente en une phrase.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Préparer dix épisodes aux enseignements distincts.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A recurring format beats an empty template.","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize.","point":"A Formatted Account uses a repeatable creative structure an audience can recognize. Repetition concerns the promise, not necessarily the substance.","body":["“One setting, one avoided mistake” is a format: every episode can teach something different. A colored background with three arbitrary sentences is only a template. Record what stays fixed and what varies. That separation makes testing clearer while preventing the series from exhausting itself.","A useful episode may slightly break its format to serve the subject. Keep the promise but adjust length when the explanation requires it. Record that exception so it is not confused with a strategic change. Consistency helps readers recognize what they receive; it should not become a restriction that prevents explanation. A format earns its place by making good ideas easier to deliver."],"action":["Define the recurring promise in one sentence.","Prepare ten episodes with different lessons."],"trap":"Recognizing a format does not guarantee the next episode offers anything new.","quote":"A recurring format beats an empty template.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A recurring format beats an empty template.","text":"A Formatted Account uses a repeatable creative structure an audience can recognize.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Formatted Account","text":"A Formatted Account uses a repeatable creative structure an audience can recognize. Repetition concerns the promise, not necessarily the substance.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Recognizing a format does not guarantee the next episode offers anything new.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the recurring promise in one sentence.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Prepare ten episodes with different lessons.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"020","slug":"chaotic-account","term":"Chaotic Account","category":"creative","kind":"essay","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["ai-persona","formatted-account","distribution-is-the-moat"],"fr":{"title":"Le compte chaotique a quand même une ligne.","dek":"Un Chaotic Account accepte plusieurs formats plutôt qu’un gabarit rigide.","point":"Un Chaotic Account accepte plusieurs formats plutôt qu’un gabarit rigide. Dans l’AGD, chaotique veut dire flexible, pas dépourvu de public ou de logique.","body":["Un fondateur peut publier une capture, une anecdote et une démo sans perdre sa voix. Le lien se trouve dans son regard sur le travail. Organisez les contenus par intention : faire comprendre, faire rire, montrer une friction. Sinon, le meilleur post de la semaine devient une excuse pour poursuivre n’importe quelle tendance.","Imaginez une semaine construite autour des rendez-vous ratés : un meme, une anecdote puis une démonstration pratique. Les formats changent, le problème reste reconnaissable. Comparez les réactions à cette famille de contenus. Vous pourrez apprendre quel traitement éclaire la situation sans réduire la ligne éditoriale au format qui a obtenu le plus gros pic."],"action":["Conserver un public commun aux formats.","Étiqueter chaque post par intention."],"trap":"La diversité de formats peut compliquer l’attribution ; documentez ce qui a réellement changé.","quote":"Le compte chaotique a quand même une ligne.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le compte chaotique a quand même une ligne.","text":"Un Chaotic Account accepte plusieurs formats plutôt qu’un gabarit rigide.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Chaotic Account","text":"Un Chaotic Account accepte plusieurs formats plutôt qu’un gabarit rigide. Dans l’AGD, chaotique veut dire flexible, pas dépourvu de public ou de logique.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La diversité de formats peut compliquer l’attribution ; documentez ce qui a réellement changé.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Conserver un public commun aux formats.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Étiqueter chaque post par intention.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A chaotic account still has a point of view.","dek":"A Chaotic Account allows several formats rather than one rigid template.","point":"A Chaotic Account allows several formats rather than one rigid template. In AGD, chaotic means flexible, not devoid of audience or logic.","body":["A founder can post a screenshot, an anecdote and a demo without losing their voice. The connection is their view of work. Organize content by purpose: explain, entertain, expose friction. Otherwise the week’s strongest post becomes an excuse to chase every trend.","Imagine a week built around missed appointments: a meme, an anecdote and a practical demonstration. Formats change while the problem remains recognizable. Compare responses within that content family. You can learn which treatment clarifies the situation without reducing the entire editorial direction to the format producing the biggest spike. This preserves flexibility while providing a meaningful basis for the next creative decision."],"action":["Keep a common audience across formats.","Label each post by purpose."],"trap":"Format diversity can complicate attribution; document what actually changed.","quote":"A chaotic account still has a point of view.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A chaotic account still has a point of view.","text":"A Chaotic Account allows several formats rather than one rigid template.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Chaotic Account","text":"A Chaotic Account allows several formats rather than one rigid template. In AGD, chaotic means flexible, not devoid of audience or logic.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Format diversity can complicate attribution; document what actually changed.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep a common audience across formats.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Label each post by purpose.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"021","slug":"ai-persona","term":"AI Persona","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["persona-agd","chaotic-account","distribution-is-the-moat"],"fr":{"title":"Le personnage synthétique doit avoir quelque chose à dire.","dek":"Une AI Persona utilise largement l’IA pour son apparence, sa voix ou sa production.","point":"Une AI Persona utilise largement l’IA pour son apparence, sa voix ou sa production. Sa valeur éditoriale dépend encore de sa cohérence et de son utilité.","body":["Définissez une continuité : ce que le personnage sait, ignore, apprécie et ne prétend pas avoir vécu. Un narrateur fictif peut raconter une expérience illustrative, pas fournir un faux témoignage client. Les erreurs de voix ou de détails récurrents cassent l’identité plus sûrement qu’un rendu imparfait. Gardez une fiche de référence et identifiez la fiction.","Une fiche de continuité peut contenir un vocabulaire préféré, quelques positions éditoriales et les détails visuels constants. Ajoutez les domaines où le personnage ne donne pas d’avis d’expert. La stabilité facilite la production, mais la transparence protège la compréhension du lecteur. L’objectif est une fiction cohérente, pas une personne imaginaire présentée comme une cliente réelle."],"action":["Écrire les limites du personnage.","Relire chaque script pour repérer les expériences réelles inventées."],"trap":"Une apparence réaliste ne constitue pas une preuve d’expertise ou d’usage du produit.","quote":"Le personnage synthétique doit avoir quelque chose à dire.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le personnage synthétique doit avoir quelque chose à dire.","text":"Une AI Persona utilise largement l’IA pour son apparence, sa voix ou sa production.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"AI Persona","text":"Une AI Persona utilise largement l’IA pour son apparence, sa voix ou sa production. Sa valeur éditoriale dépend encore de sa cohérence et de son utilité.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une apparence réaliste ne constitue pas une preuve d’expertise ou d’usage du produit.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire les limites du personnage.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Relire chaque script pour repérer les expériences réelles inventées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A synthetic character needs something to say.","dek":"An AI Persona substantially uses AI for appearance, voice or production.","point":"An AI Persona substantially uses AI for appearance, voice or production. Its editorial value still depends on coherence and usefulness.","body":["Define continuity: what the character knows, does not know, likes and never claims to have experienced. A fictional narrator can tell an illustrative story, not provide a fake customer testimonial. Inconsistent voice or recurring details break identity faster than imperfect rendering. Keep a reference sheet and identify the fiction.","A continuity sheet can include preferred vocabulary, editorial positions and consistent visual details. Add subjects where the character does not offer expert judgment. Stability supports production while transparency supports reader understanding. The aim is coherent fiction, not an imaginary person presented as an actual customer. Review both image and script because a careful disclosure cannot repair contradictory claims inside the content itself."],"action":["Write the character’s boundaries.","Review scripts for invented real-world experiences."],"trap":"A realistic appearance is not evidence of expertise or product use.","quote":"A synthetic character needs something to say.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A synthetic character needs something to say.","text":"An AI Persona substantially uses AI for appearance, voice or production.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"AI Persona","text":"An AI Persona substantially uses AI for appearance, voice or production. Its editorial value still depends on coherence and usefulness.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A realistic appearance is not evidence of expertise or product use.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the character’s boundaries.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review scripts for invented real-world experiences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"022","slug":"persona-agd","term":"Persona AGD","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["slideshow-agd","ai-persona","distribution-is-the-moat"],"fr":{"title":"Même produit. Trois narrateurs. Trois bonnes raisons.","dek":"Persona AGD organise le réseau autour de personnages éditoriaux distincts plutôt qu’autour de comptes de marque génériques..","point":"Persona AGD organise le réseau autour de personnages éditoriaux distincts plutôt qu’autour de comptes de marque génériques.","body":["Pour un outil de calendrier, imaginez des perspectives identifiées comme fictionnelles : la freelance qui jongle, l’étudiant qui révise, le parent qui coordonne. Chacune rencontre un problème spécifique. La différence doit apparaître dans le scénario, pas seulement dans l’âge affiché. On évalue ensuite si les publics et leurs questions se distinguent vraiment.","Créez une grille de scénarios, puis cherchez les doublons. Si les trois narrateurs rencontrent toujours la même situation avec les mêmes mots, les biographies ne font aucun travail. Réécrivez à partir des contraintes de chacun. Une différence crédible de contexte est plus utile qu’un catalogue de traits psychologiques inventés pour remplir le brief."],"action":["Associer chaque persona à une friction précise.","Éviter qu’ils répètent tous le même argumentaire."],"trap":"Trois personnages ne prouvent pas que vous avez atteint trois audiences différentes.","quote":"Même produit. Trois narrateurs. Trois bonnes raisons.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Même produit. Trois narrateurs. Trois bonnes raisons.","text":"Persona AGD organise le réseau autour de personnages éditoriaux distincts plutôt qu’autour de comptes de marque génériques..","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Persona AGD","text":"Persona AGD organise le réseau autour de personnages éditoriaux distincts plutôt qu’autour de comptes de marque génériques.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Trois personnages ne prouvent pas que vous avez atteint trois audiences différentes.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Associer chaque persona à une friction précise.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Éviter qu’ils répètent tous le même argumentaire.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"One product. Three narrators. Three reasons.","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts..","point":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.","body":["For a calendar tool, consider clearly fictional perspectives: a juggling freelancer, a revising student, a coordinating parent. Each encounters a specific problem. The difference must appear in the scenario, not merely a displayed age. Then examine whether audiences and their questions actually differ.","Build a scenario grid and look for duplicates. If all three narrators always encounter the same situation in the same words, their biographies are doing no work. Rewrite from each character’s constraints. A credible difference in context is more useful than a catalog of psychological traits invented to fill a brief. Evaluate the published content against those constraints rather than the personas’ decorative descriptions."],"action":["Connect each persona to a specific friction.","Avoid having them repeat the same sales script."],"trap":"Three characters do not prove you reached three different audiences.","quote":"One product. Three narrators. Three reasons.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"One product. Three narrators. Three reasons.","text":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts..","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Persona AGD","text":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Three characters do not prove you reached three different audiences.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect each persona to a specific friction.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Avoid having them repeat the same sales script.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"023","slug":"slideshow-agd","term":"Slideshow AGD","category":"creative","kind":"guide","image":"signal","tier":"canonical","evidence":"editorial","sources":[],"related":["story-slideshow","persona-agd","distribution-is-the-moat"],"fr":{"title":"Le carrousel est une histoire, pas un PDF découpé.","dek":"Slideshow AGD utilise des comptes qui publient des carrousels ou diaporamas natifs.","point":"Slideshow AGD utilise des comptes qui publient des carrousels ou diaporamas natifs. Une bonne séquence crée une progression, avec une raison claire de passer à l’écran suivant.","body":["Écrivez d’abord les articulations : situation, complication, découverte, application. Une slide peut porter une seule idée sans devenir vide. Si chaque écran répète la promesse du premier, le lecteur avance sans apprendre. Faites lire la séquence hors design pour vérifier que la progression existe avant de polir la typographie.","Une séquence pédagogique peut commencer par un mauvais résultat, montrer la cause puis proposer une correction. Les images doivent aider à voir la différence, pas seulement occuper l’écran. Sur chaque slide, vérifiez taille du texte, contraste et charge visuelle. Un carrousel conçu pour le mobile doit rester lisible sans demander au lecteur de zoomer partout."],"action":["Donner un rôle à chaque slide.","Garder une conclusion utilisable sans cliquer ailleurs."],"trap":"Davantage de slides n’équivaut pas à davantage de valeur ni à une meilleure distribution.","quote":"Le carrousel est une histoire, pas un PDF découpé.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le carrousel est une histoire, pas un PDF découpé.","text":"Slideshow AGD utilise des comptes qui publient des carrousels ou diaporamas natifs.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Slideshow AGD","text":"Slideshow AGD utilise des comptes qui publient des carrousels ou diaporamas natifs. Une bonne séquence crée une progression, avec une raison claire de passer à l’écran suivant.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Davantage de slides n’équivaut pas à davantage de valeur ni à une meilleure distribution.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Donner un rôle à chaque slide.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Garder une conclusion utilisable sans cliquer ailleurs.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A slideshow is a story, not a sliced PDF.","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows.","point":"Slideshow AGD uses accounts publishing native carousels or slideshows. A useful sequence progresses, giving a clear reason to reach the next screen.","body":["Write the transitions first: situation, complication, discovery, application. A slide can hold one idea without becoming empty. If every screen repeats the first screen’s promise, readers move without learning. Read the sequence without design to check progression before polishing typography.","An educational sequence can start with a poor result, show its cause and offer a correction. Images should help viewers see the difference rather than merely occupy space. Check text size, contrast and visual load on every slide. A mobile slideshow should remain readable without constant zooming. Its narrative structure and physical legibility work together; neither compensates for the absence of the other."],"action":["Give each slide a purpose.","Keep a conclusion useful without another click."],"trap":"More slides do not mean more value or better distribution.","quote":"A slideshow is a story, not a sliced PDF.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A slideshow is a story, not a sliced PDF.","text":"Slideshow AGD uses accounts publishing native carousels or slideshows.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Slideshow AGD","text":"Slideshow AGD uses accounts publishing native carousels or slideshows. A useful sequence progresses, giving a clear reason to reach the next screen.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"More slides do not mean more value or better distribution.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Give each slide a purpose.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep a conclusion useful without another click.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"024","slug":"story-slideshow","term":"Story Slideshow","category":"creative","kind":"essay","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["educational-slideshow","slideshow-agd","distribution-is-the-moat"],"fr":{"title":"Une petite tension vaut quinze slides de conseils.","dek":"Le Story Slideshow organise une séquence autour d’une situation et de sa résolution.","point":"Le Story Slideshow organise une séquence autour d’une situation et de sa résolution. Son intérêt est narratif ; il ne dépend pas d’un nombre magique de slides.","body":["Ouvrez sur un choix concret : sauvegarder ses notes ou improviser devant le client. Montrez ce qui complique ce choix, puis ce qui le débloque. Le produit peut apparaître au moment où il devient utile. Retirez-le du brouillon : si toute la scène s’effondre, vous avez peut-être écrit une publicité sans histoire.","Écrivez deux fins possibles avant de produire : l’une montre ce que la personne a appris, l’autre pousse immédiatement vers l’achat. Si la première raconte mieux votre sujet, gardez-la. Un CTA peut venir après sans voler la résolution. Le lecteur doit pouvoir distinguer le bénéfice du récit et l’action commerciale proposée ensuite."],"action":["Écrire le conflit en une ligne.","Montrer la résolution plutôt que l’annoncer."],"trap":"N’inventez pas de résultat client pour rendre la chute plus convaincante.","quote":"Une petite tension vaut quinze slides de conseils.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une petite tension vaut quinze slides de conseils.","text":"Le Story Slideshow organise une séquence autour d’une situation et de sa résolution.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Story Slideshow","text":"Le Story Slideshow organise une séquence autour d’une situation et de sa résolution. Son intérêt est narratif ; il ne dépend pas d’un nombre magique de slides.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"N’inventez pas de résultat client pour rendre la chute plus convaincante.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire le conflit en une ligne.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Montrer la résolution plutôt que l’annoncer.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A little tension beats fifteen advice slides.","dek":"A Story Slideshow organizes a sequence around a situation and its resolution.","point":"A Story Slideshow organizes a sequence around a situation and its resolution. Its value is narrative; it does not depend on a magic slide count.","body":["Open with a concrete choice: recover your notes or improvise in front of a client. Show what complicates the choice and what resolves it. A product can enter when it becomes useful. Remove it from the draft: if the entire scene collapses, you may have written an ad without a story.","Write two endings before production: one shows what the person learned, another immediately pushes a purchase. If the first better serves the subject, keep it. A CTA can follow without stealing the resolution. Readers should distinguish the story’s value from the commercial next step. This also makes it possible to test that next step without rebuilding the entire narrative each time."],"action":["Write the conflict in one line.","Show the resolution instead of announcing it."],"trap":"Do not invent a customer outcome to make the ending more convincing.","quote":"A little tension beats fifteen advice slides.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A little tension beats fifteen advice slides.","text":"A Story Slideshow organizes a sequence around a situation and its resolution.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Story Slideshow","text":"A Story Slideshow organizes a sequence around a situation and its resolution. Its value is narrative; it does not depend on a magic slide count.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Do not invent a customer outcome to make the ending more convincing.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the conflict in one line.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show the resolution instead of announcing it.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"025","slug":"educational-slideshow","term":"Educational Slideshow","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["meme-slideshow","story-slideshow","distribution-is-the-moat"],"fr":{"title":"Apprendre quelque chose avant la dernière slide.","dek":"Un carrousel pédagogique transmet une connaissance applicable pendant la lecture.","point":"Un carrousel pédagogique transmet une connaissance applicable pendant la lecture. La promesse ne doit pas être entièrement repoussée vers une page de vente.","body":["Prenez une question étroite : comment distinguer une médiane d’une moyenne ? Un petit exemple chiffré explicitement illustratif suffit. Montrez le calcul et la décision qu’il change. Le dernier écran peut proposer une ressource complémentaire, mais les écrans précédents doivent déjà résoudre la question initiale.","Pour expliquer une moyenne trompeuse, montrez quelques valeurs fictives puis placez le gros résultat à côté. Le lecteur peut refaire le calcul et voir pourquoi la conclusion change. Cette vérifiabilité rend la séquence plus solide qu’un chiffre impressionnant présenté seul. Elle crée aussi une bonne transition vers une note plus longue pour qui veut approfondir."],"action":["Choisir une question vérifiable.","Ajouter un exemple et une limite."],"trap":"Une définition sans application laisse souvent au lecteur tout le travail utile.","quote":"Apprendre quelque chose avant la dernière slide.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Apprendre quelque chose avant la dernière slide.","text":"Un carrousel pédagogique transmet une connaissance applicable pendant la lecture.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Educational Slideshow","text":"Un carrousel pédagogique transmet une connaissance applicable pendant la lecture. La promesse ne doit pas être entièrement repoussée vers une page de vente.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une définition sans application laisse souvent au lecteur tout le travail utile.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Choisir une question vérifiable.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Ajouter un exemple et une limite.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Teach something before the final slide.","dek":"An educational slideshow communicates usable knowledge during reading.","point":"An educational slideshow communicates usable knowledge during reading. Its entire promise should not be deferred to a sales page.","body":["Take a narrow question: how do median and mean differ? A small, explicitly illustrative numerical example is enough. Show the calculation and the decision it changes. The last screen can suggest further reading, but earlier screens should already answer the original question.","To explain a misleading average, show a few fictional values and place the large outcome beside them. Readers can repeat the calculation and see why the conclusion changes. This verifiability makes the sequence stronger than an impressive number standing alone. It also creates a useful transition to a longer note for readers wanting more detail, while leaving the original slideshow complete on its own."],"action":["Choose an answerable question.","Include an example and a limitation."],"trap":"A definition without application often leaves all useful work to the reader.","quote":"Teach something before the final slide.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Teach something before the final slide.","text":"An educational slideshow communicates usable knowledge during reading.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Educational Slideshow","text":"An educational slideshow communicates usable knowledge during reading. Its entire promise should not be deferred to a sales page.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A definition without application often leaves all useful work to the reader.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose an answerable question.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Include an example and a limitation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"026","slug":"meme-slideshow","term":"Meme Slideshow","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["product-discovery","educational-slideshow","distribution-is-the-moat"],"fr":{"title":"La blague doit marcher sans le logo.","dek":"Un Meme Slideshow construit sa séquence autour d’une observation culturelle ou d’une chute.","point":"Un Meme Slideshow construit sa séquence autour d’une observation culturelle ou d’une chute. Le produit peut y trouver sa place, mais ne remplace pas le mécanisme comique.","body":["La bonne matière est souvent une friction que votre public reconnaît immédiatement. Trois réunions pour décider d’en annuler une, par exemple. Faites lire le texte à une personne du public cible. Demandez ce qu’elle a reconnu, pas si elle trouve ça sympa. Le signal qualitatif aide à distinguer connivence et politesse.","La chute peut viser une habitude plutôt qu’une personne. Un comportement collectif reconnaissable donne de la matière sans inventer de propos attribués à un client. Si vous utilisez une situation fictive, gardez ce statut clair. La précision comique tient souvent dans un détail juste, pas dans une affirmation spectaculaire sur le nombre de personnes qui vivent la scène."],"action":["Partir d’une observation précise.","Vérifier les droits sur les images reprises."],"trap":"Le succès d’une blague ne valide pas automatiquement le positionnement du produit.","quote":"La blague doit marcher sans le logo.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La blague doit marcher sans le logo.","text":"Un Meme Slideshow construit sa séquence autour d’une observation culturelle ou d’une chute.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Meme Slideshow","text":"Un Meme Slideshow construit sa séquence autour d’une observation culturelle ou d’une chute. Le produit peut y trouver sa place, mais ne remplace pas le mécanisme comique.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le succès d’une blague ne valide pas automatiquement le positionnement du produit.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Partir d’une observation précise.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Vérifier les droits sur les images reprises.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"The joke should work without the logo.","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline.","point":"A Meme Slideshow builds its sequence around a cultural observation or punchline. A product can fit inside it, but cannot replace the comic mechanism.","body":["Useful material often comes from a friction your audience instantly recognizes. Three meetings to decide to cancel one, for example. Show the text to someone in the intended audience. Ask what they recognized, not whether they liked it. Qualitative feedback helps separate resonance from politeness.","The punchline can target a habit rather than a person. A recognizable shared behavior provides material without inventing customer quotes. Keep a fictional situation’s status clear. Comic precision often comes from one convincing detail rather than a spectacular claim about how many people experience the scene. That leaves space for humor while preserving the distinction between an observation, an illustration and actual research."],"action":["Start with a specific observation.","Check rights to reused images."],"trap":"A successful joke does not automatically validate product positioning.","quote":"The joke should work without the logo.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The joke should work without the logo.","text":"A Meme Slideshow builds its sequence around a cultural observation or punchline.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Meme Slideshow","text":"A Meme Slideshow builds its sequence around a cultural observation or punchline. A product can fit inside it, but cannot replace the comic mechanism.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful joke does not automatically validate product positioning.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Start with a specific observation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check rights to reused images.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"027","slug":"product-discovery","term":"Product Discovery","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["brainrotization","meme-slideshow","distribution-is-the-moat"],"fr":{"title":"Le produit entre en scène quand il sert à quelque chose.","dek":"Un contenu de découverte produit présente un outil à l’intérieur d’un usage intelligible.","point":"Un contenu de découverte produit présente un outil à l’intérieur d’un usage intelligible. L’approche éditoriale ne dispense pas de rendre visible une relation commerciale pertinente.","body":["Montrez la tâche avant l’interface. Pour un outil vidéo, le sujet peut être un montage à adapter à trois formats. Expliquez ce qui reste manuel, ce qui se simplifie et où le résultat échoue. Une démo qui conserve les limites aide davantage le lecteur qu’une suite de fonctionnalités sans contexte.","Un outil complémentaire peut apparaître si le workflow l’exige. Par exemple, une feuille Google Sheets peut organiser les idées avant leur production. Présentez son rôle exact et les informations qui passent à l’étape suivante. Une liste de logos n’explique rien ; une transition bien décrite permet au lecteur de refaire le travail avec ses propres moyens."],"action":["Décrire le travail à accomplir.","Montrer une limite réelle de la solution."],"trap":"Une mention discrète ne doit pas dissimuler qui bénéficie commercialement du contenu.","quote":"Le produit entre en scène quand il sert à quelque chose.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le produit entre en scène quand il sert à quelque chose.","text":"Un contenu de découverte produit présente un outil à l’intérieur d’un usage intelligible.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Product Discovery","text":"Un contenu de découverte produit présente un outil à l’intérieur d’un usage intelligible. L’approche éditoriale ne dispense pas de rendre visible une relation commerciale pertinente.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une mention discrète ne doit pas dissimuler qui bénéficie commercialement du contenu.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Décrire le travail à accomplir.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Montrer une limite réelle de la solution.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"The product enters when it becomes useful.","dek":"Product discovery content introduces a tool inside an understandable use case.","point":"Product discovery content introduces a tool inside an understandable use case. An editorial approach does not remove the need to disclose a relevant commercial relationship.","body":["Show the task before the interface. For a video tool, the subject might be adapting an edit to three formats. Explain what stays manual, what gets easier and where results fail. A demo retaining limitations helps readers more than a context-free feature list.","A complementary tool can appear when the workflow needs it. Google Sheets, for example, can organize ideas before production. Explain its exact role and what information moves to the next step. A logo list explains little; a clearly described transition lets readers repeat the work using their own setup. This gives adjacent products a reason to appear beyond lending credibility to a promotional collection."],"action":["Describe the job to be done.","Show a real limitation of the solution."],"trap":"A subtle mention should not conceal who benefits commercially from the content.","quote":"The product enters when it becomes useful.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The product enters when it becomes useful.","text":"Product discovery content introduces a tool inside an understandable use case.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Product Discovery","text":"Product discovery content introduces a tool inside an understandable use case. An editorial approach does not remove the need to disclose a relevant commercial relationship.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A subtle mention should not conceal who benefits commercially from the content.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe the job to be done.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show a real limitation of the solution.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"028","slug":"brainrotization","term":"Brainrotization","category":"creative","kind":"essay","image":"signal","tier":"editorial","evidence":"editorial","sources":[],"related":["creative-brief","product-discovery","distribution-is-the-moat"],"fr":{"title":"Le marketing a attrapé le brainrot. Et après ?","dek":"Brainrotization est un mot de notre registre culturel pour les formats rapides, absurdes et compressés des feeds.","point":"Brainrotization est un mot de notre registre culturel pour les formats rapides, absurdes et compressés des feeds. Il ne décrit ni une pathologie ni une mesure cognitive.","body":["L’absurde peut créer un langage commun, mais il peut aussi effacer le sujet. Demandez ce qui reste après la blague : une idée, un problème reconnu, un souvenir utile ? Un montage frénétique n’a pas à être condamné par principe. Il doit simplement répondre au même test de cohérence que la vidéo la plus sobre.","Un contenu absurde peut rester précis sur son statut : sketch, métaphore ou exemple inventé. Ce cadre évite qu’une blague se transforme en preuve commerciale dans une capture sortie de son contexte. Travaillez la chute et la lisibilité ensemble. Le public peut apprécier une forme chaotique sans avoir envie de décoder une démonstration incompréhensible."],"action":["Résumer le message sans décrire les effets.","Tester la compréhension auprès du public visé."],"trap":"Un terme culturel provocateur ne justifie pas des affirmations sur la santé ou l’attention du public.","quote":"Le marketing a attrapé le brainrot. Et après ?","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le marketing a attrapé le brainrot. Et après ?","text":"Brainrotization est un mot de notre registre culturel pour les formats rapides, absurdes et compressés des feeds.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Brainrotization","text":"Brainrotization est un mot de notre registre culturel pour les formats rapides, absurdes et compressés des feeds. Il ne décrit ni une pathologie ni une mesure cognitive.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un terme culturel provocateur ne justifie pas des affirmations sur la santé ou l’attention du public.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Résumer le message sans décrire les effets.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Tester la compréhension auprès du public visé.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Marketing caught brainrot. What next?","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats.","point":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats. It describes neither a medical condition nor a cognitive measurement.","body":["Absurdity can create a shared language, but it can also erase the subject. Ask what remains after the joke: an idea, a recognized problem, a useful memory? Frenetic editing need not be condemned by default. It should pass the same coherence test as the quietest video.","Absurd content can still identify its status: sketch, metaphor or invented example. That framing prevents a joke from becoming commercial evidence in an out-of-context screenshot. Work on the punchline and legibility together. Audiences can enjoy chaotic form without wanting to decode an incomprehensible demonstration. The useful question is whether the chosen absurdity sharpens the point or merely delays its arrival."],"action":["Summarize the message without describing effects.","Test understanding with the intended audience."],"trap":"Provocative cultural language does not justify claims about audience health or attention.","quote":"Marketing caught brainrot. What next?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Marketing caught brainrot. What next?","text":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Brainrotization","text":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats. It describes neither a medical condition nor a cognitive measurement.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Provocative cultural language does not justify claims about audience health or attention.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Summarize the message without describing effects.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Test understanding with the intended audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"029","slug":"creative-brief","term":"Creative Brief","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["hook-payoff","brainrotization","distribution-is-the-moat"],"fr":{"title":"Un bon brief commence par ce qu’on veut apprendre.","dek":"Un brief créatif AGD relie public, promesse, format et hypothèse.","point":"Un brief créatif AGD relie public, promesse, format et hypothèse. Il donne au créateur une direction et à l’analyste une question interprétable.","body":["Remplacez « faire une vidéo virale » par « vérifier si cette friction parle aux étudiants en révision ». Donnez les éléments obligatoires, les libertés et les interdits. Une bonne contrainte explique son rôle : le premier écran doit rendre la situation visible, pas simplement contenir un mot-clé.","Ajoutez au brief la phrase que le lecteur devrait pouvoir répéter après visionnage. Ce n’est pas un slogan obligatoire, mais un contrôle de compréhension. Si l’équipe créative propose une meilleure manière de transmettre cette idée, le brief doit la permettre. Le document fixe l’objectif du travail sans confondre l’objectif et la première solution imaginée."],"action":["Écrire la question d’apprentissage.","Définir ce qui reste libre pour le créateur."],"trap":"Un brief trop prescriptif peut éliminer la variation que le test était censé explorer.","quote":"Un bon brief commence par ce qu’on veut apprendre.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un bon brief commence par ce qu’on veut apprendre.","text":"Un brief créatif AGD relie public, promesse, format et hypothèse.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Creative Brief","text":"Un brief créatif AGD relie public, promesse, format et hypothèse. Il donne au créateur une direction et à l’analyste une question interprétable.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un brief trop prescriptif peut éliminer la variation que le test était censé explorer.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire la question d’apprentissage.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Définir ce qui reste libre pour le créateur.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A good brief starts with what we want to learn.","dek":"An AGD creative brief connects audience, promise, format and hypothesis.","point":"An AGD creative brief connects audience, promise, format and hypothesis. It gives a creator direction and an analyst an interpretable question.","body":["Replace “make a viral video” with “test whether this friction resonates with students revising.” List requirements, freedoms and boundaries. A useful constraint explains its role: the first screen should make the situation visible, not merely contain a keyword.","Add the sentence a viewer should be able to repeat afterward. It is not a mandatory slogan but a comprehension check. If the creative team proposes a better way to convey the idea, the brief should allow it. The document sets the job’s objective without confusing that objective with the first imagined solution. This distinction keeps constraints useful while preserving the creator’s judgment."],"action":["Write the learning question.","Define what the creator can choose freely."],"trap":"An overly prescriptive brief can eliminate the variation the test was meant to explore.","quote":"A good brief starts with what we want to learn.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A good brief starts with what we want to learn.","text":"An AGD creative brief connects audience, promise, format and hypothesis.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Creative Brief","text":"An AGD creative brief connects audience, promise, format and hypothesis. It gives a creator direction and an analyst an interpretable question.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An overly prescriptive brief can eliminate the variation the test was meant to explore.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the learning question.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define what the creator can choose freely.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"030","slug":"hook-payoff","term":"Hook & payoff","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["creative-library","creative-brief","distribution-is-the-moat"],"fr":{"title":"La promesse du hook doit être remboursée.","dek":"Le payoff est la réponse narrative ou pratique à la promesse initiale.","point":"Le payoff est la réponse narrative ou pratique à la promesse initiale. Son alignement avec l’accroche se vérifie dans le contenu, pas seulement dans une courbe de rétention.","body":["Si l’ouverture annonce une erreur coûteuse, montrez l’erreur et comment l’éviter. Une révélation vague sur la dernière seconde ne rembourse pas la promesse. Relisez la séquence comme un contrat : qu’a accepté le spectateur en restant ? Ce contrôle peut supprimer une accroche performante mais trompeuse.","Un audit simple consiste à montrer seulement le début à une personne et lui demander ce qu’elle attend. Montrez ensuite la fin. L’écart entre attente et réponse aide à repérer les promesses involontaires. Ce retour n’est pas une mesure représentative de votre marché, mais il peut révéler une incohérence avant d’engager une production complète."],"action":["Écrire promesse et résolution côte à côte.","Vérifier que la résolution est montrée clairement."],"trap":"Garder une audience jusqu’au bout par confusion n’est pas la même chose que lui apporter de la valeur.","quote":"La promesse du hook doit être remboursée.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La promesse du hook doit être remboursée.","text":"Le payoff est la réponse narrative ou pratique à la promesse initiale.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Hook & payoff","text":"Le payoff est la réponse narrative ou pratique à la promesse initiale. Son alignement avec l’accroche se vérifie dans le contenu, pas seulement dans une courbe de rétention.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Garder une audience jusqu’au bout par confusion n’est pas la même chose que lui apporter de la valeur.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire promesse et résolution côte à côte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Vérifier que la résolution est montrée clairement.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"The hook’s promise must be paid back.","dek":"The payoff is the narrative or practical answer to the opening promise.","point":"The payoff is the narrative or practical answer to the opening promise. Its alignment with the hook is checked in the content, not only in a retention curve.","body":["If the opening promises an expensive mistake, show the mistake and how to avoid it. A vague revelation in the final second does not repay the promise. Read the sequence as a contract: what did the viewer agree to by staying? This check may remove a strong but misleading opening.","A simple audit shows only the beginning and asks what a person expects. Then reveal the ending. The gap between expectation and answer helps expose unintended promises. This feedback is not a representative measurement of your market, but it can uncover incoherence before full production. Keep the observed confusion in the brief so the next revision addresses a concrete problem rather than somebody’s vague preference."],"action":["Write promise and resolution side by side.","Check that the resolution is clearly shown."],"trap":"Keeping an audience through confusion is not the same as delivering value.","quote":"The hook’s promise must be paid back.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The hook’s promise must be paid back.","text":"The payoff is the narrative or practical answer to the opening promise.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Hook & payoff","text":"The payoff is the narrative or practical answer to the opening promise. Its alignment with the hook is checked in the content, not only in a retention curve.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Keeping an audience through confusion is not the same as delivering value.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write promise and resolution side by side.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check that the resolution is clearly shown.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"031","slug":"creative-library","term":"Creative Library","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["format-fatigue","hook-payoff","distribution-is-the-moat"],"fr":{"title":"Votre bibliothèque créative n’est pas un dossier final_final.","dek":"Une bibliothèque créative organise les concepts, versions, droits et résultats.","point":"Une bibliothèque créative organise les concepts, versions, droits et résultats. Elle permet de retrouver une idée et les conditions de son test sans dépendre de la mémoire de l’équipe.","body":["Donnez un identifiant au concept, puis aux versions. Conservez le brief, la source des images, les marchés prévus et les publications associées. Le nom du fichier ne suffit pas à raconter ce qui a changé. Une version gagnante sans son contexte devient vite un template copié à mauvais escient.","Ajoutez une courte note après chaque test : ce qui a été publié, la différence entre versions et les limites de lecture. Évitez de renommer tous les fichiers « winner ». Un contenu peut gagner sur les vues et perdre sur la compréhension produit. Des annotations précises rendent l’archive exploitable par une nouvelle personne ou un agent."],"action":["Relier chaque asset à son concept.","Conserver les licences et les versions publiées."],"trap":"Un asset disponible dans le drive n’est pas automatiquement autorisé pour tous les comptes ou marchés.","quote":"Votre bibliothèque créative n’est pas un dossier final_final.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Votre bibliothèque créative n’est pas un dossier final_final.","text":"Une bibliothèque créative organise les concepts, versions, droits et résultats.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Creative Library","text":"Une bibliothèque créative organise les concepts, versions, droits et résultats. Elle permet de retrouver une idée et les conditions de son test sans dépendre de la mémoire de l’équipe.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un asset disponible dans le drive n’est pas automatiquement autorisé pour tous les comptes ou marchés.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Relier chaque asset à son concept.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Conserver les licences et les versions publiées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Your creative library is not a final_final folder.","dek":"A creative library organizes concepts, versions, rights and results.","point":"A creative library organizes concepts, versions, rights and results. It lets a team recover an idea and its test conditions without relying on memory.","body":["Give the concept an identifier, then identify its versions. Keep the brief, image sources, intended markets and associated posts. A filename cannot explain what changed. A winning version without context quickly becomes a template copied for the wrong reasons.","Add a short note after every test: what was published, how versions differed and the limits of interpretation. Avoid renaming every strong file “winner.” Content can win on views and lose on product understanding. Precise annotations make an archive usable by a new colleague or agent without requiring them to reconstruct the campaign from scattered messages and the memory of its original owner."],"action":["Connect each asset to its concept.","Keep licenses and published versions."],"trap":"An asset in a shared drive is not automatically licensed for every account or market.","quote":"Your creative library is not a final_final folder.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your creative library is not a final_final folder.","text":"A creative library organizes concepts, versions, rights and results.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Creative Library","text":"A creative library organizes concepts, versions, rights and results. It lets a team recover an idea and its test conditions without relying on memory.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An asset in a shared drive is not automatically licensed for every account or market.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect each asset to its concept.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep licenses and published versions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"032","slug":"format-fatigue","term":"Format fatigue","category":"creative","kind":"essay","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["creative-matrix","creative-library","distribution-is-the-moat"],"fr":{"title":"Le format marche. Jusqu’au jour où il se répète.","dek":"La fatigue de format est une hypothèse sur une réponse qui s’affaiblit à force de répétition.","point":"La fatigue de format est une hypothèse sur une réponse qui s’affaiblit à force de répétition. Pour l’étudier, il faut distinguer répétition, sujets moins forts et changements de public.","body":["Ne jetez pas une série après deux épisodes faibles. Comparez les thèmes, la promesse et la maturité des observations. Testez une variation de structure qui garde le même problème à résoudre. Si la baisse concerne tous les formats en même temps, chercher une explication uniquement créative peut masquer autre chose.","Séparez les nouveaux lecteurs des habitués quand les données le permettent. Un format peut sembler répétitif à l’équipe tout en restant inédit pour une grande partie du public. L’inverse existe aussi : les créateurs aiment encore leur série alors que les réactions signalent une lassitude. La décision doit s’appuyer sur le contexte observable, pas sur le seul enthousiasme interne."],"action":["Comparer les épisodes à durée d’observation égale.","Tester une variation avant d’abandonner la série."],"trap":"Une baisse ne prouve pas que le public est lassé ; la cause peut rester inconnue.","quote":"Le format marche. Jusqu’au jour où il se répète.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le format marche. Jusqu’au jour où il se répète.","text":"La fatigue de format est une hypothèse sur une réponse qui s’affaiblit à force de répétition.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Format fatigue","text":"La fatigue de format est une hypothèse sur une réponse qui s’affaiblit à force de répétition. Pour l’étudier, il faut distinguer répétition, sujets moins forts et changements de public.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une baisse ne prouve pas que le public est lassé ; la cause peut rester inconnue.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Comparer les épisodes à durée d’observation égale.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Tester une variation avant d’abandonner la série.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"The format works. Until it just repeats.","dek":"Format fatigue is a hypothesis about weakening response after repetition.","point":"Format fatigue is a hypothesis about weakening response after repetition. Studying it requires separating repetition from weaker topics and audience changes.","body":["Do not abandon a series after two weak episodes. Compare topics, promises and observation maturity. Test a structural variation addressing the same problem. If every format declines together, looking only for a creative explanation may hide another cause.","Separate new viewers from returning audiences when data allows. A format can feel repetitive to the team while remaining new to much of the audience. The reverse can also happen: creators still enjoy a series while responses suggest fatigue. Ground the decision in observable context rather than internal enthusiasm alone. Where those audience distinctions cannot be measured, state the uncertainty instead of filling it with assumptions."],"action":["Compare episodes at equal observation ages.","Test a variation before abandoning the series."],"trap":"A decline does not prove audience fatigue; the cause may remain unknown.","quote":"The format works. Until it just repeats.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The format works. Until it just repeats.","text":"Format fatigue is a hypothesis about weakening response after repetition.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Format fatigue","text":"Format fatigue is a hypothesis about weakening response after repetition. Studying it requires separating repetition from weaker topics and audience changes.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A decline does not prove audience fatigue; the cause may remain unknown.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Compare episodes at equal observation ages.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Test a variation before abandoning the series.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"033","slug":"creative-matrix","term":"Creative Matrix","category":"creative","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["account-persona","format-fatigue","distribution-is-the-moat"],"fr":{"title":"La matrice qui empêche cinquante copies de naître.","dek":"Une matrice créative croise des dimensions de variation : public, problème, angle, format.","point":"Une matrice créative croise des dimensions de variation : public, problème, angle, format. Elle sert à choisir des expériences, pas à remplir mécaniquement toutes les cases.","body":["Commencez par quelques combinaisons crédibles. Un même problème peut mériter une démo et un récit, sans exiger un meme. Notez pourquoi chaque combinaison pourrait fonctionner. Les cases vides sont utiles : elles révèlent parfois une absence d’idée plutôt qu’un manque de production.","Une case intéressante doit pouvoir se transformer en brief. Écrivez la situation d’ouverture, la différence apportée et la question à mesurer. Si aucune de ces phrases ne vient, laissez la case vide. La matrice est un outil de sélection : son intérêt peut justement être de réduire le nombre de productions qui n’ont pas encore de sujet."],"action":["Croiser trois publics avec trois angles pertinents.","Écarter les combinaisons sans raison éditoriale."],"trap":"Un tableau rempli n’est pas une preuve de diversité si les scénarios racontent tous la même chose.","quote":"La matrice qui empêche cinquante copies de naître.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La matrice qui empêche cinquante copies de naître.","text":"Une matrice créative croise des dimensions de variation : public, problème, angle, format.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Creative Matrix","text":"Une matrice créative croise des dimensions de variation : public, problème, angle, format. Elle sert à choisir des expériences, pas à remplir mécaniquement toutes les cases.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un tableau rempli n’est pas une preuve de diversité si les scénarios racontent tous la même chose.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Croiser trois publics avec trois angles pertinents.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Écarter les combinaisons sans raison éditoriale.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"The matrix that stops fifty copies from being born.","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format.","point":"A creative matrix crosses variation dimensions: audience, problem, angle and format. It helps select experiments rather than mechanically filling every cell.","body":["Start with a few credible combinations. One problem may deserve a demo and a narrative without needing a meme. Record why each combination could work. Empty cells are useful: sometimes they reveal a missing idea rather than insufficient output.","An interesting cell should become a brief. Write the opening situation, the difference offered and the question to measure. If none of those sentences comes easily, leave the cell empty. The matrix is a selection tool: its value may be reducing productions that do not yet have a subject. A small set of explainable experiments is easier to learn from than an exhaustive but arbitrary catalog."],"action":["Cross three audiences with three relevant angles.","Reject combinations without an editorial reason."],"trap":"A full table is not proof of diversity if every scenario says the same thing.","quote":"The matrix that stops fifty copies from being born.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The matrix that stops fifty copies from being born.","text":"A creative matrix crosses variation dimensions: audience, problem, angle and format.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Creative Matrix","text":"A creative matrix crosses variation dimensions: audience, problem, angle and format. It helps select experiments rather than mechanically filling every cell.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A full table is not proof of diversity if every scenario says the same thing.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Cross three audiences with three relevant angles.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Reject combinations without an editorial reason.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"034","slug":"niche-warming","term":"Niche Warming","category":"field-notes","kind":"guide","image":"current","tier":"canonical","evidence":"editorial","sources":[],"related":["native-posting","budget-of-learning","distribution-is-the-moat"],"fr":{"title":"Réchauffer un compte sans invoquer la magie.","dek":"Niche Warming consiste à explorer des contenus de niche dans l’application, avec des recherches, des vues et des interactions authentiques.","point":"Niche Warming consiste à explorer des contenus de niche dans l’application, avec des recherches, des vues et des interactions authentiques. Son effet précis sur la portée reste une hypothèse à tester.","body":["La préparation peut servir à comprendre les codes d’un public autant qu’à contextualiser un compte. Notez les sujets, créateurs et recommandations rencontrés. Une checklist de gestes mécaniques ne prouve pas qu’un contexte pertinent s’est construit. Comparez ensuite des comptes comparables et gardez les observations qui contredisent votre intuition.","Un carnet de préparation peut noter les expressions que les créateurs emploient, les questions des commentaires et les formats devenus banals. Ces observations nourrissent un brief concret. Distinguez-les du résultat du compte : apprendre le langage d’une niche est un bénéfice de recherche plausible, même quand aucune amélioration de portée n’est démontrée."],"action":["Définir la niche et ses requêtes.","Documenter les observations sans inventer une recette de portée."],"trap":"Aucune durée magique ni nombre universel d’interactions n’est établi ici.","quote":"Réchauffer un compte sans invoquer la magie.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Réchauffer un compte sans invoquer la magie.","text":"Niche Warming consiste à explorer des contenus de niche dans l’application, avec des recherches, des vues et des interactions authentiques.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Niche Warming","text":"Niche Warming consiste à explorer des contenus de niche dans l’application, avec des recherches, des vues et des interactions authentiques. Son effet précis sur la portée reste une hypothèse à tester.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Aucune durée magique ni nombre universel d’interactions n’est établi ici.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir la niche et ses requêtes.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Documenter les observations sans inventer une recette de portée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Warm an account without invoking magic.","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions.","point":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions. Its precise effect on reach remains a testable hypothesis.","body":["Preparation can help understand an audience’s codes as well as contextualize an account. Record topics, creators and recommendations encountered. A checklist of mechanical gestures does not prove relevant context formed. Compare comparable accounts afterward and retain observations contradicting your intuition.","A preparation notebook can record creator vocabulary, recurring comment questions and formats that have become ordinary. Those observations feed a concrete brief. Keep them separate from account outcomes: learning a niche’s language can provide research value even when no reach improvement is demonstrated. This distinction allows the team to use what it actually learned without turning the whole activity into an unsupported algorithmic claim."],"action":["Define the niche and its queries.","Document observations without inventing a reach recipe."],"trap":"No magic duration or universal interaction count is established here.","quote":"Warm an account without invoking magic.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Warm an account without invoking magic.","text":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Niche Warming","text":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions. Its precise effect on reach remains a testable hypothesis.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"No magic duration or universal interaction count is established here.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the niche and its queries.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Document observations without inventing a reach recipe.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"035","slug":"native-posting","term":"Native Posting","category":"field-notes","kind":"guide","image":"current","tier":"canonical","evidence":"editorial","sources":[],"related":["native-warming","niche-warming","distribution-is-the-moat"],"tokportal":"native","fr":{"title":"Publier en natif : le geste compte, le brief aussi.","dek":"Native Posting désigne une publication effectuée dans l’interface grand public de la plateforme.","point":"Native Posting désigne une publication effectuée dans l’interface grand public de la plateforme. Une API peut orchestrer le travail sans être le canal final de publication.","body":["Un brief doit distinguer le contenu prêt à publier et les choix laissés à l’opérateur : texte, son, couverture, moment. Définissez les preuves de livraison et ce qui doit provoquer une demande de correction. L’exécution native apporte un contexte opérationnel ; elle ne dispense pas de vérifier les capacités actuelles de chaque plateforme.","Pour une livraison, demandez l’URL du post, l’heure réelle et les éventuels écarts au brief. Une fonction indisponible doit être signalée plutôt que remplacée silencieusement. Cette trace permet ensuite de comparer les résultats sur la base de ce qui a été fait. Un plan de publication et une publication vérifiée ne sont pas le même objet."],"action":["Spécifier les fonctions natives nécessaires.","Vérifier l’URL et la version réellement publiée."],"trap":"Une publication livrée n’est pas une preuve de portée ou de conversion.","quote":"Publier en natif : le geste compte, le brief aussi.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Publier en natif : le geste compte, le brief aussi.","text":"Native Posting désigne une publication effectuée dans l’interface grand public de la plateforme.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Native Posting","text":"Native Posting désigne une publication effectuée dans l’interface grand public de la plateforme. Une API peut orchestrer le travail sans être le canal final de publication.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une publication livrée n’est pas une preuve de portée ou de conversion.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Spécifier les fonctions natives nécessaires.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Vérifier l’URL et la version réellement publiée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Native posting: the action matters, so does the brief.","dek":"Native Posting means publishing through a platform’s consumer interface.","point":"Native Posting means publishing through a platform’s consumer interface. An API may orchestrate work without being the final publishing channel.","body":["A brief should distinguish ready-to-publish content from choices left to the operator: text, audio, cover, timing. Define delivery evidence and what requires correction. Native execution provides operational context; it does not remove the need to check current platform capabilities.","For delivery, request the post URL, actual time and any departures from the brief. An unavailable feature should be reported rather than silently substituted. This record lets analysis compare outcomes against what actually happened. A publishing plan and a verified publication are different objects. Keeping both prevents the team from attributing performance to a creative or native feature that never reached the audience."],"action":["Specify the native features required.","Verify the URL and version actually published."],"trap":"A delivered post is not evidence of reach or conversion.","quote":"Native posting: the action matters, so does the brief.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Native posting: the action matters, so does the brief.","text":"Native Posting means publishing through a platform’s consumer interface.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Native Posting","text":"Native Posting means publishing through a platform’s consumer interface. An API may orchestrate work without being the final publishing channel.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A delivered post is not evidence of reach or conversion.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Specify the native features required.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Verify the URL and version actually published.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"036","slug":"native-warming","term":"Native Warming","category":"field-notes","kind":"guide","image":"current","tier":"canonical","evidence":"editorial","sources":[],"related":["geo-targeted-account","native-posting","distribution-is-the-moat"],"fr":{"title":"Le warming n’est pas une danse de robots.","dek":"Native Warming se déroule dans l’application réelle avec des interactions ordinaires et authentiques.","point":"Native Warming se déroule dans l’application réelle avec des interactions ordinaires et authentiques. La pratique doit garder un sens pour l’utilisateur qui l’exécute.","body":["Donner une liste d’intérêts et un objectif d’observation est plus intelligible qu’exiger une chorégraphie de likes. L’opérateur peut signaler des tendances pertinentes, des décalages de langue ou des contenus hors sujet. Ces retours ont une valeur de recherche, même si l’effet sur la distribution ultérieure reste inconnu.","Une consigne utile peut demander de relever trois types de questions récurrentes dans la niche. Le nombre est un format de compte rendu, pas une dose algorithmique. L’opérateur garde la liberté de signaler qu’il n’a pas trouvé de motif clair. Une absence de signal est une information, pas un travail à maquiller pour compléter le formulaire."],"action":["Écrire un objectif d’observation.","Recueillir les enseignements qualitatifs."],"trap":"Le caractère humain d’une action ne transforme pas une hypothèse en résultat démontré.","quote":"Le warming n’est pas une danse de robots.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le warming n’est pas une danse de robots.","text":"Native Warming se déroule dans l’application réelle avec des interactions ordinaires et authentiques.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Native Warming","text":"Native Warming se déroule dans l’application réelle avec des interactions ordinaires et authentiques. La pratique doit garder un sens pour l’utilisateur qui l’exécute.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le caractère humain d’une action ne transforme pas une hypothèse en résultat démontré.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire un objectif d’observation.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Recueillir les enseignements qualitatifs.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Warming is not a robot dance.","dek":"Native Warming happens in the real application through ordinary, authentic interactions.","point":"Native Warming happens in the real application through ordinary, authentic interactions. The practice should remain meaningful to the person performing it.","body":["Providing interests and an observation goal is more intelligible than prescribing a choreography of likes. An operator can report relevant trends, language mismatches or off-topic content. Those observations have research value even when their effect on later distribution remains unknown.","A useful instruction might request three recurring question types in a niche. The number structures the report; it is not an algorithmic dose. Operators should remain free to report that no clear pattern emerged. Missing signal is information, not work to disguise so a form looks complete. This preserves the distinction between an authentic observation task and a mechanical requirement to perform a predetermined sequence."],"action":["Write an observation objective.","Capture qualitative learning."],"trap":"An action being human does not turn a hypothesis into a demonstrated result.","quote":"Warming is not a robot dance.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Warming is not a robot dance.","text":"Native Warming happens in the real application through ordinary, authentic interactions.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Native Warming","text":"Native Warming happens in the real application through ordinary, authentic interactions. The practice should remain meaningful to the person performing it.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An action being human does not turn a hypothesis into a demonstrated result.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write an observation objective.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Capture qualitative learning.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"037","slug":"geo-targeted-account","term":"Geo-Targeted Account","category":"field-notes","kind":"guide","image":"current","tier":"canonical","evidence":"editorial","sources":[],"related":["geo-posting","native-warming","distribution-is-the-moat"],"fr":{"title":"Un compte américain ne garantit pas une audience américaine.","dek":"Un Geo-Targeted Account est établi et opéré dans le marché visé.","point":"Un Geo-Targeted Account est établi et opéré dans le marché visé. La géographie constitue un contexte d’exécution parmi d’autres, sans garantir la composition de l’audience.","body":["Séparez pays d’opération, langue du contenu et pays des spectateurs observés. Une vidéo anglophone peut circuler bien au-delà du marché prévu. Examinez les données géographiques réellement disponibles et leur couverture. Si la plateforme ne fournit pas une ventilation fiable, conservez cette information comme inconnue au lieu de l’inférer du compte.","Dans votre tableau, créez trois colonnes : marché prévu, pays d’opération, audience observée. La dernière peut rester vide si aucune donnée n’est disponible. Ce détail évite qu’un export transforme une intention en résultat. Pour décider d’un changement de marché, cherchez aussi les contraintes du produit et les questions reçues dans les commentaires."],"action":["Définir le marché visé avant publication.","Mesurer la part géographique quand elle est disponible."],"trap":"Un pays de création n’est pas une option de ciblage publicitaire déterministe.","quote":"Un compte américain ne garantit pas une audience américaine.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un compte américain ne garantit pas une audience américaine.","text":"Un Geo-Targeted Account est établi et opéré dans le marché visé.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Geo-Targeted Account","text":"Un Geo-Targeted Account est établi et opéré dans le marché visé. La géographie constitue un contexte d’exécution parmi d’autres, sans garantir la composition de l’audience.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un pays de création n’est pas une option de ciblage publicitaire déterministe.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir le marché visé avant publication.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Mesurer la part géographique quand elle est disponible.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"A US account does not guarantee a US audience.","dek":"A Geo-Targeted Account is established and operated in its target market.","point":"A Geo-Targeted Account is established and operated in its target market. Geography is one execution context among others, without guaranteeing audience composition.","body":["Separate operating country, content language and observed viewer countries. An English video can travel far beyond its intended market. Examine available geographic data and its coverage. If a reliable breakdown is unavailable, keep it unknown instead of inferring it from account location.","Use three columns: intended market, operating country and observed audience. The last may remain unknown when data is unavailable. This prevents an export from turning intent into outcome. Before changing markets, also inspect product constraints and questions received in comments. A geographically relevant audience can still be a poor fit for an offer unavailable locally or a use case that does not match its needs."],"action":["Define the intended market before publishing.","Measure geographic share when available."],"trap":"A creation country is not deterministic ad targeting.","quote":"A US account does not guarantee a US audience.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A US account does not guarantee a US audience.","text":"A Geo-Targeted Account is established and operated in its target market.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Geo-Targeted Account","text":"A Geo-Targeted Account is established and operated in its target market. Geography is one execution context among others, without guaranteeing audience composition.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A creation country is not deterministic ad targeting.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the intended market before publishing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Measure geographic share when available.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"038","slug":"geo-posting","term":"Geo-Posting","category":"field-notes","kind":"guide","image":"current","tier":"canonical","evidence":"editorial","sources":[],"related":["us-launch","geo-targeted-account","distribution-is-the-moat"],"tokportal":"native","fr":{"title":"La localisation commence avant le bouton publier.","dek":"Geo-Posting consiste à publier depuis un compte opéré dans le marché cible.","point":"Geo-Posting consiste à publier depuis un compte opéré dans le marché cible. Le contenu doit encore correspondre aux usages, références et contraintes de ce public.","body":["Une démo destinée aux États-Unis peut échouer si le produit montre des prix, unités ou scénarios étrangers au lecteur. Faites relire le scénario par quelqu’un qui connaît le marché. Le lieu d’exécution et la pertinence culturelle sont deux dimensions distinctes ; documentez-les séparément pour ne pas expliquer chaque résultat par la géographie.","Un exemple illustratif : une démo française utilise un calendrier scolaire local, puis vise un public anglophone. Traduire la voix sans adapter les dates peut rendre l’usage incohérent. Corrigez ce contexte avant de juger le canal. Vous testerez alors une proposition compréhensible plutôt que la patience du public face à un scénario importé."],"action":["Adapter scénario, unités et vocabulaire.","Séparer variables créatives et contexte géographique."],"trap":"Un résultat local faible peut venir du message, du produit ou du contexte ; le pays n’est pas l’unique suspect.","quote":"La localisation commence avant le bouton publier.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La localisation commence avant le bouton publier.","text":"Geo-Posting consiste à publier depuis un compte opéré dans le marché cible.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Geo-Posting","text":"Geo-Posting consiste à publier depuis un compte opéré dans le marché cible. Le contenu doit encore correspondre aux usages, références et contraintes de ce public.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un résultat local faible peut venir du message, du produit ou du contexte ; le pays n’est pas l’unique suspect.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Adapter scénario, unités et vocabulaire.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Séparer variables créatives et contexte géographique.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Localization starts before the publish button.","dek":"Geo-Posting means publishing through an account operated in the target market.","point":"Geo-Posting means publishing through an account operated in the target market. Content must still fit that audience’s uses, references and constraints.","body":["A US-focused demo may fail if it shows prices, units or situations unfamiliar to viewers. Have someone who knows the market review the scenario. Execution location and cultural relevance are separate dimensions; record them separately rather than explaining every result through geography.","Consider an illustrative French demo using a local school calendar before targeting an English-speaking audience. Translating the voice without adapting dates can make the use case incoherent. Fix the context before judging distribution. You will then test an understandable proposition instead of the audience’s patience with an imported scenario. Record those changes because the localized version is a different creative treatment, not merely another upload location."],"action":["Adapt the scenario, units and language.","Separate creative variables from geography."],"trap":"Weak local results may come from message, product or context; country is not the only suspect.","quote":"Localization starts before the publish button.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Localization starts before the publish button.","text":"Geo-Posting means publishing through an account operated in the target market.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Geo-Posting","text":"Geo-Posting means publishing through an account operated in the target market. Content must still fit that audience’s uses, references and constraints.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Weak local results may come from message, product or context; country is not the only suspect.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Adapt the scenario, units and language.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate creative variables from geography.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"039","slug":"us-launch","term":"US launch","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["localization-not-translation","geo-posting","distribution-is-the-moat"],"fr":{"title":"Lancer aux US depuis ailleurs : commencer par la scène.","dek":"Un lancement international exige une offre compréhensible et une situation d’usage locale.","point":"Un lancement international exige une offre compréhensible et une situation d’usage locale. La distribution sociale ne remplace pas l’adaptation du parcours qui suit le clic.","body":["Avant de produire une série, vérifiez qu’un visiteur du marché cible peut comprendre la valeur, les prix et les modalités du produit. Choisissez un cas d’usage étroit pour vos premiers contenus. Des comptes localisés ne sauveront pas une page qui parle de contraintes inconnues du public ou présente une offre indisponible.","Suivez le clic jusque dans le produit : disponibilité, langue, devise affichée et expérience d’inscription. Une vidéo promettant une action immédiate ne doit pas mener à une page qui impose une autre attente. Ce contrôle révèle parfois que le principal chantier du lancement n’est pas le réseau de comptes mais la cohérence entre promesse et destination."],"action":["Relire le parcours complet dans le contexte local.","Relier chaque angle à une destination pertinente."],"trap":"L’audience américaine ne constitue pas, à elle seule, une preuve de demande solvable.","quote":"Lancer aux US depuis ailleurs : commencer par la scène.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Lancer aux US depuis ailleurs : commencer par la scène.","text":"Un lancement international exige une offre compréhensible et une situation d’usage locale.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"US launch","text":"Un lancement international exige une offre compréhensible et une situation d’usage locale. La distribution sociale ne remplace pas l’adaptation du parcours qui suit le clic.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"L’audience américaine ne constitue pas, à elle seule, une preuve de demande solvable.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Relire le parcours complet dans le contexte local.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Relier chaque angle à une destination pertinente.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Launching in the US from abroad: start with the scene.","dek":"An international launch needs an understandable offer and a locally relevant use case.","point":"An international launch needs an understandable offer and a locally relevant use case. Social distribution does not replace adapting the post-click journey.","body":["Before producing a series, check that target-market visitors can understand value, pricing and product terms. Choose a narrow use case for initial content. Localized accounts will not rescue a page addressing unfamiliar constraints or an unavailable offer.","Follow the click into the product: availability, language, displayed currency and signup experience. A video promising an immediate action should not lead to a page imposing a different expectation. This review sometimes reveals that the main launch problem is promise-to-destination consistency rather than account infrastructure. Fixing that mismatch gives any subsequent distribution experiment a clearer proposition to evaluate and a more meaningful commercial outcome to observe."],"action":["Review the complete journey in local context.","Connect every angle to a relevant destination."],"trap":"A US audience alone is not evidence of paying demand.","quote":"Launching in the US from abroad: start with the scene.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Launching in the US from abroad: start with the scene.","text":"An international launch needs an understandable offer and a locally relevant use case.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"US launch","text":"An international launch needs an understandable offer and a locally relevant use case. Social distribution does not replace adapting the post-click journey.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A US audience alone is not evidence of paying demand.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Review the complete journey in local context.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Connect every angle to a relevant destination.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"040","slug":"localization-not-translation","term":"Localization","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["account-brief","us-launch","distribution-is-the-moat"],"fr":{"title":"Traduire les mots. Puis refaire la situation.","dek":"La localisation adapte le sens, les références et les usages.","point":"La localisation adapte le sens, les références et les usages. Une traduction grammaticalement correcte peut laisser intact un scénario qui ne concerne pas son nouveau public.","body":["Un contenu sur la rentrée change selon les calendriers, les examens et les habitudes locales. Conservez le problème fondamental puis réécrivez son contexte. Le sous-titre traduit n’est qu’une partie du travail : les images, la capture produit et l’exemple chiffré peuvent eux aussi demander une adaptation.","Conservez un glossaire des termes qui doivent rester stables, notamment Account-Generated Distribution. Pour le reste, autorisez une formulation naturelle plutôt qu’un calque mot à mot. Faites vérifier la promesse complète : ce que comprend un lecteur local doit correspondre à ce que le contenu et le produit peuvent réellement livrer."],"action":["Lister les références culturelles du script.","Faire relire l’exemple, pas seulement les phrases."],"trap":"Changer le drapeau et la langue sans changer le contexte peut produire des pages ou posts sans valeur distincte.","quote":"Traduire les mots. Puis refaire la situation.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Traduire les mots. Puis refaire la situation.","text":"La localisation adapte le sens, les références et les usages.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Localization","text":"La localisation adapte le sens, les références et les usages. Une traduction grammaticalement correcte peut laisser intact un scénario qui ne concerne pas son nouveau public.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Changer le drapeau et la langue sans changer le contexte peut produire des pages ou posts sans valeur distincte.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Lister les références culturelles du script.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Faire relire l’exemple, pas seulement les phrases.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Translate the words. Then rebuild the situation.","dek":"Localization adapts meaning, references and uses.","point":"Localization adapts meaning, references and uses. A grammatically correct translation can preserve a scenario irrelevant to its new audience.","body":["Back-to-school content changes with local calendars, exams and habits. Keep the underlying problem and rewrite its context. Translated subtitles are only part of the work: imagery, product screens and numerical examples may also need adaptation.","Keep a glossary for terms that must remain stable, including Account-Generated Distribution. Elsewhere, allow natural phrasing instead of literal copying. Review the complete promise: what a local reader understands should match what the content and product can actually deliver. This creates equivalent meaning without requiring identical sentence structures, cultural examples or pacing across languages that organize information differently."],"action":["List cultural references in the script.","Review the example, not just the sentences."],"trap":"Changing flags and language without context can produce pages or posts without distinct value.","quote":"Translate the words. Then rebuild the situation.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Translate the words. Then rebuild the situation.","text":"Localization adapts meaning, references and uses.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Localization","text":"Localization adapts meaning, references and uses. A grammatically correct translation can preserve a scenario irrelevant to its new audience.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Changing flags and language without context can produce pages or posts without distinct value.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"List cultural references in the script.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review the example, not just the sentences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"041","slug":"account-brief","term":"Account Brief","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["operator-handoff","localization-not-translation","distribution-is-the-moat"],"fr":{"title":"Le brief de compte tient sur une page.","dek":"Un brief de compte fixe sa promesse, son audience, sa voix et ses frontières.","point":"Un brief de compte fixe sa promesse, son audience, sa voix et ses frontières. Il constitue un contrat commun entre création, exécution et analyse.","body":["Ajoutez deux exemples de publication souhaitée et un contre-exemple. Précisez qui valide, quand remonter un doute et où consigner les résultats. Cette page doit être assez courte pour servir réellement pendant le travail. Un dossier stratégique que personne n’ouvre ne prévient pas les dérives de persona.","Une bonne question de contrôle : une personne nouvelle pourrait-elle choisir entre deux contenus avec ce document seul ? Si les deux semblent également acceptables alors qu’un seul respecte le persona, le brief manque probablement d’un critère. Ajoutez le détail qui tranche, puis retirez les paragraphes de contexte qui n’aident jamais à décider."],"action":["Rédiger promesse, public, voix et refus.","Ajouter responsable et circuit de correction."],"trap":"Le brief doit évoluer avec des décisions documentées ; le laisser figé n’est pas de la cohérence.","quote":"Le brief de compte tient sur une page.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le brief de compte tient sur une page.","text":"Un brief de compte fixe sa promesse, son audience, sa voix et ses frontières.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Account Brief","text":"Un brief de compte fixe sa promesse, son audience, sa voix et ses frontières. Il constitue un contrat commun entre création, exécution et analyse.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le brief doit évoluer avec des décisions documentées ; le laisser figé n’est pas de la cohérence.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Rédiger promesse, public, voix et refus.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Ajouter responsable et circuit de correction.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"The account brief fits on one page.","dek":"An account brief sets its promise, audience, voice and boundaries.","point":"An account brief sets its promise, audience, voice and boundaries. It gives creation, execution and analysis a shared contract.","body":["Include two examples of desired posts and one counterexample. State who approves, when to escalate uncertainty and where to record results. Keep the page short enough to use during work. A strategy document nobody opens does not prevent persona drift.","A useful check asks whether a new colleague could choose between two pieces using only the document. If both seem equally acceptable while only one fits the persona, a decision criterion is probably missing. Add the detail that settles the choice, then remove background paragraphs that never help decide. A brief becomes stronger through sharper boundaries, not automatically through extra length or more sophisticated vocabulary."],"action":["Write promise, audience, voice and refusals.","Add an owner and correction path."],"trap":"A brief should evolve through documented decisions; leaving it frozen is not consistency.","quote":"The account brief fits on one page.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The account brief fits on one page.","text":"An account brief sets its promise, audience, voice and boundaries.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Account Brief","text":"An account brief sets its promise, audience, voice and boundaries. It gives creation, execution and analysis a shared contract.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A brief should evolve through documented decisions; leaving it frozen is not consistency.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write promise, audience, voice and refusals.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Add an owner and correction path.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"042","slug":"operator-handoff","term":"Operator handoff","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["publishing-window","account-brief","distribution-is-the-moat"],"tokportal":"native","fr":{"title":"Le handoff qui évite le « je pensais que ».","dek":"Un handoff transmet une tâche exécutable avec ses fichiers, contraintes et conditions de réussite.","point":"Un handoff transmet une tâche exécutable avec ses fichiers, contraintes et conditions de réussite. Les zones d’ambiguïté doivent être résolues avant une action irréversible.","body":["Précisez la version du fichier, le compte, le texte et les marges de liberté. Distinguez une heure souhaitée d’une échéance impérative. L’opérateur doit savoir quand s’arrêter : asset corrompu, fonction absente, incohérence de langue. Un retour structuré vaut mieux qu’une publication faite pour ne pas ralentir la file.","Préparez un petit exemple de retour attendu : URL reçue, heure constatée, fonction manquante et correction demandée. Ne publiez pas de données sensibles dans ce compte rendu. Ce modèle aide l’opérateur à transmettre ce qui sera vraiment utile à l’étape suivante, sans lui demander de deviner le format préféré de chaque membre de l’équipe."],"action":["Fournir une version unique des assets.","Définir les motifs de pause et de remontée."],"trap":"Une tâche marquée terminée ne remplace pas la vérification du contenu effectivement publié.","quote":"Le handoff qui évite le « je pensais que ».","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le handoff qui évite le « je pensais que ».","text":"Un handoff transmet une tâche exécutable avec ses fichiers, contraintes et conditions de réussite.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Operator handoff","text":"Un handoff transmet une tâche exécutable avec ses fichiers, contraintes et conditions de réussite. Les zones d’ambiguïté doivent être résolues avant une action irréversible.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une tâche marquée terminée ne remplace pas la vérification du contenu effectivement publié.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Fournir une version unique des assets.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Définir les motifs de pause et de remontée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"The handoff that prevents “I thought you meant”.","dek":"A handoff transfers an executable task with assets, constraints and success conditions.","point":"A handoff transfers an executable task with assets, constraints and success conditions. Ambiguity should be resolved before irreversible action.","body":["Specify file version, account, text and permitted discretion. Separate a preferred time from a hard deadline. Operators should know when to stop: corrupted assets, unavailable features, language mismatch. Structured feedback is better than publishing merely to keep the queue moving.","Prepare a small example of expected feedback: received URL, observed time, missing feature and requested correction. Keep sensitive information out of the report. This template helps operators communicate what the next stage actually needs without guessing each colleague’s preferred format. It also makes exceptions easier to compare because the team receives a consistent record of facts rather than a collection of incompatible success messages."],"action":["Provide one authoritative asset version.","Define pause and escalation conditions."],"trap":"A task marked complete does not replace checking what was actually published.","quote":"The handoff that prevents “I thought you meant”.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The handoff that prevents “I thought you meant”.","text":"A handoff transfers an executable task with assets, constraints and success conditions.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Operator handoff","text":"A handoff transfers an executable task with assets, constraints and success conditions. Ambiguity should be resolved before irreversible action.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A task marked complete does not replace checking what was actually published.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Provide one authoritative asset version.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define pause and escalation conditions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"043","slug":"publishing-window","term":"Publishing window","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["account-inventory","operator-handoff","distribution-is-the-moat"],"fr":{"title":"Une fenêtre de publication vaut mieux qu’une heure fétiche.","dek":"Une fenêtre de publication décrit l’intervalle acceptable pour une tâche.","point":"Une fenêtre de publication décrit l’intervalle acceptable pour une tâche. Elle permet de planifier l’exécution sans prétendre qu’une minute précise garantit une meilleure portée.","body":["Utilisez le fuseau du marché et conservez un horodatage absolu pour l’analyse. Si le contenu dépend d’un événement, notez la véritable date limite. Une vidéo publiée à temps sur le mauvais fuseau n’est pas une livraison conforme. La précision opérationnelle est utile même quand l’effet marketing du timing reste incertain.","Pour une sortie liée à un événement, ajoutez une règle après échéance : suspendre et demander un nouveau brief plutôt que publier un contenu devenu faux. Pour un sujet intemporel, la fenêtre peut être plus souple. Le calendrier devient ainsi un contrat adapté à la matière éditoriale, pas une collection d’heures précises choisies par habitude."],"action":["Nommer le fuseau et l’intervalle.","Enregistrer l’heure réelle de publication."],"trap":"La ponctualité ne prouve pas l’existence d’une heure optimale universelle.","quote":"Une fenêtre de publication vaut mieux qu’une heure fétiche.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une fenêtre de publication vaut mieux qu’une heure fétiche.","text":"Une fenêtre de publication décrit l’intervalle acceptable pour une tâche.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Publishing window","text":"Une fenêtre de publication décrit l’intervalle acceptable pour une tâche. Elle permet de planifier l’exécution sans prétendre qu’une minute précise garantit une meilleure portée.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La ponctualité ne prouve pas l’existence d’une heure optimale universelle.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Nommer le fuseau et l’intervalle.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Enregistrer l’heure réelle de publication.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"A publishing window beats a sacred minute.","dek":"A publishing window defines an acceptable interval for a task.","point":"A publishing window defines an acceptable interval for a task. It supports planning without claiming a particular minute guarantees better reach.","body":["Use the market’s timezone and retain an absolute timestamp for analysis. If content depends on an event, record the actual deadline. A post delivered on time in the wrong timezone is not a correct delivery. Operational precision matters even when timing’s marketing effect is uncertain.","For event-dependent content, add a post-deadline rule: pause and request a new brief rather than publish something now inaccurate. Evergreen material may allow a wider window. The calendar becomes a contract suited to the editorial substance rather than a collection of precise times chosen by habit. This also helps operators prioritize work according to real consequences instead of the visual density of a scheduling board."],"action":["Name the timezone and interval.","Record actual publication time."],"trap":"Punctuality does not prove a universal optimal posting time.","quote":"A publishing window beats a sacred minute.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A publishing window beats a sacred minute.","text":"A publishing window defines an acceptable interval for a task.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Publishing window","text":"A publishing window defines an acceptable interval for a task. It supports planning without claiming a particular minute guarantees better reach.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Punctuality does not prove a universal optimal posting time.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Name the timezone and interval.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record actual publication time.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"044","slug":"account-inventory","term":"Account inventory","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["zero-views","publishing-window","distribution-is-the-moat"],"fr":{"title":"Ton réseau commence par un inventaire fiable.","dek":"Un inventaire AGD relie chaque compte à son rôle, son marché, son responsable et son état observé.","point":"Un inventaire AGD relie chaque compte à son rôle, son marché, son responsable et son état observé. Il sépare clairement les actifs disponibles des actifs souhaités.","body":["Un compte en création, un compte accessible et un compte prêt à publier ne sont pas le même état. Ajoutez la date de dernière vérification plutôt que de conserver une étiquette éternelle. Les accès doivent rester dans un gestionnaire adapté, pas dans la feuille éditoriale. L’inventaire décrit le système ; il ne doit pas exposer ses secrets.","Ajoutez la distinction entre compte actif, temporairement indisponible et retiré du périmètre. Gardez l’historique des changements de statut pour les rétrospectives. Sans lui, un compte disparu peut sortir du calcul et embellir les résultats du réseau. L’inventaire est donc aussi un outil de mesure, à condition de ne pas réécrire le passé à chaque mise à jour."],"action":["Définir des états sans ambiguïté.","Associer responsable et date de vérification."],"trap":"Un inventaire ancien peut conduire l’agent à planifier du travail sur une capacité indisponible.","quote":"Ton réseau commence par un inventaire fiable.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Ton réseau commence par un inventaire fiable.","text":"Un inventaire AGD relie chaque compte à son rôle, son marché, son responsable et son état observé.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Account inventory","text":"Un inventaire AGD relie chaque compte à son rôle, son marché, son responsable et son état observé. Il sépare clairement les actifs disponibles des actifs souhaités.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un inventaire ancien peut conduire l’agent à planifier du travail sur une capacité indisponible.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir des états sans ambiguïté.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Associer responsable et date de vérification.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Your network starts with an accurate inventory.","dek":"An AGD inventory connects each account to its role, market, owner and observed state.","point":"An AGD inventory connects each account to its role, market, owner and observed state. It separates available assets from desired ones.","body":["An account being created, an accessible account and a publishing-ready account are different states. Record last verification time instead of keeping permanent labels. Credentials belong in an appropriate manager, not an editorial sheet. The inventory describes the system without exposing its secrets.","Distinguish active, temporarily unavailable and out-of-scope accounts. Keep status-change history for retrospectives. Otherwise a disappeared account can drop out of calculations and make the network look stronger. The inventory is therefore also a measurement tool, provided each update does not rewrite the past. Current capacity answers today’s planning question; historical membership answers what happened to the original cohort and resources committed to it."],"action":["Define unambiguous states.","Record an owner and verification date."],"trap":"An outdated inventory can make an agent plan work against unavailable capacity.","quote":"Your network starts with an accurate inventory.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your network starts with an accurate inventory.","text":"An AGD inventory connects each account to its role, market, owner and observed state.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Account inventory","text":"An AGD inventory connects each account to its role, market, owner and observed state. It separates available assets from desired ones.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An outdated inventory can make an agent plan work against unavailable capacity.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define unambiguous states.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record an owner and verification date.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"045","slug":"zero-views","term":"Stuck at 0 views","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["shadowban","account-inventory","distribution-is-the-moat"],"fr":{"title":"Zéro vue n’est pas un diagnostic.","dek":"Stuck at 0 views décrit une observation de distribution faible ou nulle après publication.","point":"Stuck at 0 views décrit une observation de distribution faible ou nulle après publication. Sans élément supplémentaire, cela n’identifie ni une sanction ni sa cause.","body":["Vérifiez l’état de publication, l’accessibilité, le traitement du média et les notifications visibles. Notez l’âge exact du post au moment du contrôle. Comparez ensuite à des contenus observés au même âge. Supprimer et republier immédiatement détruit parfois l’information nécessaire pour comprendre ce qui s’est passé.","Un compte rendu utile indique « publié à telle heure, accessible à telle heure, compteur encore nul à ce contrôle ». Cette formulation paraît moins spectaculaire qu’un diagnostic instantané, mais elle permet une vérification ultérieure. Si le compteur évolue, conservez les deux observations. Vous aurez une chronologie exploitable plutôt qu’une capture isolée impossible à interpréter."],"action":["Conserver URL, heure et notifications.","Séparer observation et hypothèses explicatives."],"trap":"Une valeur nulle dans un outil peut aussi signaler une donnée absente ou en retard.","quote":"Zéro vue n’est pas un diagnostic.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Zéro vue n’est pas un diagnostic.","text":"Stuck at 0 views décrit une observation de distribution faible ou nulle après publication.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Stuck at 0 views","text":"Stuck at 0 views décrit une observation de distribution faible ou nulle après publication. Sans élément supplémentaire, cela n’identifie ni une sanction ni sa cause.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une valeur nulle dans un outil peut aussi signaler une donnée absente ou en retard.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Conserver URL, heure et notifications.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Séparer observation et hypothèses explicatives.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Zero views is not a diagnosis.","dek":"Stuck at 0 views describes low or absent distribution after publication.","point":"Stuck at 0 views describes low or absent distribution after publication. Without further evidence it identifies neither enforcement nor its cause.","body":["Check publication state, accessibility, media processing and visible notifications. Record the post’s exact age at inspection. Compare it with content observed at the same age. Immediately deleting and reposting can destroy information needed to understand what happened.","A useful report states when the post was published, when it was accessible and when its counter was still zero. This sounds less dramatic than an instant diagnosis but allows later verification. If the counter changes, preserve both observations. You then have an interpretable timeline instead of an isolated screenshot, and can distinguish delayed measurement from genuinely absent distribution without inventing the reason for either."],"action":["Preserve URL, timestamp and notifications.","Separate observation from explanatory hypotheses."],"trap":"A zero in a tool can also indicate missing or delayed data.","quote":"Zero views is not a diagnosis.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Zero views is not a diagnosis.","text":"Stuck at 0 views describes low or absent distribution after publication.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Stuck at 0 views","text":"Stuck at 0 views describes low or absent distribution after publication. Without further evidence it identifies neither enforcement nor its cause.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A zero in a tool can also indicate missing or delayed data.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Preserve URL, timestamp and notifications.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate observation from explanatory hypotheses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"046","slug":"shadowban","term":"Shadowban","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["distribution-failure","zero-views","distribution-is-the-moat"],"fr":{"title":"Le shadowban est parfois le nom qu’on donne à l’inconnu.","dek":"Shadowban est un terme informel pour une suppression de distribution supposée sans notification explicite.","point":"Shadowban est un terme informel pour une suppression de distribution supposée sans notification explicite. Dans ce média, il reste une hypothèse tant qu’une preuve ne l’établit pas.","body":["Décrivez ce qui a changé : baisse de vues, disparition d’une source de trafic, restriction affichée. Conservez les captures et les dates. L’absence d’explication n’autorise pas à inventer une intention de plateforme. Une chronologie précise permet au support ou à l’analyste de travailler ; une étiquette dramatique apporte peu d’information.","Conservez aussi les décisions prises après la baisse. Un changement de contenu, une pause ou une suppression peut modifier ce que l’on observe ensuite. L’objectif n’est pas de prouver votre première intuition mais d’éviter de perdre la trace. Le vocabulaire précis garde le dossier ouvert aux explications concurrentes et aux informations nouvelles de la plateforme."],"action":["Écrire le symptôme exact.","Utiliser les voies officielles de diagnostic ou de recours disponibles."],"trap":"Une corrélation avec un changement récent ne suffit pas à prouver que ce changement a causé la baisse.","quote":"Le shadowban est parfois le nom qu’on donne à l’inconnu.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le shadowban est parfois le nom qu’on donne à l’inconnu.","text":"Shadowban est un terme informel pour une suppression de distribution supposée sans notification explicite.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Shadowban","text":"Shadowban est un terme informel pour une suppression de distribution supposée sans notification explicite. Dans ce média, il reste une hypothèse tant qu’une preuve ne l’établit pas.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une corrélation avec un changement récent ne suffit pas à prouver que ce changement a causé la baisse.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire le symptôme exact.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Utiliser les voies officielles de diagnostic ou de recours disponibles.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Shadowban is sometimes the name we give the unknown.","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice.","point":"Shadowban is an informal term for suspected distribution suppression without explicit notice. Here it remains a hypothesis unless evidence establishes it.","body":["Describe what changed: fewer views, a missing traffic source, a displayed restriction. Keep screenshots and dates. A missing explanation does not justify inventing platform intent. A precise timeline helps support or analysts work; a dramatic label provides little information.","Also preserve decisions made after the decline. Content changes, pauses or deletions can affect later observations. The objective is not to prove the first intuition but to keep the record interpretable. Precise language leaves room for competing explanations and new platform information. It also prevents an unverified suspicion from becoming a permanent account label that influences every future brief and analysis."],"action":["Write the exact symptom.","Use available official diagnostic or appeal channels."],"trap":"Correlation with a recent change does not prove that change caused the decline.","quote":"Shadowban is sometimes the name we give the unknown.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Shadowban is sometimes the name we give the unknown.","text":"Shadowban is an informal term for suspected distribution suppression without explicit notice.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Shadowban","text":"Shadowban is an informal term for suspected distribution suppression without explicit notice. Here it remains a hypothesis unless evidence establishes it.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Correlation with a recent change does not prove that change caused the decline.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the exact symptom.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Use available official diagnostic or appeal channels.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"047","slug":"distribution-failure","term":"Distribution failure","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["native-not-deceptive","shadowban","distribution-is-the-moat"],"fr":{"title":"Sept états différents cachés dans « ça ne marche pas ».","dek":"Une défaillance de distribution peut concerner l’accès au compte, une fonction, un contenu retiré, une publication absente ou une portée faible.","point":"Une défaillance de distribution peut concerner l’accès au compte, une fonction, un contenu retiré, une publication absente ou une portée faible. Ces états appellent des réponses différentes.","body":["Commencez par ce qui est observable. Le compte existe-t-il ? Le post est-il accessible ? Une notification décrit-elle une restriction ? Ensuite seulement examinez les résultats. Cette séparation évite de demander une nouvelle création à l’équipe alors que le fichier n’a jamais été publié correctement.","Une matrice simple peut relier chaque état à une vérification : accès pour le compte, URL pour le post, notification pour une restriction, fenêtre de mesure pour la portée. L’équipe peut alors attribuer l’incident au bon responsable. Cette organisation réduit les allers-retours et protège les créateurs contre les demandes de refaire un contenu pour résoudre un problème technique."],"action":["Classer le problème par état vérifié.","Relier chaque état à un propriétaire et une prochaine action."],"trap":"Un diagnostic trop large mélange incident technique, modération et performance éditoriale.","quote":"Sept états différents cachés dans « ça ne marche pas ».","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Sept états différents cachés dans « ça ne marche pas ».","text":"Une défaillance de distribution peut concerner l’accès au compte, une fonction, un contenu retiré, une publication absente ou une portée faible.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Distribution failure","text":"Une défaillance de distribution peut concerner l’accès au compte, une fonction, un contenu retiré, une publication absente ou une portée faible. Ces états appellent des réponses différentes.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un diagnostic trop large mélange incident technique, modération et performance éditoriale.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Classer le problème par état vérifié.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Relier chaque état à un propriétaire et une prochaine action.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Different failures hidden inside “it does not work”.","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach.","point":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach. These states call for different responses.","body":["Start with observable facts. Does the account exist? Is the post accessible? Does a notification describe a restriction? Only then inspect performance. This separation avoids requesting new creative work when the original file was never published correctly.","A simple matrix can connect each state to a check: access for accounts, URL for posts, notification for restrictions and measurement window for reach. The team can then route the incident to the right owner. This reduces back-and-forth and protects creators from being asked to remake content to solve a technical problem. The classification earns its value through a concrete next action, not through more elaborate terminology."],"action":["Classify the issue by verified state.","Connect each state to an owner and next action."],"trap":"An overly broad diagnosis mixes technical incidents, moderation and editorial performance.","quote":"Different failures hidden inside “it does not work”.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Different failures hidden inside “it does not work”.","text":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Distribution failure","text":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach. These states call for different responses.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An overly broad diagnosis mixes technical incidents, moderation and editorial performance.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Classify the issue by verified state.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Connect each state to an owner and next action.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"048","slug":"native-not-deceptive","term":"Commercial transparency","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["reddit-agd","distribution-failure","distribution-is-the-moat"],"fr":{"title":"Organique ne veut pas dire clandestin.","dek":"Un contenu peut être utile, natif et commercial à la fois.","point":"Un contenu peut être utile, natif et commercial à la fois. L’intégration éditoriale d’un produit ne doit pas fabriquer une indépendance ou une expérience qui n’existe pas.","body":["Si une marque initie le projet, indiquez cette relation de façon accessible. Racontez ensuite le sujet avec ses limites. Le lecteur peut apprécier un guide issu d’un fournisseur s’il comprend d’où il parle. Une voix pirate gagne à contester les dogmes, pas à masquer sa propre position.","Sur BLACKCURRENT, la page de transparence explique le lien avec TokPortal et les articles distinguent exemples illustratifs et résultats observés. Ce choix permet d’avoir un ton libre sans demander au lecteur de deviner le contexte commercial. La meilleure intégration produit reste celle qui aide à comprendre une opération précise et laisse les limites visibles."],"action":["Déclarer la relation commerciale pertinente.","Distinguer démonstration, illustration et expérience mesurée."],"trap":"Cette note est une règle éditoriale, pas une analyse juridique des obligations de chaque pays.","quote":"Organique ne veut pas dire clandestin.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Organique ne veut pas dire clandestin.","text":"Un contenu peut être utile, natif et commercial à la fois.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Commercial transparency","text":"Un contenu peut être utile, natif et commercial à la fois. L’intégration éditoriale d’un produit ne doit pas fabriquer une indépendance ou une expérience qui n’existe pas.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Cette note est une règle éditoriale, pas une analyse juridique des obligations de chaque pays.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Déclarer la relation commerciale pertinente.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Distinguer démonstration, illustration et expérience mesurée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Organic does not mean undercover.","dek":"Content can be useful, native and commercial at once.","point":"Content can be useful, native and commercial at once. Editorial product integration should not invent independence or experience that does not exist.","body":["If a brand initiates the project, make that relationship accessible. Then explain the subject with its limitations. Readers can value a vendor-originated guide when they understand its perspective. A pirate voice is better used challenging dogma than hiding its own position.","On BLACKCURRENT, the transparency page explains the TokPortal relationship and articles separate illustrative examples from observed outcomes. This allows a direct editorial voice without making readers guess the commercial context. The strongest product integration helps explain a specific operation while keeping limitations visible. Readers can then assess both the usefulness of the explanation and the perspective of the organization behind it."],"action":["Disclose the relevant commercial relationship.","Separate demonstrations, illustrations and measured experience."],"trap":"This note states an editorial rule, not a legal analysis of every country’s requirements.","quote":"Organic does not mean undercover.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Organic does not mean undercover.","text":"Content can be useful, native and commercial at once.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Commercial transparency","text":"Content can be useful, native and commercial at once. Editorial product integration should not invent independence or experience that does not exist.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This note states an editorial rule, not a legal analysis of every country’s requirements.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Disclose the relevant commercial relationship.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate demonstrations, illustrations and measured experience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"049","slug":"reddit-agd","term":"Reddit AGD","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["community-distribution","native-not-deceptive","distribution-is-the-moat"],"fr":{"title":"Sur Reddit, le contexte est la porte d’entrée.","dek":"Reddit AGD adapte la différenciation des comptes à une participation légitime dans des communautés.","point":"Reddit AGD adapte la différenciation des comptes à une participation légitime dans des communautés. Cela ne signifie pas multiplier des messages promotionnels identiques.","body":["Lisez les règles du subreddit et les discussions avant de contribuer. Répondez à une question avec des éléments utiles même sans lien externe. Si votre relation à un produit est pertinente, explicitez-la. Des comptes coordonnés pour simuler un consensus détruisent précisément la confiance dont une contribution a besoin.","Un bon point de départ peut être une question technique à laquelle vous savez répondre avec une méthode reproductible. Expliquez les étapes dans le commentaire lui-même et ajoutez un lien seulement s’il complète la réponse. La participation doit rester compatible avec les règles locales, y compris lorsqu’elles interdisent un type de promotion que d’autres communautés acceptent."],"action":["Vérifier les règles propres à la communauté.","Répondre à la question avant de proposer une ressource."],"trap":"La stratégie ne justifie ni vote coordonné ni faux témoignages de membres indépendants.","quote":"Sur Reddit, le contexte est la porte d’entrée.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Sur Reddit, le contexte est la porte d’entrée.","text":"Reddit AGD adapte la différenciation des comptes à une participation légitime dans des communautés.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Reddit AGD","text":"Reddit AGD adapte la différenciation des comptes à une participation légitime dans des communautés. Cela ne signifie pas multiplier des messages promotionnels identiques.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La stratégie ne justifie ni vote coordonné ni faux témoignages de membres indépendants.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Vérifier les règles propres à la communauté.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Répondre à la question avant de proposer une ressource.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"On Reddit, context is the entrance.","dek":"Reddit AGD adapts account differentiation to legitimate community participation.","point":"Reddit AGD adapts account differentiation to legitimate community participation. It does not mean multiplying identical promotional posts.","body":["Read subreddit rules and discussions before contributing. Answer a question with useful material even without an external link. Disclose a relevant product relationship. Accounts coordinated to simulate agreement undermine the trust a contribution needs.","A useful starting point is a technical question you can answer with a reproducible method. Explain the steps in the contribution itself and add a link only when it supplements the answer. Participation should fit local rules, including restrictions on promotions accepted elsewhere. Keep commercial relationships clear and never use additional accounts to manufacture support for the contribution or make a vendor recommendation appear independently endorsed."],"action":["Check the community’s own rules.","Answer the question before suggesting a resource."],"trap":"The strategy does not justify coordinated voting or fake independent-member testimonials.","quote":"On Reddit, context is the entrance.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"On Reddit, context is the entrance.","text":"Reddit AGD adapts account differentiation to legitimate community participation.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Reddit AGD","text":"Reddit AGD adapts account differentiation to legitimate community participation. It does not mean multiplying identical promotional posts.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The strategy does not justify coordinated voting or fake independent-member testimonials.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check the community’s own rules.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Answer the question before suggesting a resource.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"050","slug":"community-distribution","term":"Community distribution","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["content-rights","reddit-agd","distribution-is-the-moat"],"fr":{"title":"Participer avant de distribuer.","dek":"Une communauté ne se réduit pas à un canal d’acquisition.","point":"Une communauté ne se réduit pas à un canal d’acquisition. La distribution communautaire repose sur des contributions adaptées à ses attentes et à ses règles.","body":["Repérez les questions récurrentes et ce que les membres considèrent comme une bonne réponse. Une fiche technique peut être bienvenue là où une annonce produit serait hors sujet. Le bon indicateur initial est souvent la pertinence de l’échange, pas le nombre de liens déposés. Documentez les objections plutôt que de les traiter comme du bruit.","Conservez une fiche de contexte par communauté : sujets attendus, formats acceptés, objections fréquentes et limites de promotion. Cette fiche ne doit pas devenir une recette pour contourner la modération. Elle sert à éviter les contributions hors sujet et à reconnaître les cas où votre produit n’a simplement aucune place utile dans la discussion."],"action":["Identifier une question réellement posée.","Produire une réponse autonome et contextualisée."],"trap":"Une contribution autorisée dans une communauté n’est pas automatiquement appropriée dans une autre.","quote":"Participer avant de distribuer.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Participer avant de distribuer.","text":"Une communauté ne se réduit pas à un canal d’acquisition.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Community distribution","text":"Une communauté ne se réduit pas à un canal d’acquisition. La distribution communautaire repose sur des contributions adaptées à ses attentes et à ses règles.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une contribution autorisée dans une communauté n’est pas automatiquement appropriée dans une autre.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Identifier une question réellement posée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Produire une réponse autonome et contextualisée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"Participate before distributing.","dek":"A community is not merely an acquisition channel.","point":"A community is not merely an acquisition channel. Community distribution depends on contributions matching its expectations and rules.","body":["Identify recurring questions and what members consider a useful answer. A technical note may fit where a product announcement would not. Early usefulness is often reflected in the exchange, not the number of links posted. Record objections instead of treating them as noise.","Keep a context note for each community: expected subjects, accepted formats, frequent objections and promotional limits. This should not become a recipe for bypassing moderation. It helps prevent irrelevant contributions and recognize discussions where your product has no useful place. Choosing not to insert a link can preserve the quality of the exchange and keep the participation aligned with what members actually asked."],"action":["Identify a question people actually ask.","Produce a self-contained, contextual answer."],"trap":"A contribution allowed in one community is not automatically appropriate in another.","quote":"Participate before distributing.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Participate before distributing.","text":"A community is not merely an acquisition channel.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Community distribution","text":"A community is not merely an acquisition channel. Community distribution depends on contributions matching its expectations and rules.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A contribution allowed in one community is not automatically appropriate in another.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Identify a question people actually ask.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Produce a self-contained, contextual answer.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"051","slug":"content-rights","term":"Content rights","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["campaign-retrospective","community-distribution","distribution-is-the-moat"],"fr":{"title":"Le dossier d’assets a besoin de preuves, pas de suppositions.","dek":"Un registre de provenance relie images, sons et vidéos à leur origine et aux conditions d’utilisation vérifiées.","point":"Un registre de provenance relie images, sons et vidéos à leur origine et aux conditions d’utilisation vérifiées. C’est une base opérationnelle pour publier avec des droits connus.","body":["Conservez le lien source, l’auteur, la licence et la date de consultation. Une image trouvée dans un moteur de recherche n’est pas, pour cette raison, libre d’utilisation. Si l’asset change de marché ou de support, recontrôlez son périmètre. Pour les créations IA, notez l’origine sans prétendre à une photographie documentaire.","Le registre peut aussi noter les modifications réalisées : recadrage, sous-titrage ou adaptation. Certaines autorisations ont un périmètre qui doit être relu avant réutilisation. Si vous ne connaissez pas ce périmètre, préférez une création originale ou un asset dont les conditions sont vérifiées. La vitesse de production ne justifie pas de faire disparaître la provenance."],"action":["Associer une provenance à chaque asset.","Écarter les fichiers dont le périmètre reste inconnu."],"trap":"Cette méthode de traçabilité ne remplace pas l’examen d’une licence ou d’un cas juridique précis.","quote":"Le dossier d’assets a besoin de preuves, pas de suppositions.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le dossier d’assets a besoin de preuves, pas de suppositions.","text":"Un registre de provenance relie images, sons et vidéos à leur origine et aux conditions d’utilisation vérifiées.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Content rights","text":"Un registre de provenance relie images, sons et vidéos à leur origine et aux conditions d’utilisation vérifiées. C’est une base opérationnelle pour publier avec des droits connus.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Cette méthode de traçabilité ne remplace pas l’examen d’une licence ou d’un cas juridique précis.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Associer une provenance à chaque asset.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Écarter les fichiers dont le périmètre reste inconnu.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"An asset folder needs evidence, not assumptions.","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions.","point":"A provenance register connects images, sounds and videos to their origins and checked usage conditions. It provides an operational basis for publishing with known rights.","body":["Keep the source link, creator, license and consultation date. An image appearing in search is not therefore free to use. Recheck scope when an asset changes market or medium. For AI creations, record their origin without presenting them as documentary photographs.","The register can also record modifications such as cropping, subtitles or adaptation. Some permissions have a scope that needs checking before reuse. If that scope is unknown, prefer original work or an asset with verified conditions. Production speed does not justify losing provenance. A clear record lets the next operator understand what can be reused without treating every available file as universally cleared."],"action":["Attach provenance to every asset.","Exclude files whose usage scope remains unknown."],"trap":"This tracking method does not replace reviewing a license or a specific legal situation.","quote":"An asset folder needs evidence, not assumptions.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An asset folder needs evidence, not assumptions.","text":"A provenance register connects images, sounds and videos to their origins and checked usage conditions.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Content rights","text":"A provenance register connects images, sounds and videos to their origins and checked usage conditions. It provides an operational basis for publishing with known rights.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This tracking method does not replace reviewing a license or a specific legal situation.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach provenance to every asset.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Exclude files whose usage scope remains unknown.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"052","slug":"campaign-retrospective","term":"Campaign retrospective","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["budget-of-learning","content-rights","distribution-is-the-moat"],"fr":{"title":"Le post-mortem commence par ce qu’on ne sait pas.","dek":"Une rétrospective AGD relie objectifs, exécution, observations et décisions.","point":"Une rétrospective AGD relie objectifs, exécution, observations et décisions. Elle conserve les données manquantes au lieu de les transformer en résultats nuls.","body":["Séparez les publications prévues, livrées et mesurables. Notez les changements intervenus en cours de route. Un résultat spectaculaire peut provenir d’une seule idée ; un résultat faible peut cacher une livraison incomplète. Terminez par les décisions concrètes : poursuivre, modifier, arrêter ou collecter une preuve manquante.","Une conclusion utile peut être modeste : le concept semble compréhensible, mais la destination n’a pas été mesurée correctement. La prochaine action est alors de réparer la mesure avant de prétendre optimiser la conversion. Cette honnêteté évite de relancer une campagne sur un chiffre que personne ne peut reproduire et donne un sens précis au prochain cycle."],"action":["Documenter les écarts au plan.","Relier chaque conclusion à une observation."],"trap":"Une rétrospective qui ne change aucune décision risque de devenir une présentation décorative.","quote":"Le post-mortem commence par ce qu’on ne sait pas.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le post-mortem commence par ce qu’on ne sait pas.","text":"Une rétrospective AGD relie objectifs, exécution, observations et décisions.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Campaign retrospective","text":"Une rétrospective AGD relie objectifs, exécution, observations et décisions. Elle conserve les données manquantes au lieu de les transformer en résultats nuls.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une rétrospective qui ne change aucune décision risque de devenir une présentation décorative.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Documenter les écarts au plan.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Relier chaque conclusion à une observation.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"A retrospective starts with what we do not know.","dek":"An AGD retrospective connects objectives, execution, observations and decisions.","point":"An AGD retrospective connects objectives, execution, observations and decisions. It preserves missing data rather than turning it into zero results.","body":["Separate planned, delivered and measurable posts. Record changes made during execution. A spectacular outcome may come from one idea; a weak outcome may conceal incomplete delivery. Finish with concrete decisions: continue, modify, stop or collect missing evidence.","A useful conclusion can be modest: the concept appears understandable, but the destination was not measured correctly. The next action is to repair measurement before claiming conversion optimization. This avoids restarting a campaign around a number nobody can reproduce and gives the next cycle a precise purpose. Separate what the team learned from what it hoped to learn, even when the latter would make a better presentation."],"action":["Document departures from the plan.","Tie each conclusion to an observation."],"trap":"A retrospective that changes no decisions can become a decorative presentation.","quote":"A retrospective starts with what we do not know.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A retrospective starts with what we do not know.","text":"An AGD retrospective connects objectives, execution, observations and decisions.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Campaign retrospective","text":"An AGD retrospective connects objectives, execution, observations and decisions. It preserves missing data rather than turning it into zero results.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A retrospective that changes no decisions can become a decorative presentation.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Document departures from the plan.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Tie each conclusion to an observation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"053","slug":"budget-of-learning","term":"Learning budget","category":"field-notes","kind":"guide","image":"current","tier":"operating","evidence":"editorial","sources":[],"related":["niche-warming","campaign-retrospective","distribution-is-the-moat"],"fr":{"title":"Le coût d’un test, c’est aussi le temps perdu à le comprendre.","dek":"Un budget d’apprentissage inclut production, coordination, exécution et analyse.","point":"Un budget d’apprentissage inclut production, coordination, exécution et analyse. Il aide à choisir des expériences interprétables, au-delà du seul coût de publication.","body":["Deux tests au même prix peuvent produire des connaissances très différentes. Le premier mélange comptes, formats et marchés ; le second isole une décision utile. Notez le coût complet et la décision attendue avant de lancer. Une expérience bon marché mais impossible à lire peut être plus chère que son devis ne le suggère.","Pour arbitrer deux expériences, demandez quelle décision chacune peut réellement faire changer. Si un test ne peut ni modifier l’allocation ni améliorer un brief, sa valeur est incertaine. Une campagne exploratoire peut avoir d’autres objectifs, mais elle doit les nommer. Le budget gagne en clarté quand on sait à quelle question chaque coût est rattaché."],"action":["Évaluer le temps de coordination et d’analyse.","Définir la décision que le test doit éclairer."],"trap":"Un budget proposé n’est pas une autorisation de dépense ni une prévision de rendement.","quote":"Le coût d’un test, c’est aussi le temps perdu à le comprendre.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le coût d’un test, c’est aussi le temps perdu à le comprendre.","text":"Un budget d’apprentissage inclut production, coordination, exécution et analyse.","media":"/images/current.jpg"},{"label":"LE CONCEPT","title":"Learning budget","text":"Un budget d’apprentissage inclut production, coordination, exécution et analyse. Il aide à choisir des expériences interprétables, au-delà du seul coût de publication.","media":"/images/current.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un budget proposé n’est pas une autorisation de dépense ni une prévision de rendement.","media":"/images/current.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Évaluer le temps de coordination et d’analyse.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Définir la décision que le test doit éclairer.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/current.jpg"}]}]},"en":{"title":"A test also costs the time spent making sense of it.","dek":"A learning budget includes production, coordination, execution and analysis.","point":"A learning budget includes production, coordination, execution and analysis. It helps select interpretable experiments beyond publishing cost alone.","body":["Two equally priced tests can produce very different knowledge. One mixes accounts, formats and markets; another isolates a useful decision. Record full cost and expected decision before launching. A cheap but unreadable experiment can cost more than its quote suggests.","To choose between experiments, ask which decision each can actually change. If a test can neither alter allocation nor improve a brief, its value is uncertain. Exploratory campaigns may have other goals, but should name them. A budget becomes clearer when every cost connects to a question. This does not require predicting returns; it requires explaining what information would make the expenditure useful to the team."],"action":["Estimate coordination and analysis time.","Define the decision the test should inform."],"trap":"A proposed budget is neither spending authorization nor a return forecast.","quote":"A test also costs the time spent making sense of it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A test also costs the time spent making sense of it.","text":"A learning budget includes production, coordination, execution and analysis.","media":"/images/current.jpg"},{"label":"THE CONCEPT","title":"Learning budget","text":"A learning budget includes production, coordination, execution and analysis. It helps select interpretable experiments beyond publishing cost alone.","media":"/images/current.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A proposed budget is neither spending authorization nor a return forecast.","media":"/images/current.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Estimate coordination and analysis time.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define the decision the test should inform.","text":"Adapt this to your audience, budget and test scope.","media":"/images/current.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/current.jpg","width":1536,"height":1024,"alt":{"fr":"Banc de poissons argentés dans un océan sombre.","en":"Silver fish diverging through a dark ocean."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"054","slug":"viral-hit","term":"Viral Hit","category":"lab","kind":"protocol","image":"iceberg","tier":"canonical","evidence":"hypothesis","sources":[],"related":["viral-hit-rate","evidence-ladder","distribution-is-the-moat"],"fr":{"title":"Viral par rapport à quoi ?","dek":"Un Viral Hit est un résultat de distribution inhabituellement élevé par rapport à une référence définie : compte, cohorte ou campagne.","point":"Un Viral Hit est un résultat de distribution inhabituellement élevé par rapport à une référence définie : compte, cohorte ou campagne. Un seuil fixe de vues ne convient pas à tous les contextes.","body":["Une vidéo à 40 000 vues n’a pas le même sens pour un compte habituellement à 600 vues et pour un autre habituellement à 500 000. Ces nombres sont illustratifs. Définissez la référence avant d’observer le résultat. Sinon, vous pouvez déplacer le seuil jusqu’à obtenir le récit que vous vouliez raconter.","Dans une analyse, gardez le seuil choisi et la raison de ce choix à côté du résultat. Un seuil relatif à l’historique peut devenir instable si le compte a très peu publié. Une cohorte comparable peut alors être plus informative, à condition de justifier sa composition. Le mot viral doit rester attaché à une référence lisible."],"action":["Choisir une référence historique comparable.","Fixer le seuil avant de lire les résultats."],"trap":"Un pic de vues n’est pas une preuve d’effet commercial.","quote":"Viral par rapport à quoi ?","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Viral par rapport à quoi ?","text":"Un Viral Hit est un résultat de distribution inhabituellement élevé par rapport à une référence définie : compte, cohorte ou campagne.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Viral Hit","text":"Un Viral Hit est un résultat de distribution inhabituellement élevé par rapport à une référence définie : compte, cohorte ou campagne. Un seuil fixe de vues ne convient pas à tous les contextes.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un pic de vues n’est pas une preuve d’effet commercial.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Choisir une référence historique comparable.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Fixer le seuil avant de lire les résultats.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Viral compared with what?","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign.","point":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign. A fixed view threshold does not fit every context.","body":["A 40,000-view video means different things for an account usually reaching 600 and one usually reaching 500,000. These numbers are illustrative. Define the baseline before observing results. Otherwise you can move the threshold until it supports the story you wanted.","Keep the selected threshold and its rationale beside the result. A history-relative threshold can become unstable when an account has published very little. A comparable cohort may then be more informative, provided its composition is justified. The word viral should remain attached to a readable baseline. If no credible reference exists yet, describe the observed views and uncertainty rather than forcing a classification."],"action":["Choose a comparable historical baseline.","Set the threshold before reading results."],"trap":"A view spike is not proof of commercial impact.","quote":"Viral compared with what?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Viral compared with what?","text":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Viral Hit","text":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign. A fixed view threshold does not fit every context.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A view spike is not proof of commercial impact.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose a comparable historical baseline.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Set the threshold before reading results.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"055","slug":"viral-hit-rate","term":"Viral Hit Rate","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["median-vs-mean","viral-hit","distribution-is-the-moat"],"fr":{"title":"Le dénominateur est la moitié de l’histoire.","dek":"Le Viral Hit Rate est la proportion de publications admissibles qui dépassent un seuil d’outlier défini à l’avance.","point":"Le Viral Hit Rate est la proportion de publications admissibles qui dépassent un seuil d’outlier défini à l’avance. Sa lecture dépend du seuil, de la cohorte et de la fenêtre.","body":["Dans un exemple fictif, quatre hits sur cent posts admissibles donnent 4 %. Si vingt autres posts sont trop récents pour être évalués, affichez-les séparément. Ne les ajoutez pas silencieusement au dénominateur. Conservez aussi l’incertitude : quatre événements offrent peu de stabilité pour prédire la prochaine série.","Affichez aussi les résultats selon le concept créatif. Dix versions d’une même idée ne représentent pas dix découvertes indépendantes. Le taux par post répond à une question de production ; le taux par concept aide à comprendre la capacité d’invention. Les deux peuvent être utiles, mais ils ne doivent pas être fusionnés en un score unique sans explication."],"action":["Publier seuil, fenêtre et exclusions.","Montrer les comptes absolus avec le taux."],"trap":"Comparer deux taux aux critères d’admissibilité différents peut être trompeur.","quote":"Le dénominateur est la moitié de l’histoire.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le dénominateur est la moitié de l’histoire.","text":"Le Viral Hit Rate est la proportion de publications admissibles qui dépassent un seuil d’outlier défini à l’avance.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Viral Hit Rate","text":"Le Viral Hit Rate est la proportion de publications admissibles qui dépassent un seuil d’outlier défini à l’avance. Sa lecture dépend du seuil, de la cohorte et de la fenêtre.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Comparer deux taux aux critères d’admissibilité différents peut être trompeur.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Publier seuil, fenêtre et exclusions.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Montrer les comptes absolus avec le taux.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"The denominator is half the story.","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold.","point":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold. Interpretation depends on threshold, cohort and window.","body":["In a fictional example, four hits among one hundred eligible posts yield 4%. If twenty more are too recent to evaluate, show them separately. Do not silently add them to the denominator. Retain uncertainty too: four events offer limited stability for predicting the next series.","Also display results by creative concept. Ten versions of one idea do not represent ten independent discoveries. Post-level rate answers a production question; concept-level rate helps describe creative discovery. Both can be useful, but should not merge into one unexplained score. Keeping their denominators separate prevents a heavily repeated successful idea from being mistaken for a pipeline that repeatedly discovers unrelated winners."],"action":["Publish threshold, window and exclusions.","Show absolute counts beside the rate."],"trap":"Comparing rates with different eligibility criteria can mislead.","quote":"The denominator is half the story.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The denominator is half the story.","text":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Viral Hit Rate","text":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold. Interpretation depends on threshold, cohort and window.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Comparing rates with different eligibility criteria can mislead.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Publish threshold, window and exclusions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show absolute counts beside the rate.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"056","slug":"median-vs-mean","term":"Median vs mean","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["percentiles","viral-hit-rate","distribution-is-the-moat"],"fr":{"title":"La moyenne adore les histoires trop belles.","dek":"La moyenne additionne les valeurs puis divise par leur nombre.","point":"La moyenne additionne les valeurs puis divise par leur nombre. La médiane décrit le milieu d’une série triée. Les deux répondent à des questions différentes.","body":["Exemple fictif : 100, 100, 100, 100 et 10 000 vues. La moyenne vaut 2 080, la médiane 100. La première raconte le volume réparti théoriquement ; la seconde indique le post central. Gardez les deux avec la distribution complète pour ne pas confondre un hit isolé et une progression générale.","Dans l’exemple, supprimer les 10 000 vues fait tomber la moyenne à 100. Ce calcul de sensibilité ne signifie pas qu’il faut jeter le hit. Il montre la dépendance du total à une seule observation. Une bonne lecture garde le résultat complet et son contexte, puis pose la question de la répétabilité au lieu de l’inventer."],"action":["Afficher moyenne et médiane ensemble.","Examiner les valeurs extrêmes."],"trap":"La médiane peut aussi masquer l’intérêt économique de quelques très gros résultats.","quote":"La moyenne adore les histoires trop belles.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La moyenne adore les histoires trop belles.","text":"La moyenne additionne les valeurs puis divise par leur nombre.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Median vs mean","text":"La moyenne additionne les valeurs puis divise par leur nombre. La médiane décrit le milieu d’une série triée. Les deux répondent à des questions différentes.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La médiane peut aussi masquer l’intérêt économique de quelques très gros résultats.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Afficher moyenne et médiane ensemble.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Examiner les valeurs extrêmes.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"The average loves an overly good story.","dek":"The mean adds values and divides by their count.","point":"The mean adds values and divides by their count. The median describes the middle of a sorted series. They answer different questions.","body":["Fictional example: 100, 100, 100, 100 and 10,000 views. The mean is 2,080; the median is 100. The first describes theoretically spread volume; the second identifies the central post. Keep both alongside the distribution to distinguish an isolated hit from broad improvement.","In the example, removing the 10,000-view result brings the mean down to 100. This sensitivity check does not mean the hit should be discarded. It reveals dependence on one observation. A useful report keeps the complete result and context, then asks about repeatability rather than inventing it. The exceptional post may matter greatly while still telling us little about what an ordinary next post will achieve."],"action":["Show mean and median together.","Inspect extreme values."],"trap":"The median can also hide the economic importance of a few very large outcomes.","quote":"The average loves an overly good story.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The average loves an overly good story.","text":"The mean adds values and divides by their count.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Median vs mean","text":"The mean adds values and divides by their count. The median describes the middle of a sorted series. They answer different questions.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The median can also hide the economic importance of a few very large outcomes.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Show mean and median together.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Inspect extreme values.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"057","slug":"percentiles","term":"Distribution percentiles","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["power-law","median-vs-mean","distribution-is-the-moat"],"fr":{"title":"P90 n’est pas un nouveau mot pour « bon ».","dek":"Un percentile situe une valeur dans une distribution ordonnée.","point":"Un percentile situe une valeur dans une distribution ordonnée. P90 aide à décrire le haut de la série, mais dépend de la taille et de la définition de la cohorte.","body":["Un percentile sur dix posts est beaucoup plus instable qu’il n’en a l’air dans un dashboard. Précisez la méthode de calcul si plusieurs outils donnent des valeurs différentes. Comparez des séries de même maturité et gardez les effectifs visibles. Le percentile décrit les observations ; il ne garantit pas les prochaines performances.","Pour lire une évolution, présentez plusieurs points de la distribution. Une médiane stable avec un haut de série plus élevé raconte autre chose qu’une progression générale. Le premier cas peut signaler davantage d’extrêmes positifs ; il faut encore comprendre pourquoi. Ces résumés doivent ouvrir l’analyse des contenus, pas la remplacer."],"action":["Documenter la convention de calcul.","Afficher l’effectif de chaque cohorte."],"trap":"Un percentile élevé sur une petite série n’est pas une prévision fiable.","quote":"P90 n’est pas un nouveau mot pour « bon ».","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"P90 n’est pas un nouveau mot pour « bon ».","text":"Un percentile situe une valeur dans une distribution ordonnée.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Distribution percentiles","text":"Un percentile situe une valeur dans une distribution ordonnée. P90 aide à décrire le haut de la série, mais dépend de la taille et de la définition de la cohorte.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un percentile élevé sur une petite série n’est pas une prévision fiable.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Documenter la convention de calcul.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Afficher l’effectif de chaque cohorte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"P90 is not a new word for good.","dek":"A percentile locates a value in an ordered distribution.","point":"A percentile locates a value in an ordered distribution. P90 describes its upper region but depends on cohort size and definition.","body":["A percentile across ten posts is less stable than it looks on a dashboard. State the calculation method if tools disagree. Compare equally mature series and keep counts visible. A percentile describes observations; it does not guarantee future performance.","When reading change, show several points in the distribution. A stable median with a stronger upper region tells a different story from broad improvement. The first may suggest more positive extremes, but their cause remains to be understood. These summaries should open the content analysis rather than replace it. Show the same observation window and calculation method so apparent movement is not a reporting artifact."],"action":["Document the calculation convention.","Show each cohort’s size."],"trap":"A high percentile in a small series is not a reliable forecast.","quote":"P90 is not a new word for good.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"P90 is not a new word for good.","text":"A percentile locates a value in an ordered distribution.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Distribution percentiles","text":"A percentile locates a value in an ordered distribution. P90 describes its upper region but depends on cohort size and definition.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A high percentile in a small series is not a reliable forecast.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Document the calculation convention.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show each cohort’s size.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"058","slug":"power-law","term":"Distribution concentration","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["top-ten-accounts","percentiles","distribution-is-the-moat"],"fr":{"title":"Le hit fait du bruit. Le reste raconte le système.","dek":"La concentration mesure la part du résultat portée par une fraction des posts.","point":"La concentration mesure la part du résultat portée par une fraction des posts. Une distribution inégale n’est pas automatiquement la preuve d’une loi de puissance.","body":["Calculez la part des vues issue des publications les plus fortes, puis examinez les autres. Si un seul post porte presque tout, votre volume total est fragile. Mais cela peut rester une stratégie viable si son coût et sa répétabilité sont compris. Décrire la concentration vaut mieux que coller une formule mathématique non testée.","Un graphique trié des contributions suffit souvent à rendre la concentration visible. Ajoutez les effectifs et la fenêtre au lieu de forcer une courbe théorique. Si vous voulez réellement tester une loi de puissance, il faudra une méthode statistique dédiée et des comparaisons avec d’autres modèles. L’expression ne devrait jamais servir de décoration à un résultat simplement inégal."],"action":["Mesurer la part portée par les meilleurs posts.","Montrer le résultat avec et sans le plus gros hit."],"trap":"Retirer un outlier pour mieux raconter la moyenne peut supprimer une partie essentielle du phénomène.","quote":"Le hit fait du bruit. Le reste raconte le système.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le hit fait du bruit. Le reste raconte le système.","text":"La concentration mesure la part du résultat portée par une fraction des posts.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Distribution concentration","text":"La concentration mesure la part du résultat portée par une fraction des posts. Une distribution inégale n’est pas automatiquement la preuve d’une loi de puissance.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Retirer un outlier pour mieux raconter la moyenne peut supprimer une partie essentielle du phénomène.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Mesurer la part portée par les meilleurs posts.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Montrer le résultat avec et sans le plus gros hit.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"The hit makes noise. The rest explains the system.","dek":"Concentration measures the share of outcomes produced by a fraction of posts.","point":"Concentration measures the share of outcomes produced by a fraction of posts. An unequal distribution is not automatically evidence of a power law.","body":["Calculate the share of views from top posts, then inspect the rest. If one post carries nearly everything, total volume is fragile. That can still be viable if cost and repeatability are understood. Describing concentration beats attaching an untested mathematical label.","A ranked contribution chart often makes concentration visible without fitting a theoretical curve. Add counts and the observation window. Actually testing a power law requires a dedicated statistical method and comparison with alternative models. The expression should not decorate an outcome that is merely unequal. Descriptive reporting can still guide allocation well when it clearly shows which posts contribute and how much uncertainty remains about future repetition."],"action":["Measure the share carried by top posts.","Show results with and without the largest hit."],"trap":"Removing an outlier to improve the average’s story may erase an essential part of the phenomenon.","quote":"The hit makes noise. The rest explains the system.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The hit makes noise. The rest explains the system.","text":"Concentration measures the share of outcomes produced by a fraction of posts.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Distribution concentration","text":"Concentration measures the share of outcomes produced by a fraction of posts. An unequal distribution is not automatically evidence of a power law.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Removing an outlier to improve the average’s story may erase an essential part of the phenomenon.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Measure the share carried by top posts.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Show results with and without the largest hit.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"059","slug":"top-ten-accounts","term":"Account concentration","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["matched-cohorts","power-law","distribution-is-the-moat"],"fr":{"title":"Le réseau tourne. Ou un seul compte le porte.","dek":"La concentration par compte indique quels actifs portent le résultat total.","point":"La concentration par compte indique quels actifs portent le résultat total. Elle complète l’analyse par publication en révélant une dépendance structurelle.","body":["Additionnez les résultats admissibles par compte sur une même fenêtre, puis classez les contributions. Comparez aussi les volumes publiés : un compte peut dominer parce qu’il reçoit presque toutes les ressources. La décision utile est de savoir si cette allocation reflète une qualité observée ou une habitude opérationnelle.","Exemple illustratif : un compte reçoit la moitié des créations et génère la moitié des vues. Sa domination en volume n’indique pas nécessairement une meilleure efficacité. Un autre, moins alimenté, peut produire davantage de résultat par ressource. Comparez ces lectures sans oublier les différences d’objectif et de qualité des contenus assignés."],"action":["Comparer contribution et ressources allouées.","Documenter les comptes sans données suffisantes."],"trap":"Une faible contribution ne prouve pas qu’un compte est inutile si son objectif est différent.","quote":"Le réseau tourne. Ou un seul compte le porte.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le réseau tourne. Ou un seul compte le porte.","text":"La concentration par compte indique quels actifs portent le résultat total.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Account concentration","text":"La concentration par compte indique quels actifs portent le résultat total. Elle complète l’analyse par publication en révélant une dépendance structurelle.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une faible contribution ne prouve pas qu’un compte est inutile si son objectif est différent.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Comparer contribution et ressources allouées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Documenter les comptes sans données suffisantes.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"The network works. Or one account carries it.","dek":"Account concentration shows which assets carry the total outcome.","point":"Account concentration shows which assets carry the total outcome. It complements post-level analysis by revealing structural dependence.","body":["Sum eligible outcomes by account over one window and rank contributions. Compare publishing volumes too: one account may dominate because it receives most resources. Ask whether that allocation reflects observed quality or operational habit.","For illustration, an account receiving half the creative work also produces half the views. Its volume dominance does not necessarily mean greater efficiency. Another, less supplied account may produce more outcome per resource. Compare those views while retaining differences in purpose and assigned creative quality. A portfolio decision needs both total contribution and a fair description of what each account was given a chance to do."],"action":["Compare contributions with allocated resources.","Record accounts with insufficient data."],"trap":"Low contribution does not prove an account is useless when its purpose differs.","quote":"The network works. Or one account carries it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The network works. Or one account carries it.","text":"Account concentration shows which assets carry the total outcome.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account concentration","text":"Account concentration shows which assets carry the total outcome. It complements post-level analysis by revealing structural dependence.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Low contribution does not prove an account is useless when its purpose differs.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Compare contributions with allocated resources.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record accounts with insufficient data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"060","slug":"matched-cohorts","term":"Matched cohorts","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["posting-time-myth","top-ten-accounts","distribution-is-the-moat"],"fr":{"title":"Comparer ce qui peut vraiment l’être.","dek":"Une cohorte appariée rapproche des observations sur des caractéristiques connues.","point":"Une cohorte appariée rapproche des observations sur des caractéristiques connues. Elle réduit certaines différences visibles sans éliminer automatiquement tous les facteurs de confusion.","body":["Pour comparer des modes de publication, commencez par format, marché, âge de compte et fenêtre de mesure. Conservez les cas sans équivalent plutôt que de forcer des paires absurdes. Les variables non observées restent une limite. Une comparaison appariée doit dire pourquoi ses groupes sont crédibles, pas seulement afficher un écart.","Consignez les cas exclus et leur profil. Si seuls les comptes les plus simples à comparer restent dans l’étude, la conclusion peut ne pas s’appliquer au réseau entier. Une méthode reproductible permet à un autre lecteur de comprendre exactement la population couverte. La transparence sur les limites vaut mieux qu’un échantillon artificiellement présenté comme universel."],"action":["Choisir les variables d’appariement avant analyse.","Publier les exclusions et la couverture."],"trap":"Un appariement n’est pas une randomisation et ne suffit pas à prouver la causalité.","quote":"Comparer ce qui peut vraiment l’être.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Comparer ce qui peut vraiment l’être.","text":"Une cohorte appariée rapproche des observations sur des caractéristiques connues.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Matched cohorts","text":"Une cohorte appariée rapproche des observations sur des caractéristiques connues. Elle réduit certaines différences visibles sans éliminer automatiquement tous les facteurs de confusion.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un appariement n’est pas une randomisation et ne suffit pas à prouver la causalité.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Choisir les variables d’appariement avant analyse.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Publier les exclusions et la couverture.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Compare what is actually comparable.","dek":"A matched cohort aligns observations on known characteristics.","point":"A matched cohort aligns observations on known characteristics. It reduces some visible differences without automatically eliminating all confounding.","body":["For publishing-method comparisons, start with format, market, account age and measurement window. Retain unmatched cases separately rather than forcing implausible pairs. Unobserved variables remain a limitation. A matched comparison must explain group credibility, not merely display a gap.","Record excluded cases and their characteristics. If only the easiest accounts to compare remain, conclusions may not apply to the full network. A reproducible method lets another reader understand the population actually covered. Transparency about limits is more useful than presenting a selected sample as universal. The comparison can remain valuable, provided the claim stays inside the boundaries of the observations that support it."],"action":["Choose matching variables before analysis.","Publish exclusions and coverage."],"trap":"Matching is not randomization and does not establish causality by itself.","quote":"Compare what is actually comparable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Compare what is actually comparable.","text":"A matched cohort aligns observations on known characteristics.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Matched cohorts","text":"A matched cohort aligns observations on known characteristics. It reduces some visible differences without automatically eliminating all confounding.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Matching is not randomization and does not establish causality by itself.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose matching variables before analysis.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Publish exclusions and coverage.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"061","slug":"posting-time-myth","term":"Posting-time myth","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["posting-frequency","matched-cohorts","distribution-is-the-moat"],"fr":{"title":"19 h 42 n’est pas une stratégie.","dek":"L’effet de l’heure de publication dépend potentiellement du public et du contexte.","point":"L’effet de l’heure de publication dépend potentiellement du public et du contexte. Une heure universelle optimale n’est pas démontrée dans ce protocole.","body":["Répartissez des contenus comparables entre fenêtres prédéfinies, sans réserver vos meilleurs sujets au créneau favori. Mesurez à âge égal après publication. Distinguez jour de semaine et heure locale si l’échantillon permet cette finesse. Le verdict doit rester inconnu tant que le test n’est pas exécuté et analysé.","Préparez également la décision possible en cas d’absence de différence nette. Vous pourriez choisir le créneau le plus simple à opérer et consacrer l’énergie économisée à la création. Ce serait un résultat utile pour l’équipe. Une expérience n’a pas besoin de découvrir une astuce spectaculaire pour améliorer les opérations."],"action":["Préenregistrer les créneaux.","Répartir les concepts entre eux."],"trap":"Une capture montrant un succès à une heure ne permet pas de choisir la meilleure heure.","quote":"19 h 42 n’est pas une stratégie.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"19 h 42 n’est pas une stratégie.","text":"L’effet de l’heure de publication dépend potentiellement du public et du contexte.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Posting-time myth","text":"L’effet de l’heure de publication dépend potentiellement du public et du contexte. Une heure universelle optimale n’est pas démontrée dans ce protocole.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une capture montrant un succès à une heure ne permet pas de choisir la meilleure heure.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Préenregistrer les créneaux.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Répartir les concepts entre eux.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"7:42 p.m. is not a strategy.","dek":"Posting-time effects may depend on audience and context.","point":"Posting-time effects may depend on audience and context. A universally optimal time is not demonstrated in this protocol.","body":["Allocate comparable content across predefined windows without reserving your strongest topics for a favorite slot. Measure at equal post ages. Separate weekday and local time if the sample supports that detail. Keep the verdict unknown until the test is run and analyzed.","Plan what happens if no clear difference appears. The team might choose the easiest window to operate and spend saved effort on creative work. That would still be useful information. An experiment does not need to uncover a spectacular trick to improve operations. Recording this decision beforehand prevents a null or uncertain outcome from being hidden simply because it does not support an exciting optimization headline."],"action":["Preregister time windows.","Distribute concepts across them."],"trap":"A screenshot of success at one time cannot identify the best posting time.","quote":"7:42 p.m. is not a strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"7:42 p.m. is not a strategy.","text":"Posting-time effects may depend on audience and context.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Posting-time myth","text":"Posting-time effects may depend on audience and context. A universally optimal time is not demonstrated in this protocol.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A screenshot of success at one time cannot identify the best posting time.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Preregister time windows.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Distribute concepts across them.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"062","slug":"posting-frequency","term":"Posting frequency","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["warming-study","posting-time-myth","distribution-is-the-moat"],"fr":{"title":"Publier plus : davantage de chances ou davantage de bruit ?","dek":"Un test de fréquence doit distinguer volume total, performance par post et charge de production.","point":"Un test de fréquence doit distinguer volume total, performance par post et charge de production. Une hausse du total peut coexister avec une baisse par publication.","body":["Définissez deux cadences réalistes et une qualité créative comparable. Observez les coûts de coordination et les contenus qui ne sont pas livrés. Ne concluez pas sur le seul nombre de vues moyen : le réseau cherche peut-être plus de visites qualifiées avec un coût maîtrisé. Aucun résultat de test n’est fourni ici.","Un résultat favorable au total peut aussi augmenter la fatigue de l’équipe ou les corrections. Notez ces effets dans le bilan au lieu de les considérer comme extérieurs au test. Le bon rythme dépend du système complet. Une cadence tenable avec des briefs lisibles peut être préférable à un pic de production qui ne survit pas à la semaine suivante."],"action":["Fixer cadence, durée et indicateur principal.","Suivre coût total et résultats par post."],"trap":"Changer simultanément cadence et qualité empêche d’isoler l’effet de fréquence.","quote":"Publier plus : davantage de chances ou davantage de bruit ?","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Publier plus : davantage de chances ou davantage de bruit ?","text":"Un test de fréquence doit distinguer volume total, performance par post et charge de production.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Posting frequency","text":"Un test de fréquence doit distinguer volume total, performance par post et charge de production. Une hausse du total peut coexister avec une baisse par publication.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Changer simultanément cadence et qualité empêche d’isoler l’effet de fréquence.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Fixer cadence, durée et indicateur principal.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Suivre coût total et résultats par post.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Posting more: more chances or more noise?","dek":"A frequency test must separate total volume, per-post performance and production load.","point":"A frequency test must separate total volume, per-post performance and production load. Higher totals can coexist with weaker individual posts.","body":["Define two realistic cadences with comparable creative quality. Observe coordination costs and undelivered content. Do not conclude from average views alone: the network may seek more qualified visits at a manageable cost. No test result is supplied here.","A favorable total may also increase team fatigue or correction work. Record those effects in the review instead of treating them as outside the experiment. A suitable cadence depends on the whole system. Sustainable output with readable briefs may be preferable to a production spike that cannot survive the following week. This is an operating tradeoff to evaluate, not an assumption that lower frequency always performs better."],"action":["Set cadence, duration and primary metric.","Track total cost and per-post outcomes."],"trap":"Changing cadence and quality together prevents isolating frequency effects.","quote":"Posting more: more chances or more noise?","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Posting more: more chances or more noise?","text":"A frequency test must separate total volume, per-post performance and production load.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Posting frequency","text":"A frequency test must separate total volume, per-post performance and production load. Higher totals can coexist with weaker individual posts.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Changing cadence and quality together prevents isolating frequency effects.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Set cadence, duration and primary metric.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Track total cost and per-post outcomes.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"063","slug":"warming-study","term":"Warming protocol","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["account-age","posting-frequency","distribution-is-the-moat"],"fr":{"title":"Le warming mérite mieux qu’une anecdote.","dek":"Un protocole de warming compare des préparations définies avant publication.","point":"Un protocole de warming compare des préparations définies avant publication. Il doit séparer apprentissage de niche, comportement du compte et résultats ultérieurs.","body":["Prévoyez des groupes comparables : préparation générale, préparation ciblée et contrôle quand cela convient au contexte. Conservez les mêmes critères créatifs et l’âge de mesure. Définissez les résultats possibles, y compris l’absence de différence. Ce document propose une méthode ; il ne revendique pas une expérience exécutée.","Distinguez les observations faites pendant la préparation et celles collectées après publication. Les premières peuvent montrer une meilleure compréhension de niche sans prouver un effet de distribution. En séparant ces bénéfices, vous évitez un verdict tout ou rien. La pratique peut être utile pour la recherche créative même si le test de portée reste non concluant."],"action":["Décrire précisément les préparations.","Prévoir le traitement des abandons et données absentes."],"trap":"Une observation favorable ne suffit pas à attribuer le résultat au warming.","quote":"Le warming mérite mieux qu’une anecdote.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le warming mérite mieux qu’une anecdote.","text":"Un protocole de warming compare des préparations définies avant publication.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Warming protocol","text":"Un protocole de warming compare des préparations définies avant publication. Il doit séparer apprentissage de niche, comportement du compte et résultats ultérieurs.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une observation favorable ne suffit pas à attribuer le résultat au warming.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Décrire précisément les préparations.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Prévoir le traitement des abandons et données absentes.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Warming deserves more than an anecdote.","dek":"A warming protocol compares preparations defined before publishing.","point":"A warming protocol compares preparations defined before publishing. It should separate niche learning, account behavior and later outcomes.","body":["Plan comparable groups: general preparation, targeted preparation and control where suitable. Keep creative criteria and measurement age consistent. Define possible outcomes, including no difference. This document proposes a method; it does not claim an executed experiment.","Separate observations made during preparation from those collected after publishing. The first can show improved niche understanding without proving a distribution effect. Keeping these benefits distinct avoids an all-or-nothing verdict. The practice may support creative research even when a reach test remains inconclusive. Describe exactly which benefit was observed so a practical learning outcome does not silently become a claim about platform recommendation behavior."],"action":["Describe preparations precisely.","Plan handling of dropouts and missing data."],"trap":"A favorable observation does not establish that warming caused the result.","quote":"Warming deserves more than an anecdote.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Warming deserves more than an anecdote.","text":"A warming protocol compares preparations defined before publishing.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Warming protocol","text":"A warming protocol compares preparations defined before publishing. It should separate niche learning, account behavior and later outcomes.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A favorable observation does not establish that warming caused the result.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Describe preparations precisely.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan handling of dropouts and missing data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"064","slug":"account-age","term":"Account age","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["slideshow-vs-video","warming-study","distribution-is-the-moat"],"fr":{"title":"Un vieux compte n’est pas un groupe de contrôle.","dek":"L’âge d’un compte peut être lié à son historique, ses abonnés et ses habitudes.","point":"L’âge d’un compte peut être lié à son historique, ses abonnés et ses habitudes. Comparer ancien et nouveau compte exige de distinguer ces dimensions.","body":["Un compte ancien sans activité récente n’est pas équivalent à un créateur installé. Décrivez ancienneté, activité, audience et historique de restrictions lorsqu’ils sont observables. Les catégories doivent être choisies avant de chercher le découpage qui produit le plus bel écart. Sans données comparables, le verdict reste ouvert.","Si les comptes anciens sont les seuls à avoir survécu à plusieurs cycles, ils ont déjà traversé une sélection. Cette histoire peut expliquer une partie de leur différence avec de nouveaux comptes. Conservez les sorties de cohorte et les périodes d’inactivité. L’ancienneté est une variable commode ; elle ne résume pas tout ce que le compte a vécu."],"action":["Séparer ancienneté et activité.","Contrôler les différences d’audience disponibles."],"trap":"Une corrélation avec l’âge peut refléter une sélection de comptes survivants.","quote":"Un vieux compte n’est pas un groupe de contrôle.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un vieux compte n’est pas un groupe de contrôle.","text":"L’âge d’un compte peut être lié à son historique, ses abonnés et ses habitudes.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Account age","text":"L’âge d’un compte peut être lié à son historique, ses abonnés et ses habitudes. Comparer ancien et nouveau compte exige de distinguer ces dimensions.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une corrélation avec l’âge peut refléter une sélection de comptes survivants.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Séparer ancienneté et activité.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Contrôler les différences d’audience disponibles.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"An old account is not a control group.","dek":"Account age can be associated with history, followers and behavior.","point":"Account age can be associated with history, followers and behavior. Comparing old and new accounts requires distinguishing those dimensions.","body":["An old account without recent activity is not equivalent to an established creator. Describe age, activity, audience and observable restriction history. Choose categories before searching for the split yielding the prettiest gap. Without comparable data, the verdict remains open.","If older accounts are the only ones surviving several cycles, they have already passed through selection. That history may explain part of their difference from new accounts. Keep cohort exits and inactive periods. Age is a convenient variable, but it does not summarize everything an account experienced. A credible analysis should resist treating a date field as a complete description of operational history and accumulated audience context."],"action":["Separate age from activity.","Account for available audience differences."],"trap":"Correlation with age may reflect selection among surviving accounts.","quote":"An old account is not a control group.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An old account is not a control group.","text":"Account age can be associated with history, followers and behavior.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account age","text":"Account age can be associated with history, followers and behavior. Comparing old and new accounts requires distinguishing those dimensions.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Correlation with age may reflect selection among surviving accounts.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Separate age from activity.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Account for available audience differences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"065","slug":"slideshow-vs-video","term":"Slideshow vs video","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["formatted-vs-chaotic","account-age","distribution-is-the-moat"],"fr":{"title":"Le carrousel contre la vidéo : mauvaise question sans contexte.","dek":"Comparer carrousel et vidéo exige une promesse et un public comparables.","point":"Comparer carrousel et vidéo exige une promesse et un public comparables. Les comportements de lecture et les mesures disponibles peuvent différer entre formats.","body":["Transformez une même question en deux traitements adaptés, sans forcer une vidéo à devenir un diaporama animé. Choisissez un indicateur commun utile, comme des visites qualifiées quand elles sont mesurables. Conservez séparément les métriques natives à chaque format. Le test compare des expériences de contenu, pas seulement des extensions de fichiers.","Ajoutez le coût de production au tableau. Une vidéo peut obtenir un meilleur résultat brut avec beaucoup plus de travail ; un carrousel peut permettre une explication plus facile à corriger. Le choix dépend de la question éditoriale et des ressources. Présentez le compromis plutôt que de couronner un format pour toutes les situations."],"action":["Conserver la même question utilisateur.","Choisir une mesure commune interprétable."],"trap":"Comparer des taux de complétion définis différemment peut fabriquer un gagnant artificiel.","quote":"Le carrousel contre la vidéo : mauvaise question sans contexte.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le carrousel contre la vidéo : mauvaise question sans contexte.","text":"Comparer carrousel et vidéo exige une promesse et un public comparables.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Slideshow vs video","text":"Comparer carrousel et vidéo exige une promesse et un public comparables. Les comportements de lecture et les mesures disponibles peuvent différer entre formats.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Comparer des taux de complétion définis différemment peut fabriquer un gagnant artificiel.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Conserver la même question utilisateur.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Choisir une mesure commune interprétable.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Slideshow versus video: context comes first.","dek":"Comparing slideshow and video requires a comparable promise and audience.","point":"Comparing slideshow and video requires a comparable promise and audience. Reading behavior and available metrics may differ between formats.","body":["Turn one question into two suitable treatments without forcing video into an animated slideshow. Choose a useful shared metric, such as measurable qualified visits. Keep format-native metrics separate. The test compares content experiences, not file extensions.","Include production cost in the table. A video may achieve a stronger raw outcome with much more work, while a slideshow may make an explanation easier to revise. The choice depends on the editorial question and resources. Present the tradeoff rather than crowning a format for every situation. Also retain whether both treatments actually delivered equivalent information; unequal substance can otherwise masquerade as a format effect."],"action":["Keep the same user question.","Choose an interpretable shared measure."],"trap":"Comparing differently defined completion rates can manufacture a winner.","quote":"Slideshow versus video: context comes first.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Slideshow versus video: context comes first.","text":"Comparing slideshow and video requires a comparable promise and audience.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Slideshow vs video","text":"Comparing slideshow and video requires a comparable promise and audience. Reading behavior and available metrics may differ between formats.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Comparing differently defined completion rates can manufacture a winner.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep the same user question.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Choose an interpretable shared measure.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"066","slug":"formatted-vs-chaotic","term":"Formatted vs chaotic","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["creative-diversity-test","slideshow-vs-video","distribution-is-the-moat"],"fr":{"title":"La série ou le chaos ? Un test, pas une guerre de goûts.","dek":"Un test Formatted versus Chaotic compare une structure récurrente à plusieurs formats.","point":"Un test Formatted versus Chaotic compare une structure récurrente à plusieurs formats. Il doit conserver un objectif éditorial commun et documenter la variation réelle.","body":["La série gagne peut-être en cohérence opérationnelle ; le compte flexible peut explorer davantage d’angles. Mesurez aussi la charge créative et le nombre de concepts testés. Sinon, vous risquez de comparer un système richement alimenté à un autre sous-financé. Aucun vainqueur n’est présumé dans ce protocole.","Dans chaque groupe, archivez les concepts réellement publiés. Un compte chaotique peut sembler meilleur parce qu’il a reçu les sujets les plus forts. Une série peut sembler plus stable parce que ses variations sont moins ambitieuses. Le registre créatif permet de discuter ces différences au lieu de les faire disparaître derrière une étiquette de format."],"action":["Définir ce qui reste fixe dans chaque groupe.","Comparer les ressources engagées."],"trap":"Un résultat de campagne ne devient pas une règle universelle sur les formats.","quote":"La série ou le chaos ? Un test, pas une guerre de goûts.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La série ou le chaos ? Un test, pas une guerre de goûts.","text":"Un test Formatted versus Chaotic compare une structure récurrente à plusieurs formats.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Formatted vs chaotic","text":"Un test Formatted versus Chaotic compare une structure récurrente à plusieurs formats. Il doit conserver un objectif éditorial commun et documenter la variation réelle.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un résultat de campagne ne devient pas une règle universelle sur les formats.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir ce qui reste fixe dans chaque groupe.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Comparer les ressources engagées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Series or chaos? A test, not a taste war.","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats.","point":"A Formatted versus Chaotic test compares a recurring structure with multiple formats. It needs a shared editorial objective and documented variation.","body":["A series may improve operating consistency; a flexible account may explore more angles. Measure creative workload and concepts tested too. Otherwise you may compare a well-resourced system with an underfunded one. This protocol presumes no winner.","Archive the concepts actually published in each group. A chaotic account may appear stronger because it received the best subjects. A series may appear more stable because its variations were less ambitious. A creative record makes these differences discussable instead of hiding them behind a format label. The result should explain the tested systems, not imply that one loosely defined category has defeated another in every possible context."],"action":["Define fixed elements in each group.","Compare invested resources."],"trap":"One campaign’s outcome does not become a universal rule about formats.","quote":"Series or chaos? A test, not a taste war.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Series or chaos? A test, not a taste war.","text":"A Formatted versus Chaotic test compares a recurring structure with multiple formats.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Formatted vs chaotic","text":"A Formatted versus Chaotic test compares a recurring structure with multiple formats. It needs a shared editorial objective and documented variation.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"One campaign’s outcome does not become a universal rule about formats.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define fixed elements in each group.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Compare invested resources.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"067","slug":"creative-diversity-test","term":"Creative diversity","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["native-features-test","formatted-vs-chaotic","distribution-is-the-moat"],"fr":{"title":"La diversité se mesure aussi dans ce qu’on apprend.","dek":"Un test de diversité créative examine des variations substantielles plutôt qu’un simple compte de fichiers.","point":"Un test de diversité créative examine des variations substantielles plutôt qu’un simple compte de fichiers. Il relie les concepts aux résultats et à leur stabilité.","body":["Étiquetez angles, personas et situations avant d’examiner la performance. Comparez des ensembles au volume similaire avec des degrés de diversité documentés. Gardez les coûts visibles : davantage d’angles peut demander plus de conception. La question est de savoir si cette différence améliore l’apprentissage utile, pas seulement la dispersion des résultats.","Une relecture aveugle peut aider : cachez les résultats et demandez à plusieurs personnes de classer les créations selon la taxonomie. Les désaccords révèlent des catégories trop vagues. Ce contrôle ne mesure pas l’effet marketing, mais il vérifie que votre définition de diversité peut être appliquée sans connaître à l’avance les gagnants."],"action":["Définir une taxonomie créative simple.","Mesurer résultats et effort de conception."],"trap":"Une taxonomie inventée après lecture des résultats peut rationaliser les succès.","quote":"La diversité se mesure aussi dans ce qu’on apprend.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La diversité se mesure aussi dans ce qu’on apprend.","text":"Un test de diversité créative examine des variations substantielles plutôt qu’un simple compte de fichiers.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Creative diversity","text":"Un test de diversité créative examine des variations substantielles plutôt qu’un simple compte de fichiers. Il relie les concepts aux résultats et à leur stabilité.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une taxonomie inventée après lecture des résultats peut rationaliser les succès.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir une taxonomie créative simple.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Mesurer résultats et effort de conception.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Diversity also lives in what you learn.","dek":"A creative-diversity test examines meaningful variation rather than counting files.","point":"A creative-diversity test examines meaningful variation rather than counting files. It connects concepts with outcomes and their stability.","body":["Label angles, personas and situations before examining performance. Compare similar-volume groups with documented diversity differences. Keep costs visible: more angles may require more design work. Ask whether the difference improves useful learning, not merely outcome dispersion.","A blind review can help: hide results and ask several people to classify creative work using the taxonomy. Disagreements expose vague categories. This does not measure marketing impact, but checks whether the definition of diversity can be applied without already knowing winners. Keep ambiguous cases visible and revise the coding guide before using those categories to explain performance or allocate the next production budget."],"action":["Define a simple creative taxonomy.","Measure outcomes and design effort."],"trap":"A taxonomy invented after reading results can rationalize successes.","quote":"Diversity also lives in what you learn.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Diversity also lives in what you learn.","text":"A creative-diversity test examines meaningful variation rather than counting files.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Creative diversity","text":"A creative-diversity test examines meaningful variation rather than counting files. It connects concepts with outcomes and their stability.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A taxonomy invented after reading results can rationalize successes.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define a simple creative taxonomy.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Measure outcomes and design effort.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"068","slug":"native-features-test","term":"Native features","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["zero-view-rate","creative-diversity-test","distribution-is-the-moat"],"fr":{"title":"Ce n’est peut-être pas le natif. C’est peut-être la fonction.","dek":"Un test de fonctionnalités natives distingue l’effet d’une fonction du canal de publication.","point":"Un test de fonctionnalités natives distingue l’effet d’une fonction du canal de publication. Une comparaison de workflows entiers ne permet pas toujours cette séparation.","body":["Si un groupe utilise un son ou une mise en forme absent de l’autre, le traitement ne se limite plus au mode d’envoi. Documentez précisément les fonctions utilisées. Selon la question, vous pouvez accepter ce bundle de différences ou chercher un test plus étroit. Il faut seulement annoncer honnêtement ce que la comparaison mesure.","Un protocole peut volontairement comparer deux expériences complètes si c’est la décision réelle de l’équipe. Il faut alors nommer le traitement comme tel. L’objectif n’est pas de supprimer toute complexité, mais de ne pas tirer une conclusion étroite à partir d’un test large. La formulation du résultat doit rester à l’échelle de ce qui a été changé."],"action":["Inventorier les différences de fonctionnalités.","Choisir entre test de fonction et test de workflow."],"trap":"Un écart entre workflows ne prouve pas quel composant a produit l’effet.","quote":"Ce n’est peut-être pas le natif. C’est peut-être la fonction.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Ce n’est peut-être pas le natif. C’est peut-être la fonction.","text":"Un test de fonctionnalités natives distingue l’effet d’une fonction du canal de publication.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Native features","text":"Un test de fonctionnalités natives distingue l’effet d’une fonction du canal de publication. Une comparaison de workflows entiers ne permet pas toujours cette séparation.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un écart entre workflows ne prouve pas quel composant a produit l’effet.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Inventorier les différences de fonctionnalités.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Choisir entre test de fonction et test de workflow.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Maybe it is not native. Maybe it is the feature.","dek":"A native-feature test separates a feature’s effect from its publishing channel.","point":"A native-feature test separates a feature’s effect from its publishing channel. Comparing whole workflows does not always allow that separation.","body":["If one group uses audio or formatting absent from the other, treatment no longer concerns upload method alone. Document features precisely. Depending on the question, accept that bundle of differences or design a narrower test. State honestly what the comparison measures.","A protocol may deliberately compare two complete experiences when that is the team’s actual decision. Name the treatment accordingly. The aim is not to remove all complexity but to avoid a narrow conclusion from a broad test. Keep the result’s wording at the scale of what changed. A workflow comparison can be practically useful without identifying the isolated contribution of every feature inside it."],"action":["Inventory feature differences.","Choose a feature test or a workflow test."],"trap":"A gap between workflows does not identify which component produced the effect.","quote":"Maybe it is not native. Maybe it is the feature.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Maybe it is not native. Maybe it is the feature.","text":"A native-feature test separates a feature’s effect from its publishing channel.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Native features","text":"A native-feature test separates a feature’s effect from its publishing channel. Comparing whole workflows does not always allow that separation.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A gap between workflows does not identify which component produced the effect.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Inventory feature differences.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Choose a feature test or a workflow test.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"069","slug":"zero-view-rate","term":"Zero-view rate","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["confidence-intervals","native-features-test","distribution-is-the-moat"],"fr":{"title":"Un taux de zéro mérite une définition entière.","dek":"Le taux de publications à zéro vue dépend d’un âge d’observation, d’une source de mesure et d’un périmètre admissible.","point":"Le taux de publications à zéro vue dépend d’un âge d’observation, d’une source de mesure et d’un périmètre admissible. Les données manquantes doivent rester distinctes.","body":["Comptez les posts réellement publiés et observables à la fenêtre retenue. Séparez les valeurs nulles, les erreurs de collecte et les publications encore trop jeunes. Affichez les nombres bruts. Un taux qui baisse parce que l’outil ne récupère plus les comptes problématiques ne signale pas nécessairement une amélioration.","Ajoutez un contrôle de collecte avant de déclencher une alerte de performance. Si plusieurs comptes perdent leurs données au même moment, le problème peut être dans l’outil de mesure. Conservez les réponses techniques utiles et la dernière observation valide. Ce réflexe évite de lancer des corrections éditoriales pour réparer un compteur qui n’a simplement pas été actualisé."],"action":["Fixer âge d’observation et source.","Conserver une catégorie donnée inconnue."],"trap":"Zéro observé, zéro absent et zéro supposé ne sont pas interchangeables.","quote":"Un taux de zéro mérite une définition entière.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un taux de zéro mérite une définition entière.","text":"Le taux de publications à zéro vue dépend d’un âge d’observation, d’une source de mesure et d’un périmètre admissible.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Zero-view rate","text":"Le taux de publications à zéro vue dépend d’un âge d’observation, d’une source de mesure et d’un périmètre admissible. Les données manquantes doivent rester distinctes.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Zéro observé, zéro absent et zéro supposé ne sont pas interchangeables.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Fixer âge d’observation et source.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Conserver une catégorie donnée inconnue.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"A zero rate deserves a complete definition.","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope.","point":"Zero-view rate depends on observation age, measurement source and eligibility scope. Missing data must remain separate.","body":["Count genuinely published posts observable at the selected window. Separate null values, collection failures and posts too young to evaluate. Show raw counts. A rate declining because a tool no longer retrieves problematic accounts does not necessarily indicate improvement.","Check collection before raising a performance alert. If several accounts lose data simultaneously, the problem may sit in the measurement tool. Preserve useful technical responses and the last valid observation. This avoids launching editorial fixes for a counter that simply was not refreshed. The operational next step should follow the evidence available, while the actual distribution outcome remains unknown until a reliable observation can be made."],"action":["Set observation age and source.","Keep an unknown-data category."],"trap":"Observed zero, missing zero and assumed zero are not interchangeable.","quote":"A zero rate deserves a complete definition.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A zero rate deserves a complete definition.","text":"Zero-view rate depends on observation age, measurement source and eligibility scope.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Zero-view rate","text":"Zero-view rate depends on observation age, measurement source and eligibility scope. Missing data must remain separate.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Observed zero, missing zero and assumed zero are not interchangeable.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Set observation age and source.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep an unknown-data category.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"070","slug":"confidence-intervals","term":"Uncertainty","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["survivorship-bias","zero-view-rate","distribution-is-the-moat"],"fr":{"title":"L’intervalle d’incertitude fait partie du résultat.","dek":"Un intervalle exprime l’incertitude sous les hypothèses d’une méthode.","point":"Un intervalle exprime l’incertitude sous les hypothèses d’une méthode. Il ne corrige pas un mauvais échantillon, une mesure incomplète ou une confusion de variables.","body":["Avant de choisir une formule, identifiez l’unité indépendante : post, compte ou campagne. Des posts issus du même compte peuvent partager des facteurs communs. Une analyse qui les traite tous comme indépendants peut paraître trop précise. Publiez la méthode, ses hypothèses et les données qui restent hors de portée.","Expliquez également ce que l’intervalle ne couvre pas : erreurs de collecte, biais de sélection ou changement de définition peuvent rester hors du calcul. Un lecteur doit pouvoir distinguer incertitude statistique et qualité globale de la mesure. Cette séparation rend le résultat moins spectaculaire, mais beaucoup plus utile pour décider s’il faut agir ou mieux mesurer."],"action":["Définir l’unité d’analyse.","Expliquer la méthode et ses hypothèses."],"trap":"Un intervalle étroit ne garantit pas que la question causale soit correctement posée.","quote":"L’intervalle d’incertitude fait partie du résultat.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"L’intervalle d’incertitude fait partie du résultat.","text":"Un intervalle exprime l’incertitude sous les hypothèses d’une méthode.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Uncertainty","text":"Un intervalle exprime l’incertitude sous les hypothèses d’une méthode. Il ne corrige pas un mauvais échantillon, une mesure incomplète ou une confusion de variables.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un intervalle étroit ne garantit pas que la question causale soit correctement posée.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir l’unité d’analyse.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Expliquer la méthode et ses hypothèses.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Uncertainty is part of the result.","dek":"An interval expresses uncertainty under a method’s assumptions.","point":"An interval expresses uncertainty under a method’s assumptions. It does not fix a poor sample, incomplete measurement or confounding.","body":["Before choosing a formula, identify the independent unit: post, account or campaign. Posts from one account may share common factors. Treating all of them as independent can look overly precise. Publish the method, assumptions and data beyond its reach.","Explain what the interval does not cover: collection errors, selection bias or a changed definition may sit outside its calculation. Readers should distinguish statistical uncertainty from overall measurement quality. This makes a result less dramatic but more useful when deciding whether to act or measure better. Numerical precision should not suppress the practical question of whether the underlying observations represent the population and outcome being discussed."],"action":["Define the unit of analysis.","Explain the method and assumptions."],"trap":"A narrow interval does not guarantee a properly framed causal question.","quote":"Uncertainty is part of the result.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Uncertainty is part of the result.","text":"An interval expresses uncertainty under a method’s assumptions.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Uncertainty","text":"An interval expresses uncertainty under a method’s assumptions. It does not fix a poor sample, incomplete measurement or confounding.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A narrow interval does not guarantee a properly framed causal question.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the unit of analysis.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Explain the method and assumptions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"071","slug":"survivorship-bias","term":"Survivorship bias","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["regression-to-mean","confidence-intervals","distribution-is-the-moat"],"fr":{"title":"Les comptes disparus avaient aussi des résultats.","dek":"Le biais de survivance apparaît quand l’analyse ne conserve que les unités encore visibles.","point":"Le biais de survivance apparaît quand l’analyse ne conserve que les unités encore visibles. Un réseau évalué sans ses comptes abandonnés peut sembler artificiellement performant.","body":["Conservez les raisons de sortie et la dernière date observée. Distinguez un compte arrêté volontairement, inaccessible ou simplement oublié par la collecte. L’analyse d’un portefeuille doit partir d’une cohorte définie au départ, puis expliquer son devenir. Les actifs survivants répondent à une question différente de l’investissement initial.","Présentez un petit tableau de devenir de cohorte : toujours actif, arrêté, inaccessible, état inconnu. Les catégories doivent refléter des faits vérifiés et leur date. Ce tableau aide à comprendre pourquoi l’effectif diminue. Il empêche aussi qu’un excellent résultat des survivants soit présenté comme le rendement de tous les comptes lancés au départ."],"action":["Figer la cohorte de départ.","Documenter les sorties et leur coût."],"trap":"Une donnée perdue ne doit pas être réinventée ; signalez la limite de couverture.","quote":"Les comptes disparus avaient aussi des résultats.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Les comptes disparus avaient aussi des résultats.","text":"Le biais de survivance apparaît quand l’analyse ne conserve que les unités encore visibles.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Survivorship bias","text":"Le biais de survivance apparaît quand l’analyse ne conserve que les unités encore visibles. Un réseau évalué sans ses comptes abandonnés peut sembler artificiellement performant.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une donnée perdue ne doit pas être réinventée ; signalez la limite de couverture.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Figer la cohorte de départ.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Documenter les sorties et leur coût.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"The missing accounts had results too.","dek":"Survivorship bias appears when analysis retains only still-visible units.","point":"Survivorship bias appears when analysis retains only still-visible units. A network evaluated without abandoned accounts can look artificially strong.","body":["Keep exit reasons and last observed dates. Separate intentionally stopped, inaccessible and uncollected accounts. Portfolio analysis should begin with an initial cohort and explain what happened to it. Surviving assets answer a different question from the original investment.","Show a small cohort-status table: still active, intentionally stopped, inaccessible and unknown. Categories should reflect verified facts and dates. This explains why counts decline and prevents strong survivor outcomes from being presented as returns across every account originally launched. Keep unknown states separate instead of assigning a convenient reason for disappearance. The incomplete history is itself a limitation of what the final performance comparison can claim."],"action":["Freeze the initial cohort.","Record exits and their costs."],"trap":"Lost data must not be invented; report the coverage limitation.","quote":"The missing accounts had results too.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The missing accounts had results too.","text":"Survivorship bias appears when analysis retains only still-visible units.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Survivorship bias","text":"Survivorship bias appears when analysis retains only still-visible units. A network evaluated without abandoned accounts can look artificially strong.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Lost data must not be invented; report the coverage limitation.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Freeze the initial cohort.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Record exits and their costs.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"072","slug":"regression-to-mean","term":"Regression to the mean","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["cohort-maturity","survivorship-bias","distribution-is-the-moat"],"fr":{"title":"Après un hit, le retour sur terre n’est pas toujours une panne.","dek":"Un résultat extrême peut être suivi de résultats plus ordinaires.","point":"Un résultat extrême peut être suivi de résultats plus ordinaires. Cette possibilité invite à ne pas attribuer automatiquement toute baisse à la dernière décision prise.","body":["Après un post exceptionnel, comparez la suite à l’historique complet plutôt qu’au seul pic. Conservez la chronologie des changements. Un nouveau hook peut coïncider avec une baisse sans l’avoir causée. Pour évaluer une modification, il faut une comparaison adaptée, pas le souvenir du meilleur jour.","Une rétrospective peut comparer trois références : la période avant le hit, le hit lui-même et les publications suivantes. Cette présentation suffit parfois à calmer un diagnostic précipité. Elle ne prouve aucune cause, mais montre si la suite ressemble davantage à l’activité habituelle qu’à un effondrement inédit. Les incidents documentés restent à examiner séparément."],"action":["Comparer à une référence stable.","Séparer évolution normale et incidents vérifiés."],"trap":"Ce phénomène possible ne doit pas servir à ignorer une dégradation technique réelle.","quote":"Après un hit, le retour sur terre n’est pas toujours une panne.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Après un hit, le retour sur terre n’est pas toujours une panne.","text":"Un résultat extrême peut être suivi de résultats plus ordinaires.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Regression to the mean","text":"Un résultat extrême peut être suivi de résultats plus ordinaires. Cette possibilité invite à ne pas attribuer automatiquement toute baisse à la dernière décision prise.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Ce phénomène possible ne doit pas servir à ignorer une dégradation technique réelle.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Comparer à une référence stable.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Séparer évolution normale et incidents vérifiés.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"After a hit, returning to earth is not always a failure.","dek":"An extreme outcome can be followed by more ordinary outcomes.","point":"An extreme outcome can be followed by more ordinary outcomes. This possibility cautions against attributing every decline to the latest decision.","body":["After an exceptional post, compare subsequent output with the full history rather than the peak alone. Keep a change timeline. A new hook may coincide with a decline without causing it. Evaluating a change requires a suitable comparison, not the memory of the best day.","A review can show three references: the period before the hit, the hit itself and subsequent posts. This sometimes slows a premature diagnosis. It proves no cause, but reveals whether later results resemble ordinary activity more than an unprecedented collapse. Documented incidents still need separate investigation. The objective is to keep an exceptional observation from becoming the only standard against which every future post is judged."],"action":["Compare with a stable baseline.","Separate ordinary variation from verified incidents."],"trap":"This possible phenomenon should not be used to dismiss a real technical deterioration.","quote":"After a hit, returning to earth is not always a failure.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"After a hit, returning to earth is not always a failure.","text":"An extreme outcome can be followed by more ordinary outcomes.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Regression to the mean","text":"An extreme outcome can be followed by more ordinary outcomes. This possibility cautions against attributing every decline to the latest decision.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"This possible phenomenon should not be used to dismiss a real technical deterioration.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Compare with a stable baseline.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate ordinary variation from verified incidents.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"073","slug":"cohort-maturity","term":"Cohort maturity","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["attribution","regression-to-mean","distribution-is-the-moat"],"fr":{"title":"J7 n’existe pas pour un visiteur arrivé hier.","dek":"Une conversion à J7 doit porter sur des personnes ayant eu sept jours complets pour convertir.","point":"Une conversion à J7 doit porter sur des personnes ayant eu sept jours complets pour convertir. Mélanger cohortes matures et récentes fausse la comparaison.","body":["Fixez le début du parcours et la définition de conversion. Comparez les cohortes à même âge, avec les données manquantes visibles. Un ratio achats du mois sur visites du mois n’est pas automatiquement une conversion de cohorte : les acheteurs peuvent être arrivés bien avant la fenêtre affichée.","Pour une cohorte quotidienne, conservez la date d’entrée et la borne de mesure. Un tableau peut afficher les cohortes récentes sans calculer leur taux final. Vous gardez ainsi la visibilité sur l’activité nouvelle tout en protégeant la comparaison. La donnée immature n’est pas mauvaise ; elle répond simplement à une question qui n’a pas encore toute sa durée."],"action":["Choisir événement de départ et résultat.","Exclure du taux J7 les parcours encore immatures."],"trap":"Un achat pendant la période n’est pas forcément attribuable à une visite de la même période.","quote":"J7 n’existe pas pour un visiteur arrivé hier.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"J7 n’existe pas pour un visiteur arrivé hier.","text":"Une conversion à J7 doit porter sur des personnes ayant eu sept jours complets pour convertir.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Cohort maturity","text":"Une conversion à J7 doit porter sur des personnes ayant eu sept jours complets pour convertir. Mélanger cohortes matures et récentes fausse la comparaison.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un achat pendant la période n’est pas forcément attribuable à une visite de la même période.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Choisir événement de départ et résultat.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Exclure du taux J7 les parcours encore immatures.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Day seven does not exist for yesterday’s visitor.","dek":"Day-seven conversion should cover people given seven full days to convert.","point":"Day-seven conversion should cover people given seven full days to convert. Mixing mature and recent cohorts distorts comparisons.","body":["Define journey start and conversion. Compare cohorts at equal ages while showing missing data. Monthly purchases divided by monthly visits is not automatically a cohort conversion rate: buyers may have arrived long before the displayed window.","For daily cohorts, keep entry date and measurement cutoff. A table can show recent cohorts without calculating their final rate. This preserves visibility into new activity while protecting comparisons. Immature data is not bad data; it simply concerns a question whose full observation time has not elapsed. Make that distinction visible rather than silently including recent arrivals in a denominator they have not had time to complete."],"action":["Choose the starting event and outcome.","Exclude immature journeys from day-seven rates."],"trap":"A purchase during a period is not necessarily attributable to a visit in that period.","quote":"Day seven does not exist for yesterday’s visitor.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Day seven does not exist for yesterday’s visitor.","text":"Day-seven conversion should cover people given seven full days to convert.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Cohort maturity","text":"Day-seven conversion should cover people given seven full days to convert. Mixing mature and recent cohorts distorts comparisons.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A purchase during a period is not necessarily attributable to a visit in that period.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Choose the starting event and outcome.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Exclude immature journeys from day-seven rates.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"074","slug":"attribution","term":"Attribution","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["views-to-buyers","cohort-maturity","distribution-is-the-moat"],"fr":{"title":"Un UTM dit d’où vient le clic. Pas toute l’histoire.","dek":"Les paramètres de campagne décrivent une origine instrumentée.","point":"Les paramètres de campagne décrivent une origine instrumentée. Ils ne prouvent pas à eux seuls l’influence causale d’un contenu sur une décision d’achat.","body":["Gardez séparés le premier point de contact, le dernier lien et la source déclarée par le client. Une recommandation personnelle peut précéder une visite taguée. Ne faites pas disparaître cette nuance dans un chiffre unique. La part non attribuée reste inconnue ; elle n’est ni un échec ni un succès caché que l’on peut s’approprier.","Dans le média, les liens TokPortal portent une origine éditoriale et un identifiant d’article. Cela permet de reconnaître certains passages, pas de reconstituer toutes les expositions antérieures. Un lecteur peut revenir sans paramètre ou sur un autre appareil. Le bilan doit annoncer sa couverture et éviter de transformer les visites identifiables en totalité de l’influence."],"action":["Nommer précisément chaque vue d’attribution.","Dédupliquer les acheteurs entre contenus."],"trap":"Additionner les conversions assistées de plusieurs articles peut compter plusieurs fois le même client.","quote":"Un UTM dit d’où vient le clic. Pas toute l’histoire.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un UTM dit d’où vient le clic. Pas toute l’histoire.","text":"Les paramètres de campagne décrivent une origine instrumentée.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Attribution","text":"Les paramètres de campagne décrivent une origine instrumentée. Ils ne prouvent pas à eux seuls l’influence causale d’un contenu sur une décision d’achat.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Additionner les conversions assistées de plusieurs articles peut compter plusieurs fois le même client.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Nommer précisément chaque vue d’attribution.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Dédupliquer les acheteurs entre contenus.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"A UTM tells you about the click. Not the whole story.","dek":"Campaign parameters describe an instrumented origin.","point":"Campaign parameters describe an instrumented origin. They do not alone prove a piece of content caused a purchase decision.","body":["Keep first touch, last link and customer-declared source separate. A personal recommendation may precede a tagged visit. Do not erase that nuance in one number. Unattributed share remains unknown; it is neither failure nor hidden success to claim.","This publication’s TokPortal links carry an editorial source and article identifier. They help recognize some visits, not reconstruct every prior exposure. A reader may return without parameters or on another device. Reporting should state coverage and avoid treating identifiable visits as the entirety of influence. Equally, unattributed outcomes should not be claimed for the publication merely because its content could theoretically have contributed earlier in the journey."],"action":["Name each attribution view precisely.","Deduplicate buyers across content."],"trap":"Adding assisted conversions from several articles can count the same customer repeatedly.","quote":"A UTM tells you about the click. Not the whole story.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A UTM tells you about the click. Not the whole story.","text":"Campaign parameters describe an instrumented origin.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Attribution","text":"Campaign parameters describe an instrumented origin. They do not alone prove a piece of content caused a purchase decision.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Adding assisted conversions from several articles can count the same customer repeatedly.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Name each attribution view precisely.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Deduplicate buyers across content.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"075","slug":"views-to-buyers","term":"Views to buyers","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["experiment-preregistration","attribution","distribution-is-the-moat"],"fr":{"title":"Un million de vues peut rater le problème.","dek":"Les vues mesurent une exposition selon la définition de la plateforme.","point":"Les vues mesurent une exposition selon la définition de la plateforme. Les nouveaux acheteurs mesurent un résultat commercial distinct, qui exige une définition et une source propres.","body":["Suivez le passage entre contenu, visite, usage et achat sans supposer que toutes les personnes sont identifiables. Pour un premier achat, excluez les renouvellements et les tests selon des règles documentées. Une hausse de vues peut rester utile pour la notoriété ; elle ne doit pas être rebaptisée croissance de clients.","Un article peut contribuer à plusieurs objectifs : compréhension, recrutement d’opérateurs ou découverte du produit. Définissez celui que vous évaluez avant de réécrire son CTA. Une page sans achat directement attribué peut encore rendre un service réel. Le piège consiste à confondre cette valeur possible avec un résultat commercial déjà démontré."],"action":["Définir le résultat commercial attendu.","Conserver les limites de rapprochement des identités."],"trap":"Un checkout ouvert ou une simulation ne constitue pas un paiement réel.","quote":"Un million de vues peut rater le problème.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un million de vues peut rater le problème.","text":"Les vues mesurent une exposition selon la définition de la plateforme.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Views to buyers","text":"Les vues mesurent une exposition selon la définition de la plateforme. Les nouveaux acheteurs mesurent un résultat commercial distinct, qui exige une définition et une source propres.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un checkout ouvert ou une simulation ne constitue pas un paiement réel.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir le résultat commercial attendu.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Conserver les limites de rapprochement des identités.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"A million views can miss the problem.","dek":"Views measure exposure under the platform’s definition.","point":"Views measure exposure under the platform’s definition. New buyers measure a separate commercial outcome requiring its own definition and source.","body":["Track movement from content to visit, use and purchase without assuming everyone is identifiable. For first purchases, exclude renewals and tests under documented rules. More views may still support awareness; they should not be renamed customer growth.","An article can support several goals: understanding, operator recruitment or product discovery. Define which one is being evaluated before rewriting its CTA. A page without directly attributed purchases may still provide real value. The trap is confusing that possible value with an already demonstrated commercial outcome. Keep each objective and evidence source separate so useful recruitment or learning paths are not erased by an overly narrow sales metric."],"action":["Define the intended commercial outcome.","Retain identity-matching limitations."],"trap":"An opened checkout or preview is not a real payment.","quote":"A million views can miss the problem.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A million views can miss the problem.","text":"Views measure exposure under the platform’s definition.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Views to buyers","text":"Views measure exposure under the platform’s definition. New buyers measure a separate commercial outcome requiring its own definition and source.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An opened checkout or preview is not a real payment.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the intended commercial outcome.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Retain identity-matching limitations.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"076","slug":"experiment-preregistration","term":"Preregistration","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["stop-rules","views-to-buyers","distribution-is-the-moat"],"fr":{"title":"Écrire le verdict possible avant de connaître le score.","dek":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue.","point":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue. Cela limite les récits reconstruits après observation.","body":["Un document daté suffit pour commencer : hypothèse, groupes, durée, indicateur principal, exclusions et décision attendue. Vous pouvez modifier le plan si la réalité l’exige, à condition de garder la version précédente et d’expliquer pourquoi. L’exploration reste possible ; elle doit être identifiée comme telle.","Ajoutez un exemple de conclusion acceptable pour chaque issue : signal favorable, différence incertaine ou problème de mesure. Cet exercice révèle souvent les protocoles qui ne savent pas quoi faire d’un résultat négatif. Une bonne expérience doit rester informative quand elle contrarie le plan initial. Sinon, elle sert surtout à produire une justification après coup."],"action":["Figer une version du plan avant collecte.","Journaliser les écarts et analyses exploratoires."],"trap":"Préenregistrer un mauvais protocole ne le rend pas valide ; cela rend seulement ses choix visibles.","quote":"Écrire le verdict possible avant de connaître le score.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Écrire le verdict possible avant de connaître le score.","text":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Preregistration","text":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue. Cela limite les récits reconstruits après observation.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Préenregistrer un mauvais protocole ne le rend pas valide ; cela rend seulement ses choix visibles.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Figer une version du plan avant collecte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Journaliser les écarts et analyses exploratoires.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Write possible verdicts before knowing the score.","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance.","point":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance. It limits stories reconstructed after observation.","body":["A dated document is enough to begin: hypothesis, groups, duration, primary metric, exclusions and expected decision. You can modify the plan when reality demands it, provided the previous version and explanation remain. Exploration is still possible; label it as exploration.","Add an acceptable conclusion for each outcome: favorable signal, uncertain difference or measurement failure. This often exposes protocols that have no response to negative results. A useful experiment should remain informative when it contradicts the initial plan. Otherwise it mainly produces retrospective justification. Recording these possibilities also helps reviewers distinguish the intended decision from additional questions discovered while the experiment was already underway."],"action":["Freeze a plan version before collection.","Log departures and exploratory analyses."],"trap":"Preregistering a poor protocol does not validate it; it makes its choices visible.","quote":"Write possible verdicts before knowing the score.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Write possible verdicts before knowing the score.","text":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Preregistration","text":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance. It limits stories reconstructed after observation.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Preregistering a poor protocol does not validate it; it makes its choices visible.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Freeze a plan version before collection.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Log departures and exploratory analyses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"077","slug":"stop-rules","term":"Stop rules","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["evidence-ladder","experiment-preregistration","distribution-is-the-moat"],"fr":{"title":"Savoir arrêter fait partie du test.","dek":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience.","point":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience. Elle doit considérer l’information attendue et les contraintes opérationnelles.","body":["Définissez une limite de durée et les incidents qui justifient une pause : données manquantes, mauvais asset, changement de périmètre. Arrêter dès qu’un chiffre devient flatteur peut sélectionner un hasard favorable. Continuer indéfiniment jusqu’à trouver un succès n’est pas davantage une méthode.","Une pause pour fichier incorrect doit préserver les observations déjà valides et identifier les publications concernées. Ne mélangez pas automatiquement avant et après correction. Selon le changement, il faudra poursuivre, recommencer une partie du test ou accepter une conclusion limitée. La règle d’arrêt protège l’interprétation autant que le budget."],"action":["Définir échéance et critères de pause.","Séparer arrêt opérationnel et conclusion statistique."],"trap":"Une expérience interrompue n’a pas forcément de verdict ; elle peut simplement être incomplète.","quote":"Savoir arrêter fait partie du test.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Savoir arrêter fait partie du test.","text":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Stop rules","text":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience. Elle doit considérer l’information attendue et les contraintes opérationnelles.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une expérience interrompue n’a pas forcément de verdict ; elle peut simplement être incomplète.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir échéance et critères de pause.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Séparer arrêt opérationnel et conclusion statistique.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Knowing when to stop is part of the test.","dek":"A stop rule specifies when to end, pause or reconsider an experiment.","point":"A stop rule specifies when to end, pause or reconsider an experiment. It should account for expected information and operational constraints.","body":["Set a duration limit and incidents requiring a pause: missing data, wrong assets, changed scope. Stopping as soon as a number looks attractive can select favorable noise. Continuing indefinitely until success appears is no better method.","A pause for an incorrect file should preserve valid observations and identify affected posts. Do not automatically merge results before and after correction. Depending on the change, continue, restart part of the test or accept a limited conclusion. The stop rule protects interpretation as well as budget. Record who made the decision and why so a later reviewer can understand whether the final dataset still answers the original question."],"action":["Define deadline and pause criteria.","Separate operational stopping from statistical conclusions."],"trap":"An interrupted experiment need not have a verdict; it may simply be incomplete.","quote":"Knowing when to stop is part of the test.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Knowing when to stop is part of the test.","text":"A stop rule specifies when to end, pause or reconsider an experiment.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Stop rules","text":"A stop rule specifies when to end, pause or reconsider an experiment. It should account for expected information and operational constraints.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An interrupted experiment need not have a verdict; it may simply be incomplete.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define deadline and pause criteria.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate operational stopping from statistical conclusions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"078","slug":"evidence-ladder","term":"Evidence ladder","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["viral-hit","stop-rules","distribution-is-the-moat"],"fr":{"title":"Une hypothèse mérite une étiquette, pas un déguisement.","dek":"L’échelle AGD distingue documentation de plateforme, données propriétaires méthodiques, expériences contrôlées, observations répétées, hypothèses et folklore.","point":"L’échelle AGD distingue documentation de plateforme, données propriétaires méthodiques, expériences contrôlées, observations répétées, hypothèses et folklore. Chaque affirmation doit garder sa provenance.","body":["Une documentation peut confirmer qu’une fonction existe sans prouver son effet sur la portée. Une observation interne peut signaler un motif sans établir une cause. Écrivez donc la proposition exacte soutenue par chaque source. Le niveau de preuve appartient à l’affirmation, pas au prestige de l’auteur ou au nombre de liens en bas de page.","Pendant la relecture, soulignez les verbes qui affirment une cause : augmente, réduit, provoque. Demandez quel élément permet chacun de ces verbes. Une reformulation descriptive peut parfois être plus juste : nous observons un écart, sa cause reste inconnue. Ce travail phrase par phrase vaut davantage qu’un badge global « data-driven » en haut de l’article."],"action":["Associer chaque affirmation à une source ou une étiquette.","Garder inconnus les effets non mesurés."],"trap":"Une source promotionnelle ne devient pas indépendante parce qu’un autre média la cite.","quote":"Une hypothèse mérite une étiquette, pas un déguisement.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une hypothèse mérite une étiquette, pas un déguisement.","text":"L’échelle AGD distingue documentation de plateforme, données propriétaires méthodiques, expériences contrôlées, observations répétées, hypothèses et folklore.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Evidence ladder","text":"L’échelle AGD distingue documentation de plateforme, données propriétaires méthodiques, expériences contrôlées, observations répétées, hypothèses et folklore. Chaque affirmation doit garder sa provenance.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une source promotionnelle ne devient pas indépendante parce qu’un autre média la cite.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Associer chaque affirmation à une source ou une étiquette.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Garder inconnus les effets non mesurés.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"A hypothesis needs a label, not a disguise.","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore.","point":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore. Every claim should retain provenance.","body":["Documentation may confirm a feature exists without proving its effect on reach. Internal observation may reveal a pattern without establishing a cause. Write the exact proposition supported by each source. Evidence level belongs to the claim, not author prestige or the number of links below it.","During review, underline verbs asserting a cause: increases, reduces, causes. Ask what evidence supports each one. A descriptive rewrite may be more accurate: a difference is observed and its cause remains unknown. This sentence-level work is more useful than a global “data-driven” badge above the article. Readers need to know which proposition a source actually supports, especially when one paragraph combines documented features with untested performance hypotheses."],"action":["Attach a source or label to each claim.","Keep unmeasured effects unknown."],"trap":"A promotional source does not become independent because another publication cites it.","quote":"A hypothesis needs a label, not a disguise.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A hypothesis needs a label, not a disguise.","text":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Evidence ladder","text":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore. Every claim should retain provenance.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A promotional source does not become independent because another publication cites it.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach a source or label to each claim.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep unmeasured effects unknown.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"079","slug":"ai-agd","term":"AI AGD","category":"machines","kind":"guide","image":"signal","tier":"canonical","evidence":"editorial","sources":[],"related":["agentic-agd","agent-audit-log","distribution-is-the-moat"],"fr":{"title":"L’IA peut penser le système avant de remplir le calendrier.","dek":"AI AGD désigne l’usage de l’IA pour planifier, produire, analyser ou orchestrer l’AGD.","point":"AI AGD désigne l’usage de l’IA pour planifier, produire, analyser ou orchestrer l’AGD. Cela n’implique pas une exécution entièrement autonome.","body":["Le premier gain peut être une meilleure classification des idées plutôt qu’un plus grand nombre de vidéos. Demandez à l’agent de repérer les concepts redondants, les publics oubliés et les hypothèses sans mesure. Puis confrontez ses propositions au contexte réel. Une liste convaincante n’est pas une preuve qu’il connaît vos clients.","Un exercice simple consiste à donner dix briefs à l’agent et à lui demander où deux comptes racontent la même chose. Exigez qu’il cite les passages concernés. Vous obtenez alors une proposition vérifiable plutôt qu’un jugement général. La valeur vient de l’aide à la décision, même si aucune publication supplémentaire n’est produite."],"action":["Confier une tâche d’analyse bornée.","Faire vérifier les classifications avant de les utiliser."],"trap":"L’aisance rédactionnelle d’un modèle peut masquer une connaissance insuffisante du terrain.","quote":"L’IA peut penser le système avant de remplir le calendrier.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"L’IA peut penser le système avant de remplir le calendrier.","text":"AI AGD désigne l’usage de l’IA pour planifier, produire, analyser ou orchestrer l’AGD.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"AI AGD","text":"AI AGD désigne l’usage de l’IA pour planifier, produire, analyser ou orchestrer l’AGD. Cela n’implique pas une exécution entièrement autonome.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"L’aisance rédactionnelle d’un modèle peut masquer une connaissance insuffisante du terrain.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Confier une tâche d’analyse bornée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Faire vérifier les classifications avant de les utiliser.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"AI can think about the system before filling the calendar.","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD.","point":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD. It does not imply fully autonomous execution.","body":["The first gain may be better idea classification rather than more videos. Ask an agent to find redundant concepts, overlooked audiences and unmeasured hypotheses. Compare its proposals with real context. A convincing list does not prove it understands your customers.","Give an agent ten briefs and ask where two accounts are saying the same thing. Require it to cite the relevant passages. This produces a checkable proposal rather than a general judgment. The value comes from decision support even if no additional post is produced. Keep corrections to its classification so later prompts can reflect the distinctions your team actually cares about."],"action":["Assign a bounded analytical task.","Verify classifications before using them."],"trap":"A model’s fluent writing can hide insufficient knowledge of actual conditions.","quote":"AI can think about the system before filling the calendar.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"AI can think about the system before filling the calendar.","text":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"AI AGD","text":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD. It does not imply fully autonomous execution.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A model’s fluent writing can hide insufficient knowledge of actual conditions.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Assign a bounded analytical task.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Verify classifications before using them.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"080","slug":"agentic-agd","term":"Agentic AGD","category":"machines","kind":"guide","image":"signal","tier":"canonical","evidence":"editorial","sources":[],"related":["human-api","ai-agd","distribution-is-the-moat"],"fr":{"title":"Un agent de distribution n’est pas un calendrier qui parle.","dek":"Agentic AGD organise des décisions récurrentes entre comptes, contenus, marchés et expériences.","point":"Agentic AGD organise des décisions récurrentes entre comptes, contenus, marchés et expériences. L’agent coordonne le système dans un périmètre explicitement défini.","body":["Un agent utile sait quelle information manque et quelle action il est autorisé à entreprendre. Il peut proposer une allocation, détecter une anomalie ou préparer un brief. La boucle doit préciser qui approuve les changements de budget et comment arrêter une exécution. Sans ces frontières, une démonstration d’autonomie devient une dette opérationnelle.","Pour commencer, laissez l’agent proposer la prochaine expérience avec ses données d’appui et ses limites. Un humain peut ensuite corriger le plan avant toute mutation. Archivez ces corrections : elles montrent les règles encore implicites. Le système devient plus autonome quand ces règles sont comprises et vérifiables, pas quand on retire arbitrairement la validation."],"action":["Écrire le périmètre d’action.","Définir les exceptions qui reviennent à un humain."],"trap":"Un agent capable d’appeler un outil n’est pas automatiquement autorisé à l’utiliser en réel.","quote":"Un agent de distribution n’est pas un calendrier qui parle.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un agent de distribution n’est pas un calendrier qui parle.","text":"Agentic AGD organise des décisions récurrentes entre comptes, contenus, marchés et expériences.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Agentic AGD","text":"Agentic AGD organise des décisions récurrentes entre comptes, contenus, marchés et expériences. L’agent coordonne le système dans un périmètre explicitement défini.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un agent capable d’appeler un outil n’est pas automatiquement autorisé à l’utiliser en réel.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire le périmètre d’action.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Définir les exceptions qui reviennent à un humain.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A distribution agent is not a talking calendar.","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments.","point":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments. The agent operates within an explicitly defined scope.","body":["A useful agent knows which information is missing and which actions it may take. It can propose allocation, detect anomalies or prepare briefs. The loop should specify who approves budget changes and how execution stops. Without boundaries, an autonomy demo becomes operational debt.","Begin by having the agent propose the next experiment with supporting observations and limitations. A human can correct the plan before mutations occur. Keep those corrections because they expose still-implicit rules. The system becomes more autonomous when its rules are understood and checkable, not when approval is arbitrarily removed. This gives the team a concrete basis for expanding scope gradually."],"action":["Write the action scope.","Define exceptions that return to a human."],"trap":"An agent able to call a tool is not automatically authorized to use it live.","quote":"A distribution agent is not a talking calendar.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A distribution agent is not a talking calendar.","text":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Agentic AGD","text":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments. The agent operates within an explicitly defined scope.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An agent able to call a tool is not automatically authorized to use it live.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the action scope.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define exceptions that return to a human.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"081","slug":"human-api","term":"Human API","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/"],"related":["mcp-orchestration","agentic-agd","distribution-is-the-moat"],"tokportal":"mcp","fr":{"title":"Derrière l’API, quelqu’un ouvre vraiment l’app.","dek":"Une Human API expose un workflow logiciel dont une partie est exécutée par des personnes.","point":"Une Human API expose un workflow logiciel dont une partie est exécutée par des personnes. Dans le contexte TokPortal, orchestration et interaction native sont deux couches distinctes.","body":["Un appel peut créer une mission plutôt qu’une publication immédiate. L’intégration doit donc gérer attente, statut et correction. Concevez votre produit autour de ce cycle réel : demande reçue, travail exécuté, résultat vérifié. Masquer la latence derrière un message de succès instantané donne à l’utilisateur une fausse image de ce qui s’est passé.","Dans l’interface client, un état « demande acceptée » peut précéder « publication vérifiée ». Ajoutez une manière de traiter les retards et les corrections. Cette distinction est importante pour les agents : ils ne doivent pas analyser une mission comme un post déjà visible. Le contrat logiciel gagne à respecter le temps réel du travail humain."],"action":["Distinguer acceptation et livraison.","Prévoir un retour de statut et une gestion des corrections."],"trap":"Un HTTP réussi peut confirmer la création d’une demande sans confirmer son exécution finale.","quote":"Derrière l’API, quelqu’un ouvre vraiment l’app.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Derrière l’API, quelqu’un ouvre vraiment l’app.","text":"Une Human API expose un workflow logiciel dont une partie est exécutée par des personnes.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Human API","text":"Une Human API expose un workflow logiciel dont une partie est exécutée par des personnes. Dans le contexte TokPortal, orchestration et interaction native sont deux couches distinctes.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un HTTP réussi peut confirmer la création d’une demande sans confirmer son exécution finale.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Distinguer acceptation et livraison.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Prévoir un retour de statut et une gestion des corrections.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Behind the API, someone actually opens the app.","dek":"A Human API exposes a software workflow partly executed by people.","point":"A Human API exposes a software workflow partly executed by people. In TokPortal’s context, orchestration and native interaction are separate layers.","body":["A call may create a mission rather than immediately publish a post. Integrations therefore need waiting, status and correction handling. Design around the real cycle: request received, work executed, result verified. Hiding latency behind instant success misrepresents what happened.","A client interface can show request accepted before publication verified. Add handling for delays and corrections. This matters for agents: they should not analyze a mission as though it were already a visible post. The software contract should respect the actual time of human work. Clear intermediate states make integrations more useful without promising instantaneous execution the underlying operation does not provide."],"action":["Separate acceptance from delivery.","Plan status feedback and correction handling."],"trap":"A successful HTTP response can confirm request creation without confirming final execution.","quote":"Behind the API, someone actually opens the app.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Behind the API, someone actually opens the app.","text":"A Human API exposes a software workflow partly executed by people.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Human API","text":"A Human API exposes a software workflow partly executed by people. In TokPortal’s context, orchestration and native interaction are separate layers.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful HTTP response can confirm request creation without confirming final execution.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Separate acceptance from delivery.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan status feedback and correction handling.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"082","slug":"mcp-orchestration","term":"MCP orchestration","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["dry-run-contract","human-api","distribution-is-the-moat"],"tokportal":"mcp","fr":{"title":"Le MCP relie des outils. Il n’écrit pas ta stratégie.","dek":"MCP permet à un client d’agent de découvrir et appeler des outils exposés par un serveur.","point":"MCP permet à un client d’agent de découvrir et appeler des outils exposés par un serveur. Le catalogue technique doit être relié à un objectif et à des limites d’action.","body":["Lisez les descriptions et annotations avant de construire une recette. Une opération en lecture n’a pas le même effet qu’une création payante. Sur TokPortal, la documentation distingue serveur local et distant. Choisissez le transport adapté à votre environnement, puis testez le contrat en simulation avant toute exécution commerciale.","Une recette lisible nomme l’intention avant la suite d’appels : préparer un compte dans un marché, vérifier son état, organiser une publication. Chaque étape doit annoncer ce qu’elle attend de la précédente. Le lecteur peut ainsi comprendre les dépendances et repérer pourquoi un identifiant fictif de simulation ne doit jamais traverser vers une opération réelle."],"action":["Découvrir le catalogue actuel.","Séparer outils de lecture et opérations mutantes."],"trap":"Le nom d’un outil ne suffit pas à comprendre ses coûts et ses effets secondaires.","quote":"Le MCP relie des outils. Il n’écrit pas ta stratégie.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le MCP relie des outils. Il n’écrit pas ta stratégie.","text":"MCP permet à un client d’agent de découvrir et appeler des outils exposés par un serveur.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"MCP orchestration","text":"MCP permet à un client d’agent de découvrir et appeler des outils exposés par un serveur. Le catalogue technique doit être relié à un objectif et à des limites d’action.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le nom d’un outil ne suffit pas à comprendre ses coûts et ses effets secondaires.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Découvrir le catalogue actuel.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Séparer outils de lecture et opérations mutantes.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"MCP connects tools. It does not write your strategy.","dek":"MCP lets an agent client discover and call tools exposed by a server.","point":"MCP lets an agent client discover and call tools exposed by a server. Its technical catalog still needs an objective and action boundaries.","body":["Read descriptions and annotations before composing a recipe. A read operation differs from paid creation. TokPortal’s documentation distinguishes local and remote servers. Choose transport for your environment and test the contract in preview before commercial execution.","A readable recipe names the intent before listing calls: prepare an account in a market, verify its state, organize publication. Each step should state what it requires from the previous one. Readers can then understand dependencies and see why synthetic preview identifiers must never pass into live operations. Tool availability is only one part of building a coherent, authorized workflow."],"action":["Discover the current catalog.","Separate read tools from mutations."],"trap":"A tool name is not enough to understand costs and side effects.","quote":"MCP connects tools. It does not write your strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"MCP connects tools. It does not write your strategy.","text":"MCP lets an agent client discover and call tools exposed by a server.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"MCP orchestration","text":"MCP lets an agent client discover and call tools exposed by a server. Its technical catalog still needs an objective and action boundaries.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A tool name is not enough to understand costs and side effects.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Discover the current catalog.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate read tools from mutations.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"083","slug":"dry-run-contract","term":"Dry-run contract","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/sandbox/"],"related":["idempotency","mcp-orchestration","distribution-is-the-moat"],"tokportal":"sandbox","fr":{"title":"Une simulation doit savoir ce qu’elle ne simule pas.","dek":"Un dry run valide une requête sans produire ses effets réels selon le contrat du service.","point":"Un dry run valide une requête sans produire ses effets réels selon le contrat du service. Il ne constitue pas une garantie de capacité ou de résultat futur.","body":["Dans le MCP TokPortal, dry_run se place au niveau supérieur des arguments, pas dans body. La version locale doit être compatible avec ce contrat. Lisez les champs de réponse indiquant les charges simulées et réelles. Les identifiants de preview restent synthétiques : la transition en réel demande de créer puis d’utiliser les véritables ressources.","Dans le résultat présenté à l’humain, affichez le mode, la requête et les charges annoncées. N’écrivez pas « compte créé » quand le service a seulement validé une simulation. Ce choix de mots évite qu’un autre agent poursuive le travail sur une ressource imaginaire. La bonne frontière est à la fois technique et compréhensible dans le compte rendu."],"action":["Vérifier la version et la réponse de simulation.","Garder une frontière explicite avec l’exécution réelle."],"trap":"Un preview réussi n’autorise pas une dépense et ne réserve pas de capacité.","quote":"Une simulation doit savoir ce qu’elle ne simule pas.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une simulation doit savoir ce qu’elle ne simule pas.","text":"Un dry run valide une requête sans produire ses effets réels selon le contrat du service.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Dry-run contract","text":"Un dry run valide une requête sans produire ses effets réels selon le contrat du service. Il ne constitue pas une garantie de capacité ou de résultat futur.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un preview réussi n’autorise pas une dépense et ne réserve pas de capacité.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Vérifier la version et la réponse de simulation.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Garder une frontière explicite avec l’exécution réelle.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A preview must know what it does not simulate.","dek":"A dry run validates a request without producing live effects under the service’s contract.","point":"A dry run validates a request without producing live effects under the service’s contract. It does not guarantee future capacity or outcomes.","body":["In TokPortal MCP, dry_run belongs at the top argument level, not inside body. The local version must support that contract. Read response fields for simulated and actual charges. Preview identifiers remain synthetic: moving live requires creating and using actual resources.","Show the mode, request and reported charges in the human-readable result. Do not say account created when the service only validated a preview. That wording prevents another agent from continuing work against an imaginary resource. The boundary should be both technical and understandable in the report, especially when output is copied into another task without the full execution history attached."],"action":["Check version and preview response.","Keep an explicit boundary before live execution."],"trap":"A successful preview neither authorizes spending nor reserves capacity.","quote":"A preview must know what it does not simulate.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A preview must know what it does not simulate.","text":"A dry run validates a request without producing live effects under the service’s contract.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Dry-run contract","text":"A dry run validates a request without producing live effects under the service’s contract. It does not guarantee future capacity or outcomes.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful preview neither authorizes spending nor reserves capacity.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check version and preview response.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep an explicit boundary before live execution.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"084","slug":"idempotency","term":"Idempotency","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["webhooks","dry-run-contract","distribution-is-the-moat"],"fr":{"title":"Réessayer sans commander deux fois.","dek":"L’idempotence évite qu’une même intention répétée produise plusieurs effets lorsque l’opération et son contrat la prennent en charge.","point":"L’idempotence évite qu’une même intention répétée produise plusieurs effets lorsque l’opération et son contrat la prennent en charge. Elle ne s’applique pas indistinctement à tous les outils.","body":["Après un timeout, ne supposez pas que rien ne s’est passé. Vérifiez l’état ou réutilisez la même clé pour la même intention si l’endpoint le prévoit. La documentation TokPortal exclut certaines opérations qui renvoient des secrets du mécanisme de replay. Une nouvelle clé à chaque retry annule précisément la protection recherchée.","Documentez ce que signifie « même intention » pour l’application. Un retry après perte de réponse n’est pas une nouvelle commande ; un changement de pays ou de contenu peut l’être. Cette distinction doit être visible dans le journal. Elle évite autant les doublons coûteux que les reprises ambiguës sur des paramètres qui ont changé."],"action":["Conserver une clé par intention logique.","Relire les exceptions documentées."],"trap":"Réutiliser une clé pour une autre commande peut créer une ambiguïté de contrat.","quote":"Réessayer sans commander deux fois.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Réessayer sans commander deux fois.","text":"L’idempotence évite qu’une même intention répétée produise plusieurs effets lorsque l’opération et son contrat la prennent en charge.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Idempotency","text":"L’idempotence évite qu’une même intention répétée produise plusieurs effets lorsque l’opération et son contrat la prennent en charge. Elle ne s’applique pas indistinctement à tous les outils.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Réutiliser une clé pour une autre commande peut créer une ambiguïté de contrat.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Conserver une clé par intention logique.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Relire les exceptions documentées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Retry without ordering twice.","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract.","point":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract. It does not apply indiscriminately to every tool.","body":["After a timeout, do not assume nothing happened. Check state or reuse the same key for the same intent when supported. TokPortal documentation excludes some secret-bearing operations from replay. A fresh key on every retry defeats the protection you wanted.","Document what the application considers the same intent. Retrying after a lost response is not a new order; changing country or content may be. Make that distinction visible in the log. It prevents both costly duplicates and ambiguous replays after parameters change. When the service’s contract is unclear, inspect state before retrying rather than treating every timeout as proof of failure."],"action":["Keep one key per logical intent.","Review documented exceptions."],"trap":"Reusing a key for a different request can create contract ambiguity.","quote":"Retry without ordering twice.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Retry without ordering twice.","text":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Idempotency","text":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract. It does not apply indiscriminately to every tool.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Reusing a key for a different request can create contract ambiguity.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep one key per logical intent.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review documented exceptions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"085","slug":"webhooks","term":"Webhooks","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["agent-budget","idempotency","distribution-is-the-moat"],"fr":{"title":"Le webhook annonce un fait. Il ne remplace pas ton état.","dek":"Un webhook transmet un événement vers votre intégration.","point":"Un webhook transmet un événement vers votre intégration. Le consommateur doit vérifier son authenticité, traiter les répétitions et réconcilier les états selon le contrat documenté.","body":["Ne supposez pas que les événements arrivent une seule fois ou dans l’ordre attendu. Conservez un identifiant lorsque le service en fournit un et prévoyez une lecture de l’état actuel. Les secrets de signature doivent rester dans un stockage approprié, pas dans le code client. L’utilisateur voit ainsi une progression fondée sur des faits vérifiés.","Un consommateur peut conserver le dernier état confirmé et la date de réception. Si un événement semble contradictoire, une lecture de l’état source permet de trancher selon le contrat disponible. Le journal doit garder l’incident sans exposer le secret de signature. La fiabilité se construit dans ces reprises, pas seulement dans la réception du premier événement de démonstration."],"action":["Appliquer la vérification documentée.","Prévoir déduplication et réconciliation."],"trap":"Un événement reçu n’est fiable qu’après les contrôles adaptés au service.","quote":"Le webhook annonce un fait. Il ne remplace pas ton état.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le webhook annonce un fait. Il ne remplace pas ton état.","text":"Un webhook transmet un événement vers votre intégration.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Webhooks","text":"Un webhook transmet un événement vers votre intégration. Le consommateur doit vérifier son authenticité, traiter les répétitions et réconcilier les états selon le contrat documenté.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un événement reçu n’est fiable qu’après les contrôles adaptés au service.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Appliquer la vérification documentée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Prévoir déduplication et réconciliation.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A webhook reports an event. It does not replace your state.","dek":"A webhook sends an event to your integration.","point":"A webhook sends an event to your integration. Consumers should verify authenticity, handle repetition and reconcile state under the documented contract.","body":["Do not assume events arrive exactly once or in the expected order. Retain identifiers when provided and allow reading current state. Signing secrets belong in appropriate storage, not client code. Users then see progress grounded in verified events.","A consumer can retain the latest confirmed state and receipt time. If an event appears contradictory, reading source state can resolve it under the available contract. Keep an incident record without exposing the signing secret. Reliability is built in these recovery paths, not merely in receiving the first demonstration event. Test duplicate and delayed delivery cases before depending on the integration for unattended decisions."],"action":["Apply documented verification.","Plan deduplication and reconciliation."],"trap":"A received event is trustworthy only after service-appropriate checks.","quote":"A webhook reports an event. It does not replace your state.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A webhook reports an event. It does not replace your state.","text":"A webhook sends an event to your integration.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Webhooks","text":"A webhook sends an event to your integration. Consumers should verify authenticity, handle repetition and reconcile state under the documented contract.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A received event is trustworthy only after service-appropriate checks.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Apply documented verification.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan deduplication and reconciliation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"086","slug":"agent-budget","term":"Agent budgets","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["agent-maturity","webhooks","distribution-is-the-moat"],"tokportal":"mcp","fr":{"title":"Un agent sans plafond n’a pas un budget.","dek":"Un budget d’agent définit les opérations autorisées, les limites et les conditions de renouvellement.","point":"Un budget d’agent définit les opérations autorisées, les limites et les conditions de renouvellement. Il doit distinguer dépenses immédiates, récurrentes et coûts seulement estimés.","body":["Faites lire les prix actuels et l’état du compte avant de proposer un plan. La simulation prépare une décision ; l’autorisation fixe ce qui peut réellement être exécuté. Conservez l’écart entre prévision et dépense constatée. Une boucle qui relance des tâches après erreur doit aussi respecter le plafond initial.","Une interface de validation peut présenter séparément coût immédiat et engagement récurrent estimé. Elle doit aussi indiquer ce qui n’a pas pu être chiffré. L’humain approuve alors un périmètre concret. Si le plan change ensuite, comparez le nouveau coût à cette autorisation au lieu de supposer que le premier accord couvre toute extension future."],"action":["Définir périmètre, plafond et durée.","Arrêter les mutations quand la limite est atteinte."],"trap":"Un solde disponible n’est pas une autorisation de le dépenser intégralement.","quote":"Un agent sans plafond n’a pas un budget.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un agent sans plafond n’a pas un budget.","text":"Un budget d’agent définit les opérations autorisées, les limites et les conditions de renouvellement.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Agent budgets","text":"Un budget d’agent définit les opérations autorisées, les limites et les conditions de renouvellement. Il doit distinguer dépenses immédiates, récurrentes et coûts seulement estimés.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un solde disponible n’est pas une autorisation de le dépenser intégralement.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir périmètre, plafond et durée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Arrêter les mutations quand la limite est atteinte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"An agent without a ceiling has no budget.","dek":"An agent budget defines authorized operations, limits and renewal conditions.","point":"An agent budget defines authorized operations, limits and renewal conditions. It should distinguish immediate spending, recurring charges and estimates.","body":["Read current prices and account state before proposing a plan. Preview prepares a decision; authorization defines what can execute. Keep estimated and actual spending separate. A loop restarting tasks after errors should still respect the original ceiling.","An approval interface can separate immediate cost from estimated recurring commitment and identify anything not priced. A human then approves a concrete scope. If the plan changes, compare its new cost with that authorization rather than assuming the first approval covers every future extension. Preserve the original scope in the log so later retries and revisions can be assessed against the same boundary."],"action":["Define scope, ceiling and duration.","Stop mutations when the limit is reached."],"trap":"An available balance is not authorization to spend all of it.","quote":"An agent without a ceiling has no budget.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An agent without a ceiling has no budget.","text":"An agent budget defines authorized operations, limits and renewal conditions.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Agent budgets","text":"An agent budget defines authorized operations, limits and renewal conditions. It should distinguish immediate spending, recurring charges and estimates.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An available balance is not authorization to spend all of it.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define scope, ceiling and duration.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Stop mutations when the limit is reached.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"087","slug":"agent-maturity","term":"AGD maturity model","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["api-slop","agent-budget","distribution-is-the-moat"],"fr":{"title":"L’autonomie est une échelle, pas un interrupteur.","dek":"Le modèle AGD distingue exécution manuelle, assistance IA, orchestration approuvée, gestion agentique et autonomie étendue.","point":"Le modèle AGD distingue exécution manuelle, assistance IA, orchestration approuvée, gestion agentique et autonomie étendue. Ces niveaux décrivent des responsabilités, pas des médailles.","body":["Une équipe peut être avancée en analyse et manuelle en publication. Identifiez les décisions confiées au système et les moyens de reprise humaine. Monter d’un niveau n’a d’intérêt que si la qualité de contrôle suit. Garder une validation sur les dépenses peut rester rationnel même quand les briefs sont entièrement automatisés.","Pour chaque étape, demandez comment détecter une erreur et qui peut la corriger. Une classification créative réversible et un achat réel n’ont pas les mêmes conséquences. Vous pouvez donc déléguer différemment sans incohérence. Le modèle de maturité sert à rendre ces choix explicites, pas à pousser toute l’organisation vers un niveau maximal."],"action":["Cartographier les responsabilités par étape.","Automatiser là où les erreurs sont détectables et récupérables."],"trap":"Le niveau le plus autonome n’est pas nécessairement le meilleur pour chaque organisation.","quote":"L’autonomie est une échelle, pas un interrupteur.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"L’autonomie est une échelle, pas un interrupteur.","text":"Le modèle AGD distingue exécution manuelle, assistance IA, orchestration approuvée, gestion agentique et autonomie étendue.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"AGD maturity model","text":"Le modèle AGD distingue exécution manuelle, assistance IA, orchestration approuvée, gestion agentique et autonomie étendue. Ces niveaux décrivent des responsabilités, pas des médailles.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le niveau le plus autonome n’est pas nécessairement le meilleur pour chaque organisation.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Cartographier les responsabilités par étape.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Automatiser là où les erreurs sont détectables et récupérables.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Autonomy is a ladder, not a switch.","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy.","point":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy. Levels describe responsibility, not medals.","body":["A team can be advanced in analysis and manual in publishing. Identify decisions delegated to the system and human recovery options. Moving up only helps if control quality follows. Keeping spending approval can remain rational even when briefs are fully automated.","For every stage, ask how an error is detected and who can correct it. Reversible creative classification and live purchasing have different consequences. You can therefore delegate them differently without inconsistency. The maturity model makes those choices explicit instead of pushing the whole organization toward a maximum level. Operational readiness matters more than how autonomous the workflow sounds in a presentation."],"action":["Map responsibility at each step.","Automate where errors can be detected and recovered."],"trap":"The most autonomous level is not necessarily best for every organization.","quote":"Autonomy is a ladder, not a switch.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Autonomy is a ladder, not a switch.","text":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"AGD maturity model","text":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy. Levels describe responsibility, not medals.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The most autonomous level is not necessarily best for every organization.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Map responsibility at each step.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Automate where errors can be detected and recovered.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"088","slug":"api-slop","term":"API Slop","category":"machines","kind":"guide","image":"signal","tier":"editorial","evidence":"editorial","sources":[],"related":["content-routing","agent-maturity","distribution-is-the-moat"],"fr":{"title":"Ton API n’est pas une stratégie de distribution.","dek":"API Slop critique un usage qui envoie massivement des contenus indifférenciés sans attention aux comptes ni au contexte.","point":"API Slop critique un usage qui envoie massivement des contenus indifférenciés sans attention aux comptes ni au contexte. La critique vise la stratégie, pas l’existence des API.","body":["Une API peut orchestrer une exécution humaine, organiser les validations ou rendre les résultats lisibles. Le problème arrive quand la facilité technique devient le seul critère de publication. Demandez à chaque envoi : pourquoi ce contenu sur ce compte ? Si la réponse est seulement « parce qu’on peut », la queue mérite une pause.","Une règle de file peut refuser un asset quand aucune justification de compte n’est fournie. Le refus ne prouve pas que le contenu est mauvais ; il indique que sa destination n’est pas encore expliquée. Cette friction utile empêche la facilité d’envoi de devenir une politique éditoriale. L’équipe peut corriger le routage ou retravailler l’idée."],"action":["Associer une justification éditoriale à chaque routage.","Refuser les duplications sans intérêt distinct."],"trap":"API ne veut pas dire mauvaise portée ; aucune pénalité générale n’est démontrée ici.","quote":"Ton API n’est pas une stratégie de distribution.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Ton API n’est pas une stratégie de distribution.","text":"API Slop critique un usage qui envoie massivement des contenus indifférenciés sans attention aux comptes ni au contexte.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"API Slop","text":"API Slop critique un usage qui envoie massivement des contenus indifférenciés sans attention aux comptes ni au contexte. La critique vise la stratégie, pas l’existence des API.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"API ne veut pas dire mauvaise portée ; aucune pénalité générale n’est démontrée ici.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Associer une justification éditoriale à chaque routage.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Refuser les duplications sans intérêt distinct.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Your API is not a distribution strategy.","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context.","point":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context. It targets strategy, not APIs themselves.","body":["An API can orchestrate human execution, manage approvals or make outcomes readable. Trouble starts when technical ease becomes the sole publishing criterion. Ask each delivery: why this content on this account? If the answer is only “because we can,” pause the queue.","A queue rule can reject an asset when no account rationale is supplied. Rejection does not prove the content is bad; it means its destination is unexplained. This useful friction prevents easy delivery from becoming editorial policy. The team can correct routing or revisit the idea before creating more versions. Automation then protects a meaningful decision instead of multiplying an unexamined one."],"action":["Attach an editorial rationale to each routing choice.","Reject duplication without distinct value."],"trap":"API does not mean poor reach; no general penalty is demonstrated here.","quote":"Your API is not a distribution strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your API is not a distribution strategy.","text":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"API Slop","text":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context. It targets strategy, not APIs themselves.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"API does not mean poor reach; no general penalty is demonstrated here.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach an editorial rationale to each routing choice.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Reject duplication without distinct value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"089","slug":"content-routing","term":"Content routing","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["creative-clustering","api-slop","distribution-is-the-moat"],"fr":{"title":"Le bon contenu peut atterrir sur le mauvais compte.","dek":"Le routage relie une création à un compte selon public, persona, marché et objectif.","point":"Le routage relie une création à un compte selon public, persona, marché et objectif. Il constitue une décision éditoriale avant d’être une opération technique.","body":["Un agent peut proposer des correspondances à partir des métadonnées, mais doit pouvoir s’abstenir. Une vidéo d’expert ne convient pas automatiquement à un compte étudiant parce que le produit est identique. Gardez une justification courte et les critères de refus. Les routages difficiles révèlent souvent des briefs de comptes insuffisamment distincts.","Conservez le motif d’affectation avec le post. Lors du bilan, comparez les correspondances évidentes et les cas hésitants. Vous pourrez améliorer les briefs ou la taxonomie plutôt que changer aveuglément les comptes. Une bonne trace de routage explique pourquoi la publication a été placée là au moment de la décision, même si le résultat déçoit ensuite."],"action":["Définir des critères d’éligibilité.","Autoriser explicitement le cas aucun compte adapté."],"trap":"Forcer une correspondance partout transforme une bibliothèque en machine à duplication.","quote":"Le bon contenu peut atterrir sur le mauvais compte.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le bon contenu peut atterrir sur le mauvais compte.","text":"Le routage relie une création à un compte selon public, persona, marché et objectif.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Content routing","text":"Le routage relie une création à un compte selon public, persona, marché et objectif. Il constitue une décision éditoriale avant d’être une opération technique.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Forcer une correspondance partout transforme une bibliothèque en machine à duplication.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir des critères d’éligibilité.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Autoriser explicitement le cas aucun compte adapté.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Good content can land on the wrong account.","dek":"Routing connects creative work to an account by audience, persona, market and purpose.","point":"Routing connects creative work to an account by audience, persona, market and purpose. It is an editorial decision before a technical operation.","body":["An agent can propose matches from metadata but should be able to abstain. Expert content does not automatically suit a student account because the product is the same. Keep a short rationale and rejection criteria. Difficult routing often reveals insufficiently distinct account briefs.","Keep the assignment rationale with the post. During review, compare obvious matches with uncertain ones. This can improve briefs or taxonomy instead of prompting blind account changes. A useful routing record explains why the content was placed there at decision time even if outcomes disappoint. It prevents hindsight from rewriting the original reason and makes the next matching decision easier to evaluate."],"action":["Define eligibility criteria.","Explicitly allow no suitable account."],"trap":"Forcing a match everywhere turns a library into a duplication engine.","quote":"Good content can land on the wrong account.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Good content can land on the wrong account.","text":"Routing connects creative work to an account by audience, persona, market and purpose.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Content routing","text":"Routing connects creative work to an account by audience, persona, market and purpose. It is an editorial decision before a technical operation.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Forcing a match everywhere turns a library into a duplication engine.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define eligibility criteria.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Explicitly allow no suitable account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"090","slug":"creative-clustering","term":"Creative clustering","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["anomaly-detection","content-routing","distribution-is-the-moat"],"fr":{"title":"Classer des idées sans gommer leurs différences.","dek":"Le clustering créatif rapproche des contenus selon des critères choisis.","point":"Le clustering créatif rapproche des contenus selon des critères choisis. Les groupes doivent être interprétables et contrôlés avant de servir à l’allocation.","body":["Un modèle peut classer deux vidéos ensemble parce qu’elles utilisent le même décor alors que leurs promesses diffèrent. Donnez une définition de l’angle, du format et de la situation. Vérifiez un échantillon de désaccords humains-machine. Le but n’est pas de fabriquer une taxonomie parfaite, mais de retrouver les décisions créatives utiles.","Utilisez quelques exemples annotés comme référence et conservez les cas qui appartiennent à plusieurs groupes. Une catégorie « ambigu » vaut mieux qu’une précision artificielle. Si l’agent classe surtout le décor, reformulez la consigne autour du problème traité. Le classement doit aider à retrouver des idées, pas seulement à remplir une colonne de métadonnées."],"action":["Définir chaque dimension de classement.","Relire les cas ambigus."],"trap":"Une proximité visuelle ne prouve pas une proximité d’intention ou d’audience.","quote":"Classer des idées sans gommer leurs différences.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Classer des idées sans gommer leurs différences.","text":"Le clustering créatif rapproche des contenus selon des critères choisis.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Creative clustering","text":"Le clustering créatif rapproche des contenus selon des critères choisis. Les groupes doivent être interprétables et contrôlés avant de servir à l’allocation.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une proximité visuelle ne prouve pas une proximité d’intention ou d’audience.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir chaque dimension de classement.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Relire les cas ambigus.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Group ideas without erasing their differences.","dek":"Creative clustering groups content under chosen criteria.","point":"Creative clustering groups content under chosen criteria. Groups should be interpretable and checked before informing allocation.","body":["A model may group videos by background while their promises differ. Define angle, format and situation. Review a sample of human-machine disagreements. The goal is not a perfect taxonomy but recoverable, useful creative decisions.","Use a few annotated examples as references and retain cases belonging to several groups. An ambiguous category is better than artificial precision. If the agent mostly classifies scenery, rewrite the instruction around the problem addressed. Grouping should help retrieve ideas rather than merely fill a metadata column. A small review set can reveal whether the labels preserve useful distinctions across genuinely different creative treatments."],"action":["Define each classification dimension.","Review ambiguous cases."],"trap":"Visual similarity does not prove similar intent or audience.","quote":"Group ideas without erasing their differences.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Group ideas without erasing their differences.","text":"Creative clustering groups content under chosen criteria.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Creative clustering","text":"Creative clustering groups content under chosen criteria. Groups should be interpretable and checked before informing allocation.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Visual similarity does not prove similar intent or audience.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define each classification dimension.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review ambiguous cases.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"091","slug":"anomaly-detection","term":"Anomaly detection","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["human-review","creative-clustering","distribution-is-the-moat"],"fr":{"title":"Une alerte utile doit dire quoi regarder.","dek":"La détection d’anomalies signale un écart à une référence définie.","point":"La détection d’anomalies signale un écart à une référence définie. Elle doit distinguer incident de collecte, changement opérationnel et résultat de distribution.","body":["Commencez par des alertes interprétables : publication attendue absente, données en retard, coût hors plafond. Ajoutez ensuite des écarts de performance avec des seuils adaptés à la variabilité. Chaque alerte doit fournir les faits, la période et une prochaine vérification. Une notification spectaculaire sans contexte fatigue l’équipe plus qu’elle ne la protège.","Une alerte « données non actualisées depuis la borne attendue » est plus exploitable qu’un score rouge sans explication. Elle indique quoi contrôler avant de conclure à une chute de performance. Ajoutez la dernière valeur fiable et la source. L’opérateur dispose alors d’une petite enquête prête à commencer, plutôt que d’une inquiétude vague à interpréter."],"action":["Associer une prochaine vérification à chaque alerte.","Mesurer les faux positifs."],"trap":"Une anomalie est un signal d’enquête, pas une cause identifiée.","quote":"Une alerte utile doit dire quoi regarder.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une alerte utile doit dire quoi regarder.","text":"La détection d’anomalies signale un écart à une référence définie.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Anomaly detection","text":"La détection d’anomalies signale un écart à une référence définie. Elle doit distinguer incident de collecte, changement opérationnel et résultat de distribution.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une anomalie est un signal d’enquête, pas une cause identifiée.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Associer une prochaine vérification à chaque alerte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Mesurer les faux positifs.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A useful alert tells you what to inspect.","dek":"Anomaly detection flags deviation from a defined baseline.","point":"Anomaly detection flags deviation from a defined baseline. It should distinguish collection issues, operating changes and distribution outcomes.","body":["Start with interpretable alerts: missing expected publication, delayed data, spending beyond limits. Add performance deviations with thresholds suited to variability. Every alert should include facts, period and next check. Dramatic notifications without context exhaust teams more than they protect them.","An alert saying data has not updated since the expected cutoff is more actionable than an unexplained red score. It identifies what to check before concluding that performance declined. Include the last reliable value and source. The operator then receives a small investigation ready to begin rather than vague concern to interpret. That specificity also helps distinguish measurement failures from genuine changes over time."],"action":["Attach a next check to every alert.","Measure false positives."],"trap":"An anomaly is an investigation signal, not an identified cause.","quote":"A useful alert tells you what to inspect.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A useful alert tells you what to inspect.","text":"Anomaly detection flags deviation from a defined baseline.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Anomaly detection","text":"Anomaly detection flags deviation from a defined baseline. It should distinguish collection issues, operating changes and distribution outcomes.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An anomaly is an investigation signal, not an identified cause.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach a next check to every alert.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Measure false positives.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"092","slug":"human-review","term":"Human review","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["source-of-truth","anomaly-detection","distribution-is-the-moat"],"fr":{"title":"La validation humaine doit porter sur une vraie décision.","dek":"Une validation humaine utile expose l’action, ses conséquences et les éléments à vérifier.","point":"Une validation humaine utile expose l’action, ses conséquences et les éléments à vérifier. Un bouton d’accord sans contexte n’apporte qu’une illusion de contrôle.","body":["Présentez le compte, l’asset, le texte, le coût et ce qui a changé depuis la dernière version. Distinguez un accord éditorial d’une autorisation financière. Si tout est marqué urgent, rien ne sera vraiment relu. Réservez les interruptions aux décisions où un humain peut modifier le résultat de façon informée.","La revue peut mettre en évidence les différences depuis la version précédente au lieu de réafficher tout le dossier. Un changement de CTA n’exige pas la même décision qu’un changement de pays ou de coût. Cette présentation aide l’humain à consacrer son attention au point qui compte. L’approbation doit rester attachée à la version réellement examinée."],"action":["Afficher une version concrète à approuver.","Définir précisément la portée de l’accord."],"trap":"La présence d’un humain dans le circuit ne prouve pas qu’il a reçu assez d’information.","quote":"La validation humaine doit porter sur une vraie décision.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La validation humaine doit porter sur une vraie décision.","text":"Une validation humaine utile expose l’action, ses conséquences et les éléments à vérifier.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Human review","text":"Une validation humaine utile expose l’action, ses conséquences et les éléments à vérifier. Un bouton d’accord sans contexte n’apporte qu’une illusion de contrôle.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"La présence d’un humain dans le circuit ne prouve pas qu’il a reçu assez d’information.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Afficher une version concrète à approuver.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Définir précisément la portée de l’accord.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Human review should contain a real decision.","dek":"Useful human review exposes the action, consequences and evidence to check.","point":"Useful human review exposes the action, consequences and evidence to check. An approval button without context offers only an illusion of control.","body":["Show account, asset, text, cost and changes since the last version. Separate editorial approval from financial authorization. If everything is urgent, little gets reviewed. Reserve interruptions for decisions where an informed human can meaningfully change the outcome.","Review can highlight changes since the previous version rather than redisplay the entire dossier. A CTA change calls for a different decision from a market or cost change. This helps humans focus attention where it matters. Approval should remain attached to the version actually reviewed. If execution uses another version, the system should detect that mismatch rather than relying on a generic historical approval flag."],"action":["Show a concrete version for approval.","Define exactly what approval covers."],"trap":"A human in the loop does not prove they received enough information.","quote":"Human review should contain a real decision.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Human review should contain a real decision.","text":"Useful human review exposes the action, consequences and evidence to check.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Human review","text":"Useful human review exposes the action, consequences and evidence to check. An approval button without context offers only an illusion of control.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A human in the loop does not prove they received enough information.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Show a concrete version for approval.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define exactly what approval covers.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"093","slug":"source-of-truth","term":"Source of truth","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["seo-agd","human-review","distribution-is-the-moat"],"tokportal":"mcp","fr":{"title":"La doc qui dit non vaut mieux que la landing qui dit tout.","dek":"La source de vérité technique décrit les capacités actuelles d’une interface.","point":"La source de vérité technique décrit les capacités actuelles d’une interface. Une page commerciale plus large peut parler d’un service qui n’est pas entièrement exposé par cette interface.","body":["Lors de la préparation de ce média, la documentation MCP TokPortal précisait que la création de bundles YouTube n’était pas disponible par l’API. Il faut conserver cette limite dans les exemples, même si d’autres pages mentionnent YouTube dans un contexte plus large. Citez la documentation datée et vérifiez le schéma avant de proposer une commande.","Quand deux pages se contredisent, consignez les URLs, la date et le périmètre de chaque affirmation. Une correction du tutoriel peut être nécessaire sans que le service global ait changé. Pour un exemple exécutable, la capacité de l’endpoint utilisé est déterminante. Ce réflexe évite de transformer un texte marketing ancien en commande invalide."],"action":["Vérifier le périmètre de l’interface utilisée.","Conserver les limites explicites dans les tutoriels."],"trap":"Une fonctionnalité du service global n’est pas forcément disponible dans chaque API ou outil MCP.","quote":"La doc qui dit non vaut mieux que la landing qui dit tout.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"La doc qui dit non vaut mieux que la landing qui dit tout.","text":"La source de vérité technique décrit les capacités actuelles d’une interface.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Source of truth","text":"La source de vérité technique décrit les capacités actuelles d’une interface. Une page commerciale plus large peut parler d’un service qui n’est pas entièrement exposé par cette interface.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une fonctionnalité du service global n’est pas forcément disponible dans chaque API ou outil MCP.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Vérifier le périmètre de l’interface utilisée.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Conserver les limites explicites dans les tutoriels.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Documentation that says no beats a page promising everything.","dek":"A technical source of truth describes an interface’s current capabilities.","point":"A technical source of truth describes an interface’s current capabilities. A broader marketing page may describe services not fully exposed through that interface.","body":["While preparing this publication, TokPortal MCP documentation stated that YouTube bundle creation was unavailable through the API. Examples should retain that limit even when other pages mention YouTube more broadly. Cite dated documentation and check the schema before proposing a command.","When pages disagree, record their URLs, date and the scope of each statement. A tutorial may need correction even when the broader service has not changed. For executable examples, the capability of the specific endpoint is decisive. This prevents older marketing copy from becoming an invalid command and makes the limitation understandable without implying that every other interface has exactly the same scope."],"action":["Check the scope of the interface being used.","Preserve explicit limitations in tutorials."],"trap":"A feature of the broader service is not necessarily available in every API or MCP tool.","quote":"Documentation that says no beats a page promising everything.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Documentation that says no beats a page promising everything.","text":"A technical source of truth describes an interface’s current capabilities.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Source of truth","text":"A technical source of truth describes an interface’s current capabilities. A broader marketing page may describe services not fully exposed through that interface.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A feature of the broader service is not necessarily available in every API or MCP tool.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check the scope of the interface being used.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Preserve explicit limitations in tutorials.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"094","slug":"seo-agd","term":"SEO AGD","category":"machines","kind":"guide","image":"signal","tier":"canonical","evidence":"editorial","sources":[],"related":["pseo-agd","source-of-truth","distribution-is-the-moat"],"fr":{"title":"Une vidéo peut avoir une deuxième vie dans la recherche.","dek":"SEO AGD explore la visibilité de contenus et propriétés sociales dans les moteurs et la recherche interne des plateformes.","point":"SEO AGD explore la visibilité de contenus et propriétés sociales dans les moteurs et la recherche interne des plateformes. Cette possibilité ne garantit ni indexation ni classement.","body":["Partez d’une question que le contenu résout réellement. Rendez le contexte explicite dans le titre, la légende ou la transcription disponible. Vérifiez que la page publique est accessible. Le contenu doit rester utile dans le feed : transformer chaque phrase en répétition de mot-clé peut dégrader le média sans améliorer sa découverte.","Un tutoriel social peut renvoyer vers une explication longue qui conserve étapes et limites. La page enrichit alors le sujet au lieu de recopier la légende. Vérifiez que le lien a un sens pour le lecteur qui découvre la vidéo sans connaître votre marque. La recherche prolonge une information utile ; elle ne doit pas justifier une duplication sans intérêt."],"action":["Relier le contenu à une intention précise.","Vérifier l’accès public et les éléments textuels utiles."],"trap":"Être accessible aux robots ne garantit pas d’être indexé ou cité.","quote":"Une vidéo peut avoir une deuxième vie dans la recherche.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Une vidéo peut avoir une deuxième vie dans la recherche.","text":"SEO AGD explore la visibilité de contenus et propriétés sociales dans les moteurs et la recherche interne des plateformes.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"SEO AGD","text":"SEO AGD explore la visibilité de contenus et propriétés sociales dans les moteurs et la recherche interne des plateformes. Cette possibilité ne garantit ni indexation ni classement.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Être accessible aux robots ne garantit pas d’être indexé ou cité.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Relier le contenu à une intention précise.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Vérifier l’accès public et les éléments textuels utiles.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A video can have a second life in search.","dek":"SEO AGD explores social content and properties appearing in search engines and platform search.","point":"SEO AGD explores social content and properties appearing in search engines and platform search. This possibility guarantees neither indexing nor ranking.","body":["Start with a question the content actually answers. Make context explicit in the title, caption or available transcript. Check that the public page is accessible. Content should remain useful in the feed: turning every sentence into keyword repetition can harm it without improving discovery.","A social tutorial can lead to a longer explanation preserving steps and limitations. The page then extends the subject instead of copying the caption. Check that the link makes sense to a viewer discovering the video without knowing the brand. Search extends useful information; it should not justify pointless duplication. Keep each surface valuable in its own context while making the connection understandable."],"action":["Connect content to a specific intent.","Check public access and useful textual elements."],"trap":"Crawler accessibility does not guarantee indexing or citation.","quote":"A video can have a second life in search.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A video can have a second life in search.","text":"SEO AGD explores social content and properties appearing in search engines and platform search.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"SEO AGD","text":"SEO AGD explores social content and properties appearing in search engines and platform search. This possibility guarantees neither indexing nor ranking.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Crawler accessibility does not guarantee indexing or citation.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect content to a specific intent.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check public access and useful textual elements.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"095","slug":"pseo-agd","term":"pSEO AGD","category":"machines","kind":"guide","image":"signal","tier":"canonical","evidence":"documented","sources":["https://developers.google.com/search/docs/essentials/spam-policies"],"related":["llm-quoting","seo-agd","distribution-is-the-moat"],"fr":{"title":"Le programmatique a besoin d’une raison par page.","dek":"pSEO AGD organise systématiquement des contenus sociaux autour d’intentions de recherche distinctes.","point":"pSEO AGD organise systématiquement des contenus sociaux autour d’intentions de recherche distinctes. Le volume n’excuse pas les pages ou publications redondantes.","body":["Une base de questions peut alimenter plusieurs formats si chaque réponse apporte une application propre. Refusez les permutations de pays ou d’outils qui ne changent rien au fond. Le système doit pouvoir bloquer un contenu sans information nouvelle. La scalabilité utile réside dans la structure et les contrôles, pas dans une obligation de remplir le sitemap.","Dans la file de rédaction, ajoutez un champ « décision ou problème distinct ». Deux sujets qui aboutissent au même exemple et à la même réponse méritent souvent une seule page plus complète. Le contrôle peut donc réduire le volume prévu. C’est une fonction saine du système : mieux couvrir une intention vaut mieux que multiplier ses formulations."],"action":["Dédupliquer les intentions avant rédaction.","Exiger une valeur spécifique à chaque sortie."],"trap":"Google peut considérer comme abusive une production massive sans valeur ajoutée pour les utilisateurs.","quote":"Le programmatique a besoin d’une raison par page.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le programmatique a besoin d’une raison par page.","text":"pSEO AGD organise systématiquement des contenus sociaux autour d’intentions de recherche distinctes.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"pSEO AGD","text":"pSEO AGD organise systématiquement des contenus sociaux autour d’intentions de recherche distinctes. Le volume n’excuse pas les pages ou publications redondantes.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Google peut considérer comme abusive une production massive sans valeur ajoutée pour les utilisateurs.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Dédupliquer les intentions avant rédaction.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Exiger une valeur spécifique à chaque sortie.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Programmatic content needs a reason for every page.","dek":"pSEO AGD systematically organizes social content around distinct search intents.","point":"pSEO AGD systematically organizes social content around distinct search intents. Volume does not excuse redundant pages or posts.","body":["A question database can feed several formats when each answer brings a distinct application. Reject country or tool permutations that change nothing substantive. The system should block content without new information. Useful scale lives in structure and checks, not an obligation to fill a sitemap.","Add a distinct decision or problem field to the writing queue. Two subjects leading to the same example and answer may deserve one more complete page. The check can therefore reduce planned volume. That is healthy system behavior: covering an intent well beats multiplying its phrasings. Scaling should make meaningful coverage easier while preserving the ability to reject output that adds nothing for readers."],"action":["Deduplicate intents before writing.","Require specific value in each output."],"trap":"Google can treat mass production without added user value as abusive.","quote":"Programmatic content needs a reason for every page.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Programmatic content needs a reason for every page.","text":"pSEO AGD systematically organizes social content around distinct search intents.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"pSEO AGD","text":"pSEO AGD systematically organizes social content around distinct search intents. Volume does not excuse redundant pages or posts.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Google can treat mass production without added user value as abusive.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Deduplicate intents before writing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Require specific value in each output.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"096","slug":"llm-quoting","term":"LLM quoting","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["knowledge-graph","pseo-agd","distribution-is-the-moat"],"fr":{"title":"Pour être cité, commencer par être citable.","dek":"Un contenu citable formule clairement une proposition, sa portée et sa provenance.","point":"Un contenu citable formule clairement une proposition, sa portée et sa provenance. Les balises ou fichiers destinés aux machines ne garantissent pas une citation par un assistant.","body":["Placez une définition autonome près du début, puis développez exemples et limites. N’utilisez pas un chiffre séduisant sans méthode. Rendez les sources consultables et le texte accessible sans interaction obligatoire. Une réponse courte peut être extraite correctement si elle contient déjà les réserves nécessaires à sa compréhension.","Relisez la définition comme si elle était extraite seule. Si une limite essentielle n’apparaît que six paragraphes plus bas, l’extrait peut déformer le propos. Rapprochez la réserve de l’affirmation. Cette discipline sert aussi aux lecteurs humains qui parcourent rapidement la page et décident ensuite s’ils ont besoin de lire le raisonnement complet."],"action":["Écrire une définition autonome.","Ajouter provenance, date et limites à la proposition."],"trap":"Un fichier llms.txt aide à orienter la lecture ; il n’existe ici aucune promesse de prise en compte.","quote":"Pour être cité, commencer par être citable.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Pour être cité, commencer par être citable.","text":"Un contenu citable formule clairement une proposition, sa portée et sa provenance.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"LLM quoting","text":"Un contenu citable formule clairement une proposition, sa portée et sa provenance. Les balises ou fichiers destinés aux machines ne garantissent pas une citation par un assistant.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un fichier llms.txt aide à orienter la lecture ; il n’existe ici aucune promesse de prise en compte.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire une définition autonome.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Ajouter provenance, date et limites à la proposition.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"To be cited, first be quotable.","dek":"Citable content clearly states a proposition, scope and provenance.","point":"Citable content clearly states a proposition, scope and provenance. Machine-oriented markup or files do not guarantee citation by an assistant.","body":["Place a self-contained definition near the start, then expand examples and limitations. Do not use an attractive number without a method. Keep sources accessible and text readable without mandatory interaction. A short answer can be extracted correctly when it already contains necessary qualifications.","Read the definition as if it were extracted alone. If an essential limitation appears six paragraphs later, the excerpt may distort the claim. Move the qualification closer. This also helps human readers scanning the page before deciding whether to read the full reasoning. Clear structure improves extractability without requiring a promise that any specific assistant will discover, select or cite the page."],"action":["Write a self-contained definition.","Attach provenance, date and limits."],"trap":"An llms.txt file can orient reading; no promise of adoption is made here.","quote":"To be cited, first be quotable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"To be cited, first be quotable.","text":"Citable content clearly states a proposition, scope and provenance.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"LLM quoting","text":"Citable content clearly states a proposition, scope and provenance. Machine-oriented markup or files do not guarantee citation by an assistant.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An llms.txt file can orient reading; no promise of adoption is made here.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a self-contained definition.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach provenance, date and limits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"097","slug":"knowledge-graph","term":"AGD content graph","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"documented","sources":["https://developers.google.com/search/docs/crawling-indexing/links-crawlable"],"related":["multilingual-seo","llm-quoting","distribution-is-the-moat"],"fr":{"title":"Un bon lien continue une idée.","dek":"Un graphe éditorial relie concepts parents, voisins et applications.","point":"Un graphe éditorial relie concepts parents, voisins et applications. Son utilité vient du sens des relations, pas du nombre de liens ajoutés automatiquement.","body":["Account Isolation mène naturellement vers Content Isolation : l’un différencie les comptes, l’autre ce qu’ils publient. Un lien vers le MCP n’est pertinent que lorsque le lecteur passe à l’orchestration. Donnez aux ancres un libellé qui annonce la suite. Des liens faciles à crawler restent d’abord des invitations adressées à une personne.","Évitez que tous les articles renvoient aux mêmes trois pages sans raison. Les relations doivent suivre l’argument : une note sur le zéro vue mène au diagnostic et à la qualité de mesure ; un essai créatif mène aux personas et aux formats. Le réseau devient navigable quand chaque lien annonce une question voisine réellement utile."],"action":["Relier parent, voisins et application concrète.","Éviter les ancres vagues."],"trap":"Le maillage ne compense pas des articles sans contenu propre.","quote":"Un bon lien continue une idée.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un bon lien continue une idée.","text":"Un graphe éditorial relie concepts parents, voisins et applications.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"AGD content graph","text":"Un graphe éditorial relie concepts parents, voisins et applications. Son utilité vient du sens des relations, pas du nombre de liens ajoutés automatiquement.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Le maillage ne compense pas des articles sans contenu propre.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Relier parent, voisins et application concrète.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Éviter les ancres vagues.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A good link continues an idea.","dek":"An editorial graph connects parent concepts, neighbors and applications.","point":"An editorial graph connects parent concepts, neighbors and applications. Its usefulness comes from meaningful relationships, not automatically added link counts.","body":["Account Isolation naturally leads to Content Isolation: one differentiates accounts, the other what they publish. An MCP link fits when the reader moves into orchestration. Give anchors labels describing the next step. Crawlable links are still invitations addressed to a person first.","Avoid sending every article to the same three pages without reason. Relationships should follow the argument: a zero-view note leads to diagnosis and measurement quality, while a creative essay leads to personas and formats. The graph becomes navigable when every link announces a useful neighboring question. Automated suggestions can help, but should still be checked against what the source article actually discusses."],"action":["Connect parent, neighbors and practical application.","Avoid vague anchors."],"trap":"Internal linking does not compensate for articles lacking their own substance.","quote":"A good link continues an idea.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A good link continues an idea.","text":"An editorial graph connects parent concepts, neighbors and applications.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"AGD content graph","text":"An editorial graph connects parent concepts, neighbors and applications. Its usefulness comes from meaningful relationships, not automatically added link counts.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Internal linking does not compensate for articles lacking their own substance.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect parent, neighbors and practical application.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Avoid vague anchors.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"098","slug":"multilingual-seo","term":"Multilingual publishing","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"documented","sources":["https://developers.google.com/search/docs/specialty/international/localized-versions"],"related":["structured-editorial","knowledge-graph","distribution-is-the-moat"],"fr":{"title":"Deux langues, deux vraies lectures.","dek":"Une publication multilingue donne une URL stable à chaque version et relie les traductions correspondantes.","point":"Une publication multilingue donne une URL stable à chaque version et relie les traductions correspondantes. Chaque langue doit rester lisible et cohérente de bout en bout.","body":["Le sélecteur de langue doit conserver l’article, pas renvoyer systématiquement à l’accueil. Les références culturelles peuvent demander une réécriture. Les liens hreflang signalent les variantes, tandis que chaque version possède sa propre URL canonique. Vérifiez également navigation, textes alternatifs et messages d’erreur, souvent oubliés après traduction du corps.","Les versions française et anglaise peuvent partager un identifiant de traduction tout en gardant des métadonnées propres. Cela facilite le changement de langue, les corrections et les contrôles de liens. Si une traduction manque, ne créez pas une fausse variante remplie dans l’autre langue. Signalez le manque dans le pipeline et publiez seulement les versions réellement complètes."],"action":["Relier les variantes équivalentes.","Vérifier la langue de toutes les interfaces."],"trap":"Les annotations multilingues facilitent l’interprétation ; elles ne garantissent pas un classement.","quote":"Deux langues, deux vraies lectures.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Deux langues, deux vraies lectures.","text":"Une publication multilingue donne une URL stable à chaque version et relie les traductions correspondantes.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Multilingual publishing","text":"Une publication multilingue donne une URL stable à chaque version et relie les traductions correspondantes. Chaque langue doit rester lisible et cohérente de bout en bout.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Les annotations multilingues facilitent l’interprétation ; elles ne garantissent pas un classement.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Relier les variantes équivalentes.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Vérifier la langue de toutes les interfaces.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"Two languages, two real reading experiences.","dek":"A multilingual publication gives each version a stable URL and connects matching translations.","point":"A multilingual publication gives each version a stable URL and connects matching translations. Each language should remain readable and coherent throughout.","body":["Language switching should preserve the article rather than always return home. Cultural references may need rewriting. Hreflang links identify variants while each version has its own canonical URL. Check navigation, alternative text and error messages, often forgotten after body translation.","French and English versions can share a translation identifier while keeping their own metadata. This simplifies language switching, corrections and link checks. If a translation is missing, do not create a false variant filled with the other language. Flag the gap in the pipeline and publish only complete versions. A consistent route map should connect equivalents rather than make search engines or readers guess which page matches."],"action":["Connect equivalent variants.","Check language across all interfaces."],"trap":"Multilingual annotations aid interpretation; they do not guarantee ranking.","quote":"Two languages, two real reading experiences.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Two languages, two real reading experiences.","text":"A multilingual publication gives each version a stable URL and connects matching translations.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Multilingual publishing","text":"A multilingual publication gives each version a stable URL and connects matching translations. Each language should remain readable and coherent throughout.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Multilingual annotations aid interpretation; they do not guarantee ranking.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect equivalent variants.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check language across all interfaces.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"099","slug":"structured-editorial","term":"Structured editorial","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["agent-audit-log","multilingual-seo","distribution-is-the-moat"],"fr":{"title":"Un schéma strict libère la voix. Il ne l’écrit pas.","dek":"Un schéma éditorial impose les éléments nécessaires à une publication : identité, traduction, média, stories, texte, sources et liens.","point":"Un schéma éditorial impose les éléments nécessaires à une publication : identité, traduction, média, stories, texte, sources et liens. Il ne peut pas garantir à lui seul l’intérêt de l’article.","body":["Séparez les validations mécaniques de la relecture : un slug unique et une image avec provenance se vérifient automatiquement. La justesse d’une opinion et l’utilité d’un exemple demandent un jugement. Un pipeline mature bloque aussi les références cassées et les traductions manquantes, au lieu de publier un squelette parce que le JSON est valide.","Le schéma livré avec BLACKCURRENT exige deux langues, une image avec provenance, des stories, un corps de texte et des limites explicites. Le validateur contrôle aussi les références vers d’autres articles. Ces contraintes rendent le seed reproductible. La relecture reste responsable de la singularité du sujet et de la pertinence des exemples, que la structure seule ne peut certifier."],"action":["Valider structure et relations avant publication.","Relire le texte pour sa valeur propre."],"trap":"Un article conforme au schéma peut encore être répétitif ou inutile.","quote":"Un schéma strict libère la voix. Il ne l’écrit pas.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un schéma strict libère la voix. Il ne l’écrit pas.","text":"Un schéma éditorial impose les éléments nécessaires à une publication : identité, traduction, média, stories, texte, sources et liens.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Structured editorial","text":"Un schéma éditorial impose les éléments nécessaires à une publication : identité, traduction, média, stories, texte, sources et liens. Il ne peut pas garantir à lui seul l’intérêt de l’article.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un article conforme au schéma peut encore être répétitif ou inutile.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Valider structure et relations avant publication.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Relire le texte pour sa valeur propre.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"A strict schema frees the voice. It does not write it.","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links.","point":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links. It cannot guarantee an interesting article by itself.","body":["Separate mechanical validation from review: unique slugs and image provenance can be checked automatically. The soundness of an opinion and usefulness of an example need judgment. A mature pipeline also blocks broken references and missing translations instead of publishing a skeleton because its JSON is valid.","BLACKCURRENT’s supplied schema requires two languages, an image with provenance, stories, body text and explicit limitations. Validation also checks references to other articles. These constraints make seeding reproducible. Review still owns subject distinctiveness and example relevance, neither of which structure alone certifies. Treat automated checks as necessary publishing conditions rather than a substitute for deciding whether the piece is actually worth reading."],"action":["Validate structure and relationships before publishing.","Review the text for its own value."],"trap":"A schema-compliant article can still be repetitive or useless.","quote":"A strict schema frees the voice. It does not write it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A strict schema frees the voice. It does not write it.","text":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Structured editorial","text":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links. It cannot guarantee an interesting article by itself.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A schema-compliant article can still be repetitive or useless.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Validate structure and relationships before publishing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review the text for its own value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},{"id":"100","slug":"agent-audit-log","term":"Agent audit log","category":"machines","kind":"guide","image":"signal","tier":"operating","evidence":"editorial","sources":[],"related":["ai-agd","structured-editorial","distribution-is-the-moat"],"fr":{"title":"Le journal qui permet de comprendre le lendemain.","dek":"Un journal d’agent relie intention, outil, résultat et décision suivante.","point":"Un journal d’agent relie intention, outil, résultat et décision suivante. Il doit conserver les éléments utiles sans exposer clés, secrets ou données personnelles inutiles.","body":["Enregistrez les identifiants de requête et le statut pertinent plutôt qu’une réponse complète contenant potentiellement des secrets. Séparez simulation et exécution réelle. Lorsqu’un incident survient, le journal doit permettre de savoir ce qui a été demandé et ce qui a été confirmé. Une narration enthousiaste n’est pas une trace d’exécution.","Un journal lisible peut indiquer : intention reçue, simulation terminée, accord obtenu, exécution confirmée. Les étapes absentes restent absentes. Cette chaîne permet de reprendre après interruption sans supposer que tout s’est produit. Elle facilite aussi la correction d’une erreur en distinguant le plan de l’agent et les effets réellement confirmés par le service."],"action":["Journaliser intention, mode et état confirmé.","Masquer les secrets et limiter les données conservées."],"trap":"Un log doit distinguer une action tentée d’une action effectivement terminée.","quote":"Le journal qui permet de comprendre le lendemain.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le journal qui permet de comprendre le lendemain.","text":"Un journal d’agent relie intention, outil, résultat et décision suivante.","media":"/images/signal.jpg"},{"label":"LE CONCEPT","title":"Agent audit log","text":"Un journal d’agent relie intention, outil, résultat et décision suivante. Il doit conserver les éléments utiles sans exposer clés, secrets ou données personnelles inutiles.","media":"/images/signal.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un log doit distinguer une action tentée d’une action effectivement terminée.","media":"/images/signal.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Journaliser intention, mode et état confirmé.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Masquer les secrets et limiter les données conservées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/signal.jpg"}]}]},"en":{"title":"The log that makes tomorrow understandable.","dek":"An agent log connects intent, tool, result and next decision.","point":"An agent log connects intent, tool, result and next decision. It should retain useful evidence without exposing keys, secrets or unnecessary personal data.","body":["Record request identifiers and relevant status instead of full responses potentially containing secrets. Separate preview from live execution. When an incident occurs, the log should reveal what was requested and confirmed. An enthusiastic narrative is not an execution trace.","A readable log can show intent received, preview completed, approval obtained and execution confirmed. Missing stages remain missing. This chain supports recovery after interruption without assuming everything happened. It also makes correction easier by separating the agent’s plan from effects actually confirmed by the service. Keep the report precise enough that another operator can continue without reconstructing meaning from enthusiastic but ambiguous progress messages."],"action":["Log intent, mode and confirmed state.","Redact secrets and minimize retained data."],"trap":"A log should distinguish attempted actions from genuinely completed ones.","quote":"The log that makes tomorrow understandable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The log that makes tomorrow understandable.","text":"An agent log connects intent, tool, result and next decision.","media":"/images/signal.jpg"},{"label":"THE CONCEPT","title":"Agent audit log","text":"An agent log connects intent, tool, result and next decision. It should retain useful evidence without exposing keys, secrets or unnecessary personal data.","media":"/images/signal.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A log should distinguish attempted actions from genuinely completed ones.","media":"/images/signal.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Log intent, mode and confirmed state.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"},{"label":"PUT IT TO WORK / 2","title":"Redact secrets and minimize retained data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/signal.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/signal.jpg","width":1536,"height":1024,"alt":{"fr":"Écran CRT au signal vert dans une pièce sombre.","en":"A CRT screen with a green signal in a dark room."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}}],"lang":"en"}]]}]
