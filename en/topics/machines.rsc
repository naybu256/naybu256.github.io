12:["$","$L11","079",{"a":{"id":"079","slug":"ai-agd","term":"AI AGD","category":"machines","kind":"guide","image":"ai-agd","tier":"canonical","evidence":"editorial","sources":[],"related":["agentic-agd","agent-audit-log","distribution-is-the-moat"],"en":{"title":"AI can think about the system before filling the calendar.","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD.","point":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD. It does not imply fully autonomous execution.","body":["The first gain may be better idea classification rather than more videos. Ask an agent to find redundant concepts, overlooked audiences and unmeasured hypotheses. Compare its proposals with real context. A convincing list does not prove it understands your customers.","Give an agent ten briefs and ask where two accounts are saying the same thing. Require it to cite the relevant passages. This produces a checkable proposal rather than a general judgment. The value comes from decision support even if no additional post is produced. Keep corrections to its classification so later prompts can reflect the distinctions your team actually cares about."],"action":["Assign a bounded analytical task.","Verify classifications before using them."],"trap":"A model’s fluent writing can hide insufficient knowledge of actual conditions.","quote":"AI can think about the system before filling the calendar.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"AI can think about the system before filling the calendar.","text":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD.","media":"/images/editorial/ai-agd.jpg"},{"label":"THE CONCEPT","title":"AI AGD","text":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD. It does not imply fully autonomous execution.","media":"/images/editorial/ai-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A model’s fluent writing can hide insufficient knowledge of actual conditions.","media":"/images/editorial/ai-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Assign a bounded analytical task.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ai-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Verify classifications before using them.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/ai-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/ai-agd.jpg","width":1280,"height":853,"alt":{"en":"A vintage mainframe computer with control buttons, reel storage, and cabinets of electronics."},"credit":"Pargon","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 4bca5422b5ac0db97ae1373679890f422c520f25.","source":"https://commons.wikimedia.org/wiki/File:Mainframe_Computer.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0"}},"lang":"en"}]
13:["$","$L11","080",{"a":{"id":"080","slug":"agentic-agd","term":"Agentic AGD","category":"machines","kind":"guide","image":"agentic-agd","tier":"canonical","evidence":"editorial","sources":[],"related":["human-api","ai-agd","distribution-is-the-moat"],"en":{"title":"A distribution agent is not a talking calendar.","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments.","point":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments. The agent operates within an explicitly defined scope.","body":["A useful agent knows which information is missing and which actions it may take. It can propose allocation, detect anomalies or prepare briefs. The loop should specify who approves budget changes and how execution stops. Without boundaries, an autonomy demo becomes operational debt.","Begin by having the agent propose the next experiment with supporting observations and limitations. A human can correct the plan before mutations occur. Keep those corrections because they expose still-implicit rules. The system becomes more autonomous when its rules are understood and checkable, not when approval is arbitrarily removed. This gives the team a concrete basis for expanding scope gradually."],"action":["Write the action scope.","Define exceptions that return to a human."],"trap":"An agent able to call a tool is not automatically authorized to use it live.","quote":"A distribution agent is not a talking calendar.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A distribution agent is not a talking calendar.","text":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments.","media":"/images/editorial/agentic-agd.jpg"},{"label":"THE CONCEPT","title":"Agentic AGD","text":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments. The agent operates within an explicitly defined scope.","media":"/images/editorial/agentic-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An agent able to call a tool is not automatically authorized to use it live.","media":"/images/editorial/agentic-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write the action scope.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agentic-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define exceptions that return to a human.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agentic-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agentic-agd.jpg","width":1280,"height":720,"alt":{"en":"Yellow industrial robots handle kegs inside a brewery production area."},"credit":"Larry D. Moore","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 52b376103be14f0112d317a163fe9c74d08e6ffc.","source":"https://commons.wikimedia.org/wiki/File:Tour4_Spoetzl_Brewery_Shiner_Texas_2024.jpg","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},"lang":"en"}]
14:["$","$L11","081",{"a":{"id":"081","slug":"human-api","term":"Human API","category":"machines","kind":"guide","image":"human-api","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/"],"related":["mcp-orchestration","agentic-agd","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"Behind the API, someone actually opens the app.","dek":"A Human API exposes a software workflow partly executed by people.","point":"A Human API exposes a software workflow partly executed by people. In TokPortal’s context, orchestration and native interaction are separate layers.","body":["A call may create a mission rather than immediately publish a post. Integrations therefore need waiting, status and correction handling. Design around the real cycle: request received, work executed, result verified. Hiding latency behind instant success misrepresents what happened.","A client interface can show request accepted before publication verified. Add handling for delays and corrections. This matters for agents: they should not analyze a mission as though it were already a visible post. The software contract should respect the actual time of human work. Clear intermediate states make integrations more useful without promising instantaneous execution the underlying operation does not provide."],"action":["Separate acceptance from delivery.","Plan status feedback and correction handling."],"trap":"A successful HTTP response can confirm request creation without confirming final execution.","quote":"Behind the API, someone actually opens the app.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Behind the API, someone actually opens the app.","text":"A Human API exposes a software workflow partly executed by people.","media":"/images/editorial/human-api.jpg"},{"label":"THE CONCEPT","title":"Human API","text":"A Human API exposes a software workflow partly executed by people. In TokPortal’s context, orchestration and native interaction are separate layers.","media":"/images/editorial/human-api.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful HTTP response can confirm request creation without confirming final execution.","media":"/images/editorial/human-api.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Separate acceptance from delivery.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-api.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan status feedback and correction handling.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-api.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/human-api.jpg","width":1280,"height":960,"alt":{"en":"A worker operates an antique printing press inside a working print shop."},"credit":"Caelb375","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 2aa5baf9386557b730ec488a397287c9d71e5e4b.","source":"https://commons.wikimedia.org/wiki/File:Printing_at_Bay_View_Printing_Company.png","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0"}},"lang":"en"}]
15:["$","$L11","082",{"a":{"id":"082","slug":"mcp-orchestration","term":"MCP orchestration","category":"machines","kind":"guide","image":"mcp-orchestration","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["dry-run-contract","human-api","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"MCP connects tools. It does not write your strategy.","dek":"MCP lets an agent client discover and call tools exposed by a server.","point":"MCP lets an agent client discover and call tools exposed by a server. Its technical catalog still needs an objective and action boundaries.","body":["Read descriptions and annotations before composing a recipe. A read operation differs from paid creation. TokPortal’s documentation distinguishes local and remote servers. Choose transport for your environment and test the contract in preview before commercial execution.","A readable recipe names the intent before listing calls: prepare an account in a market, verify its state, organize publication. Each step should state what it requires from the previous one. Readers can then understand dependencies and see why synthetic preview identifiers must never pass into live operations. Tool availability is only one part of building a coherent, authorized workflow."],"action":["Discover the current catalog.","Separate read tools from mutations."],"trap":"A tool name is not enough to understand costs and side effects.","quote":"MCP connects tools. It does not write your strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"MCP connects tools. It does not write your strategy.","text":"MCP lets an agent client discover and call tools exposed by a server.","media":"/images/editorial/mcp-orchestration.jpg"},{"label":"THE CONCEPT","title":"MCP orchestration","text":"MCP lets an agent client discover and call tools exposed by a server. Its technical catalog still needs an objective and action boundaries.","media":"/images/editorial/mcp-orchestration.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A tool name is not enough to understand costs and side effects.","media":"/images/editorial/mcp-orchestration.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Discover the current catalog.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/mcp-orchestration.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate read tools from mutations.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/mcp-orchestration.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/mcp-orchestration.jpg","width":1280,"height":813,"alt":{"en":"Rows of terminals and connected wires on a telephone network patch panel."},"credit":"Dennis van Zuijlekom","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 48635187f29082eba162a0fa0936511cf975dcd3.","source":"https://commons.wikimedia.org/wiki/File:Krone_LSA-PLUS_Patch_Panel_(14672372192).png","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"}},"lang":"en"}]
16:["$","$L11","083",{"a":{"id":"083","slug":"dry-run-contract","term":"Dry-run contract","category":"machines","kind":"guide","image":"dry-run-contract","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/sandbox/"],"related":["idempotency","mcp-orchestration","distribution-is-the-moat"],"tokportal":"sandbox","en":{"title":"A preview must know what it does not simulate.","dek":"A dry run validates a request without producing live effects under the service’s contract.","point":"A dry run validates a request without producing live effects under the service’s contract. It does not guarantee future capacity or outcomes.","body":["In TokPortal MCP, dry_run belongs at the top argument level, not inside body. The local version must support that contract. Read response fields for simulated and actual charges. Preview identifiers remain synthetic: moving live requires creating and using actual resources.","Show the mode, request and reported charges in the human-readable result. Do not say account created when the service only validated a preview. That wording prevents another agent from continuing work against an imaginary resource. The boundary should be both technical and understandable in the report, especially when output is copied into another task without the full execution history attached."],"action":["Check version and preview response.","Keep an explicit boundary before live execution."],"trap":"A successful preview neither authorizes spending nor reserves capacity.","quote":"A preview must know what it does not simulate.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A preview must know what it does not simulate.","text":"A dry run validates a request without producing live effects under the service’s contract.","media":"/images/editorial/dry-run-contract.jpg"},{"label":"THE CONCEPT","title":"Dry-run contract","text":"A dry run validates a request without producing live effects under the service’s contract. It does not guarantee future capacity or outcomes.","media":"/images/editorial/dry-run-contract.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A successful preview neither authorizes spending nor reserves capacity.","media":"/images/editorial/dry-run-contract.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check version and preview response.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/dry-run-contract.jpg"},{"label":"PUT IT TO WORK / 2","title":"Keep an explicit boundary before live execution.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/dry-run-contract.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/dry-run-contract.jpg","width":1280,"height":992,"alt":{"en":"Mary Jackson holds an aircraft model inside a wind tunnel at NASA Langley."},"credit":"NASA; restoration by Adam Cuerden","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 42976da6950d21d2f0ae93640659121b482a3bab.","source":"https://commons.wikimedia.org/wiki/File:Mary_Jackson_in_a_wind_tunnel_with_a_model_at_NASA_Langley.jpg","license":"Public domain","licenseUrl":"https://creativecommons.org/publicdomain/mark/1.0/"}},"lang":"en"}]
17:["$","$L11","084",{"a":{"id":"084","slug":"idempotency","term":"Idempotency","category":"machines","kind":"guide","image":"idempotency","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["webhooks","dry-run-contract","distribution-is-the-moat"],"en":{"title":"Retry without ordering twice.","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract.","point":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract. It does not apply indiscriminately to every tool.","body":["After a timeout, do not assume nothing happened. Check state or reuse the same key for the same intent when supported. TokPortal documentation excludes some secret-bearing operations from replay. A fresh key on every retry defeats the protection you wanted.","Document what the application considers the same intent. Retrying after a lost response is not a new order; changing country or content may be. Make that distinction visible in the log. It prevents both costly duplicates and ambiguous replays after parameters change. When the service’s contract is unclear, inspect state before retrying rather than treating every timeout as proof of failure."],"action":["Keep one key per logical intent.","Review documented exceptions."],"trap":"Reusing a key for a different request can create contract ambiguity.","quote":"Retry without ordering twice.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Retry without ordering twice.","text":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract.","media":"/images/editorial/idempotency.jpg"},{"label":"THE CONCEPT","title":"Idempotency","text":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract. It does not apply indiscriminately to every tool.","media":"/images/editorial/idempotency.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Reusing a key for a different request can create contract ambiguity.","media":"/images/editorial/idempotency.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Keep one key per logical intent.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/idempotency.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review documented exceptions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/idempotency.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/idempotency.jpg","width":1280,"height":946,"alt":{"en":"Numbered mechanical counter wheels inside an analogue tape deck."},"credit":"Retired electrician","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e42ad2d38f4e8621abf96d9db7464bdb61b0c686.","source":"https://commons.wikimedia.org/wiki/File:Technics_RS-M270x_mechanical_counter.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},"lang":"en"}]
18:["$","$L11","085",{"a":{"id":"085","slug":"webhooks","term":"Webhooks","category":"machines","kind":"guide","image":"webhooks","tier":"operating","evidence":"editorial","sources":[],"related":["agent-budget","idempotency","distribution-is-the-moat"],"en":{"title":"A webhook reports an event. It does not replace your state.","dek":"A webhook sends an event to your integration.","point":"A webhook sends an event to your integration. Consumers should verify authenticity, handle repetition and reconcile state under the documented contract.","body":["Do not assume events arrive exactly once or in the expected order. Retain identifiers when provided and allow reading current state. Signing secrets belong in appropriate storage, not client code. Users then see progress grounded in verified events.","A consumer can retain the latest confirmed state and receipt time. If an event appears contradictory, reading source state can resolve it under the available contract. Keep an incident record without exposing the signing secret. Reliability is built in these recovery paths, not merely in receiving the first demonstration event. Test duplicate and delayed delivery cases before depending on the integration for unattended decisions."],"action":["Apply documented verification.","Plan deduplication and reconciliation."],"trap":"A received event is trustworthy only after service-appropriate checks.","quote":"A webhook reports an event. It does not replace your state.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A webhook reports an event. It does not replace your state.","text":"A webhook sends an event to your integration.","media":"/images/editorial/webhooks.jpg"},{"label":"THE CONCEPT","title":"Webhooks","text":"A webhook sends an event to your integration. Consumers should verify authenticity, handle repetition and reconcile state under the documented contract.","media":"/images/editorial/webhooks.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A received event is trustworthy only after service-appropriate checks.","media":"/images/editorial/webhooks.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Apply documented verification.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/webhooks.jpg"},{"label":"PUT IT TO WORK / 2","title":"Plan deduplication and reconciliation.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/webhooks.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/webhooks.jpg","width":1280,"height":853,"alt":{"en":"A vintage telegraph machine and its brass components displayed on a wooden base."},"credit":"Homoatrox","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: e87da8fd61b405505186536d68723e07cd1b94f9.","source":"https://commons.wikimedia.org/wiki/File:Telegraph_machine_in_DOSAAF_museum_(Minsk).jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},"lang":"en"}]
19:["$","$L11","086",{"a":{"id":"086","slug":"agent-budget","term":"Agent budgets","category":"machines","kind":"guide","image":"agent-budget","tier":"operating","evidence":"editorial","sources":[],"related":["agent-maturity","webhooks","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"An agent without a ceiling has no budget.","dek":"An agent budget defines authorized operations, limits and renewal conditions.","point":"An agent budget defines authorized operations, limits and renewal conditions. It should distinguish immediate spending, recurring charges and estimates.","body":["Read current prices and account state before proposing a plan. Preview prepares a decision; authorization defines what can execute. Keep estimated and actual spending separate. A loop restarting tasks after errors should still respect the original ceiling.","An approval interface can separate immediate cost from estimated recurring commitment and identify anything not priced. A human then approves a concrete scope. If the plan changes, compare its new cost with that authorization rather than assuming the first approval covers every future extension. Preserve the original scope in the log so later retries and revisions can be assessed against the same boundary."],"action":["Define scope, ceiling and duration.","Stop mutations when the limit is reached."],"trap":"An available balance is not authorization to spend all of it.","quote":"An agent without a ceiling has no budget.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"An agent without a ceiling has no budget.","text":"An agent budget defines authorized operations, limits and renewal conditions.","media":"/images/editorial/agent-budget.jpg"},{"label":"THE CONCEPT","title":"Agent budgets","text":"An agent budget defines authorized operations, limits and renewal conditions. It should distinguish immediate spending, recurring charges and estimates.","media":"/images/editorial/agent-budget.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An available balance is not authorization to spend all of it.","media":"/images/editorial/agent-budget.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define scope, ceiling and duration.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-budget.jpg"},{"label":"PUT IT TO WORK / 2","title":"Stop mutations when the limit is reached.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-budget.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agent-budget.jpg","width":1280,"height":850,"alt":{"en":"A wall covered with electricity meters, junction boxes, and cables in Kolkata."},"credit":"Jorge Royan","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 9fd2f2f167bccd31d986f87d485e162e7cd15e8d.","source":"https://commons.wikimedia.org/wiki/File:India_-_Kolkata_electricity_meters_-_3832.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},"lang":"en"}]
1a:["$","$L11","087",{"a":{"id":"087","slug":"agent-maturity","term":"AGD maturity model","category":"machines","kind":"guide","image":"agent-maturity","tier":"operating","evidence":"editorial","sources":[],"related":["api-slop","agent-budget","distribution-is-the-moat"],"en":{"title":"Autonomy is a ladder, not a switch.","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy.","point":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy. Levels describe responsibility, not medals.","body":["A team can be advanced in analysis and manual in publishing. Identify decisions delegated to the system and human recovery options. Moving up only helps if control quality follows. Keeping spending approval can remain rational even when briefs are fully automated.","For every stage, ask how an error is detected and who can correct it. Reversible creative classification and live purchasing have different consequences. You can therefore delegate them differently without inconsistency. The maturity model makes those choices explicit instead of pushing the whole organization toward a maximum level. Operational readiness matters more than how autonomous the workflow sounds in a presentation."],"action":["Map responsibility at each step.","Automate where errors can be detected and recovered."],"trap":"The most autonomous level is not necessarily best for every organization.","quote":"Autonomy is a ladder, not a switch.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Autonomy is a ladder, not a switch.","text":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy.","media":"/images/editorial/agent-maturity.jpg"},{"label":"THE CONCEPT","title":"AGD maturity model","text":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy. Levels describe responsibility, not medals.","media":"/images/editorial/agent-maturity.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"The most autonomous level is not necessarily best for every organization.","media":"/images/editorial/agent-maturity.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Map responsibility at each step.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-maturity.jpg"},{"label":"PUT IT TO WORK / 2","title":"Automate where errors can be detected and recovered.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-maturity.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agent-maturity.jpg","width":1280,"height":3090,"alt":{"en":"A tall metal escape ladder with a protective cage beside a building."},"credit":"Frank C. Müller","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 140892ac870d0b5d45c28cc5b523aa6a5fecfdcf.","source":"https://commons.wikimedia.org/wiki/File:Fluchtleiter_(fcm).jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},"lang":"en"}]
1b:["$","$L11","088",{"a":{"id":"088","slug":"api-slop","term":"API Slop","category":"machines","kind":"guide","image":"api-slop","tier":"editorial","evidence":"editorial","sources":[],"related":["content-routing","agent-maturity","distribution-is-the-moat"],"en":{"title":"Your API is not a distribution strategy.","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context.","point":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context. It targets strategy, not APIs themselves.","body":["An API can orchestrate human execution, manage approvals or make outcomes readable. Trouble starts when technical ease becomes the sole publishing criterion. Ask each delivery: why this content on this account? If the answer is only “because we can,” pause the queue.","A queue rule can reject an asset when no account rationale is supplied. Rejection does not prove the content is bad; it means its destination is unexplained. This useful friction prevents easy delivery from becoming editorial policy. The team can correct routing or revisit the idea before creating more versions. Automation then protects a meaningful decision instead of multiplying an unexamined one."],"action":["Attach an editorial rationale to each routing choice.","Reject duplication without distinct value."],"trap":"API does not mean poor reach; no general penalty is demonstrated here.","quote":"Your API is not a distribution strategy.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Your API is not a distribution strategy.","text":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context.","media":"/images/editorial/api-slop.jpg"},{"label":"THE CONCEPT","title":"API Slop","text":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context. It targets strategy, not APIs themselves.","media":"/images/editorial/api-slop.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"API does not mean poor reach; no general penalty is demonstrated here.","media":"/images/editorial/api-slop.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach an editorial rationale to each routing choice.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/api-slop.jpg"},{"label":"PUT IT TO WORK / 2","title":"Reject duplication without distinct value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/api-slop.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/api-slop.jpg","width":1280,"height":721,"alt":{"en":"A dense tangle of cables running through a service shaft."},"credit":"Dmitry G","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 6391382f4065ce09c9bf83beda2b64ca4092f673.","source":"https://commons.wikimedia.org/wiki/File:Cable_salad_in_shaft.JPG","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},"lang":"en"}]
1c:["$","$L11","089",{"a":{"id":"089","slug":"content-routing","term":"Content routing","category":"machines","kind":"guide","image":"content-routing","tier":"operating","evidence":"editorial","sources":[],"related":["creative-clustering","api-slop","distribution-is-the-moat"],"en":{"title":"Good content can land on the wrong account.","dek":"Routing connects creative work to an account by audience, persona, market and purpose.","point":"Routing connects creative work to an account by audience, persona, market and purpose. It is an editorial decision before a technical operation.","body":["An agent can propose matches from metadata but should be able to abstain. Expert content does not automatically suit a student account because the product is the same. Keep a short rationale and rejection criteria. Difficult routing often reveals insufficiently distinct account briefs.","Keep the assignment rationale with the post. During review, compare obvious matches with uncertain ones. This can improve briefs or taxonomy instead of prompting blind account changes. A useful routing record explains why the content was placed there at decision time even if outcomes disappoint. It prevents hindsight from rewriting the original reason and makes the next matching decision easier to evaluate."],"action":["Define eligibility criteria.","Explicitly allow no suitable account."],"trap":"Forcing a match everywhere turns a library into a duplication engine.","quote":"Good content can land on the wrong account.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Good content can land on the wrong account.","text":"Routing connects creative work to an account by audience, persona, market and purpose.","media":"/images/editorial/content-routing.jpg"},{"label":"THE CONCEPT","title":"Content routing","text":"Routing connects creative work to an account by audience, persona, market and purpose. It is an editorial decision before a technical operation.","media":"/images/editorial/content-routing.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Forcing a match everywhere turns a library into a duplication engine.","media":"/images/editorial/content-routing.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define eligibility criteria.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-routing.jpg"},{"label":"PUT IT TO WORK / 2","title":"Explicitly allow no suitable account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/content-routing.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/content-routing.jpg","width":1280,"height":814,"alt":{"en":"A red and yellow railway switch lever beside branching tracks."},"credit":"W.carter","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 277cd29bdacbcd6cde447a2c17d6fa9aae9a42ed.","source":"https://commons.wikimedia.org/wiki/File:Railway_switch_lever_on_Gr%C3%B6t%C3%B6.jpg","license":"Public domain","licenseUrl":"https://creativecommons.org/publicdomain/mark/1.0/"}},"lang":"en"}]
1d:["$","$L11","090",{"a":{"id":"090","slug":"creative-clustering","term":"Creative clustering","category":"machines","kind":"guide","image":"creative-clustering","tier":"operating","evidence":"editorial","sources":[],"related":["anomaly-detection","content-routing","distribution-is-the-moat"],"en":{"title":"Group ideas without erasing their differences.","dek":"Creative clustering groups content under chosen criteria.","point":"Creative clustering groups content under chosen criteria. Groups should be interpretable and checked before informing allocation.","body":["A model may group videos by background while their promises differ. Define angle, format and situation. Review a sample of human-machine disagreements. The goal is not a perfect taxonomy but recoverable, useful creative decisions.","Use a few annotated examples as references and retain cases belonging to several groups. An ambiguous category is better than artificial precision. If the agent mostly classifies scenery, rewrite the instruction around the problem addressed. Grouping should help retrieve ideas rather than merely fill a metadata column. A small review set can reveal whether the labels preserve useful distinctions across genuinely different creative treatments."],"action":["Define each classification dimension.","Review ambiguous cases."],"trap":"Visual similarity does not prove similar intent or audience.","quote":"Group ideas without erasing their differences.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Group ideas without erasing their differences.","text":"Creative clustering groups content under chosen criteria.","media":"/images/editorial/creative-clustering.jpg"},{"label":"THE CONCEPT","title":"Creative clustering","text":"Creative clustering groups content under chosen criteria. Groups should be interpretable and checked before informing allocation.","media":"/images/editorial/creative-clustering.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Visual similarity does not prove similar intent or audience.","media":"/images/editorial/creative-clustering.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define each classification dimension.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-clustering.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review ambiguous cases.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/creative-clustering.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/creative-clustering.jpg","width":1280,"height":851,"alt":{"en":"Small square mosaic tiles form a geometric pattern in warm pink and brown shades."},"credit":"Asturio Cantabrio","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 20f204ef32026a23142fa474e049e98a441a1058.","source":"https://commons.wikimedia.org/wiki/File:Mosaic_tile_works_ac_(1).jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"lang":"en"}]
1e:["$","$L11","091",{"a":{"id":"091","slug":"anomaly-detection","term":"Anomaly detection","category":"machines","kind":"guide","image":"anomaly-detection","tier":"operating","evidence":"editorial","sources":[],"related":["human-review","creative-clustering","distribution-is-the-moat"],"en":{"title":"A useful alert tells you what to inspect.","dek":"Anomaly detection flags deviation from a defined baseline.","point":"Anomaly detection flags deviation from a defined baseline. It should distinguish collection issues, operating changes and distribution outcomes.","body":["Start with interpretable alerts: missing expected publication, delayed data, spending beyond limits. Add performance deviations with thresholds suited to variability. Every alert should include facts, period and next check. Dramatic notifications without context exhaust teams more than they protect them.","An alert saying data has not updated since the expected cutoff is more actionable than an unexplained red score. It identifies what to check before concluding that performance declined. Include the last reliable value and source. The operator then receives a small investigation ready to begin rather than vague concern to interpret. That specificity also helps distinguish measurement failures from genuine changes over time."],"action":["Attach a next check to every alert.","Measure false positives."],"trap":"An anomaly is an investigation signal, not an identified cause.","quote":"A useful alert tells you what to inspect.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A useful alert tells you what to inspect.","text":"Anomaly detection flags deviation from a defined baseline.","media":"/images/editorial/anomaly-detection.jpg"},{"label":"THE CONCEPT","title":"Anomaly detection","text":"Anomaly detection flags deviation from a defined baseline. It should distinguish collection issues, operating changes and distribution outcomes.","media":"/images/editorial/anomaly-detection.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An anomaly is an investigation signal, not an identified cause.","media":"/images/editorial/anomaly-detection.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Attach a next check to every alert.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/anomaly-detection.jpg"},{"label":"PUT IT TO WORK / 2","title":"Measure false positives.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/anomaly-detection.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/anomaly-detection.jpg","width":1280,"height":676,"alt":{"en":"An oscilloscope displays a bright cyan waveform on its screen."},"credit":"Pittigrilli","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: d96ff7da85e43d6db955879d46cdfb25af8152c7.","source":"https://commons.wikimedia.org/wiki/File:Tektronix_Oscilloscope_475A.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"lang":"en"}]
1f:["$","$L11","092",{"a":{"id":"092","slug":"human-review","term":"Human review","category":"machines","kind":"guide","image":"human-review","tier":"operating","evidence":"editorial","sources":[],"related":["source-of-truth","anomaly-detection","distribution-is-the-moat"],"en":{"title":"Human review should contain a real decision.","dek":"Useful human review exposes the action, consequences and evidence to check.","point":"Useful human review exposes the action, consequences and evidence to check. An approval button without context offers only an illusion of control.","body":["Show account, asset, text, cost and changes since the last version. Separate editorial approval from financial authorization. If everything is urgent, little gets reviewed. Reserve interruptions for decisions where an informed human can meaningfully change the outcome.","Review can highlight changes since the previous version rather than redisplay the entire dossier. A CTA change calls for a different decision from a market or cost change. This helps humans focus attention where it matters. Approval should remain attached to the version actually reviewed. If execution uses another version, the system should detect that mismatch rather than relying on a generic historical approval flag."],"action":["Show a concrete version for approval.","Define exactly what approval covers."],"trap":"A human in the loop does not prove they received enough information.","quote":"Human review should contain a real decision.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Human review should contain a real decision.","text":"Useful human review exposes the action, consequences and evidence to check.","media":"/images/editorial/human-review.jpg"},{"label":"THE CONCEPT","title":"Human review","text":"Useful human review exposes the action, consequences and evidence to check. An approval button without context offers only an illusion of control.","media":"/images/editorial/human-review.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A human in the loop does not prove they received enough information.","media":"/images/editorial/human-review.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Show a concrete version for approval.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-review.jpg"},{"label":"PUT IT TO WORK / 2","title":"Define exactly what approval covers.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/human-review.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/human-review.jpg","width":1280,"height":720,"alt":{"en":"A small watchmaker’s lathe and precision tools arranged on a wooden workbench."},"credit":"Helge Klaus Rieder","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: cb4dd8d8f2b3704fe001b9f15e3859db0abaaf46.","source":"https://commons.wikimedia.org/wiki/File:Roscheiderhof-lg1-uhrmacher-2a.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en"}},"lang":"en"}]
20:["$","$L11","093",{"a":{"id":"093","slug":"source-of-truth","term":"Source of truth","category":"machines","kind":"guide","image":"source-of-truth","tier":"operating","evidence":"documented","sources":["https://developers.tokportal.com/mcp/"],"related":["seo-agd","human-review","distribution-is-the-moat"],"tokportal":"mcp","en":{"title":"Documentation that says no beats a page promising everything.","dek":"A technical source of truth describes an interface’s current capabilities.","point":"A technical source of truth describes an interface’s current capabilities. A broader marketing page may describe services not fully exposed through that interface.","body":["While preparing this publication, TokPortal MCP documentation stated that YouTube bundle creation was unavailable through the API. Examples should retain that limit even when other pages mention YouTube more broadly. Cite dated documentation and check the schema before proposing a command.","When pages disagree, record their URLs, date and the scope of each statement. A tutorial may need correction even when the broader service has not changed. For executable examples, the capability of the specific endpoint is decisive. This prevents older marketing copy from becoming an invalid command and makes the limitation understandable without implying that every other interface has exactly the same scope."],"action":["Check the scope of the interface being used.","Preserve explicit limitations in tutorials."],"trap":"A feature of the broader service is not necessarily available in every API or MCP tool.","quote":"Documentation that says no beats a page promising everything.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Documentation that says no beats a page promising everything.","text":"A technical source of truth describes an interface’s current capabilities.","media":"/images/editorial/source-of-truth.jpg"},{"label":"THE CONCEPT","title":"Source of truth","text":"A technical source of truth describes an interface’s current capabilities. A broader marketing page may describe services not fully exposed through that interface.","media":"/images/editorial/source-of-truth.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A feature of the broader service is not necessarily available in every API or MCP tool.","media":"/images/editorial/source-of-truth.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Check the scope of the interface being used.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/source-of-truth.jpg"},{"label":"PUT IT TO WORK / 2","title":"Preserve explicit limitations in tutorials.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/source-of-truth.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/source-of-truth.jpg","width":1280,"height":960,"alt":{"en":"Wooden card catalog cabinets line an ornate room at the Bibliothèque Mazarine in Paris."},"credit":"Marie-Lan Nguyen","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: aa901e1af91616911bfefd4fb878f826cf0a4646.","source":"https://commons.wikimedia.org/wiki/File:Salle_des_catalogues_de_la_Bibliotheque_Mazarine_Paris.jpg","license":"CC BY 2.0 fr","licenseUrl":"https://creativecommons.org/licenses/by/2.0/fr/deed.en"}},"lang":"en"}]
21:["$","$L11","094",{"a":{"id":"094","slug":"seo-agd","term":"SEO AGD","category":"machines","kind":"guide","image":"seo-agd","tier":"canonical","evidence":"editorial","sources":[],"related":["pseo-agd","source-of-truth","distribution-is-the-moat"],"en":{"title":"A video can have a second life in search.","dek":"SEO AGD explores social content and properties appearing in search engines and platform search.","point":"SEO AGD explores social content and properties appearing in search engines and platform search. This possibility guarantees neither indexing nor ranking.","body":["Start with a question the content actually answers. Make context explicit in the title, caption or available transcript. Check that the public page is accessible. Content should remain useful in the feed: turning every sentence into keyword repetition can harm it without improving discovery.","A social tutorial can lead to a longer explanation preserving steps and limitations. The page then extends the subject instead of copying the caption. Check that the link makes sense to a viewer discovering the video without knowing the brand. Search extends useful information; it should not justify pointless duplication. Keep each surface valuable in its own context while making the connection understandable."],"action":["Connect content to a specific intent.","Check public access and useful textual elements."],"trap":"Crawler accessibility does not guarantee indexing or citation.","quote":"A video can have a second life in search.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A video can have a second life in search.","text":"SEO AGD explores social content and properties appearing in search engines and platform search.","media":"/images/editorial/seo-agd.jpg"},{"label":"THE CONCEPT","title":"SEO AGD","text":"SEO AGD explores social content and properties appearing in search engines and platform search. This possibility guarantees neither indexing nor ranking.","media":"/images/editorial/seo-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Crawler accessibility does not guarantee indexing or citation.","media":"/images/editorial/seo-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect content to a specific intent.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/seo-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check public access and useful textual elements.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/seo-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/seo-agd.jpg","width":1280,"height":851,"alt":{"en":"The Mount Pleasant radio telescope dish stands beneath dramatic clouds."},"credit":"Noodle snacks","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 3a1c174c71682755dd6d3a18004c19581e92f287.","source":"https://commons.wikimedia.org/wiki/File:Mount_Pleasant_Radio_Telescope.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}},"lang":"en"}]
22:["$","$L11","095",{"a":{"id":"095","slug":"pseo-agd","term":"pSEO AGD","category":"machines","kind":"guide","image":"pseo-agd","tier":"canonical","evidence":"documented","sources":["https://developers.google.com/search/docs/essentials/spam-policies"],"related":["llm-quoting","seo-agd","distribution-is-the-moat"],"en":{"title":"Programmatic content needs a reason for every page.","dek":"pSEO AGD systematically organizes social content around distinct search intents.","point":"pSEO AGD systematically organizes social content around distinct search intents. Volume does not excuse redundant pages or posts.","body":["A question database can feed several formats when each answer brings a distinct application. Reject country or tool permutations that change nothing substantive. The system should block content without new information. Useful scale lives in structure and checks, not an obligation to fill a sitemap.","Add a distinct decision or problem field to the writing queue. Two subjects leading to the same example and answer may deserve one more complete page. The check can therefore reduce planned volume. That is healthy system behavior: covering an intent well beats multiplying its phrasings. Scaling should make meaningful coverage easier while preserving the ability to reject output that adds nothing for readers."],"action":["Deduplicate intents before writing.","Require specific value in each output."],"trap":"Google can treat mass production without added user value as abusive.","quote":"Programmatic content needs a reason for every page.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Programmatic content needs a reason for every page.","text":"pSEO AGD systematically organizes social content around distinct search intents.","media":"/images/editorial/pseo-agd.jpg"},{"label":"THE CONCEPT","title":"pSEO AGD","text":"pSEO AGD systematically organizes social content around distinct search intents. Volume does not excuse redundant pages or posts.","media":"/images/editorial/pseo-agd.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Google can treat mass production without added user value as abusive.","media":"/images/editorial/pseo-agd.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Deduplicate intents before writing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/pseo-agd.jpg"},{"label":"PUT IT TO WORK / 2","title":"Require specific value in each output.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/pseo-agd.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/pseo-agd.jpg","width":1280,"height":960,"alt":{"en":"Antique printing presses displayed in a room with tiled floors."},"credit":"Vis M","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: acd22a5143a3826240ee4c7c5e9cb05d628f1bd4.","source":"https://commons.wikimedia.org/wiki/File:Printing_press_05.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"lang":"en"}]
23:["$","$L11","096",{"a":{"id":"096","slug":"llm-quoting","term":"LLM quoting","category":"machines","kind":"guide","image":"llm-quoting","tier":"operating","evidence":"editorial","sources":[],"related":["knowledge-graph","pseo-agd","distribution-is-the-moat"],"en":{"title":"To be cited, first be quotable.","dek":"Citable content clearly states a proposition, scope and provenance.","point":"Citable content clearly states a proposition, scope and provenance. Machine-oriented markup or files do not guarantee citation by an assistant.","body":["Place a self-contained definition near the start, then expand examples and limitations. Do not use an attractive number without a method. Keep sources accessible and text readable without mandatory interaction. A short answer can be extracted correctly when it already contains necessary qualifications.","Read the definition as if it were extracted alone. If an essential limitation appears six paragraphs later, the excerpt may distort the claim. Move the qualification closer. This also helps human readers scanning the page before deciding whether to read the full reasoning. Clear structure improves extractability without requiring a promise that any specific assistant will discover, select or cite the page."],"action":["Write a self-contained definition.","Attach provenance, date and limits."],"trap":"An llms.txt file can orient reading; no promise of adoption is made here.","quote":"To be cited, first be quotable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"To be cited, first be quotable.","text":"Citable content clearly states a proposition, scope and provenance.","media":"/images/editorial/llm-quoting.jpg"},{"label":"THE CONCEPT","title":"LLM quoting","text":"Citable content clearly states a proposition, scope and provenance. Machine-oriented markup or files do not guarantee citation by an assistant.","media":"/images/editorial/llm-quoting.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An llms.txt file can orient reading; no promise of adoption is made here.","media":"/images/editorial/llm-quoting.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a self-contained definition.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/llm-quoting.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach provenance, date and limits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/llm-quoting.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/llm-quoting.jpg","width":1280,"height":960,"alt":{"en":"Wooden letterpress blocks of different sizes arranged into a dense typographic pattern."},"credit":"Michellecornelison","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 7cc619ddea58b31ed187119b2477ae1fd51f29bb.","source":"https://commons.wikimedia.org/wiki/File:Wood_letterpress_type.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"lang":"en"}]
24:["$","$L11","097",{"a":{"id":"097","slug":"knowledge-graph","term":"AGD content graph","category":"machines","kind":"guide","image":"knowledge-graph","tier":"operating","evidence":"documented","sources":["https://developers.google.com/search/docs/crawling-indexing/links-crawlable"],"related":["multilingual-seo","llm-quoting","distribution-is-the-moat"],"en":{"title":"A good link continues an idea.","dek":"An editorial graph connects parent concepts, neighbors and applications.","point":"An editorial graph connects parent concepts, neighbors and applications. Its usefulness comes from meaningful relationships, not automatically added link counts.","body":["Account Isolation naturally leads to Content Isolation: one differentiates accounts, the other what they publish. An MCP link fits when the reader moves into orchestration. Give anchors labels describing the next step. Crawlable links are still invitations addressed to a person first.","Avoid sending every article to the same three pages without reason. Relationships should follow the argument: a zero-view note leads to diagnosis and measurement quality, while a creative essay leads to personas and formats. The graph becomes navigable when every link announces a useful neighboring question. Automated suggestions can help, but should still be checked against what the source article actually discusses."],"action":["Connect parent, neighbors and practical application.","Avoid vague anchors."],"trap":"Internal linking does not compensate for articles lacking their own substance.","quote":"A good link continues an idea.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A good link continues an idea.","text":"An editorial graph connects parent concepts, neighbors and applications.","media":"/images/editorial/knowledge-graph.jpg"},{"label":"THE CONCEPT","title":"AGD content graph","text":"An editorial graph connects parent concepts, neighbors and applications. Its usefulness comes from meaningful relationships, not automatically added link counts.","media":"/images/editorial/knowledge-graph.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Internal linking does not compensate for articles lacking their own substance.","media":"/images/editorial/knowledge-graph.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect parent, neighbors and practical application.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/knowledge-graph.jpg"},{"label":"PUT IT TO WORK / 2","title":"Avoid vague anchors.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/knowledge-graph.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/knowledge-graph.jpg","width":1280,"height":719,"alt":{"en":"Old suspension bridge cables and metal remains stand among dense woodland vegetation."},"credit":"Rosser1954","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: acd6ffe8ea4180573853b3383994387b3cecec5a.","source":"https://commons.wikimedia.org/wiki/File:Old_Suspension_Bridge_cables,_Ballochmyle,_East_Ayrshire.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"lang":"en"}]
25:["$","$L11","098",{"a":{"id":"098","slug":"multilingual-seo","term":"Multilingual publishing","category":"machines","kind":"guide","image":"multilingual-seo","tier":"operating","evidence":"documented","sources":["https://developers.google.com/search/docs/specialty/international/localized-versions"],"related":["structured-editorial","knowledge-graph","distribution-is-the-moat"],"en":{"title":"Two languages, two real reading experiences.","dek":"A multilingual publication gives each version a stable URL and connects matching translations.","point":"A multilingual publication gives each version a stable URL and connects matching translations. Each language should remain readable and coherent throughout.","body":["Language switching should preserve the article rather than always return home. Cultural references may need rewriting. Hreflang links identify variants while each version has its own canonical URL. Check navigation, alternative text and error messages, often forgotten after body translation.","French and English versions can share a translation identifier while keeping their own metadata. This simplifies language switching, corrections and link checks. If a translation is missing, do not create a false variant filled with the other language. Flag the gap in the pipeline and publish only complete versions. A consistent route map should connect equivalents rather than make search engines or readers guess which page matches."],"action":["Connect equivalent variants.","Check language across all interfaces."],"trap":"Multilingual annotations aid interpretation; they do not guarantee ranking.","quote":"Two languages, two real reading experiences.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Two languages, two real reading experiences.","text":"A multilingual publication gives each version a stable URL and connects matching translations.","media":"/images/editorial/multilingual-seo.jpg"},{"label":"THE CONCEPT","title":"Multilingual publishing","text":"A multilingual publication gives each version a stable URL and connects matching translations. Each language should remain readable and coherent throughout.","media":"/images/editorial/multilingual-seo.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Multilingual annotations aid interpretation; they do not guarantee ranking.","media":"/images/editorial/multilingual-seo.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Connect equivalent variants.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/multilingual-seo.jpg"},{"label":"PUT IT TO WORK / 2","title":"Check language across all interfaces.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/multilingual-seo.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/multilingual-seo.jpg","width":1280,"height":732,"alt":{"en":"Street signs show the same road name in multiple languages and scripts."},"credit":"Libresocietycy","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 53ac8f0d645a00b01319f0f754395057ffdf40ec.","source":"https://commons.wikimedia.org/wiki/File:Multilingual_street_sign_in_Kormacit.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"lang":"en"}]
26:["$","$L11","099",{"a":{"id":"099","slug":"structured-editorial","term":"Structured editorial","category":"machines","kind":"guide","image":"structured-editorial","tier":"operating","evidence":"editorial","sources":[],"related":["agent-audit-log","multilingual-seo","distribution-is-the-moat"],"en":{"title":"A strict schema frees the voice. It does not write it.","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links.","point":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links. It cannot guarantee an interesting article by itself.","body":["Separate mechanical validation from review: unique slugs and image provenance can be checked automatically. The soundness of an opinion and usefulness of an example need judgment. A mature pipeline also blocks broken references and missing translations instead of publishing a skeleton because its JSON is valid.","FEEDRAID’s supplied schema requires two languages, an image with provenance, stories, body text and explicit limitations. Validation also checks references to other articles. These constraints make seeding reproducible. Review still owns subject distinctiveness and example relevance, neither of which structure alone certifies. Treat automated checks as necessary publishing conditions rather than a substitute for deciding whether the piece is actually worth reading."],"action":["Validate structure and relationships before publishing.","Review the text for its own value."],"trap":"A schema-compliant article can still be repetitive or useless.","quote":"A strict schema frees the voice. It does not write it.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A strict schema frees the voice. It does not write it.","text":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links.","media":"/images/editorial/structured-editorial.jpg"},{"label":"THE CONCEPT","title":"Structured editorial","text":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links. It cannot guarantee an interesting article by itself.","media":"/images/editorial/structured-editorial.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A schema-compliant article can still be repetitive or useless.","media":"/images/editorial/structured-editorial.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Validate structure and relationships before publishing.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/structured-editorial.jpg"},{"label":"PUT IT TO WORK / 2","title":"Review the text for its own value.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/structured-editorial.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/structured-editorial.jpg","width":1280,"height":960,"alt":{"en":"Metal Thai printing type sorted into compartments of a large wooden case."},"credit":"Paul_012","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: 4171d3715c8c192eb700f3e595e112c6dee117bc.","source":"https://commons.wikimedia.org/wiki/File:Thai_metal_type,_Bangkok_National_Museum.jpg","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}},"lang":"en"}]
27:["$","$L11","100",{"a":{"id":"100","slug":"agent-audit-log","term":"Agent audit log","category":"machines","kind":"guide","image":"agent-audit-log","tier":"operating","evidence":"editorial","sources":[],"related":["ai-agd","structured-editorial","distribution-is-the-moat"],"en":{"title":"The log that makes tomorrow understandable.","dek":"An agent log connects intent, tool, result and next decision.","point":"An agent log connects intent, tool, result and next decision. It should retain useful evidence without exposing keys, secrets or unnecessary personal data.","body":["Record request identifiers and relevant status instead of full responses potentially containing secrets. Separate preview from live execution. When an incident occurs, the log should reveal what was requested and confirmed. An enthusiastic narrative is not an execution trace.","A readable log can show intent received, preview completed, approval obtained and execution confirmed. Missing stages remain missing. This chain supports recovery after interruption without assuming everything happened. It also makes correction easier by separating the agent’s plan from effects actually confirmed by the service. Keep the report precise enough that another operator can continue without reconstructing meaning from enthusiastic but ambiguous progress messages."],"action":["Log intent, mode and confirmed state.","Redact secrets and minimize retained data."],"trap":"A log should distinguish attempted actions from genuinely completed ones.","quote":"The log that makes tomorrow understandable.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The log that makes tomorrow understandable.","text":"An agent log connects intent, tool, result and next decision.","media":"/images/editorial/agent-audit-log.jpg"},{"label":"THE CONCEPT","title":"Agent audit log","text":"An agent log connects intent, tool, result and next decision. It should retain useful evidence without exposing keys, secrets or unnecessary personal data.","media":"/images/editorial/agent-audit-log.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A log should distinguish attempted actions from genuinely completed ones.","media":"/images/editorial/agent-audit-log.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Log intent, mode and confirmed state.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-audit-log.jpg"},{"label":"PUT IT TO WORK / 2","title":"Redact secrets and minimize retained data.","text":"Adapt this to your audience, budget and test scope.","media":"/images/editorial/agent-audit-log.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T17:06:44.287Z","author":"feedraid-editorial","media":{"kind":"photograph","src":"/images/editorial/agent-audit-log.jpg","width":1280,"height":1420,"alt":{"en":"Labeled decks of punched computer cards packed into a storage box."},"credit":"ArnoldReinhold","provenance":"Wikimedia Commons photograph. Resized and JPEG-compressed from the source photograph. Original source SHA1: b8ab119149236be900f3661af56ce7f925753d6f.","source":"https://commons.wikimedia.org/wiki/File:PunchCardDecks.agr.jpg","license":"CC BY-SA 2.5","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.5"}},"lang":"en"}]
