.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0"},"en":{"title":"A US account does not guarantee a US audience.","dek":"A Geo-Targeted Account is established and operated in its target market."},"readingMinutes":2},"lang":"en"}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]}]]}]
