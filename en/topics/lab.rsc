4:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"The Lab — FEEDRAID"}],["$","meta","1",{"name":"description","content":"AGD, creative systems and the culture underneath the feed. An editorial project initiated by TokPortal."}],["$","link","2",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","3",{"rel":"canonical","href":"https://naybu256.github.io/en/topics/lab/"}],["$","link","4",{"rel":"alternate","hrefLang":"en","href":"https://naybu256.github.io/en/topics/lab/"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L6",null,{"fallback":"$7","children":["$","$L8",null,{"fallback":"$7","children":["$","$L9",null,{"providerId":"layout:/","segmentMap":{"children":["en","topics","lab"]},"children":["$","$La",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"lang|en|d","fallback":["$","main",null,{"className":"main-shell","style":{"paddingTop":100,"minHeight":"80vh"},"children":[["$","span",null,{"className":"mono acid","children":"404 / SIGNAL LOST"}],["$","div",null,{"className":"page-heading","children":[["$","h1",null,{"children":"Off the current."}],["$","p",null,{"children":"This page does not exist."}],["$","a",null,{"className":"read-link","href":"/en/","children":"Back to feed ↗"}]]}]]}],"children":["$","$L9",null,{"providerId":"layout:/[lang]","segmentMap":{"children":["topics","lab"]},"children":["$","$La",null,{"id":"layout:/[lang]","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"[\"lang|en|d\",\"topics\",\"category|lab|d\"]","fallback":["$","main",null,{"className":"main-shell","style":{"paddingTop":100,"minHeight":"80vh"},"children":[["$","span",null,{"className":"mono acid","children":"404 / SIGNAL LOST"}],["$","div",null,{"className":"page-heading","children":[["$","h1",null,{"children":"Off the current."}],["$","p",null,{"children":"This page does not exist."}],["$","a",null,{"className":"read-link","href":"/en/","children":"Back to feed ↗"}]]}]]}],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L9",null,{"providerId":"page:/en/topics/lab","segmentMap":{"children":["__PAGE__"]},"children":["$","$La",null,{"id":"page:/en/topics/lab"}]}],null]}]}]}]}]}]}]}]}]}]}],null,null]
