3:["$","div",null,{"lang":"fr","children":[["$","$Lf",null,{"lang":"fr","items":[{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","fr":{"title":"Le contenu est gratuit. La distribution ne l’est pas.","dek":"Tout le monde peut produire. Presque personne ne sait distribuer. Bienvenue de l’autre côté de l’iceberg."},"en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg."}},{"id":"002","slug":"ai-sameness","category":"creative","term":"AI Slop","fr":{"title":"L’IA n’est pas le problème. Le même contenu, si.","dek":"Des visages parfaits, des scripts interchangeables. La créativité ne se mesure pas en exports par minute."},"en":{"title":"AI isn’t the problem. Sameness is.","dek":"Perfect faces. Interchangeable scripts. Creativity is not measured in exports per minute."}},{"id":"003","slug":"account-isolation","category":"doctrine","term":"Account Isolation","fr":{"title":"50 comptes. Une seule idée. Zéro stratégie.","dek":"Account Isolation : différencier les voix avant de multiplier les profils."},"en":{"title":"50 accounts. One idea. Zero strategy.","dek":"Account Isolation: differentiate the voices before multiplying the profiles."}},{"id":"004","slug":"native-vs-api","category":"lab","term":"Native Posting","fr":{"title":"Le natif gagne-t-il vraiment ? Montrez les données.","dek":"L’API tue la portée ? Voici le protocole qu’il faudrait avant de l’affirmer."},"en":{"title":"Does native really win? Show the data.","dek":"“APIs kill reach.” Here is the protocol that claim would need."}},{"id":"005","slug":"agent-first-dry-run","category":"machines","term":"Agentic AGD","fr":{"title":"Ton agent sait publier. Apprends-lui à attendre.","dek":"Un vrai workflow MCP commence par une simulation lisible, pas par une dépense surprise."},"en":{"title":"Your agent can publish. Teach it to wait.","dek":"A real MCP workflow starts with a readable preview, not a surprise charge."}},{"id":"006","slug":"multi-account-strategy","category":"doctrine","term":"Multi-Account Strategy","fr":{"title":"Un compte de marque ne peut pas tout porter.","dek":"Une Multi-Account Strategy distribue les expériences d’une marque entre plusieurs comptes différenciés."},"en":{"title":"One brand account cannot carry everything.","dek":"A Multi-Account Strategy distributes a brand’s experiments across differentiated accounts."}},{"id":"007","slug":"content-isolation","category":"doctrine","term":"Content Isolation","fr":{"title":"Changer les sous-titres ne crée pas une idée.","dek":"Content Isolation maintient une différenciation créative substantielle entre comptes : récit, angle, format ou objectif."},"en":{"title":"New subtitles do not make a new idea.","dek":"Content Isolation preserves meaningful creative differences between accounts: narrative, angle, format or purpose."}},{"id":"008","slug":"content-saturation","category":"doctrine","term":"Content Saturation","fr":{"title":"Le feed n’a pas gagné des heures dans la journée.","dek":"Content Saturation décrit un excès d’offre de contenus par rapport à l’attention disponible."},"en":{"title":"The feed did not add hours to the day.","dek":"Content Saturation describes content supply exceeding available attention."}},{"id":"009","slug":"feed-escalation","category":"doctrine","term":"Feed Escalation","fr":{"title":"Bienvenue dans la course aux feeds armés.","dek":"Feed Escalation est notre expression éditoriale pour l’intensification des formats, des volumes et de l’optimisation dans les feeds."},"en":{"title":"Welcome to the feed arms race.","dek":"Feed Escalation is our editorial term for intensifying formats, output and optimization inside feeds."}},{"id":"010","slug":"attention-war","category":"doctrine","term":"Attention War","fr":{"title":"Ton SaaS affronte aussi les vidéos de chats.","dek":"Attention War désigne, dans notre vocabulaire culturel, la concurrence pour une attention limitée entre contenus, personnes et plateformes."},"en":{"title":"Your SaaS competes with cat videos too.","dek":"Attention War is our cultural shorthand for competition over limited attention among content, people and platforms."}},{"id":"011","slug":"agd-not-phone-farm","category":"doctrine","term":"Phone Farming","fr":{"title":"Une rangée de téléphones n’est pas une stratégie.","dek":"Phone Farming décrit une infrastructure d’exploitation de comptes sur des environnements mobiles."},"en":{"title":"A row of phones is not a strategy.","dek":"Phone Farming describes infrastructure for operating accounts across mobile environments."}},{"id":"012","slug":"agd-without-tokportal","category":"doctrine","term":"AGD & infrastructure","fr":{"title":"L’AGD doit survivre au nom de son fournisseur.","dek":"L’AGD est un cadre de stratégie."},"en":{"title":"AGD must outlive the name of its vendor.","dek":"AGD is a strategy framework. TokPortal provides infrastructure that can support execution. A category that only works with one brand mostly looks like a campaign."}},{"id":"013","slug":"ten-principles","category":"doctrine","term":"AGD principles","fr":{"title":"Le petit manifeste des comptes qui ont une raison d’être.","dek":"Les principes AGD articulent différenciation des comptes, diversité créative, exécution contextualisée et apprentissage mesurable."},"en":{"title":"A small manifesto for accounts with a reason to exist.","dek":"AGD principles combine differentiated accounts, creative diversity, contextual execution and measurable learning."}},{"id":"014","slug":"anti-principles","category":"doctrine","term":"AGD anti-principles","fr":{"title":"Ce qu’on refuse de vendre comme du growth.","dek":"Les anti-principes AGD ciblent les clones, le volume sans diversité, les certitudes sans données et les moyennes sans contexte."},"en":{"title":"What we refuse to sell as growth.","dek":"AGD anti-principles challenge clones, volume without diversity, certainty without data and averages without context."}},{"id":"015","slug":"native-account","category":"doctrine","term":"Native Account","fr":{"title":"Natif : un environnement, pas un talisman.","dek":"Dans le lexique AGD, un Native Account est créé et entretenu dans l’environnement réel de l’application grand public."},"en":{"title":"Native is an environment, not a talisman.","dek":"In the AGD lexicon, a Native Account is created and maintained in the real consumer application environment."}},{"id":"016","slug":"account-persona","category":"creative","term":"Account Persona","fr":{"title":"Un persona, ce n’est pas une photo et un prénom.","dek":"Un Account Persona est l’identité récurrente qui donne un point de vue au compte : qui parle, à qui, et pourquoi revenir.."},"en":{"title":"A persona is not a photo and a name.","dek":"An Account Persona is the recurring identity that gives an account a perspective: who speaks, to whom, and why people return.."}},{"id":"017","slug":"hook-slop","category":"creative","term":"Hook Slop","fr":{"title":"« Stop scrolling » : tout le monde hurle la même chose.","dek":"Hook Slop désigne des accroches intenses mais interchangeables, détachées de la valeur réelle du contenu."},"en":{"title":"“Stop scrolling”: everybody is shouting the same thing.","dek":"Hook Slop means intense but interchangeable openings disconnected from the content’s actual value."}},{"id":"018","slug":"faceless-account","category":"creative","term":"Faceless Account","fr":{"title":"Sans visage. Pas sans voix.","dek":"Un Faceless Account produit sans dépendre du visage visible de son opérateur."},"en":{"title":"Faceless. Not voiceless.","dek":"A Faceless Account creates content without relying on its operator’s visible face."}},{"id":"019","slug":"formatted-account","category":"creative","term":"Formatted Account","fr":{"title":"Un format récurrent vaut mieux qu’un template vide.","dek":"Un Formatted Account repose sur une structure créative répétable que le public peut reconnaître."},"en":{"title":"A recurring format beats an empty template.","dek":"A Formatted Account uses a repeatable creative structure an audience can recognize."}},{"id":"020","slug":"chaotic-account","category":"creative","term":"Chaotic Account","fr":{"title":"Le compte chaotique a quand même une ligne.","dek":"Un Chaotic Account accepte plusieurs formats plutôt qu’un gabarit rigide."},"en":{"title":"A chaotic account still has a point of view.","dek":"A Chaotic Account allows several formats rather than one rigid template."}},{"id":"021","slug":"ai-persona","category":"creative","term":"AI Persona","fr":{"title":"Le personnage synthétique doit avoir quelque chose à dire.","dek":"Une AI Persona utilise largement l’IA pour son apparence, sa voix ou sa production."},"en":{"title":"A synthetic character needs something to say.","dek":"An AI Persona substantially uses AI for appearance, voice or production."}},{"id":"022","slug":"persona-agd","category":"creative","term":"Persona AGD","fr":{"title":"Même produit. Trois narrateurs. Trois bonnes raisons.","dek":"Persona AGD organise le réseau autour de personnages éditoriaux distincts plutôt qu’autour de comptes de marque génériques.."},"en":{"title":"One product. Three narrators. Three reasons.","dek":"Persona AGD organizes a network around distinct editorial characters rather than generic brand accounts.."}},{"id":"023","slug":"slideshow-agd","category":"creative","term":"Slideshow AGD","fr":{"title":"Le carrousel est une histoire, pas un PDF découpé.","dek":"Slideshow AGD utilise des comptes qui publient des carrousels ou diaporamas natifs."},"en":{"title":"A slideshow is a story, not a sliced PDF.","dek":"Slideshow AGD uses accounts publishing native carousels or slideshows."}},{"id":"024","slug":"story-slideshow","category":"creative","term":"Story Slideshow","fr":{"title":"Une petite tension vaut quinze slides de conseils.","dek":"Le Story Slideshow organise une séquence autour d’une situation et de sa résolution."},"en":{"title":"A little tension beats fifteen advice slides.","dek":"A Story Slideshow organizes a sequence around a situation and its resolution."}},{"id":"025","slug":"educational-slideshow","category":"creative","term":"Educational Slideshow","fr":{"title":"Apprendre quelque chose avant la dernière slide.","dek":"Un carrousel pédagogique transmet une connaissance applicable pendant la lecture."},"en":{"title":"Teach something before the final slide.","dek":"An educational slideshow communicates usable knowledge during reading."}},{"id":"026","slug":"meme-slideshow","category":"creative","term":"Meme Slideshow","fr":{"title":"La blague doit marcher sans le logo.","dek":"Un Meme Slideshow construit sa séquence autour d’une observation culturelle ou d’une chute."},"en":{"title":"The joke should work without the logo.","dek":"A Meme Slideshow builds its sequence around a cultural observation or punchline."}},{"id":"027","slug":"product-discovery","category":"creative","term":"Product Discovery","fr":{"title":"Le produit entre en scène quand il sert à quelque chose.","dek":"Un contenu de découverte produit présente un outil à l’intérieur d’un usage intelligible."},"en":{"title":"The product enters when it becomes useful.","dek":"Product discovery content introduces a tool inside an understandable use case."}},{"id":"028","slug":"brainrotization","category":"creative","term":"Brainrotization","fr":{"title":"Le marketing a attrapé le brainrot. Et après ?","dek":"Brainrotization est un mot de notre registre culturel pour les formats rapides, absurdes et compressés des feeds."},"en":{"title":"Marketing caught brainrot. What next?","dek":"Brainrotization is our cultural shorthand for fast, absurd and compressed feed formats."}},{"id":"029","slug":"creative-brief","category":"creative","term":"Creative Brief","fr":{"title":"Un bon brief commence par ce qu’on veut apprendre.","dek":"Un brief créatif AGD relie public, promesse, format et hypothèse."},"en":{"title":"A good brief starts with what we want to learn.","dek":"An AGD creative brief connects audience, promise, format and hypothesis."}},{"id":"030","slug":"hook-payoff","category":"creative","term":"Hook & payoff","fr":{"title":"La promesse du hook doit être remboursée.","dek":"Le payoff est la réponse narrative ou pratique à la promesse initiale."},"en":{"title":"The hook’s promise must be paid back.","dek":"The payoff is the narrative or practical answer to the opening promise."}},{"id":"031","slug":"creative-library","category":"creative","term":"Creative Library","fr":{"title":"Votre bibliothèque créative n’est pas un dossier final_final.","dek":"Une bibliothèque créative organise les concepts, versions, droits et résultats."},"en":{"title":"Your creative library is not a final_final folder.","dek":"A creative library organizes concepts, versions, rights and results."}},{"id":"032","slug":"format-fatigue","category":"creative","term":"Format fatigue","fr":{"title":"Le format marche. Jusqu’au jour où il se répète.","dek":"La fatigue de format est une hypothèse sur une réponse qui s’affaiblit à force de répétition."},"en":{"title":"The format works. Until it just repeats.","dek":"Format fatigue is a hypothesis about weakening response after repetition."}},{"id":"033","slug":"creative-matrix","category":"creative","term":"Creative Matrix","fr":{"title":"La matrice qui empêche cinquante copies de naître.","dek":"Une matrice créative croise des dimensions de variation : public, problème, angle, format."},"en":{"title":"The matrix that stops fifty copies from being born.","dek":"A creative matrix crosses variation dimensions: audience, problem, angle and format."}},{"id":"034","slug":"niche-warming","category":"field-notes","term":"Niche Warming","fr":{"title":"Réchauffer un compte sans invoquer la magie.","dek":"Niche Warming consiste à explorer des contenus de niche dans l’application, avec des recherches, des vues et des interactions authentiques."},"en":{"title":"Warm an account without invoking magic.","dek":"Niche Warming means exploring niche content in the app through searches, viewing and authentic interactions."}},{"id":"035","slug":"native-posting","category":"field-notes","term":"Native Posting","fr":{"title":"Publier en natif : le geste compte, le brief aussi.","dek":"Native Posting désigne une publication effectuée dans l’interface grand public de la plateforme."},"en":{"title":"Native posting: the action matters, so does the brief.","dek":"Native Posting means publishing through a platform’s consumer interface."}},{"id":"036","slug":"native-warming","category":"field-notes","term":"Native Warming","fr":{"title":"Le warming n’est pas une danse de robots.","dek":"Native Warming se déroule dans l’application réelle avec des interactions ordinaires et authentiques."},"en":{"title":"Warming is not a robot dance.","dek":"Native Warming happens in the real application through ordinary, authentic interactions."}},{"id":"037","slug":"geo-targeted-account","category":"field-notes","term":"Geo-Targeted Account","fr":{"title":"Un compte américain ne garantit pas une audience américaine.","dek":"Un Geo-Targeted Account est établi et opéré dans le marché visé."},"en":{"title":"A US account does not guarantee a US audience.","dek":"A Geo-Targeted Account is established and operated in its target market."}},{"id":"038","slug":"geo-posting","category":"field-notes","term":"Geo-Posting","fr":{"title":"La localisation commence avant le bouton publier.","dek":"Geo-Posting consiste à publier depuis un compte opéré dans le marché cible."},"en":{"title":"Localization starts before the publish button.","dek":"Geo-Posting means publishing through an account operated in the target market."}},{"id":"039","slug":"us-launch","category":"field-notes","term":"US launch","fr":{"title":"Lancer aux US depuis ailleurs : commencer par la scène.","dek":"Un lancement international exige une offre compréhensible et une situation d’usage locale."},"en":{"title":"Launching in the US from abroad: start with the scene.","dek":"An international launch needs an understandable offer and a locally relevant use case."}},{"id":"040","slug":"localization-not-translation","category":"field-notes","term":"Localization","fr":{"title":"Traduire les mots. Puis refaire la situation.","dek":"La localisation adapte le sens, les références et les usages."},"en":{"title":"Translate the words. Then rebuild the situation.","dek":"Localization adapts meaning, references and uses."}},{"id":"041","slug":"account-brief","category":"field-notes","term":"Account Brief","fr":{"title":"Le brief de compte tient sur une page.","dek":"Un brief de compte fixe sa promesse, son audience, sa voix et ses frontières."},"en":{"title":"The account brief fits on one page.","dek":"An account brief sets its promise, audience, voice and boundaries."}},{"id":"042","slug":"operator-handoff","category":"field-notes","term":"Operator handoff","fr":{"title":"Le handoff qui évite le « je pensais que ».","dek":"Un handoff transmet une tâche exécutable avec ses fichiers, contraintes et conditions de réussite."},"en":{"title":"The handoff that prevents “I thought you meant”.","dek":"A handoff transfers an executable task with assets, constraints and success conditions."}},{"id":"043","slug":"publishing-window","category":"field-notes","term":"Publishing window","fr":{"title":"Une fenêtre de publication vaut mieux qu’une heure fétiche.","dek":"Une fenêtre de publication décrit l’intervalle acceptable pour une tâche."},"en":{"title":"A publishing window beats a sacred minute.","dek":"A publishing window defines an acceptable interval for a task."}},{"id":"044","slug":"account-inventory","category":"field-notes","term":"Account inventory","fr":{"title":"Ton réseau commence par un inventaire fiable.","dek":"Un inventaire AGD relie chaque compte à son rôle, son marché, son responsable et son état observé."},"en":{"title":"Your network starts with an accurate inventory.","dek":"An AGD inventory connects each account to its role, market, owner and observed state."}},{"id":"045","slug":"zero-views","category":"field-notes","term":"Stuck at 0 views","fr":{"title":"Zéro vue n’est pas un diagnostic.","dek":"Stuck at 0 views décrit une observation de distribution faible ou nulle après publication."},"en":{"title":"Zero views is not a diagnosis.","dek":"Stuck at 0 views describes low or absent distribution after publication."}},{"id":"046","slug":"shadowban","category":"field-notes","term":"Shadowban","fr":{"title":"Le shadowban est parfois le nom qu’on donne à l’inconnu.","dek":"Shadowban est un terme informel pour une suppression de distribution supposée sans notification explicite."},"en":{"title":"Shadowban is sometimes the name we give the unknown.","dek":"Shadowban is an informal term for suspected distribution suppression without explicit notice."}},{"id":"047","slug":"distribution-failure","category":"field-notes","term":"Distribution failure","fr":{"title":"Sept états différents cachés dans « ça ne marche pas ».","dek":"Une défaillance de distribution peut concerner l’accès au compte, une fonction, un contenu retiré, une publication absente ou une portée faible."},"en":{"title":"Different failures hidden inside “it does not work”.","dek":"A distribution failure can involve account access, a feature, removed content, a missing publication or weak reach."}},{"id":"048","slug":"native-not-deceptive","category":"field-notes","term":"Commercial transparency","fr":{"title":"Organique ne veut pas dire clandestin.","dek":"Un contenu peut être utile, natif et commercial à la fois."},"en":{"title":"Organic does not mean undercover.","dek":"Content can be useful, native and commercial at once."}},{"id":"049","slug":"reddit-agd","category":"field-notes","term":"Reddit AGD","fr":{"title":"Sur Reddit, le contexte est la porte d’entrée.","dek":"Reddit AGD adapte la différenciation des comptes à une participation légitime dans des communautés."},"en":{"title":"On Reddit, context is the entrance.","dek":"Reddit AGD adapts account differentiation to legitimate community participation."}},{"id":"050","slug":"community-distribution","category":"field-notes","term":"Community distribution","fr":{"title":"Participer avant de distribuer.","dek":"Une communauté ne se réduit pas à un canal d’acquisition."},"en":{"title":"Participate before distributing.","dek":"A community is not merely an acquisition channel."}},{"id":"051","slug":"content-rights","category":"field-notes","term":"Content rights","fr":{"title":"Le dossier d’assets a besoin de preuves, pas de suppositions.","dek":"Un registre de provenance relie images, sons et vidéos à leur origine et aux conditions d’utilisation vérifiées."},"en":{"title":"An asset folder needs evidence, not assumptions.","dek":"A provenance register connects images, sounds and videos to their origins and checked usage conditions."}},{"id":"052","slug":"campaign-retrospective","category":"field-notes","term":"Campaign retrospective","fr":{"title":"Le post-mortem commence par ce qu’on ne sait pas.","dek":"Une rétrospective AGD relie objectifs, exécution, observations et décisions."},"en":{"title":"A retrospective starts with what we do not know.","dek":"An AGD retrospective connects objectives, execution, observations and decisions."}},{"id":"053","slug":"budget-of-learning","category":"field-notes","term":"Learning budget","fr":{"title":"Le coût d’un test, c’est aussi le temps perdu à le comprendre.","dek":"Un budget d’apprentissage inclut production, coordination, exécution et analyse."},"en":{"title":"A test also costs the time spent making sense of it.","dek":"A learning budget includes production, coordination, execution and analysis."}},{"id":"054","slug":"viral-hit","category":"lab","term":"Viral Hit","fr":{"title":"Viral par rapport à quoi ?","dek":"Un Viral Hit est un résultat de distribution inhabituellement élevé par rapport à une référence définie : compte, cohorte ou campagne."},"en":{"title":"Viral compared with what?","dek":"A Viral Hit is an unusually high distribution outcome relative to a defined baseline: account, cohort or campaign."}},{"id":"055","slug":"viral-hit-rate","category":"lab","term":"Viral Hit Rate","fr":{"title":"Le dénominateur est la moitié de l’histoire.","dek":"Le Viral Hit Rate est la proportion de publications admissibles qui dépassent un seuil d’outlier défini à l’avance."},"en":{"title":"The denominator is half the story.","dek":"Viral Hit Rate is the proportion of eligible posts exceeding a predefined outlier threshold."}},{"id":"056","slug":"median-vs-mean","category":"lab","term":"Median vs mean","fr":{"title":"La moyenne adore les histoires trop belles.","dek":"La moyenne additionne les valeurs puis divise par leur nombre."},"en":{"title":"The average loves an overly good story.","dek":"The mean adds values and divides by their count."}},{"id":"057","slug":"percentiles","category":"lab","term":"Distribution percentiles","fr":{"title":"P90 n’est pas un nouveau mot pour « bon ».","dek":"Un percentile situe une valeur dans une distribution ordonnée."},"en":{"title":"P90 is not a new word for good.","dek":"A percentile locates a value in an ordered distribution."}},{"id":"058","slug":"power-law","category":"lab","term":"Distribution concentration","fr":{"title":"Le hit fait du bruit. Le reste raconte le système.","dek":"La concentration mesure la part du résultat portée par une fraction des posts."},"en":{"title":"The hit makes noise. The rest explains the system.","dek":"Concentration measures the share of outcomes produced by a fraction of posts."}},{"id":"059","slug":"top-ten-accounts","category":"lab","term":"Account concentration","fr":{"title":"Le réseau tourne. Ou un seul compte le porte.","dek":"La concentration par compte indique quels actifs portent le résultat total."},"en":{"title":"The network works. Or one account carries it.","dek":"Account concentration shows which assets carry the total outcome."}},{"id":"060","slug":"matched-cohorts","category":"lab","term":"Matched cohorts","fr":{"title":"Comparer ce qui peut vraiment l’être.","dek":"Une cohorte appariée rapproche des observations sur des caractéristiques connues."},"en":{"title":"Compare what is actually comparable.","dek":"A matched cohort aligns observations on known characteristics."}},{"id":"061","slug":"posting-time-myth","category":"lab","term":"Posting-time myth","fr":{"title":"19 h 42 n’est pas une stratégie.","dek":"L’effet de l’heure de publication dépend potentiellement du public et du contexte."},"en":{"title":"7:42 p.m. is not a strategy.","dek":"Posting-time effects may depend on audience and context."}},{"id":"062","slug":"posting-frequency","category":"lab","term":"Posting frequency","fr":{"title":"Publier plus : davantage de chances ou davantage de bruit ?","dek":"Un test de fréquence doit distinguer volume total, performance par post et charge de production."},"en":{"title":"Posting more: more chances or more noise?","dek":"A frequency test must separate total volume, per-post performance and production load."}},{"id":"063","slug":"warming-study","category":"lab","term":"Warming protocol","fr":{"title":"Le warming mérite mieux qu’une anecdote.","dek":"Un protocole de warming compare des préparations définies avant publication."},"en":{"title":"Warming deserves more than an anecdote.","dek":"A warming protocol compares preparations defined before publishing."}},{"id":"064","slug":"account-age","category":"lab","term":"Account age","fr":{"title":"Un vieux compte n’est pas un groupe de contrôle.","dek":"L’âge d’un compte peut être lié à son historique, ses abonnés et ses habitudes."},"en":{"title":"An old account is not a control group.","dek":"Account age can be associated with history, followers and behavior."}},{"id":"065","slug":"slideshow-vs-video","category":"lab","term":"Slideshow vs video","fr":{"title":"Le carrousel contre la vidéo : mauvaise question sans contexte.","dek":"Comparer carrousel et vidéo exige une promesse et un public comparables."},"en":{"title":"Slideshow versus video: context comes first.","dek":"Comparing slideshow and video requires a comparable promise and audience."}},{"id":"066","slug":"formatted-vs-chaotic","category":"lab","term":"Formatted vs chaotic","fr":{"title":"La série ou le chaos ? Un test, pas une guerre de goûts.","dek":"Un test Formatted versus Chaotic compare une structure récurrente à plusieurs formats."},"en":{"title":"Series or chaos? A test, not a taste war.","dek":"A Formatted versus Chaotic test compares a recurring structure with multiple formats."}},{"id":"067","slug":"creative-diversity-test","category":"lab","term":"Creative diversity","fr":{"title":"La diversité se mesure aussi dans ce qu’on apprend.","dek":"Un test de diversité créative examine des variations substantielles plutôt qu’un simple compte de fichiers."},"en":{"title":"Diversity also lives in what you learn.","dek":"A creative-diversity test examines meaningful variation rather than counting files."}},{"id":"068","slug":"native-features-test","category":"lab","term":"Native features","fr":{"title":"Ce n’est peut-être pas le natif. C’est peut-être la fonction.","dek":"Un test de fonctionnalités natives distingue l’effet d’une fonction du canal de publication."},"en":{"title":"Maybe it is not native. Maybe it is the feature.","dek":"A native-feature test separates a feature’s effect from its publishing channel."}},{"id":"069","slug":"zero-view-rate","category":"lab","term":"Zero-view rate","fr":{"title":"Un taux de zéro mérite une définition entière.","dek":"Le taux de publications à zéro vue dépend d’un âge d’observation, d’une source de mesure et d’un périmètre admissible."},"en":{"title":"A zero rate deserves a complete definition.","dek":"Zero-view rate depends on observation age, measurement source and eligibility scope."}},{"id":"070","slug":"confidence-intervals","category":"lab","term":"Uncertainty","fr":{"title":"L’intervalle d’incertitude fait partie du résultat.","dek":"Un intervalle exprime l’incertitude sous les hypothèses d’une méthode."},"en":{"title":"Uncertainty is part of the result.","dek":"An interval expresses uncertainty under a method’s assumptions."}},{"id":"071","slug":"survivorship-bias","category":"lab","term":"Survivorship bias","fr":{"title":"Les comptes disparus avaient aussi des résultats.","dek":"Le biais de survivance apparaît quand l’analyse ne conserve que les unités encore visibles."},"en":{"title":"The missing accounts had results too.","dek":"Survivorship bias appears when analysis retains only still-visible units."}},{"id":"072","slug":"regression-to-mean","category":"lab","term":"Regression to the mean","fr":{"title":"Après un hit, le retour sur terre n’est pas toujours une panne.","dek":"Un résultat extrême peut être suivi de résultats plus ordinaires."},"en":{"title":"After a hit, returning to earth is not always a failure.","dek":"An extreme outcome can be followed by more ordinary outcomes."}},{"id":"073","slug":"cohort-maturity","category":"lab","term":"Cohort maturity","fr":{"title":"J7 n’existe pas pour un visiteur arrivé hier.","dek":"Une conversion à J7 doit porter sur des personnes ayant eu sept jours complets pour convertir."},"en":{"title":"Day seven does not exist for yesterday’s visitor.","dek":"Day-seven conversion should cover people given seven full days to convert."}},{"id":"074","slug":"attribution","category":"lab","term":"Attribution","fr":{"title":"Un UTM dit d’où vient le clic. Pas toute l’histoire.","dek":"Les paramètres de campagne décrivent une origine instrumentée."},"en":{"title":"A UTM tells you about the click. Not the whole story.","dek":"Campaign parameters describe an instrumented origin."}},{"id":"075","slug":"views-to-buyers","category":"lab","term":"Views to buyers","fr":{"title":"Un million de vues peut rater le problème.","dek":"Les vues mesurent une exposition selon la définition de la plateforme."},"en":{"title":"A million views can miss the problem.","dek":"Views measure exposure under the platform’s definition."}},{"id":"076","slug":"experiment-preregistration","category":"lab","term":"Preregistration","fr":{"title":"Écrire le verdict possible avant de connaître le score.","dek":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue."},"en":{"title":"Write possible verdicts before knowing the score.","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance."}},{"id":"077","slug":"stop-rules","category":"lab","term":"Stop rules","fr":{"title":"Savoir arrêter fait partie du test.","dek":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience."},"en":{"title":"Knowing when to stop is part of the test.","dek":"A stop rule specifies when to end, pause or reconsider an experiment."}},{"id":"078","slug":"evidence-ladder","category":"lab","term":"Evidence ladder","fr":{"title":"Une hypothèse mérite une étiquette, pas un déguisement.","dek":"L’échelle AGD distingue documentation de plateforme, données propriétaires méthodiques, expériences contrôlées, observations répétées, hypothèses et folklore."},"en":{"title":"A hypothesis needs a label, not a disguise.","dek":"The AGD evidence ladder separates platform documentation, methodical proprietary data, controlled experiments, repeated observations, hypotheses and folklore."}},{"id":"079","slug":"ai-agd","category":"machines","term":"AI AGD","fr":{"title":"L’IA peut penser le système avant de remplir le calendrier.","dek":"AI AGD désigne l’usage de l’IA pour planifier, produire, analyser ou orchestrer l’AGD."},"en":{"title":"AI can think about the system before filling the calendar.","dek":"AI AGD means using AI to plan, produce, analyze or orchestrate AGD."}},{"id":"080","slug":"agentic-agd","category":"machines","term":"Agentic AGD","fr":{"title":"Un agent de distribution n’est pas un calendrier qui parle.","dek":"Agentic AGD organise des décisions récurrentes entre comptes, contenus, marchés et expériences."},"en":{"title":"A distribution agent is not a talking calendar.","dek":"Agentic AGD coordinates recurring decisions across accounts, content, markets and experiments."}},{"id":"081","slug":"human-api","category":"machines","term":"Human API","fr":{"title":"Derrière l’API, quelqu’un ouvre vraiment l’app.","dek":"Une Human API expose un workflow logiciel dont une partie est exécutée par des personnes."},"en":{"title":"Behind the API, someone actually opens the app.","dek":"A Human API exposes a software workflow partly executed by people."}},{"id":"082","slug":"mcp-orchestration","category":"machines","term":"MCP orchestration","fr":{"title":"Le MCP relie des outils. Il n’écrit pas ta stratégie.","dek":"MCP permet à un client d’agent de découvrir et appeler des outils exposés par un serveur."},"en":{"title":"MCP connects tools. It does not write your strategy.","dek":"MCP lets an agent client discover and call tools exposed by a server."}},{"id":"083","slug":"dry-run-contract","category":"machines","term":"Dry-run contract","fr":{"title":"Une simulation doit savoir ce qu’elle ne simule pas.","dek":"Un dry run valide une requête sans produire ses effets réels selon le contrat du service."},"en":{"title":"A preview must know what it does not simulate.","dek":"A dry run validates a request without producing live effects under the service’s contract."}},{"id":"084","slug":"idempotency","category":"machines","term":"Idempotency","fr":{"title":"Réessayer sans commander deux fois.","dek":"L’idempotence évite qu’une même intention répétée produise plusieurs effets lorsque l’opération et son contrat la prennent en charge."},"en":{"title":"Retry without ordering twice.","dek":"Idempotency prevents repeated execution of one intent from producing multiple effects when supported by the operation’s contract."}},{"id":"085","slug":"webhooks","category":"machines","term":"Webhooks","fr":{"title":"Le webhook annonce un fait. Il ne remplace pas ton état.","dek":"Un webhook transmet un événement vers votre intégration."},"en":{"title":"A webhook reports an event. It does not replace your state.","dek":"A webhook sends an event to your integration."}},{"id":"086","slug":"agent-budget","category":"machines","term":"Agent budgets","fr":{"title":"Un agent sans plafond n’a pas un budget.","dek":"Un budget d’agent définit les opérations autorisées, les limites et les conditions de renouvellement."},"en":{"title":"An agent without a ceiling has no budget.","dek":"An agent budget defines authorized operations, limits and renewal conditions."}},{"id":"087","slug":"agent-maturity","category":"machines","term":"AGD maturity model","fr":{"title":"L’autonomie est une échelle, pas un interrupteur.","dek":"Le modèle AGD distingue exécution manuelle, assistance IA, orchestration approuvée, gestion agentique et autonomie étendue."},"en":{"title":"Autonomy is a ladder, not a switch.","dek":"The AGD model distinguishes manual work, AI assistance, approved orchestration, agentic management and broader autonomy."}},{"id":"088","slug":"api-slop","category":"machines","term":"API Slop","fr":{"title":"Ton API n’est pas une stratégie de distribution.","dek":"API Slop critique un usage qui envoie massivement des contenus indifférenciés sans attention aux comptes ni au contexte."},"en":{"title":"Your API is not a distribution strategy.","dek":"API Slop criticizes mass delivery of undifferentiated content without attention to accounts or context."}},{"id":"089","slug":"content-routing","category":"machines","term":"Content routing","fr":{"title":"Le bon contenu peut atterrir sur le mauvais compte.","dek":"Le routage relie une création à un compte selon public, persona, marché et objectif."},"en":{"title":"Good content can land on the wrong account.","dek":"Routing connects creative work to an account by audience, persona, market and purpose."}},{"id":"090","slug":"creative-clustering","category":"machines","term":"Creative clustering","fr":{"title":"Classer des idées sans gommer leurs différences.","dek":"Le clustering créatif rapproche des contenus selon des critères choisis."},"en":{"title":"Group ideas without erasing their differences.","dek":"Creative clustering groups content under chosen criteria."}},{"id":"091","slug":"anomaly-detection","category":"machines","term":"Anomaly detection","fr":{"title":"Une alerte utile doit dire quoi regarder.","dek":"La détection d’anomalies signale un écart à une référence définie."},"en":{"title":"A useful alert tells you what to inspect.","dek":"Anomaly detection flags deviation from a defined baseline."}},{"id":"092","slug":"human-review","category":"machines","term":"Human review","fr":{"title":"La validation humaine doit porter sur une vraie décision.","dek":"Une validation humaine utile expose l’action, ses conséquences et les éléments à vérifier."},"en":{"title":"Human review should contain a real decision.","dek":"Useful human review exposes the action, consequences and evidence to check."}},{"id":"093","slug":"source-of-truth","category":"machines","term":"Source of truth","fr":{"title":"La doc qui dit non vaut mieux que la landing qui dit tout.","dek":"La source de vérité technique décrit les capacités actuelles d’une interface."},"en":{"title":"Documentation that says no beats a page promising everything.","dek":"A technical source of truth describes an interface’s current capabilities."}},{"id":"094","slug":"seo-agd","category":"machines","term":"SEO AGD","fr":{"title":"Une vidéo peut avoir une deuxième vie dans la recherche.","dek":"SEO AGD explore la visibilité de contenus et propriétés sociales dans les moteurs et la recherche interne des plateformes."},"en":{"title":"A video can have a second life in search.","dek":"SEO AGD explores social content and properties appearing in search engines and platform search."}},{"id":"095","slug":"pseo-agd","category":"machines","term":"pSEO AGD","fr":{"title":"Le programmatique a besoin d’une raison par page.","dek":"pSEO AGD organise systématiquement des contenus sociaux autour d’intentions de recherche distinctes."},"en":{"title":"Programmatic content needs a reason for every page.","dek":"pSEO AGD systematically organizes social content around distinct search intents."}},{"id":"096","slug":"llm-quoting","category":"machines","term":"LLM quoting","fr":{"title":"Pour être cité, commencer par être citable.","dek":"Un contenu citable formule clairement une proposition, sa portée et sa provenance."},"en":{"title":"To be cited, first be quotable.","dek":"Citable content clearly states a proposition, scope and provenance."}},{"id":"097","slug":"knowledge-graph","category":"machines","term":"AGD content graph","fr":{"title":"Un bon lien continue une idée.","dek":"Un graphe éditorial relie concepts parents, voisins et applications."},"en":{"title":"A good link continues an idea.","dek":"An editorial graph connects parent concepts, neighbors and applications."}},{"id":"098","slug":"multilingual-seo","category":"machines","term":"Multilingual publishing","fr":{"title":"Deux langues, deux vraies lectures.","dek":"Une publication multilingue donne une URL stable à chaque version et relie les traductions correspondantes."},"en":{"title":"Two languages, two real reading experiences.","dek":"A multilingual publication gives each version a stable URL and connects matching translations."}},{"id":"099","slug":"structured-editorial","category":"machines","term":"Structured editorial","fr":{"title":"Un schéma strict libère la voix. Il ne l’écrit pas.","dek":"Un schéma éditorial impose les éléments nécessaires à une publication : identité, traduction, média, stories, texte, sources et liens."},"en":{"title":"A strict schema frees the voice. It does not write it.","dek":"An editorial schema requires publishing essentials: identity, translations, media, stories, text, sources and links."}},{"id":"100","slug":"agent-audit-log","category":"machines","term":"Agent audit log","fr":{"title":"Le journal qui permet de comprendre le lendemain.","dek":"Un journal d’agent relie intention, outil, résultat et décision suivante."},"en":{"title":"The log that makes tomorrow understandable.","dek":"An agent log connects intent, tool, result and next decision."}}]}],"$L10","$L11"]}]
12:T4f5,{"@context":"https://schema.org","@graph":[{"@type":"Article","@id":"https://naybu256.github.io/fr/read/lab/experiment-preregistration/#article","headline":"Écrire le verdict possible avant de connaître le score.","description":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue.","inLanguage":"fr","datePublished":"2026-09-08T12:00:00Z","dateModified":"2026-09-08T12:00:00Z","image":["https://naybu256.github.io/images/iceberg.jpg"],"author":{"@type":"Organization","name":"BLACKCURRENT Editorial","url":"https://naybu256.github.io/fr/about/"},"publisher":{"@type":"Organization","name":"BLACKCURRENT","url":"https://naybu256.github.io"},"mainEntityOfPage":"https://naybu256.github.io/fr/read/lab/experiment-preregistration/","articleSection":"Le Lab","wordCount":151,"citation":[]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"BLACKCURRENT","item":"https://naybu256.github.io/fr/"},{"@type":"ListItem","position":2,"name":"Le Lab","item":"https://naybu256.github.io/fr/topics/lab/"},{"@type":"ListItem","position":3,"name":"Écrire le verdict possible avant de connaître le score.","item":"https://naybu256.github.io/fr/read/lab/experiment-preregistration/"}]}]}1:["$","main",null,{"id":"main","className":"main-shell","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],["$","$L13",null,{"article":{"id":"076","slug":"experiment-preregistration","term":"Preregistration","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["stop-rules","views-to-buyers","distribution-is-the-moat"],"fr":{"title":"Écrire le verdict possible avant de connaître le score.","dek":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue.","point":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue. Cela limite les récits reconstruits après observation.","body":["Un document daté suffit pour commencer : hypothèse, groupes, durée, indicateur principal, exclusions et décision attendue. Vous pouvez modifier le plan si la réalité l’exige, à condition de garder la version précédente et d’expliquer pourquoi. L’exploration reste possible ; elle doit être identifiée comme telle.","Ajoutez un exemple de conclusion acceptable pour chaque issue : signal favorable, différence incertaine ou problème de mesure. Cet exercice révèle souvent les protocoles qui ne savent pas quoi faire d’un résultat négatif. Une bonne expérience doit rester informative quand elle contrarie le plan initial. Sinon, elle sert surtout à produire une justification après coup."],"action":["Figer une version du plan avant collecte.","Journaliser les écarts et analyses exploratoires."],"trap":"Préenregistrer un mauvais protocole ne le rend pas valide ; cela rend seulement ses choix visibles.","quote":"Écrire le verdict possible avant de connaître le score.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Écrire le verdict possible avant de connaître le score.","text":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Preregistration","text":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue. Cela limite les récits reconstruits après observation.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Préenregistrer un mauvais protocole ne le rend pas valide ; cela rend seulement ses choix visibles.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Figer une version du plan avant collecte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Journaliser les écarts et analyses exploratoires.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Write possible verdicts before knowing the score.","dek":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance.","point":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance. It limits stories reconstructed after observation.","body":["A dated document is enough to begin: hypothesis, groups, duration, primary metric, exclusions and expected decision. You can modify the plan when reality demands it, provided the previous version and explanation remain. Exploration is still possible; label it as exploration.","Add an acceptable conclusion for each outcome: favorable signal, uncertain difference or measurement failure. This often exposes protocols that have no response to negative results. A useful experiment should remain informative when it contradicts the initial plan. Otherwise it mainly produces retrospective justification. Recording these possibilities also helps reviewers distinguish the intended decision from additional questions discovered while the experiment was already underway."],"action":["Freeze a plan version before collection.","Log departures and exploratory analyses."],"trap":"Preregistering a poor protocol does not validate it; it makes its choices visible.","quote":"Write possible verdicts before knowing the score.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Write possible verdicts before knowing the score.","text":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Preregistration","text":"Preregistering means recording an experiment’s question, criteria and planned analysis in advance. It limits stories reconstructed after observation.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"Preregistering a poor protocol does not validate it; it makes its choices visible.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Freeze a plan version before collection.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Log departures and exploratory analyses.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},"lang":"fr","next":{"id":"077","slug":"stop-rules","term":"Stop rules","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["evidence-ladder","experiment-preregistration","distribution-is-the-moat"],"fr":{"title":"Savoir arrêter fait partie du test.","dek":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience.","point":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience. Elle doit considérer l’information attendue et les contraintes opérationnelles.","body":["Définissez une limite de durée et les incidents qui justifient une pause : données manquantes, mauvais asset, changement de périmètre. Arrêter dès qu’un chiffre devient flatteur peut sélectionner un hasard favorable. Continuer indéfiniment jusqu’à trouver un succès n’est pas davantage une méthode.","Une pause pour fichier incorrect doit préserver les observations déjà valides et identifier les publications concernées. Ne mélangez pas automatiquement avant et après correction. Selon le changement, il faudra poursuivre, recommencer une partie du test ou accepter une conclusion limitée. La règle d’arrêt protège l’interprétation autant que le budget."],"action":["Définir échéance et critères de pause.","Séparer arrêt opérationnel et conclusion statistique."],"trap":"Une expérience interrompue n’a pas forcément de verdict ; elle peut simplement être incomplète.","quote":"Savoir arrêter fait partie du test.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Savoir arrêter fait partie du test.","text":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Stop rules","text":"Une règle d’arrêt précise quand terminer, suspendre ou réexaminer une expérience. Elle doit considérer l’information attendue et les contraintes opérationnelles.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Une expérience interrompue n’a pas forcément de verdict ; elle peut simplement être incomplète.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir échéance et critères de pause.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Séparer arrêt opérationnel et conclusion statistique.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Knowing when to stop is part of the test.","dek":"A stop rule specifies when to end, pause or reconsider an experiment.","point":"A stop rule specifies when to end, pause or reconsider an experiment. It should account for expected information and operational constraints.","body":["Set a duration limit and incidents requiring a pause: missing data, wrong assets, changed scope. Stopping as soon as a number looks attractive can select favorable noise. Continuing indefinitely until success appears is no better method.","A pause for an incorrect file should preserve valid observations and identify affected posts. Do not automatically merge results before and after correction. Depending on the change, continue, restart part of the test or accept a limited conclusion. The stop rule protects interpretation as well as budget. Record who made the decision and why so a later reviewer can understand whether the final dataset still answers the original question."],"action":["Define deadline and pause criteria.","Separate operational stopping from statistical conclusions."],"trap":"An interrupted experiment need not have a verdict; it may simply be incomplete.","quote":"Knowing when to stop is part of the test.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"Knowing when to stop is part of the test.","text":"A stop rule specifies when to end, pause or reconsider an experiment.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Stop rules","text":"A stop rule specifies when to end, pause or reconsider an experiment. It should account for expected information and operational constraints.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An interrupted experiment need not have a verdict; it may simply be incomplete.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define deadline and pause criteria.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Separate operational stopping from statistical conclusions.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},"previous":{"id":"075","slug":"views-to-buyers","term":"Views to buyers","category":"lab","kind":"protocol","image":"iceberg","tier":"operating","evidence":"hypothesis","sources":[],"related":["experiment-preregistration","attribution","distribution-is-the-moat"],"fr":{"title":"Un million de vues peut rater le problème.","dek":"Les vues mesurent une exposition selon la définition de la plateforme.","point":"Les vues mesurent une exposition selon la définition de la plateforme. Les nouveaux acheteurs mesurent un résultat commercial distinct, qui exige une définition et une source propres.","body":["Suivez le passage entre contenu, visite, usage et achat sans supposer que toutes les personnes sont identifiables. Pour un premier achat, excluez les renouvellements et les tests selon des règles documentées. Une hausse de vues peut rester utile pour la notoriété ; elle ne doit pas être rebaptisée croissance de clients.","Un article peut contribuer à plusieurs objectifs : compréhension, recrutement d’opérateurs ou découverte du produit. Définissez celui que vous évaluez avant de réécrire son CTA. Une page sans achat directement attribué peut encore rendre un service réel. Le piège consiste à confondre cette valeur possible avec un résultat commercial déjà démontré."],"action":["Définir le résultat commercial attendu.","Conserver les limites de rapprochement des identités."],"trap":"Un checkout ouvert ou une simulation ne constitue pas un paiement réel.","quote":"Un million de vues peut rater le problème.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Un million de vues peut rater le problème.","text":"Les vues mesurent une exposition selon la définition de la plateforme.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Views to buyers","text":"Les vues mesurent une exposition selon la définition de la plateforme. Les nouveaux acheteurs mesurent un résultat commercial distinct, qui exige une définition et une source propres.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un checkout ouvert ou une simulation ne constitue pas un paiement réel.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Définir le résultat commercial attendu.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Conserver les limites de rapprochement des identités.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"A million views can miss the problem.","dek":"Views measure exposure under the platform’s definition.","point":"Views measure exposure under the platform’s definition. New buyers measure a separate commercial outcome requiring its own definition and source.","body":["Track movement from content to visit, use and purchase without assuming everyone is identifiable. For first purchases, exclude renewals and tests under documented rules. More views may still support awareness; they should not be renamed customer growth.","An article can support several goals: understanding, operator recruitment or product discovery. Define which one is being evaluated before rewriting its CTA. A page without directly attributed purchases may still provide real value. The trap is confusing that possible value with an already demonstrated commercial outcome. Keep each objective and evidence source separate so useful recruitment or learning paths are not erased by an overly narrow sales metric."],"action":["Define the intended commercial outcome.","Retain identity-matching limitations."],"trap":"An opened checkout or preview is not a real payment.","quote":"A million views can miss the problem.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"A million views can miss the problem.","text":"Views measure exposure under the platform’s definition.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Views to buyers","text":"Views measure exposure under the platform’s definition. New buyers measure a separate commercial outcome requiring its own definition and source.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"An opened checkout or preview is not a real payment.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Define the intended commercial outcome.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Retain identity-matching limitations.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}}}],"$L14","$L15","$L16","$L17"]}]
