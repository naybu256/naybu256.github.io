14:["$","header",null,{"className":"article-header","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","$Lc",null,{"href":"/fr/","children":"BLACKCURRENT"}],["$","span",null,{"children":"/"}],["$","$Lc",null,{"href":"/fr/topics/lab/","children":"Le Lab"}],["$","span",null,{"children":"/"}],["$","span",null,{"children":"Preregistration"}]]}],["$","div",null,{"className":"mono acid","style":{"marginTop":28},"children":["LAB / RESEARCH PROTOCOL"," ","· ","076"]}],["$","h1",null,{"children":"Écrire le verdict possible avant de connaître le score."}],["$","p",null,{"className":"article-dek","children":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue."}],["$","div",null,{"className":"byline","children":[["$","span",null,{"className":"author-mark","children":"BC"}],["$","$Lc",null,{"href":"/fr/about/","children":"La rédaction"}],["$","span",null,{"className":"muted","children":["08.09.2026 · ",1," min"]}],["$","span",null,{"className":"evidence-tag","children":"Hypothèse · résultat inconnu"}]]}]]}]
15:["$","figure",null,{"style":{"margin":0},"children":[["$","div",null,{"className":"article-hero","children":["$","img",null,{"src":"/images/iceberg.jpg","alt":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","width":1536,"height":1024,"fetchPriority":"high"}]}],["$","figcaption",null,{"className":"image-caption","children":["BLACKCURRENT STUDIO ·"," ","ILLUSTRATION ÉDITORIALE GÉNÉRÉE PAR IA"]}]]}]
16:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-aside","children":[["$","span",null,{"className":"mono acid","children":"DANS CET ARTICLE"}],["$","a",null,{"href":"#definition","children":["01 / ","L’essentiel"]}],["$","a",null,{"href":"#analysis","children":["02 / ","Le décryptage"]}],["$","a",null,{"href":"#practice","children":["03 / ","Sur le terrain"]}],["$","a",null,{"href":"#sources","children":["04 / ","Sources & limites"]}],["$","$Lc",null,{"href":"/fr/lexicon/","children":["↗ ","Le lexique AGD"]}]]}],["$","article",null,{"className":"article-text","children":[["$","section",null,{"className":"quick-answer","id":"definition","children":[["$","span",null,{"className":"mono acid","children":"À RETENIR"}],["$","p",null,{"children":"Préenregistrer une expérience signifie noter à l’avance sa question, ses critères et son analyse prévue. Cela limite les récits reconstruits après observation."}]]}],["$","$L19",null,{"a":"$1:props:children:1:props:article","lang":"fr"}],"$undefined",["$","section",null,{"id":"analysis","className":"article-prose","children":[["$","p","0",{"children":"Un document daté suffit pour commencer : hypothèse, groupes, durée, indicateur principal, exclusions et décision attendue. Vous pouvez modifier le plan si la réalité l’exige, à condition de garder la version précédente et d’expliquer pourquoi. L’exploration reste possible ; elle doit être identifiée comme telle."}],["$","p","1",{"children":"Ajoutez un exemple de conclusion acceptable pour chaque issue : signal favorable, différence incertaine ou problème de mesure. Cet exercice révèle souvent les protocoles qui ne savent pas quoi faire d’un résultat négatif. Une bonne expérience doit rester informative quand elle contrarie le plan initial. Sinon, elle sert surtout à produire une justification après coup."}]]}],["$","blockquote",null,{"children":["“","Écrire le verdict possible avant de connaître le score.","”"]}],"$undefined",false,["$","$L19",null,{"a":"$1:props:children:1:props:article","lang":"fr","number":2}],["$","section",null,{"id":"practice","children":[["$","h2",null,{"children":"Le passage à l’action."}],["$","ol",null,{"className":"checklist","children":[["$","li","0",{"children":[["$","span",null,{"children":["0",1]}],"Figer une version du plan avant collecte."]}],["$","li","1",{"children":[["$","span",null,{"children":["0",2]}],"Journaliser les écarts et analyses exploratoires."]}]]}]]}],["$","section",null,{"id":"sources","children":[["$","h2",null,{"children":"Ce qu’il ne faut pas lui faire dire."}],["$","p",null,{"className":"caveat","children":[["$","strong",null,{"children":"La limite. "}],"Préenregistrer un mauvais protocole ne le rend pas valide ; cela rend seulement ses choix visibles."]}],["$","div",null,{"className":"sources","children":[["$","span",null,{"className":"mono acid","children":"SOURCES & PROVENANCE"}],["$","p",null,{"children":"Analyse originale issue du cadre AGD fourni par TokPortal, lexique et doctrine (2026). Les exemples sont illustratifs. Aucune étude propriétaire ni résultat client n’est revendiqué."}],["$","p",null,{"className":"editorial-note","children":["BLACKCURRENT est un projet éditorial initié par TokPortal. Cette relation est distincte du niveau de preuve des affirmations. Rédaction et traduction assistées par IA ; aucune identité de journaliste fictive."," ",["$","$Lc",null,{"href":"/fr/about/","children":"Notre ligne éditoriale →"}]]}]]}]]}],["$","div",null,{"className":"next-read","children":[["$","span",null,{"className":"mono acid","children":"LE COURANT CONTINUE"}],["$","h2",null,{"children":["$","$Lc",null,{"href":"/fr/read/lab/stop-rules/","children":"Savoir arrêter fait partie du test."}]}],["$","$Lc",null,{"href":"/fr/read/lab/stop-rules/","className":"read-link","children":["Article suivant"," ↗"]}]]}]]}],["$","aside",null,{"className":"article-aside right-aside","children":[["$","span",null,{"className":"mono muted","children":"CONNECTED IDEAS"}],[["$","$Lc","077",{"href":"/fr/read/lab/stop-rules/","children":["Stop rules"," ↗"]}],["$","$Lc","075",{"href":"/fr/read/lab/views-to-buyers/","children":["Views to buyers"," ↗"]}],["$","$Lc","001",{"href":"/fr/read/doctrine/distribution-is-the-moat/","children":["Account-Generated Distribution"," ↗"]}]]]}]]}]
17:["$","section",null,{"className":"related-grid","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Autres courants."}]}],["$","div",null,{"className":"article-grid","children":[["$","$L1a","077",{"a":"$1:props:children:1:props:next","lang":"fr"}],["$","$L1a","075",{"a":"$1:props:children:1:props:previous","lang":"fr"}],["$","$L1a","001",{"a":{"id":"001","slug":"distribution-is-the-moat","category":"doctrine","term":"Account-Generated Distribution","kind":"essay","image":"iceberg","tier":"canonical","evidence":"editorial","sources":[],"related":["account-isolation","content-isolation","content-saturation"],"fr":{"title":"Le contenu est gratuit. La distribution ne l’est pas.","dek":"Tout le monde peut produire. Presque personne ne sait distribuer. Bienvenue de l’autre côté de l’iceberg.","point":"L’Account-Generated Distribution (AGD) organise des comptes sociaux différenciés comme une infrastructure de distribution organique. Multiplier les comptes n’a de sens que si les publics, les voix et les contenus se différencient.","body":["Le pitch tient dans un onglet : un générateur, quelques prompts, cinquante vidéos. Le problème arrive après l’export. Qui va regarder ? Pourquoi cette personne s’arrêterait-elle sur ce compte plutôt que sur le prochain ? La production a un bouton. La distribution réclame encore une raison d’exister.","Un compte de marque doit souvent tout faire : rassurer, vendre, faire rire, recruter, expliquer. Chaque post négocie avec les autres. L’AGD propose de séparer ces rôles. Un compte peut explorer les galères d’étudiants ; un autre démonter des habitudes de travail ; un troisième montrer le produit en situation. Même entreprise, trois contrats éditoriaux.","Le piège consiste à prendre ce schéma pour une recette de volume. Trente comptes qui publient le même montage ne représentent pas trente idées. Ils multiplient surtout le travail de coordination, les risques de répétition et les questions sans réponse. La diversification se juge dans ce que reçoit le lecteur, pas dans le nombre de lignes d’un tableau.","L’AGD est ici un cadre proposé à partir du blueprint TokPortal, pas un consensus académique ni une promesse de portée. Il vaut ce que valent les expériences qu’il permet de conduire. Le test intéressant : apprend-on quelque chose qu’un compte unique aurait masqué ? Peut-on attribuer ce signal à un angle, à un public, à un format ?","Construisez donc un petit réseau dont vous pouvez expliquer chaque différence. Documentez les contenus qui échouent autant que ceux qui décollent. Et gardez une mesure commerciale à côté des vues : une audience qui admire un montage n’a pas forcément un problème que votre produit résout."],"action":["Écrire une promesse éditoriale distincte par compte.","Associer chaque publication à une hypothèse et à un public.","Mesurer les résultats par cohorte, puis les visites qualifiées."],"trap":"Un réseau de clones peut augmenter votre production sans ajouter une seule perspective.","quote":"Le prochain avantage ne sera pas de produire plus. Ce sera de savoir où une idée mérite de vivre.","stories":[{"id":"brief","title":"L’idée en trois écrans.","slides":[{"label":"LE SIGNAL","title":"Le prochain avantage ne sera pas de produire plus. Ce sera de savoir où une idée mérite de vivre.","text":"Tout le monde peut produire. Presque personne ne sait distribuer. Bienvenue de l’autre côté de l’iceberg.","media":"/images/iceberg.jpg"},{"label":"LE CONCEPT","title":"Account-Generated Distribution","text":"L’Account-Generated Distribution (AGD) organise des comptes sociaux différenciés comme une infrastructure de distribution organique. Multiplier les comptes n’a de sens que si les publics, les voix et les contenus se différencient.","media":"/images/iceberg.jpg"},{"label":"LE CONTRE-CHAMP","title":"Ce qui peut tromper.","text":"Un réseau de clones peut augmenter votre production sans ajouter une seule perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"Du concept au terrain.","slides":[{"label":"PASSER À L’ACTION / 1","title":"Écrire une promesse éditoriale distincte par compte.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 2","title":"Associer chaque publication à une hypothèse et à un public.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"},{"label":"PASSER À L’ACTION / 3","title":"Mesurer les résultats par cohorte, puis les visites qualifiées.","text":"À adapter à votre public, à votre budget et au périmètre de votre test.","media":"/images/iceberg.jpg"}]}]},"en":{"title":"Content is cheap. Distribution isn’t.","dek":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","point":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","body":["The pitch fits in a browser tab: one generator, a few prompts, fifty videos. The problem starts after export. Who watches? Why should that person stop at this account instead of the next one? Production has a button. Distribution still needs a reason to exist.","A brand account is often asked to reassure, sell, entertain, recruit and explain. Every post negotiates with the others. AGD separates those jobs. One account explores student frustrations; another challenges work habits; a third demonstrates a product in context. One company, three editorial promises.","The trap is reading this architecture as a volume recipe. Thirty accounts running the same edit do not represent thirty ideas. They mostly multiply coordination, repetition and unanswered questions. Diversification lives in what a viewer receives, not in the number of rows in a spreadsheet.","AGD is a proposed framework drawn from the TokPortal blueprint, not an academic consensus or a reach guarantee. Its value depends on the experiments it helps run. The useful question is whether a network reveals something that one account would hide. Can the signal be connected to an angle, an audience or a format?","Build a small network whose differences you can explain. Document the failures alongside the breakout posts. And keep a commercial measure next to views: somebody enjoying your edit does not necessarily have a problem your product solves."],"action":["Write a different editorial promise for each account.","Attach each post to a hypothesis and an audience.","Measure by cohort, then inspect qualified visits."],"trap":"A clone network can increase output without adding a single perspective.","quote":"The next advantage is knowing where an idea deserves to live.","stories":[{"id":"brief","title":"The idea in three screens.","slides":[{"label":"THE SIGNAL","title":"The next advantage is knowing where an idea deserves to live.","text":"Everyone can produce. Almost nobody knows how to distribute. Welcome to the other side of the iceberg.","media":"/images/iceberg.jpg"},{"label":"THE CONCEPT","title":"Account-Generated Distribution","text":"Account-Generated Distribution (AGD) organizes differentiated social accounts as organic distribution infrastructure. More accounts only make strategic sense when audiences, voices and creative work also differ.","media":"/images/iceberg.jpg"},{"label":"THE OTHER SIDE","title":"What can mislead.","text":"A clone network can increase output without adding a single perspective.","media":"/images/iceberg.jpg"}]},{"id":"practice","title":"From concept to practice.","slides":[{"label":"PUT IT TO WORK / 1","title":"Write a different editorial promise for each account.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 2","title":"Attach each post to a hypothesis and an audience.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"},{"label":"PUT IT TO WORK / 3","title":"Measure by cohort, then inspect qualified visits.","text":"Adapt this to your audience, budget and test scope.","media":"/images/iceberg.jpg"}]}]},"video":{"src":"/video/below-the-surface.mp4","poster":"/images/iceberg.jpg","caption":{"fr":"Sous la surface — animation d’une illustration originale. Sans audio.","en":"Below the surface — animated original illustration. No audio."},"tracks":{"fr":"/video/intro-fr.vtt","en":"/video/intro-en.vtt"}},"schemaVersion":1,"publishedAt":"2026-09-08T12:00:00Z","updatedAt":"2026-09-08T12:00:00Z","author":"blackcurrent-editorial","media":{"src":"/images/iceberg.jpg","width":1536,"height":1024,"alt":{"fr":"Iceberg nocturne et masse immergée verte, métaphore de la distribution invisible.","en":"Night iceberg with a green submerged mass, a metaphor for unseen distribution."},"credit":"BLACKCURRENT Studio","provenance":"AI-generated editorial illustration; original imagegen asset, September 8, 2026."}},"lang":"fr"}]]}]]}]
